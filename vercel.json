{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/ig",
      "destination": "/pl/?utm_campaign=organic-outbound&utm_source=instagram&utm_medium=bio",
      "permanent": false
    },
    {
      "source": "/ig/",
      "destination": "/pl/?utm_campaign=organic-outbound&utm_source=instagram&utm_medium=bio",
      "permanent": false
    },
    {
      "source": "/contra",
      "destination": "/pl/?utm_campaign=organic-outbound&utm_source=contra&utm_medium=profile",
      "permanent": false
    },
    {
      "source": "/contra/",
      "destination": "/pl/?utm_campaign=organic-outbound&utm_source=contra&utm_medium=profile",
      "permanent": false
    },
    {
      "source": "/li",
      "destination": "/pl/?utm_campaign=organic-outbound&utm_source=linkedin&utm_medium=bio",
      "permanent": false
    },
    {
      "source": "/li/",
      "destination": "/pl/?utm_campaign=organic-outbound&utm_source=linkedin&utm_medium=bio",
      "permanent": false
    },
    {
      "source": "/gh",

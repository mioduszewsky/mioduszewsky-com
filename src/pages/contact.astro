---
// /contact — dedykowana strona domykająca (research 16.07.2026: hybryda
// „umów rozmowę" + krótki formularz konwertuje najlepiej dla high-ticket
// founder-led). Styl 1:1 z W5 (ivory/ink/blue/brand, Nohemi + General Sans).
import VariantLayout from '../layouts/VariantLayout.astro';
import LanguageSwitch from '../components/LanguageSwitch.astro';
import { contactPl } from '../content/contact-pl';
import { routes, type Locale } from '../i18n/site';
import { TRACKING_ENABLED, GOOGLE_ADS_ID, GOOGLE_ADS_LABEL } from '../config/tracking';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const isPl = locale === 'pl';
const p = isPl ? contactPl : undefined;
const r = routes[locale];
const alt = routes[isPl ? 'en' : 'pl'];

// === DO UZUPEŁNIENIA ===
// Link z Google Calendar → „Umów termin" (Appointment schedule). Pusty = pokazujemy
// przycisk-zastępnik z mailem, bez osadzonego kalendarza.
// Pełny URL harmonogramu + ?gv=true (parametr embed Google); krótki link:
// https://calendar.app.google/GhHdELRtMzaYqnJk6
const GOOGLE_BOOKING_URL = 'https://calendar.google.com/calendar/appointments/schedules/AcZssZ39wrl4iSUoqCtoj5VJq-7MT070YyXr1xMDsy1ncUfS8g-bHiVCisccj1MjHpkPjRlwDlJSw1kU?gv=true';
// Endpoint = API Gateway HTTP API → Lambda → SES (eu-central-1).
// (Function URL z publicznym auth NIE działa na tym koncie — guardrail; użyto API GW.)
const CONTACT_ENDPOINT = 'https://fdoy7mjmtd.execute-api.eu-central-1.amazonaws.com/';
// =======================
---

<VariantLayout
  title={p?.meta.title || 'Book a call · mioduszewsky'}
  bg="#f8f9f2"
  fg="#000000"
  switcher={false}
  robots="index, follow, max-image-preview:large"
  description={p?.meta.description || 'Book a free 15-minute call or send a short message. One person from idea to launch: strategy, copy, design and build.'}
  locale={locale}
  alternatePath={alt.contact}
>
  <main class="ct">
    <header class="ct-nav">
      <a class="mark" href={r.home} aria-label={p?.logoAria || 'mioduszewsky — back home'}>
        <video autoplay loop muted playsinline preload="auto" aria-hidden="true" poster="/logo3d/logo-nav-poster.webp">
          <source src="/logo3d/logo-nav.mp4" type="video/mp4;codecs=hvc1" />
          <source src="/logo3d/logo-nav.webm" type="video/webm" />
        </video>
      </a>
      <div class="nav-actions">
        {/* „← Wroc" przed przelacznikiem jezyka: przy odwrotnej kolejnosci strzalka
            celowala prosto w „EN" i czytalo sie to jak „wroc do wersji angielskiej". */}
        <a class="back" href={r.home}>← {p?.back || 'Back'}</a>
        <LanguageSwitch locale={locale} href={alt.contact} />
      </div>
    </header>

    <section class="ct-head">
      <div class="ct-head-l">
        <p class="label">{p?.label || '( Next step · one honest conversation )'}</p>
        <h1>
          {isPl ? <Fragment><span class="hl">{p!.h1}</span><br />{p!.h2}<br />{p!.h3}</Fragment> : <Fragment>Book a <span class="hl">15-minute</span> call.<br />Or just write to me.</Fragment>}
        </h1>
      </div>
      <p class="lead">
        {p?.lead || 'Tell me what you have now, even if it is nothing yet, what is not working and what the new page should do. I will tell you whether the project is a fit and what I would build first. No pressure, no sales script.'}
      </p>
    </section>

    <section class="ct-grid">
      <!-- ŚCIEŻKA 1: umów rozmowę (główny CTA) -->
      <div class="path path-call">
        <span class="pnum">01</span>
        <h2>{p?.call.title || 'Book a call'}</h2>
        <p class="pdesc">{p?.call.desc || 'Pick a slot that works for you. 15 minutes, video, no obligation.'}</p>
        {GOOGLE_BOOKING_URL ? (
          <div class="cal-embed" id="calEmbed" data-src={GOOGLE_BOOKING_URL}>
            <div class="cal-consent" id="calConsent">
              <p>{p?.call.consent || 'The booking calendar is provided by Google and, once shown, sets a cookie on your device to display available times.'}</p>
              <button type="button" class="btn" id="calLoadBtn"><span class="btn-in">{p?.call.show || 'Show calendar'}</span></button>
            </div>
            {/* Pokazywane tylko wtedy, gdy ramka nie wstala — najczesciej przez blokera. */}
            <div class="cal-blocked" id="calBlocked" hidden>
              <p class="cal-blocked-t">{p?.call.blockedTitle || 'The calendar will not load here'}</p>
              <p class="cal-blocked-n">{p?.call.blockedNote || 'A privacy extension is usually the reason. Open it in a new window instead — it works there.'}</p>
            </div>
          </div>
          <div class="cal-actions">
            {/* Widoczny ZAWSZE, nie dopiero po wykryciu bledu: omija ramke calkowicie,
                wiec dziala takze u ludzi, ktorych bloker podmienia iframe na pusta strone. */}
            <a class="btn cal-open" href={GOOGLE_BOOKING_URL} target="_blank" rel="noopener">
              <span class="btn-in">{p?.call.openNew || 'Open the calendar in a new window'}</span>
            </a>
            <p class="cal-note">{p?.call.noteBefore || 'Prefer email?'} <a href={`mailto:kacper@mioduszewsky.com?subject=${encodeURIComponent(p?.call.mailSubject || 'Book a call')}`}>{p?.call.email || 'Email me'}</a> {p?.call.noteAfter || 'and we will find a slot.'}</p>
          </div>
        ) : (
          <div class="cal-fallback">
            <a class="btn big" href={`mailto:kacper@mioduszewsky.com?subject=${encodeURIComponent(p?.call.mailSubject || 'Book a call')}`}>
              <span class="btn-in">{p?.call.fallback || 'Email me to book a call'}</span>
            </a>
            <p class="note">{p?.call.fallbackNote || 'Live calendar is being connected. For now, email works and I reply fast.'}</p>
          </div>
        )}
      </div>

      <!-- ŚCIEŻKA 2: krótki formularz (max 3 pola + zgoda) -->
      <div class="path path-form">
        <span class="pnum">02</span>
        <h2>{p?.form.title || 'Or send a message'}</h2>
        <p class="pdesc">{p?.form.desc || 'Prefer to write first? Three fields, that is it.'}</p>

        <form id="ctForm" novalidate>
          <label class="fld">
            <span>{p?.form.name || 'Your name'}</span>
            <input type="text" name="name" autocomplete="name" required maxlength="120" />
          </label>
          <label class="fld">
            <span>{p?.form.email || 'Email'}</span>
            <input type="email" name="email" autocomplete="email" required maxlength="200" />
          </label>
          <label class="fld">
            <span>{p?.form.message || 'What should we talk about?'}</span>
            <textarea name="message" rows="3" required maxlength="4000"></textarea>
          </label>

          <!-- honeypot: ukryte, boty wypełnią -->
          <div class="hp" aria-hidden="true">
            <label>{p?.form.honeypot || 'Leave this empty'}<input type="text" name="hp" tabindex="-1" autocomplete="off" /></label>
          </div>

          <label class="consent">
            <input type="checkbox" name="consent" required />
            <span>{isPl ? <Fragment>{p!.form.consentBefore} <a href={r.privacy}>{p!.form.privacy}</a> i <a href={r.terms}>{p!.form.terms}</a>.</Fragment> : <Fragment>I agree that my data is processed to answer this message, per the <a href={r.privacy}>privacy policy</a> and <a href={r.terms}>terms of service</a>.</Fragment>}</span>
          </label>

          <button type="submit" class="btn big submit">
            <span class="btn-in">{p?.form.send || 'Send message'}</span>
          </button>
          <p class="formmsg" id="ctMsg" role="status" aria-live="polite"></p>
        </form>

        <div class="ct-success" id="ctSuccess" hidden>
          <h3>{p?.form.successTitle || 'Thanks — message sent.'}</h3>
          <p>{p?.form.successText || 'I read every message myself and reply within a day. Want it faster? Grab a call slot:'}</p>
          <a class="btn big" href={GOOGLE_BOOKING_URL || `mailto:kacper@mioduszewsky.com?subject=${encodeURIComponent(p?.call.mailSubject || 'Book a call')}`}>
            <span class="btn-in">{isPl ? 'Umów 15 minut' : 'Book a 15-min call'}</span>
          </a>
        </div>
      </div>
    </section>

    <section class="ct-alt">
      <p class="label">{p?.other || '( Other ways )'}</p>
      <div class="alt-grid">
        <a href="mailto:kacper@mioduszewsky.com">kacper@mioduszewsky.com</a>
        <a class="sc" href="https://instagram.com/mioduszewsky" target="_blank" rel="noopener"><svg class="sc-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.914-.0564 1.2775-.0689 1.6882-.0626 4.947.0062 3.2586.0206 3.6671.0825 4.9473.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.295 1.6361.4961 2.9134.552 1.2773.056 1.6884.069 4.9462.0627 3.2578-.0062 3.668-.0207 4.9478-.0814 1.28-.0607 2.147-.2652 2.9098-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.6682 1.0745-1.3378 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6898.063-4.948-.0063-3.2583-.021-3.6668-.0817-4.9465-.0607-1.2797-.264-2.1487-.5633-2.9117-.3084-.7889-.72-1.4568-1.3876-2.1228C21.2982 1.33 20.628.9208 19.8378.6165 19.074.321 18.2017.1197 16.9244.0645 15.6471.0093 15.236-.005 11.977.0014 8.718.0076 8.31.0215 7.0301.0839m.1402 21.6932c-1.17-.0509-1.8053-.2453-2.2287-.408-.5606-.216-.96-.4771-1.3819-.895-.422-.4178-.6811-.8186-.9-1.378-.1644-.4234-.3624-1.058-.4171-2.228-.0595-1.2645-.072-1.6442-.079-4.848-.007-3.2037.0053-3.583.0607-4.848.05-1.169.2456-1.805.408-2.2282.216-.5613.4762-.96.895-1.3816.4188-.4217.8184-.6814 1.3783-.9003.423-.1651 1.0575-.3614 2.227-.4171 1.2655-.06 1.6447-.072 4.848-.079 3.2033-.007 3.5835.005 4.8495.0608 1.169.0508 1.8053.2445 2.228.408.5608.216.96.4754 1.3816.895.4217.4194.6816.8176.9005 1.3787.1653.4217.3617 1.056.4169 2.2263.0602 1.2655.0739 1.645.0796 4.848.0058 3.203-.0055 3.5834-.061 4.848-.051 1.17-.245 1.8055-.408 2.2294-.216.5604-.4763.96-.8954 1.3814-.419.4215-.8181.6811-1.3783.9-.4224.1649-1.0577.3617-2.2262.4174-1.2656.0595-1.6448.072-4.8493.079-3.2045.007-3.5825-.006-4.848-.0608M16.953 5.5864A1.44 1.44 0 1 0 18.39 4.144a1.44 1.44 0 0 0-1.437 1.4424M5.8385 12.012c.0067 3.4032 2.7706 6.1557 6.173 6.1493 3.4026-.0065 6.157-2.7701 6.1506-6.1733-.0065-3.4032-2.771-6.1565-6.174-6.1498-3.403.0067-6.156 2.771-6.1496 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A3.9996 3.9996 0 0 1 8 12.0077" /></svg><span>Instagram</span></a>
        <a class="sc" href="https://www.linkedin.com/in/kacper-mioduszewski/" target="_blank" rel="noopener"><svg class="sc-i sc-i-in" viewBox="0 0 24 24" aria-hidden="true"><g transform="scale(0.0535714)"><path d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z" /></g></svg><span>LinkedIn</span></a>
        <a class="sc" href="https://contra.com/kacper_mioduszewski_i7ytzt28" target="_blank" rel="noopener"><svg class="sc-i sc-i-contra" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M8.53257 4.1249C7.3761 5.8885 5.86224 7.39707 4.09025 8.54825C2.83892 9.4038 1.46713 10.0996 0.00488281 10.6031V11.0068H11.0004V0.0055542H10.6134C10.1069 1.47971 9.40224 2.86386 8.53213 4.1249H8.53257ZM12.9974 0.0055542V11.054H23.9942V10.6503C22.5324 10.1468 21.1615 9.45101 19.9089 8.59546C18.1386 7.44428 16.6234 5.93571 15.467 4.17211C14.5876 2.89783 13.8772 1.4978 13.3694 0.0055542H12.9974ZM23.9942 12.946H12.9974V23.9945H13.3694C13.8772 22.5027 14.5872 21.1022 15.467 19.8279C16.6234 18.0643 18.1391 16.5557 19.9089 15.4046C21.1615 14.5486 22.5324 13.8532 23.9942 13.3497V12.946ZM11.0008 23.9945V12.9932H0.00532404V13.3969C1.46713 13.9004 2.83936 14.5962 4.09069 15.4518C5.86224 16.6029 7.3761 18.112 8.53301 19.8751C9.40312 21.1362 10.1073 22.5199 10.6143 23.994H11.0013L11.0008 23.9945Z" /></svg><span>Contra</span></a>
      </div>
    </section>

    <footer class="ct-foot">
      <span>© 2026 mioduszewsky</span>
      <span>{p?.remote || 'Wrocław, PL · working worldwide'}</span>
      <a href={r.terms}>{p?.terms || 'Terms'}</a>
      <a href={r.privacy}>{p?.privacy || 'Privacy'}</a>
    </footer>
  </main>

  <script define:vars={{ CONTACT_ENDPOINT, TRACKING_ENABLED, GOOGLE_ADS_ID, GOOGLE_ADS_LABEL, isPl, formCopy: p?.form, iframeTitle: p?.call.iframeTitle }}>
    // Kalendarz Google ustawia cookie NID gdy się ładuje. Dwie ścieżki zgody:
    // 1) TRACKING_ENABLED (baner site-wide w VariantLayout skonfigurowany): jeśli user
    //    kliknął Accept w bannerze (mioduszewsky_consent), kalendarz ładuje się od razu,
    //    bez dodatkowego klika — zgoda już jest załatwiona wcześniej w wizycie.
    // 2) Bez tego (TRACKING_ENABLED=false, stan obecny — żadne ID jeszcze nie ustawione,
    //    więc bannera nie ma): zostaje lokalny gate "Show calendar" per-widget.
    const CAL_CONSENT_KEY = 'mioduszewsky_cal_consent';
    const SITE_CONSENT_KEY = 'mioduszewsky_consent';
    const calEmbed = document.getElementById('calEmbed');
    const calConsent = document.getElementById('calConsent');
    const calLoadBtn = document.getElementById('calLoadBtn');
    const calBlocked = document.getElementById('calBlocked');
    /* Ramka Google Calendar to czesty cel rozszerzen prywatnosci. Rozpoznajemy dwa
       przypadki: (1) zadanie w ogole nie doszlo — brak zdarzenia `load` w oknie czasu;
       (2) bloker podmienil ramke na pusta strone — wtedy `load` jest, ale dokument
       staje sie SAME-ORIGIN i da sie go odczytac. Prawdziwy kalendarz jest cross-origin,
       wiec proba odczytu rzuca wyjatkiem — i to wlasnie oznacza, ze wszystko dziala. */
    function markCalendarBlocked() {
      if (!calBlocked || !calBlocked.hidden) return;
      calBlocked.hidden = false;
      calEmbed?.classList.add('cal-is-blocked');
    }
    function loadCalendar() {
      if (!calEmbed || calEmbed.querySelector('iframe')) return;
      const iframe = document.createElement('iframe');
      iframe.src = calEmbed.dataset.src;
      iframe.title = iframeTitle || 'Book a 15-minute call';
      iframe.style.border = '0';
      iframe.width = '100%';
      iframe.height = '560';
      calConsent?.remove();
      const timer = setTimeout(markCalendarBlocked, 6000);
      iframe.addEventListener('load', () => {
        clearTimeout(timer);
        try {
          if (iframe.contentDocument) markCalendarBlocked();
        } catch { /* cross-origin = realny kalendarz, nic nie robimy */ }
      });
      iframe.addEventListener('error', () => { clearTimeout(timer); markCalendarBlocked(); });
      calEmbed.appendChild(iframe);
      try { localStorage.setItem(CAL_CONSENT_KEY, '1'); } catch {}
    }
    if (calEmbed) {
      let alreadyConsented = false;
      try {
        alreadyConsented = TRACKING_ENABLED
          ? localStorage.getItem(SITE_CONSENT_KEY) === 'accepted'
          : localStorage.getItem(CAL_CONSENT_KEY) === '1';
      } catch {}
      if (alreadyConsented) loadCalendar();
      calLoadBtn?.addEventListener('click', loadCalendar);
      // Jeśli user klika Accept w bannerze PO wejściu na tę stronę (bez przeładowania).
      document.addEventListener('mioduszewsky:trackingReady', loadCalendar);
    }

    // Przechwyt UTM z URL-a, żeby atrybucja przeżyła do maila (patrz TRACKING-GATE.md).
    const utmParams = new URLSearchParams(location.search);
    const utm = {
      utm_source: utmParams.get('utm_source') || '',
      utm_medium: utmParams.get('utm_medium') || '',
      utm_campaign: utmParams.get('utm_campaign') || '',
      utm_content: utmParams.get('utm_content') || '',
      utm_term: utmParams.get('utm_term') || '',
    };
    const utmSuffix = Object.values(utm).some(Boolean)
      ? '\n\n[utm] ' + Object.entries(utm).filter(([, v]) => v).map(([k, v]) => k + '=' + v).join(' ')
      : '';

    // Event celu "Lead" po realnym wysłaniu formularza — patrz TRACKING-GATE.md.
    function fireLeadConversion() {
      try {
        if (window.gtag && GOOGLE_ADS_ID && GOOGLE_ADS_LABEL) {
          window.gtag('event', 'conversion', { send_to: GOOGLE_ADS_ID + '/' + GOOGLE_ADS_LABEL });
        }
      } catch {}
      try { window.posthog?.capture('Lead'); } catch {}
      // Meta: ten sam event celu co Google. fbq istnieje tylko po zgodzie (VariantLayout).
      try { window.fbq?.('track', 'Lead'); } catch {}
    }

    const form = document.getElementById('ctForm');
    const msg = document.getElementById('ctMsg');
    const success = document.getElementById('ctSuccess');
    const btn = form?.querySelector('button[type="submit"]');

    // iOS: :active nie działa bez listenera touchstart; haptyka = Android vibrate
    addEventListener('touchstart', () => {}, { passive: true });
    const coarse = matchMedia('(pointer: coarse)').matches;
    const buzz = (pattern) => { if (coarse) try { navigator.vibrate?.(pattern); } catch {} };

    // Błąd = komunikat + podświetlenie KONKRETNYCH pól + focus na pierwszym z nich.
    const showError = (text, fields = []) => {
      form.querySelectorAll('.err').forEach((f) => f.classList.remove('err'));
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
      fields.forEach((n) => {
        const input = form.querySelector(`[name="${n}"]`);
        input?.setAttribute('aria-invalid', 'true');
        // consent leży w label.consent, nie w .fld — closest łapie oba przypadki
        input?.closest('.fld, .consent')?.classList.add('err');
      });
      msg.textContent = text;
      msg.classList.remove('err');
      void msg.offsetWidth; // restart animacji shake przy kolejnym błędzie
      msg.classList.add('err');
      buzz([12, 60, 12]); // podwójny impuls = „coś nie tak" (Android)
      form.querySelector('.err input, .err textarea')?.focus();
    };
    // interakcja z polem czyści jego stan błędu od razu (dotyczy też checkboxa)
    form?.addEventListener('input', (e) => {
      e.target.removeAttribute?.('aria-invalid');
      e.target.closest('.fld, .consent')?.classList.remove('err');
      if (!form.querySelector('.err')) { msg.textContent = ''; msg.classList.remove('err'); }
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const name = (fd.get('name') || '').toString().trim();
      const email = (fd.get('email') || '').toString().trim();
      const message = (fd.get('message') || '').toString().trim();
      const consent = fd.get('consent') === 'on';
      const hp = (fd.get('hp') || '').toString();

      const missing = [];
      if (!name) missing.push('name');
      if (!email) missing.push('email');
      if (!message) missing.push('message');
      if (missing.length) { showError(formCopy?.missing || 'Please fill in all three fields.', missing); return; }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { showError(formCopy?.invalidEmail || 'That email does not look right.', ['email']); return; }
      if (!consent) { showError(formCopy?.missingConsent || 'Please tick the consent box so I can reply.', ['consent']); return; }
      msg.textContent = '';
      msg.classList.remove('err');

      const messageWithUtm = message + utmSuffix;

      // Bez skonfigurowanego endpointu — fallback do maila (nic nie ginie).
      if (!CONTACT_ENDPOINT) {
        window.location.href =
          'mailto:kacper@mioduszewsky.com?subject=' + encodeURIComponent((formCopy?.fallbackSubject || 'Contact from ') + name) +
          '&body=' + encodeURIComponent(messageWithUtm + '\n\n— ' + name + ' (' + email + ')');
        fireLeadConversion();
        return;
      }

      btn.disabled = true;
      const orig = btn.querySelector('.btn-in').textContent;
      btn.querySelector('.btn-in').textContent = formCopy?.sending || 'Sending…';
      try {
        const res = await fetch(CONTACT_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, message: messageWithUtm, consent, hp }),
        });
        if (!res.ok) throw new Error('bad_status');
        form.hidden = true;
        success.hidden = false;
        buzz(16); // pojedynczy dłuższy impuls = sukces (Android)
        fireLeadConversion();
      } catch {
        showError(formCopy?.error || 'Something went wrong. Email me directly at kacper@mioduszewsky.com.');
        btn.disabled = false;
        btn.querySelector('.btn-in').textContent = orig;
      }
    });
  </script>

  <style>
    @font-face { font-family: 'NohemiV'; src: url('/fonts/Nohemi-Variable.woff2') format('woff2'); font-weight: 100 900; font-display: swap; }
    @font-face { font-family: 'GeneralSansV'; src: url('/fonts/GeneralSans-Variable.woff2') format('woff2'); font-weight: 200 700; font-display: swap; }

    .ct {
      --ink: #000; --ivory: #f8f9f2; --dim: #8b8677; --blue: #0522ff; --brand: #ffcc33;
      font-family: 'GeneralSansV', sans-serif; background: var(--ivory); color: var(--ink);
      min-height: 100svh; padding: 0 6vw 3vh; display: flex; flex-direction: column;
    }
    .label { font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: var(--dim); }
    h1, h2, h3 { font-family: 'NohemiV', sans-serif; letter-spacing: -0.025em; font-weight: 520; }

    .ct-nav { display: flex; align-items: flex-start; justify-content: space-between; padding: 18px 0; }
    .nav-actions { display: flex; align-items: center; gap: 14px; }
    :global(.ct-nav .language-switch) { color: var(--ink); text-decoration: none; font-size: 11px; font-weight: 650; letter-spacing: 0.14em; padding: 8px 2px; }
    :global(.ct-nav .language-switch:hover) { color: var(--blue); }
    .ct-nav .mark { display: block; }
    .ct-nav .mark video { height: clamp(44px, 4.4vw, 62px); width: auto; display: block; }
    .back { text-decoration: none; color: var(--ink); font-size: 13px; letter-spacing: 0.16em; text-transform: uppercase; }
    .back:hover { color: var(--blue); }

    .ct-head { display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: end; padding: 3vh 0 2vh; }
    .ct-head h1 { font-size: clamp(1.9rem, 4vw, 3.4rem); line-height: 1.05; margin: 0.9rem 0 0; }
    /* ujemny margines rownowazy padding: bez tego marker wcinal pierwsza litere
       naglowka o 0.1em i pierwszy wiersz nie trzymal lewej krawedzi kolumny */
    .hl { background: linear-gradient(100deg, transparent 1%, color-mix(in srgb, var(--brand) 80%, transparent) 5% 95%, transparent 99%); padding: 0 0.1em; margin: 0 -0.1em; }
    .lead { max-width: 44ch; font-size: clamp(0.95rem, 1.1vw, 1.05rem); line-height: 1.6; color: #4c483c; padding-bottom: 0.4rem; }
    @media (max-width: 820px) { .ct-head { grid-template-columns: 1fr; gap: 1.4rem; align-items: start; } }

    .ct-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 4vw, 4rem); padding: 3vh 0 2vh; }
    .path { border-top: 1px solid color-mix(in srgb, var(--ink) 18%, transparent); padding-top: 1.4rem; position: relative; }
    .pnum { font-family: 'GeneralSansV', monospace; font-size: 12px; letter-spacing: 0.24em; color: var(--dim); }
    .path h2 { font-size: clamp(1.35rem, 2vw, 1.85rem); margin: 0.3rem 0 0.45rem; }
    .pdesc { color: #4c483c; font-size: 14px; line-height: 1.5; margin-bottom: 1.3rem; max-width: 40ch; }

    .btn { display: inline-block; position: relative; overflow: clip; text-decoration: none; color: var(--ink); border: 1px solid var(--ink); border-radius: 999px; padding: 10px 22px; font-size: 12px; letter-spacing: 0.06em; background: var(--ivory); cursor: pointer; transition: color 0.3s, border-color 0.3s, scale 0.18s ease-out; font-family: inherit; }
    /* hover: tusz nalewa się od dołu — 1:1 z przyciskami na stronie głównej */
    .btn::before { content: ""; position: absolute; inset: 0; z-index: 0; background: var(--ink); transform: scaleY(0); transform-origin: bottom; transition: transform 0.45s cubic-bezier(0.19, 1, 0.22, 1); }
    .btn .btn-in { display: inline-block; position: relative; z-index: 1; }
    .btn:hover { color: var(--ivory); }
    .btn:hover::before { transform: scaleY(1); }
    .btn:active { scale: 0.96; }
    .btn.big { padding: 16px 34px; font-size: 13px; background: var(--ink); color: var(--ivory); border-color: var(--ink); }
    .btn.big::before { background: var(--blue); }
    .btn.big:hover { border-color: var(--blue); }
    .btn[disabled] { opacity: 0.5; cursor: default; }
    .btn[disabled]::before { transform: scaleY(0); }
    .btn[disabled]:active { scale: 1; }

    .cal-embed { position: relative; border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent); border-radius: 14px; overflow: hidden; background: #fff; min-height: 560px; }
    .cal-embed iframe { display: block; }
    .cal-consent { min-height: 560px; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 1.1rem; padding: 2.4rem; }
    .cal-consent p { font-size: 14px; line-height: 1.6; color: #4c483c; max-width: 34ch; margin: 0; }
    /* Komunikat o zablokowanej ramce lezy NA niej: pusta ramka zostaje pod spodem,
       wiec nie ma skoku ukladu, gdy blokada zostanie wykryta po chwili. */
    /* przy wykrytej blokadzie pusta ramka znika, a komunikat wraca do przeplywu —
       inaczej zostawaloby 560 px bieli wokol trzech linijek tekstu */
    .cal-is-blocked { min-height: 0; }
    .cal-is-blocked iframe { display: none; }
    .cal-is-blocked .cal-blocked { position: static; padding-block: 2.6rem; }
    .cal-blocked {
      position: absolute; inset: 0; display: flex; flex-direction: column;
      align-items: flex-start; justify-content: center; gap: 0.6rem;
      padding: 2.4rem; background: #fff; border-radius: 14px;
    }
    .cal-blocked-t { margin: 0; font-family: 'NohemiV', sans-serif; font-weight: 560; font-size: 19px; letter-spacing: -0.02em; }
    .cal-blocked-n { margin: 0; font-size: 14px; line-height: 1.6; color: #4c483c; max-width: 34ch; }
    .cal-actions { margin-top: 1.1rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.9rem 1.4rem; }
    .cal-open { white-space: nowrap; }
    /* gdy ramka jest zablokowana, przycisk „otworz w nowym oknie" przestaje byc
       alternatywa i staje sie glowna droga — dostaje wypelnienie jak CTA */
    .cal-is-blocked ~ .cal-actions .cal-open { background: var(--ink); color: var(--ivory); }
    .cal-note { margin: 0; font-size: 12px; color: var(--dim); }
    .cal-note a { color: var(--blue); }
    .cal-fallback .note { margin-top: 1rem; font-size: 12px; color: var(--dim); line-height: 1.5; max-width: 36ch; }

    .fld { display: block; margin-bottom: 0.8rem; }
    .fld span { display: block; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); margin-bottom: 0.35rem; }
    .fld input, .fld textarea {
      /* globalny border-box z layoutu jest scope'owany przez Astro i tu NIE działa —
         bez tego width:100% + padding wystaje poza ekran na mobile */
      box-sizing: border-box;
      width: 100%; font-family: inherit; font-size: 16px; color: var(--ink);
      background: #fff; border: 1px solid color-mix(in srgb, var(--ink) 16%, transparent);
      border-radius: 10px; padding: 10px 14px; resize: vertical;
      transition: border-color 0.2s, box-shadow 0.25s;
    }
    .fld input:focus, .fld textarea:focus {
      outline: none; border-color: var(--blue);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--blue) 14%, transparent);
    }
    /* błąd walidacji: podświetlone konkretne pole, nie tylko ogólny komunikat */
    .fld.err input, .fld.err textarea { border-color: #c70404; }
    .fld.err span { color: #c70404; }
    .consent.err { color: #c70404; }
    .consent.err input { outline: 2px solid #c70404; outline-offset: 2px; border-radius: 3px; }
    .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
    .consent { display: flex; gap: 10px; align-items: flex-start; margin: 0.2rem 0 1.1rem; font-size: 13px; line-height: 1.5; color: #4c483c; cursor: pointer; }
    .consent input { margin-top: 3px; accent-color: var(--blue); width: 16px; height: 16px; flex: none; }
    /* Dotyk: bez szarego flasha iOS, checkbox z realnym polem tapu, stany :active */
    .ct a, .ct button, .ct label, .ct input { -webkit-tap-highlight-color: transparent; }
    @media (pointer: coarse) {
      .consent { padding-block: 6px; }
      .consent input { width: 22px; height: 22px; margin-top: 0; }
      .back, .alt-grid a, .ct-foot a { padding-block: 8px; }
      .back:active, .alt-grid a:active { color: var(--blue); }
      .cal-embed iframe { height: 640px; }
    }
    .consent a { color: var(--blue); }
    .submit { width: 100%; }
    .formmsg { margin-top: 1rem; font-size: 13px; color: var(--blue); min-height: 1.2em; }
    .formmsg.err { color: #c70404; animation: ctShake 0.4s cubic-bezier(0.36, 0.07, 0.19, 0.97); }
    @keyframes ctShake {
      0%, 100% { translate: 0; }
      20%, 60% { translate: -5px 0; }
      40%, 80% { translate: 5px 0; }
    }
    /* sukces wjeżdża miękko zamiast pojawiać się skokiem */
    .ct-success:not([hidden]) { animation: ctIn 0.55s cubic-bezier(0.19, 1, 0.22, 1); }
    @keyframes ctIn { from { opacity: 0; translate: 0 16px; } }
    @media (prefers-reduced-motion: reduce) {
      .formmsg.err, .ct-success:not([hidden]) { animation: none; }
    }

    .ct-success h3 { font-size: clamp(1.4rem, 2.2vw, 2rem); margin-bottom: 0.8rem; }
    .ct-success p { color: #4c483c; font-size: 15px; line-height: 1.6; margin-bottom: 1.4rem; max-width: 40ch; }

    .ct-alt { border-top: 1px solid color-mix(in srgb, var(--ink) 16%, transparent); padding-top: 1.6rem; margin-top: 1vh; }
    .alt-grid { display: flex; gap: 2.5rem; flex-wrap: wrap; margin-top: 0.8rem; }
    .alt-grid a { text-decoration: none; color: var(--ink); font-family: 'NohemiV', sans-serif; font-size: clamp(1.1rem, 1.8vw, 1.5rem); font-weight: 520; letter-spacing: -0.015em; position: relative; }
    .alt-grid a:hover { color: var(--blue); }
    .alt-grid .sc { display: inline-flex; align-items: center; gap: 0.5em; }
    .alt-grid .sc-i { width: 0.82em; height: 0.82em; fill: currentColor; flex: none; }
    .alt-grid .sc-i-contra { width: 0.76em; height: 0.76em; }
    /* glif LinkedIn wypelnia caly viewBox, wiec w tej samej ramce co reszta
       siedzi optycznie nizej — mniejszy i podniesiony do linii liter */
    .alt-grid .sc-i-in { width: 0.74em; height: 0.74em; transform: translateY(-0.045em); }

    .ct-foot { display: flex; gap: 1.5rem; flex-wrap: wrap; margin-top: auto; padding-top: 3.5vh; font-size: 12px; color: var(--dim); letter-spacing: 0.04em; }
    .ct-foot a { color: var(--dim); text-decoration: none; }
    .ct-foot a:hover { color: var(--ink); }

    @media (max-width: 820px) {
      .ct-grid { grid-template-columns: 1fr; gap: 3.5rem; }
      .ct { padding: 0 5vw 5vh; }
    }
  </style>
</VariantLayout>

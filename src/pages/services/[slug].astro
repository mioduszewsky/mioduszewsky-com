---
import ServiceLanding from '../../components/ServiceLanding.astro';
import { servicesEn } from '../../content/services-en';
export const getStaticPaths = () => servicesEn.map((service) => ({ params: { slug: service.slug }, props: { service } }));
const { service } = Astro.props;
---
<ServiceLanding service={service} locale="en" />

---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Playground — animacje sanity check">
  <main>
    <section class="screen bg-ink text-cream">
      <p class="text-mono-eyebrow opacity-60">SCROLL ↓</p>
      <h1 class="hero-headline" data-anim="fade-up">animacje działają</h1>
      <p class="text-mono-strip opacity-50">Lenis + GSAP + ScrollTrigger</p>
    </section>

    <section class="screen bg-cream text-ink">
      <p class="text-mono-eyebrow">SCROLL TRIGGER</p>
      <h2 class="hero-headline" data-anim="scrub-x">ten napis jedzie razem ze scrollem</h2>
    </section>

    <section class="screen bg-yellow-bright text-ink">
      <p class="text-mono-eyebrow">PARALLAX</p>
      <h2 class="hero-headline" data-anim="parallax-up">trzecia warstwa głębi</h2>
    </section>

    <section class="screen bg-ink text-cream">
      <p class="text-mono-eyebrow opacity-60">END</p>
      <h2 class="hero-headline">stack gotowy</h2>
    </section>
  </main>

  <style>
    .screen {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      padding: 8vh 8vw;
      gap: 2.4rem;
    }
    .hero-headline {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: clamp(64px, 12vw, 220px);
      line-height: 0.88;
      letter-spacing: -0.045em;
      text-transform: uppercase;
      max-width: 18ch;
    }
  </style>

  <script>
    import { gsap, ScrollTrigger } from '../scripts/animation-core';

    document.querySelectorAll<HTMLElement>('[data-anim="fade-up"]').forEach((el) => {
      gsap.from(el, {
        y: 80,
        opacity: 0,
        duration: 1.1,
        ease: 'power3.out',
        scrollTrigger: { trigger: el, start: 'top 80%' },
      });
    });

    document.querySelectorAll<HTMLElement>('[data-anim="scrub-x"]').forEach((el) => {
      gsap.fromTo(
        el,
        { x: '-15%' },
        {
          x: '15%',
          ease: 'none',
          scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: 0.6 },
        },
      );
    });

    document.querySelectorAll<HTMLElement>('[data-anim="parallax-up"]').forEach((el) => {
      gsap.fromTo(
        el,
        { y: 120 },
        {
          y: -120,
          ease: 'none',
          scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: true },
        },
      );
    });
  </script>
</Layout>

---
/*
  PODGLĄD ROBOCZY — trzy pomysły na zakończenie manifestu zamiast dopisku „teraz.".
  Poza produkcją: noindex, bez analytics, bez GSAP. Gesty pokazane w stanie
  docelowym (przekreślenie narysowane, kropka pulsuje), żeby oceniać pomysł,
  a nie animację wejścia. Do skasowania po decyzji.
*/
import '@fontsource-variable/shantell-sans';

const versions = [
  {
    id: 'a',
    kicker: 'Wersja A',
    name: 'Przekreślenie „kolejny etap"',
    note: 'Czerwony spray przekreśla to, co odrzucone — ten sam gest, który masz w hero EN na słowie „generic". Napięcie robi pierwsza linia, więc dopisek wypada. Żółty zostaje sam na „ten ostatni".',
  },
  {
    id: 'b',
    kicker: 'Wersja B',
    name: '„teraz." jako czwarta linia',
    note: 'Dopisek przestaje być przypisem i staje się puentą: ta sama skala co reszta, własny wiersz. Rytm trzech długich linii zamyka jedna krótka.',
  },
  {
    id: 'c',
    kicker: 'Wersja C',
    name: 'Czerwona kropka „na żywo"',
    note: 'Zamiast dopisku — kropka obok „live", czytana odruchowo jako wskaźnik transmisji. Zero dodatkowego tekstu. Pulsowanie gaśnie przy prefers-reduced-motion, kropka zostaje.',
  },
];
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Manifest — podgląd roboczy</title>
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <filter id="sprayF" x="-40%" y="-40%" width="180%" height="180%">
          <feTurbulence type="fractalNoise" baseFrequency="0.55" numOctaves="2" result="n" />
          <feDisplacementMap in="SourceGraphic" in2="n" scale="14" />
          <feGaussianBlur stdDeviation="0.55" />
        </filter>
        <filter id="sprayMist" x="-60%" y="-60%" width="220%" height="220%">
          <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="3" result="n" />
          <feDisplacementMap in="SourceGraphic" in2="n" scale="30" />
          <feGaussianBlur stdDeviation="1.6" />
        </filter>
      </defs>
    </svg>

    <header class="page-head">
      <p class="page-kicker">( Podgląd roboczy · nie jest to strona produkcyjna )</p>
      <h1 class="page-h">Manifest bez przypisu.</h1>
      <p class="page-sub">
        Ta sama sekcja w trzech wersjach. Pierwsza pokazuje stan obecny dla porównania.
        Oceniaj na telefonie — tam ta sekcja zajmuje cały ekran.
      </p>
    </header>

    <section class="vw">
      <div class="vw-tag"><span class="vw-kicker">Stan obecny</span><span class="vw-name">Dopisek „teraz."</span></div>
      <p class="vw-note">Żółty dopisek obok „Wchodzisz live." — konkuruje o ten sam akcent co „ten ostatni" dwie linie wyżej.</p>
      <div class="manif">
        <p class="manif-t">
          Nie chodzi o kolejny etap.<br />
          Chodzi o <em>ten ostatni</em>.<br />
          Wchodzisz live.<span class="tag tag-manif" aria-hidden="true">teraz.</span>
        </p>
        <p class="manif-sub">Wysyłasz stronę klientom. Puszczasz na nią kampanię. Pokazujesz partnerom. Przestajesz ją robić i zaczynasz jej używać.</p>
      </div>
    </section>

    {versions.map((v) => (
      <section class={`vw vw-${v.id}`}>
        <div class="vw-tag"><span class="vw-kicker">{v.kicker}</span><span class="vw-name">{v.name}</span></div>
        <p class="vw-note">{v.note}</p>
        <div class="manif">
          <p class="manif-t">
            {v.id === 'a' ? (
              <Fragment>
                Nie chodzi o <span class="fix">kolejny etap<svg class="strike" viewBox="0 0 200 44" preserveAspectRatio="none" aria-hidden="true"><g class="strike-mist" filter="url(#sprayMist)"><path d="M6 25 C 60 18, 138 30, 194 21" /><path d="M10 33 C 68 26, 132 37, 190 26" /></g><g class="strike-ink" filter="url(#sprayF)"><path d="M6 25 C 60 18, 138 30, 194 21" /><path d="M10 33 C 68 26, 132 37, 190 26" /></g></svg></span>.<br />
                Chodzi o <em>ten ostatni</em>.<br />
                Wchodzisz live.
              </Fragment>
            ) : v.id === 'b' ? (
              <Fragment>
                Nie chodzi o kolejny etap.<br />
                Chodzi o <em>ten ostatni</em>.<br />
                Wchodzisz live.<br />
                <em>teraz.</em>
              </Fragment>
            ) : (
              <Fragment>
                Nie chodzi o kolejny etap.<br />
                Chodzi o <em>ten ostatni</em>.<br />
                Wchodzisz live<span class="live-dot" aria-hidden="true"></span>
              </Fragment>
            )}
          </p>
          <p class="manif-sub">Wysyłasz stronę klientom. Puszczasz na nią kampanię. Pokazujesz partnerom. Przestajesz ją robić i zaczynasz jej używać.</p>
        </div>
      </section>
    ))}

    <footer class="page-foot">
      <p>Po decyzji ten plik znika — <code>src/pages/manifest.astro</code>.</p>
    </footer>

    <style is:global>
      @font-face { font-family: 'NohemiV'; src: url('/fonts/Nohemi-Variable.woff2') format('woff2'); font-weight: 100 900; font-display: swap; }
      @font-face { font-family: 'GeneralSansV'; src: url('/fonts/GeneralSans-Variable.woff2') format('woff2'); font-weight: 200 700; font-display: swap; }

      :root { --ivory: #f8f9f2; --ink: #000000; --dim: #8b8677; --brand: #ffcc33; --spray: #c70404; }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--ivory); color: var(--ink); font-family: 'GeneralSansV', system-ui, sans-serif; overflow-x: hidden; }

      .page-head { padding: 8vh 5vw 4vh; max-width: 720px; }
      .page-kicker { font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--dim); margin: 0 0 1.2rem; }
      .page-h { font-family: 'NohemiV', sans-serif; font-weight: 520; letter-spacing: -0.03em; font-size: clamp(2rem, 6vw, 3rem); line-height: 1.02; margin: 0 0 1.2rem; }
      .page-sub { font-size: 15px; line-height: 1.6; color: #4c483c; margin: 0; max-width: 52ch; }

      .vw { padding: 4vh 5vw 6vh; border-top: 1px solid color-mix(in srgb, var(--ink) 16%, transparent); }
      .vw-tag { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 1rem; margin-bottom: 0.5rem; }
      .vw-kicker { font-size: 10.5px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--dim); }
      .vw-name { font-family: 'NohemiV', sans-serif; font-weight: 600; font-size: clamp(1.05rem, 3.4vw, 1.35rem); letter-spacing: -0.02em; }
      .vw-note { font-size: 13.5px; line-height: 1.55; color: #4c483c; margin: 0 0 3vh; max-width: 58ch; }

      /* --- sekcja odtworzona 1:1 z produkcji --- */
      .manif {
        background: var(--ink); color: var(--ivory); text-align: center;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        padding: 12vh 6vw; border-radius: 14px;
      }
      .manif-t {
        font-family: 'NohemiV', 'ClashV', sans-serif; font-weight: 460;
        font-size: clamp(1.9rem, 7.4vw, 4.4rem); line-height: 1.12; letter-spacing: -0.02em;
        margin: 0; text-wrap: balance;
      }
      .manif em { color: var(--brand); font-style: normal; }
      .manif-sub {
        margin: 4.5vh 0 0; font-size: clamp(0.9rem, 3.4vw, 1.05rem);
        letter-spacing: 0.03em; color: color-mix(in srgb, var(--ivory) 60%, transparent);
        max-width: 46ch; text-wrap: pretty;
      }

      /* dopisek odręczny — stan obecny */
      .tag {
        font-family: 'Shantell Sans Variable', cursive; font-weight: 560; color: var(--brand);
        font-size: clamp(0.95rem, 1.5vw, 1.35rem); line-height: 1.05; letter-spacing: 0.01em;
        white-space: nowrap;
      }
      .tag-manif {
        rotate: -5deg; display: inline-block; vertical-align: super; font-size: 0.42em;
        margin-left: 0.2em; margin-right: -0.2em; width: 0; overflow: visible;
      }

      /* WERSJA A — spray przekreśla odrzucone */
      .fix { position: relative; display: inline-block; white-space: nowrap; }
      .fix .strike {
        position: absolute; inset: 14% -5% auto; width: 110%; height: 66%;
        fill: none; stroke: var(--spray); stroke-linecap: round; pointer-events: none; overflow: visible;
      }
      .strike-ink path { stroke-width: 4.5; }
      .strike-ink path:last-child { stroke-width: 3.5; opacity: 0.92; }
      .strike-mist path { stroke-width: 7; opacity: 0.12; }

      /* WERSJA C — wskaźnik transmisji */
      .live-dot {
        display: inline-block; width: 0.28em; height: 0.28em; border-radius: 50%;
        background: var(--spray); margin-left: 0.24em; vertical-align: 0.18em;
        box-shadow: 0 0 0 0 color-mix(in srgb, var(--spray) 70%, transparent);
        animation: liveBeat 1.9s cubic-bezier(0.19, 1, 0.22, 1) infinite;
      }
      @keyframes liveBeat {
        0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--spray) 55%, transparent); }
        70% { box-shadow: 0 0 0 0.5em color-mix(in srgb, var(--spray) 0%, transparent); }
        100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--spray) 0%, transparent); }
      }
      @media (prefers-reduced-motion: reduce) { .live-dot { animation: none; } }

      .page-foot { padding: 4vh 5vw 10vh; border-top: 1px solid color-mix(in srgb, var(--ink) 16%, transparent); }
      .page-foot p { font-size: 12.5px; color: var(--dim); margin: 0; }
      .page-foot code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }

      @media (min-width: 900px) {
        .page-head, .vw { padding-inline: 6vw; }
        .manif-t { font-size: clamp(1.9rem, 4.6vw, 4.4rem); }
        .manif-sub { font-size: clamp(0.9rem, 1.25vw, 1.05rem); }
      }
    </style>
  </body>
</html>

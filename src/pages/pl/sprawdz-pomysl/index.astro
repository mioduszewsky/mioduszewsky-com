---
// Landing „Sprawdź pomysł”, przeniesiony 1:1 z prototypu zapis.html (wersja 2m, 09.11.2026).
// Samodzielny dokument: bez układu strony, nawigacji, analityki i banera zgody, jak w prototypie.
// Style i skrypt is:inline, żeby Astro ich nie przepisywało. Formularz to atrapa: patrz TODO Sender w skrypcie.
---
<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Sprawdź pomysł na biznes · mioduszewsky</title>
<meta name="description" content="5 etapów mailem, za darmo. Po 15 minutach masz listę braków z kwotą. Po ok. 3 tygodniach wiesz: robić, zmienić czy odpuścić.">
<meta property="og:title" content="Sprawdź, czy Twój pomysł na biznes zadziała.">
<meta property="og:description" content="5 etapów mailem, za darmo. Po 15 minutach masz listę braków z kwotą. Po ok. 3 tygodniach wiesz: robić, zmienić czy odpuścić.">
<meta property="og:image" content="https://mioduszewsky.com/pl/sprawdz-pomysl/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Sprawdź, czy Twój pomysł na biznes zadziała.">
<meta name="theme-color" content="#f8f9f2">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96">
<link rel="shortcut icon" href="/favicon.ico">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preload" href="/fonts/Nohemi-Variable.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/GeneralSans-Variable.woff2" as="font" type="font/woff2" crossorigin>
<style is:inline>
@font-face { font-family: 'NohemiV'; src: url('/fonts/Nohemi-Variable.woff2') format('woff2'); font-weight: 100 900; font-display: swap; }
@font-face { font-family: 'GeneralSansV'; src: url('/fonts/GeneralSans-Variable.woff2') format('woff2'); font-weight: 200 700; font-display: swap; }

:root {
  --ivory: #f8f9f2; --ink: #000; --text2: #4c483c; --brand: #ffcc33; --blue: #0522ff; --paper: #fff;
  --line: rgba(0,0,0,.16); --err: #a8131f; --field-line: rgba(0,0,0,.46);
  --gutter: clamp(16px, 5vw, 72px);
  /* H1 jest największym tekstem na każdej szerokości (08.11, venture-2): reszta skali liczy się od --h1 */
  --h1: clamp(1.72rem, 8.5vw, 2.5rem);
  --max-liczba: calc(var(--h1) * .9);
  --max-naglowek: calc(var(--h1) * .95);
  --display: 'NohemiV', system-ui, sans-serif; --body: 'GeneralSansV', system-ui, sans-serif;
  --ease: cubic-bezier(.19, 1, .22, 1);
  --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
}
*, *::before, *::after { box-sizing: border-box; min-width: 0; }
html { background: var(--ivory); color: var(--ink); -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
body { margin: 0; font: 430 16px/1.5 var(--body); overflow-wrap: break-word; -webkit-font-smoothing: antialiased; }
h1, h2, h3, p, ul, ol, dl, dd { margin: 0; padding: 0; }
ul, ol { list-style: none; }
a { color: inherit; }
button { font: inherit; color: inherit; }
::selection { background: var(--blue); color: var(--ivory); }
:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }
.wrap { width: 100%; max-width: 1296px; margin: 0 auto; padding-inline: var(--gutter); }

/* Marker z mioduszewsky.com (w5.astro) */
em.mk {
  font-style: normal; padding: 0 .08em; margin: 0 -.08em;
  background: linear-gradient(100deg, transparent 1.5%, color-mix(in srgb, var(--brand) 72%, transparent) 6% 94%, transparent 98.5%) no-repeat 0 68% / 100% var(--mk-h, 56%);
  -webkit-box-decoration-break: clone; box-decoration-break: clone;
}
@keyframes paint { from { background-size: 0% var(--mk-h, 56%); } to { background-size: 100% var(--mk-h, 56%); } }
h1 em.mk { animation: paint .9s var(--ease) .2s backwards; }
.go em.mk { animation: paint .8s var(--ease) both; }

/* Góra */
.top { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 10px 8px; }
.logo { position: relative; display: block; width: 116px; aspect-ratio: 800 / 222; translate: -5.9% 0; transition: scale .3s var(--ease); }
.logo video { position: absolute; inset: 0; display: block; width: 100%; height: 100%; filter: drop-shadow(0 3px 5px rgba(0,0,0,.16)); background: url('/logo3d/logo-nav-poster.webp') 0 0 / 100% 100% no-repeat; }
.logo video.gra { background: none; }
.free { font-size: 14px; font-weight: 560; white-space: nowrap; }

/* Pierwszy ekran */
.hero { display: grid; gap: 28px; padding-block: 4px 8px; }
h1 { font: 520 var(--h1)/1.06 var(--display); letter-spacing: -.025em; text-wrap: balance; }
.lead { display: grid; align-content: start; gap: 4px; margin-top: 10px; font-size: 16px; line-height: 1.38; max-width: 56ch; text-wrap: pretty; }
.lead b { font-weight: 620; }

/* Formularz */
.form { display: grid; gap: 8px; margin-top: 14px; max-width: 600px; }
.two { display: grid; gap: 8px; }
.f { position: relative; }
.f label { position: absolute; left: 16px; top: 7px; font-size: 12px; font-weight: 560; line-height: 1.3; color: var(--text2); pointer-events: none; }
.f input { display: block; width: 100%; height: 54px; padding: 22px 16px 6px; font: 430 17px/1.3 var(--body); color: var(--ink); background: var(--paper); border: 1px solid var(--field-line); border-radius: 12px; appearance: none; transition: box-shadow .2s, border-color .2s; }
.f input:focus { outline: 0; border-color: var(--ink); box-shadow: 0 0 0 3px var(--brand), 0 0 0 4px var(--ink); }
.f input[aria-invalid="true"] { border: 2px solid var(--err); }
.err { font-size: 14px; font-weight: 560; line-height: 1.35; color: var(--err); padding: 4px 16px 0; }
.err:empty { display: none; }
.check { display: grid; grid-template-columns: 24px 1fr; gap: 10px; align-items: start; min-height: 44px; padding-block: 2px; font-size: 13px; line-height: 1.36; color: var(--text2); cursor: pointer; }
.check input { appearance: none; display: grid; place-items: center; width: 24px; height: 24px; margin: 0; background: var(--paper); border: 1px solid var(--field-line); border-radius: 6px; cursor: pointer; }
.check input:checked { background: var(--ink); border-color: var(--ink); }
.check input:checked::after { content: ""; width: 12px; height: 7px; border-left: 2px solid var(--ivory); border-bottom: 2px solid var(--ivory); rotate: -45deg; translate: 0 -1px; }
.check input[aria-invalid="true"] { border: 2px solid var(--err); }
.cta { position: relative; display: block; width: 100%; min-height: 56px; padding: 16px 34px; font: 500 13px/1.2 var(--body); letter-spacing: .14em; text-transform: uppercase; text-align: center; color: var(--ivory); background: var(--ink); border: 1px solid var(--ink); border-radius: 999px; cursor: pointer; overflow: clip; transition: scale .18s ease-out, border-color .3s; } /* runda 21: baton jak .btn.big na mioduszewsky.com (w5.astro) */
.cta::before { content: ""; position: absolute; inset: 0; background: var(--blue); transform: scaleY(0); transform-origin: bottom; transition: transform .45s var(--ease); }
.cta span { position: relative; }
.cta:active { scale: .97; }
.cta[aria-busy="true"] { cursor: progress; }
.cta[aria-busy="true"]::before { transform: scaleY(1); }
.note { font-size: 14px; font-weight: 560; line-height: 1.35; }
.done { display: grid; gap: 8px; margin-top: 14px; max-width: 600px; padding: 18px 20px; background: var(--brand); color: var(--ink); border: 1px solid var(--ink); border-radius: 12px; }
.done:focus { outline: 0; }
.done b { font: 520 clamp(1.3rem, 5vw, 1.7rem)/1.1 var(--display); letter-spacing: -.015em; }
.done p { font-size: 15px; line-height: 1.4; text-wrap: pretty; }
.fix { justify-self: start; min-height: 44px; padding: 0; font-size: 15px; font-weight: 560; background: none; border: 0; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }

.free-row em.mk { margin-right: 0; }

/* Ile kosztuje */
.sec { padding-top: clamp(64px, 8vw, 104px); }
.sec + .end { margin-top: clamp(64px, 8vw, 104px); }
.sec-h { font: 520 min(clamp(1.8rem, 3.4vw, 3.1rem), var(--max-naglowek))/1.08 var(--display); letter-spacing: -.02em; text-wrap: balance; }
.reg { margin-top: clamp(24px, 4vw, 48px); }
.reg > li { display: grid; gap: 12px; padding-block: 24px; border-top: 1px solid var(--line); }
.fig { font: 520 min(clamp(2.25rem, 10vw, 3rem), var(--max-liczba))/1 var(--display); letter-spacing: -.03em; }
.fig small { display: block; margin-top: 8px; font: 500 16px/1.3 var(--body); letter-spacing: 0; }
.fig s { display: block; margin-bottom: 6px; font: 500 16px/1.3 var(--body); letter-spacing: 0; color: var(--text2); text-decoration-thickness: 2px; }
.reg h3 { font-size: 17px; font-weight: 620; line-height: 1.3; }
.reg p { margin-top: 4px; max-width: 58ch; text-wrap: pretty; }
.intro { margin-top: 12px; max-width: 58ch; color: var(--text2); text-wrap: pretty; }
.bars { display: grid; gap: 6px; margin-top: 12px; max-width: 320px; font-size: 13px; font-weight: 560; }
.bars i { display: block; padding: 3px 8px; font-style: normal; line-height: 1.4; white-space: nowrap; }
.bars .d { width: 100%; background: var(--brand); }
.bars .p { width: 33.4%; background: var(--ink); color: var(--ivory); }
.sign { margin-top: 12px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 14px; color: var(--text2); }

/* Co masz po każdym etapie: akordeon w skali „3 na 10”, plusik z FAQ na w5.astro */
.etapy { --etap-n: clamp(26px, 4vw, 56px); --etap-y: clamp(20px, 2.2vw, 30px); margin-top: clamp(24px, 4vw, 48px); border-top: 1px solid var(--line); }
.etap { border-bottom: 1px solid var(--line); }
.etap-b { display: grid; grid-template-columns: var(--etap-n) minmax(0, 1fr) auto; align-items: start; column-gap: 0; width: 100%; padding: var(--etap-y) 0; text-align: left; color: var(--ink); background: none; border: 0; cursor: pointer; -webkit-tap-highlight-color: transparent; touch-action: manipulation; }
.etap-b .n { padding-top: .2em; font: 560 14px/1 var(--body); font-variant-numeric: tabular-nums lining-nums; }
.etap-t { font: 520 min(clamp(1.75rem, 9vw, 3rem), var(--max-liczba))/1.06 var(--display); letter-spacing: -.03em; text-wrap: balance; transition: translate 200ms ease; }
.etap-t .t { display: inline-block; vertical-align: top; margin: .2em 0 0 .25em; font: 560 14px/1 var(--body); letter-spacing: 0; color: var(--text2); white-space: nowrap; font-variant-numeric: tabular-nums lining-nums; }
.fmark { position: relative; flex: none; width: 18px; height: 18px; margin: clamp(6px, 1.1vw, 14px) 0 0 16px; }
.fmark::before, .fmark::after { content: ""; position: absolute; inset: 0; margin: auto; background: var(--ink); transition: rotate 240ms var(--ease-out); }
.fmark::before { width: 18px; height: 2px; }
.fmark::after { width: 2px; height: 18px; }
[aria-expanded="true"] .fmark::after { rotate: 90deg; }
.etap-p { overflow: hidden; }
.etap-w { padding: 0 0 calc(var(--etap-y) * 1.7) var(--etap-n); transition: opacity 200ms var(--ease-out) 60ms, translate 200ms var(--ease-out) 60ms; }
/* zwinięty: treść gaśnie szybciej, niż chowa się wysokość; przy otwieraniu wchodzi z dołu po 60 ms */
.etap.zw .etap-w { opacity: 0; translate: 0 8px; transition-duration: 120ms; transition-delay: 0s; }
.etap-w p { max-width: 40ch; font-size: clamp(1.125rem, 1.8vw, 1.5rem); line-height: 1.35; text-wrap: pretty; }
.etap-w em.mk { font-weight: 560; }
.final { margin-top: clamp(64px, 8vw, 104px); }
.final h3 { font: 520 min(clamp(1.8rem, 3.4vw, 3.1rem), var(--max-naglowek))/1.08 var(--display); letter-spacing: -.02em; text-wrap: balance; }
.final-t { margin-top: 16px; }
.final-a { font: 520 clamp(1.3rem, 2.4vw, 2rem)/1.15 var(--display); letter-spacing: -.015em; }
.final-t p + p { margin-top: 10px; font-size: 16px; line-height: 1.45; max-width: 52ch; text-wrap: pretty; }
.total { margin-top: clamp(40px, 5vw, 56px); border-top: 2px solid var(--ink); }
.total div { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding-block: 10px; border-bottom: 1px dashed rgba(0,0,0,.34); }
.total div:last-child { border-bottom: 0; }
.total dt { font-size: 15px; font-weight: 560; }
.total dd { font-size: 15px; font-weight: 560; text-align: right; font-variant-numeric: tabular-nums lining-nums; }
.total .free-row dd { font: 620 clamp(1.6rem, 7vw, 2.2rem)/1 var(--body); letter-spacing: -.01em; }
.pace { margin-top: 14px; font-size: 15px; line-height: 1.45; color: var(--text2); max-width: 58ch; text-wrap: pretty; }

/* Zapis na końcu */
.end { background: var(--ink); color: var(--ivory); padding-block: clamp(48px, 9vw, 112px) calc(clamp(48px, 9vw, 112px) + env(safe-area-inset-bottom)); --err: #ffcc33; }
.end :focus-visible { outline-color: var(--brand); }
.end-h { font: 520 min(clamp(2rem, 8.4vw, 3.2rem), var(--max-naglowek))/1.03 var(--display); letter-spacing: -.025em; text-wrap: balance; }
.end-h em.mk { color: var(--ink); background: var(--brand); margin: 0; padding: 0 .1em; }
.end .sub { margin-top: 12px; font-size: 17px; line-height: 1.45; max-width: 44ch; text-wrap: pretty; }
.end .form { margin-top: 24px; }
.end .f input { border-color: var(--ivory); }
.end .f input[aria-invalid="true"] { border-color: var(--brand); }
.end .f input:focus { box-shadow: 0 0 0 3px var(--brand); border-color: var(--ink); }
.end .check { color: #d6d4c8; }
.check a { color: inherit; text-underline-offset: 2px; }
.end .check input { border-color: var(--ivory); }
.end .check input:checked { background: var(--brand); border-color: var(--brand); }
.end .check input:checked::after { border-color: var(--ink); }
.end .check input[aria-invalid="true"] { border-color: var(--brand); }
.end .cta { background: var(--brand); color: var(--ink); }
.end .cta::before { background: var(--ivory); }
.end .cta { border-color: var(--brand); }
.end .done { border-color: var(--brand); }

/* Przycisk przyklejony na telefonie */
.stick { position: fixed; left: 50%; bottom: calc(14px + env(safe-area-inset-bottom)); z-index: 20; width: min(calc(100vw - 32px), 360px); height: 54px; display: grid; place-items: center; padding: 0 16px; font-size: 16px; font-weight: 500; text-decoration: none; color: var(--ivory); background: var(--ink); border-radius: 999px; box-shadow: 0 10px 30px rgba(0,0,0,.28); translate: -50% 90px; opacity: 0; visibility: hidden; transition: translate .5s var(--ease), opacity .3s, visibility .5s, scale .18s ease-out; }
.stick.show { translate: -50% 0; opacity: 1; visibility: visible; }
.stick:active { scale: .97; }

/* Hover tylko przy myszy: po stuknięciu na telefonie przycisk nie zostaje niebieski */
@media (hover: hover) {
  .logo:hover { scale: 1.05; }
  .f input:not([aria-invalid="true"]):hover { border-color: var(--ink); }
  .end .f input:not([aria-invalid="true"]):hover { border-color: var(--brand); }
  .cta:hover::before { transform: scaleY(1); }
  .cta:hover { border-color: var(--blue); }
  .end .cta:hover { border-color: var(--ivory); }
}
@media (max-width: 340px) {
  .lead { font-size: 15px; }
}
@media (min-width: 520px) {
  .two { grid-template-columns: 1fr 1fr; }
  .bars { font-size: 14px; }
}
@media (min-width: 720px) {
  .reg > li { grid-template-columns: 5fr 7fr; gap: 32px; }
  .end-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .end .form { margin-top: 0; }
}
@media (min-width: 720px) {
  .total { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 32px; }
  .total div { display: block; padding-block: 16px 0; border-bottom: 0; }
  .total dt { font-size: 14px; color: var(--text2); }
  .total dd, .total .free-row dd { margin-top: 4px; font: 620 22px/1.2 var(--body); letter-spacing: -.01em; text-align: left; }
  .pace { margin-top: 20px; }
}
@media (min-width: 900px) {
  .final { display: grid; grid-template-columns: 5fr 7fr; gap: 32px; align-items: start; }
  .final-t { margin-top: 0; }
}
@media (min-width: 1000px) {
  .logo { width: 180px; }
  .free { font-size: 15px; }
  .top { height: 90px; padding-block: 0; }
  .hero { min-height: calc(100vh - 90px); min-height: calc(100svh - 90px); align-content: center; padding-block: 0 90px; }
  .pitch { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); grid-template-rows: auto auto; column-gap: clamp(48px, 7vw, 112px); }
  .pitch > h1, .pitch > .lead { grid-column: 1; }
  .pitch > .form, .pitch > .done { grid-column: 2; grid-row: 1 / span 2; align-self: center; margin-top: 0; max-width: none; }
  .pitch .two { grid-template-columns: 1fr; }
  :root { --h1: clamp(2.8rem, 5.4vw, 4.9rem); }
  h1 { line-height: 1.04; }
  .lead { margin-top: 24px; font-size: 20px; line-height: 1.4; }
  .form { margin-top: 28px; gap: 10px; }
  .two { gap: 10px; }
  .stick { display: none; }
  .etap-w p { max-width: none; } /* runda 19: zdanie etapu w jednej linii na szerokości sekcji */
  .pace, .intro { max-width: none; } /* runda 20: dopisek pod paskiem i podtytuł sekcji w jednej linii */
}
@media (hover: hover) and (pointer: fine) {
  .etap-b[aria-expanded="false"]:hover .etap-t { translate: 12px 0; }
}
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { animation: none !important; transition: none !important; }
  /* etapy: stan końcowy od razu, treść tylko przenika */
  .etap-w { transition: opacity 200ms ease !important; translate: none !important; }
}
</style>
<noscript><style is:inline>.etap-p[hidden] { display: block; }</style></noscript>
</head>
<body>
<header class="wrap top">
  <a class="logo" id="logo" href="/pl/?utm_source=sciezka&amp;utm_medium=strona&amp;utm_campaign=sprawdz-pomysl&amp;utm_content=logo" aria-label="mioduszewsky. Strona główna.">
    <video muted loop playsinline aria-hidden="true" poster="/logo3d/logo-nav-poster.webp"></video>
  </a>
  <p class="free">Za darmo, mailem</p>
</header>

<main>
  <div class="wrap hero">
    <section class="pitch" aria-labelledby="h1">
      <h1 id="h1">Sprawdź, czy Twój pomysł na biznes <em class="mk">zadziała</em>.</h1>
      <p class="lead"><b>5 etapów mailem, za darmo.</b> <span>Po 15 minutach masz listę braków z kwotą.</span> <span>Po ok. 3 tygodniach wiesz, czy to robić.</span></p>
      <form class="form" id="zapis" novalidate>
        <div class="two">
          <div>
            <div class="f"><label for="imie1">Imię</label><input id="imie1" name="imie" type="text" autocomplete="given-name" autocapitalize="words" enterkeyhint="next" required aria-describedby="imie1-e"></div>
            <p class="err" id="imie1-e"></p>
          </div>
          <div>
            <div class="f"><label for="email1">Adres e-mail</label><input id="email1" name="email" type="email" inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false" enterkeyhint="send" required aria-describedby="email1-e"></div>
            <p class="err" id="email1-e"></p>
          </div>
        </div>
        <label class="check"><input id="zgoda1" name="zgoda" type="checkbox" required aria-describedby="zgoda1-e"><span>Chcę dostawać wiadomości od Kacpra.<br>Akceptuję <a href="/pl/polityka-prywatnosci/?utm_source=sciezka&amp;utm_medium=strona&amp;utm_campaign=sprawdz-pomysl&amp;utm_content=zgoda-polityka" target="_blank" rel="noopener">politykę prywatności</a>.</span></label>
        <p class="err" id="zgoda1-e"></p>
        <button class="cta" type="submit"><span>Sprawdzam swój pomysł</span></button>
        <p class="note">Etap 1 dostajesz od razu.</p>
      </form>
    </section>
  </div>

  <section class="sec" aria-labelledby="koszt-h">
    <div class="wrap">
      <h2 class="sec-h" id="koszt-h">Dlaczego sprawdzić, zanim wydasz oszczędności</h2>
      <ul class="reg">
        <li>
          <div class="fig">3 na 10</div>
          <div>
            <p>Tyle nowych firm w Polsce znika przed pierwszymi urodzinami. Z 281&nbsp;846 założonych w 2024 roku po roku działało 192&nbsp;714 (GUS, 2026).</p>
          </div>
        </li>
        <li>
          <div class="fig">ok. 3 razy</div>
          <div>
            <p>W przeglądzie 29 eksperymentów deklaracje były średnio około 3 razy wyższe od tego, co ludzie naprawdę płacili (List i Gallet, 2001). Pochwały znajomych to nie dowód.</p>
            <div class="bars" aria-hidden="true"><i class="d">Deklarują</i><i class="p">Płacą</i></div>
          </div>
        </li>
        <li>
          <div class="fig">do 300&nbsp;zł</div>
          <div>
            <p>Tyle najwyżej kosztuje test z pieniędzmi w etapie 4: domena, reklama, materiały, dojazd. Powyżej 300&nbsp;zł test się kończy. Lokal, towar i sprzęt mogą poczekać na wynik.</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="sec" aria-labelledby="etapy-h">
    <div class="wrap">
      <h2 class="sec-h" id="etapy-h">Co masz po każdym etapie</h2>
      <p class="intro">Żeby wiedzieć, czy jesteś gotowy na ten biznes, potrzebujesz pięciu odpowiedzi. Każdy etap daje jedną.</p>
      <ol class="etapy">
        <li class="etap"><h3><button class="etap-b" type="button" id="e1-b" aria-expanded="true" aria-controls="e1"><span class="n">1</span><span class="etap-t">Inwentaryzacja: co masz, czego brakuje <span class="t">15 + 20 min</span></span><span class="fmark" aria-hidden="true"></span></button></h3><div class="etap-p" id="e1" role="region" aria-labelledby="e1-b"><div class="etap-w"><p>Masz <em class="mk">listę braków z kwotą</em> i limit, ile możesz stracić.</p></div></div></li>
        <li class="etap"><h3><button class="etap-b" type="button" id="e2-b" aria-expanded="false" aria-controls="e2"><span class="n">2</span><span class="etap-t">Klient i konkurencja <span class="t">ok. 2 h</span></span><span class="fmark" aria-hidden="true"></span></button></h3><div class="etap-p" id="e2" role="region" aria-labelledby="e2-b" hidden><div class="etap-w"><p>Masz listę <em class="mk">5 do 10 konkurentów z ceną</em>.</p></div></div></li>
        <li class="etap"><h3><button class="etap-b" type="button" id="e3-b" aria-expanded="false" aria-controls="e3"><span class="n">3</span><span class="etap-t">Rozmowy z klientami, do 10 <span class="t">8 do 10 h</span></span><span class="fmark" aria-hidden="true"></span></button></h3><div class="etap-p" id="e3" role="region" aria-labelledby="e3-b" hidden><div class="etap-w"><p>Masz instrukcję, gdzie szukać ludzi, i wiesz, <em class="mk">czy problem istnieje poza Twoją głową</em>.</p></div></div></li>
        <li class="etap"><h3><button class="etap-b" type="button" id="e4-b" aria-expanded="false" aria-controls="e4"><span class="n">4</span><span class="etap-t">Test z pieniędzmi <span class="t">5 do 8 h</span></span><span class="fmark" aria-hidden="true"></span></button></h3><div class="etap-p" id="e4" role="region" aria-labelledby="e4-b" hidden><div class="etap-w"><p>Masz wynik w liczbach: <em class="mk">ile osób zapłaciło</em> albo się zapisało i z ilu.</p></div></div></li>
        <li class="etap"><h3><button class="etap-b" type="button" id="e5-b" aria-expanded="false" aria-controls="e5"><span class="n">5</span><span class="etap-t">Sprawdzenie testu i decyzja <span class="t">ok. 1 h</span></span><span class="fmark" aria-hidden="true"></span></button></h3><div class="etap-p" id="e5" role="region" aria-labelledby="e5-b" hidden><div class="etap-w"><p>Decyzja zostaje Twoja: <em class="mk">robić, zmienić albo odpuścić</em>.</p></div></div></li>
      </ol>
      <div class="final"><h3>Na końcu masz odpowiedź</h3><div class="final-t"><p class="final-a"><em class="mk">Robić, zmienić albo odpuścić</em>.</p><p>Decydujesz na podstawie testu z pieniędzmi, rozmów z klientami i kosztu braków. Czytam Twoje podsumowanie i w ciągu 48 godzin odpisuję, co widzę.</p></div></div>
      <dl class="total">
        <div><dt>Czas</dt><dd>ok. 3 tygodnie, ok. 20 godzin</dd></div>
        <div><dt>Test z pieniędzmi</dt><dd>najwyżej 300&nbsp;zł</dd></div>
        <div class="free-row"><dt>5 etapów mailem</dt><dd><em class="mk">0&nbsp;zł</em></dd></div>
      </dl>
      <p class="pace">Każdy mail mówi, ile zajmie następny etap. Chcesz szybciej? Daj znać, otworzę Ci kolejną część. Przerwać możesz w każdej chwili.</p>
    </div>
  </section>

  <section class="end" id="koniec" aria-labelledby="end-h">
    <div class="wrap end-grid">
      <div>
        <h2 class="end-h" id="end-h">Zacznij od <em class="mk">etapu 1.</em></h2>
        <p class="sub">Imię i mail. Po ok. 3 tygodniach decydujesz: robić, zmienić albo odpuścić.</p>
      </div>
      <form class="form" novalidate>
        <div class="two">
          <div>
            <div class="f"><label for="imie2">Imię</label><input id="imie2" name="imie" type="text" autocomplete="given-name" autocapitalize="words" enterkeyhint="next" required aria-describedby="imie2-e"></div>
            <p class="err" id="imie2-e"></p>
          </div>
          <div>
            <div class="f"><label for="email2">Adres e-mail</label><input id="email2" name="email" type="email" inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false" enterkeyhint="send" required aria-describedby="email2-e"></div>
            <p class="err" id="email2-e"></p>
          </div>
        </div>
        <label class="check"><input id="zgoda2" name="zgoda" type="checkbox" required aria-describedby="zgoda2-e"><span>Chcę dostawać wiadomości od Kacpra.<br>Akceptuję <a href="/pl/polityka-prywatnosci/?utm_source=sciezka&amp;utm_medium=strona&amp;utm_campaign=sprawdz-pomysl&amp;utm_content=zgoda-polityka" target="_blank" rel="noopener">politykę prywatności</a>.</span></label>
        <p class="err" id="zgoda2-e"></p>
        <button class="cta" type="submit"><span>Sprawdzam swój pomysł</span></button>
        <p class="note">Etap 1 dostajesz od razu.</p>
      </form>
    </div>
  </section>
</main>


<a class="stick" id="stick" href="#koniec">Sprawdzam swój pomysł</a>

<script is:inline>
(function () {
  var $ = function (s, r) { return (r || document).querySelector(s); };
  var $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };
  var calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Formularze: walidacja i atrapa wysyłki.
     TODO Sender: setTimeout niżej to atrapa, nic nigdzie nie wysyła. Po podpięciu Sendera zastąpić go
     wywołaniem endpointu i usunąć z komunikatu dopisek „(Prototyp: wysyłka jeszcze niepodłączona.)”
     (COPY.md, sukces_2_prototyp). Do tego czasu dopisek zostaje: strona niczego nie wysyła. */
  var forms = $$('form.form'), sent = false;
  function say(input, text) {
    input.setAttribute('aria-invalid', text ? 'true' : 'false');
    $('#' + input.id + '-e').textContent = text;
  }
  function done(form, imie, mail, undo) {
    var box = document.createElement('div');
    box.className = 'done'; box.tabIndex = -1; box.setAttribute('role', 'status');
    var b = document.createElement('b'); b.textContent = imie + ', sprawdź skrzynkę.';
    var p1 = document.createElement('p'); p1.textContent = 'Etap 1 już do Ciebie leci na adres ' + mail + '. Przyjdzie od Kacpra Mioduszewskiego, temat: „Sprawdź swój pomysł: etap 1”. Nie widzisz go? Zajrzyj do zakładki „Oferty” i do spamu. (Prototyp: wysyłka jeszcze niepodłączona.)';
    var fix = document.createElement('button'); fix.type = 'button'; fix.className = 'fix'; fix.textContent = 'Literówka w adresie? Popraw go tutaj.'; fix.addEventListener('click', undo);
    box.appendChild(b); box.appendChild(p1); box.appendChild(fix);
    form.replaceWith(box);
    return box;
  }
  forms.forEach(function (form) {
    var imie = $('[name=imie]', form), mail = $('[name=email]', form), zgoda = $('[name=zgoda]', form), btn = $('button', form);
    zgoda.addEventListener('change', function () { if (zgoda.checked) say(zgoda, ''); });
    [imie, mail].forEach(function (i) { i.addEventListener('input', function () { say(i, ''); }); });
    imie.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); mail.focus(); } });
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (btn.getAttribute('aria-busy') === 'true') return;
      var okI = imie.value.trim(), okM = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(mail.value.trim());
      say(imie, okI ? '' : 'Wpisz imię. Będę się nim zwracać w mailach.');
      say(mail, okM ? '' : 'Ten adres nie wygląda na poprawny. Sprawdź znak @ i końcówkę domeny.');
      say(zgoda, zgoda.checked ? '' : 'Zaznacz zgodę, żebym mógł wysłać Ci etap 1.');
      if (!okI) { imie.focus(); return; }
      if (!okM) { mail.focus(); return; }
      if (!zgoda.checked) { zgoda.focus(); return; }
      var i = okI, m = mail.value.trim();
      btn.setAttribute('aria-busy', 'true');
      $('span', btn).textContent = 'Wysyłam etap 1';
      setTimeout(function () {
        sent = true; stick();
        var boxes = forms.map(function (f) { return done(f, i, m, function () {
          sent = false;
          boxes.forEach(function (x, n) { x.replaceWith(forms[n]); });
          forms.forEach(function (f2) { var b2 = $('button', f2); b2.removeAttribute('aria-busy'); $('span', b2).textContent = 'Sprawdzam swój pomysł'; });
          stick(); mail.focus();
        }); });
        boxes[forms.indexOf(form)].focus({ preventScroll: true });
      }, 450);
    });
  });

  /* Marker maluje się, gdy wiersz wjeżdża w kadr; przycisk przyklejony tylko między formularzami */
  var pastHero = false, ctaBelow = false, atEnd = false, stickEl = $('#stick');
  function stick() { stickEl.classList.toggle('show', pastHero && !atEnd && !sent); }
  if ('IntersectionObserver' in window) {
    var paint = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('go'); paint.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -12% 0px' });
    $$('.fig small, .free-row, .end-h, .etapy').forEach(function (el) { paint.observe(el); });
    /* Pasek, gdy pierwszego przycisku nie widać w całości: nad nim (mały ekran) albo już za nim */
    new IntersectionObserver(function (es) {
      pastHero = !es[0].isIntersecting;
      ctaBelow = pastHero && es[0].boundingClientRect.top > 0;
      stick();
    }, { threshold: 1 }).observe($('#zapis .cta'));
    new IntersectionObserver(function (es) {
      atEnd = es[0].isIntersecting || es[0].boundingClientRect.top < 0; stick();
    }).observe($('#koniec'));
  }
  stickEl.addEventListener('click', function (e) {
    var i = $(ctaBelow ? '#imie1' : '#koniec input');
    if (!i) return;
    e.preventDefault();
    (ctaBelow ? $('#zapis') : $('#koniec')).scrollIntoView({ block: 'start' });
    i.focus({ preventScroll: true });
  });

  /* Etapy: każdy otwiera się i zamyka niezależnie (runda 18, 08.11). Klik zmienia tylko kliknięty panel:
     nic nad nim się nie zwija i kod nie przewija strony. Nie wracać do „poprzedni się zwija”: wymaga kompensacji scrolla,
     a to Kacper widzi jako przesuwanie całej strony. Treść zwiniętych stoi w HTML, ukrywa ją atrybut hidden.
     Ruch: wysokość panelu w pętli, 240 ms, krzywa --ease-out cubic-bezier(0.23, 1, 0.32, 1). Treść: CSS, klasa .zw. */
  var etapy = $$('.etap'), CZAS = 240, wRuchu = 0;
  var krzywa = (function (x1, y1, x2, y2) {
    function bz(t, a, c) { return 3 * a * t * (1 - t) * (1 - t) + 3 * c * t * t * (1 - t) + t * t * t; }
    function dbz(t, a, c) { return 3 * a * (1 - t) * (1 - t) + 6 * (c - a) * t * (1 - t) + 3 * (1 - c) * t * t; }
    return function (x) {
      var t = x;
      for (var i = 0; i < 8; i++) { var d = dbz(t, x1, x2); if (d < 1e-6) break; t = Math.min(1, Math.max(0, t - (bz(t, x1, x2) - x) / d)); }
      return bz(t, y1, y2);
    };
  })(0.23, 1, 0.32, 1);
  var html = document.documentElement;
  etapy.forEach(function (li) { if ($('.etap-p', li).hidden) li.classList.add('zw'); });

  function ustawEtap(li, b) {
    if (li.stopRuchu) li.stopRuchu();
    var p = $('.etap-p', li), on = b.getAttribute('aria-expanded') !== 'true';
    var od = p.hidden ? 0 : p.getBoundingClientRect().height;
    b.setAttribute('aria-expanded', String(on));
    if (p.hidden) { p.hidden = false; p.style.height = '0px'; }
    var doW = on ? p.firstElementChild.offsetHeight : 0;
    p.style.height = od + 'px';
    if (on) { void p.offsetHeight; li.classList.remove('zw'); } else li.classList.add('zw');
    function koniec() { p.style.height = ''; if (!on) p.hidden = true; }
    if (calm) { koniec(); return; }
    var t0 = performance.now(), stop = false;
    if (!wRuchu++) html.style.overflowAnchor = 'none';
    function sprzataj() { if (!--wRuchu) html.style.overflowAnchor = ''; li.stopRuchu = null; }
    li.stopRuchu = function () { stop = true; sprzataj(); };
    (function krok() {
      if (stop) return;
      var x = Math.min((performance.now() - t0) / CZAS, 1), e = krzywa(x);
      p.style.height = (od + (doW - od) * e) + 'px';
      if (x < 1) requestAnimationFrame(krok); else { koniec(); sprzataj(); }
    })();
  }
  etapy.forEach(function (li) {
    var b = $('.etap-b', li);
    b.addEventListener('click', function () { ustawEtap(li, b); });
  });

  /* Logo: plakat od razu, wideo dopiero po załadowaniu strony */
  var net = navigator.connection;
  if (!calm && !(net && net.saveData)) {
    window.addEventListener('load', function () {
      setTimeout(function () {
        var v = $('#logo video');
        v.muted = true;
        v.preload = 'auto';
        [['/logo3d/logo-nav.mp4', 'video/mp4;codecs=hvc1'], ['/logo3d/logo-nav.webm', 'video/webm']].forEach(function (s) {
          var el = document.createElement('source'); el.src = s[0]; el.type = s[1]; v.appendChild(el);
        });
        v.load();
        /* plakat zostaje pod wideo do pierwszej wyświetlonej klatki, potem znika (bez mignięcia przy podmianie) */
        v.addEventListener('playing', function () {
          var zdejmij = function () { v.classList.add('gra'); };
          if (v.requestVideoFrameCallback) v.requestVideoFrameCallback(zdejmij); else requestAnimationFrame(function () { requestAnimationFrame(zdejmij); });
        }, { once: true });
        var p = v.play(); if (p && p.catch) p.catch(function () {});
      }, 1500);
    });
  }
})();
</script>

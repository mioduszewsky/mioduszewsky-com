---
// Realizacje: strona zbiorcza case studies (30.09.2026).
// Pomysł Kacpra: wachlarz kart w 3D (komponent PortfolioGallery z 21st.dev). Wzięta jest sama
// mechanika: karty obrócone i nałożone, środkowa najwyżej, najechana wyjeżdża z nazwą case'u.
// v2 (Kacper, 30.09): jeden ekran jak na wzorze. Wyśrodkowany nagłówek, pod nim wachlarz na całą
// szerokość, bez kratki, bez rejestru i bez sekcji kontaktu. Karty same są nawigacją: klik = case.
// Bez Reacta i framer-motion: sam CSS (:has zamiast stanu hover w JS). Na telefonie przewijanie
// palcem z przyciąganiem do karty zamiast karuzeli, która jedzie sama.
import { Image } from 'astro:assets';
import VariantLayout from '../../../layouts/VariantLayout.astro';
import SiteMenu from '../../../components/SiteMenu.astro';
import BrandFooter from '../../../components/BrandFooter.astro';
import gsSzkic from '../../../assets/realizacje/glassstone-szkic.webp';
import gsArkusz from '../../../assets/realizacje/glassstone-arkusz.webp';
import gsEkran from '../../../assets/realizacje/glassstone-ekran.webp';
import igorEkran from '../../../assets/realizacje/igor-ekran.webp';
import eskEkran from '../../../assets/realizacje/eskapizm-ekran.webp';
import eskApp from '../../../assets/realizacje/eskapizm-app-ekran.webp';

const P = (t: string) => t.replace(/(^|[\s(„])([wziouaWZIOUA]) /g, '$1$2&nbsp;');

type Case = { id: string; name: string; title: string; scope: string; href?: string };
const cases: Case[] = [
  { id: 'glassstone', name: 'GlassStone', title: 'Szkic z pomiaru zamienia się w rysunek na produkcję.', scope: 'narzędzie pomiarowe, panel, strona', href: '/pl/realizacje/glassstone/' },
  { id: 'igor', name: 'Igor Grabowski', title: 'Strona kolekcji sztuki: prace, artyści i historia pozyskania dzieł.', scope: 'strona, dwie wersje językowe, newsletter' },
  { id: 'eskapizm', name: 'eskapizm', title: 'Spółka, którą współprowadzę. Strona, sprzedaż, płatności i aplikacja klienta jako jeden system.', scope: 'strona, sprzedaż, aplikacja klienta, CMS' },
];
const byId = Object.fromEntries(cases.map((c) => [c.id, c]));

// Kolejność kart: najwyżej w środku stoi rysunek GlassStone, jedyny gotowy case.
const cards = [
  { img: eskApp, alt: 'Aplikacja klienta eskapizm: przegląd podróży do Tajlandii', tag: 'aplikacja klienta', caseId: 'eskapizm' },
  { img: igorEkran, alt: 'Strona kolekcji Igora Grabowskiego: praca z kolekcji', tag: 'strona kolekcji', caseId: 'igor' },
  { img: gsSzkic, alt: 'Odręczny szkic blatu z pomiaru GlassStone', tag: 'szkic z pomiaru', caseId: 'glassstone' },
  { img: gsArkusz, alt: 'Rysunek produkcyjny blatu z generatora GlassStone', tag: 'rysunek z generatora', caseId: 'glassstone' },
  { img: gsEkran, alt: 'Strona główna GlassStone', tag: 'strona', caseId: 'glassstone' },
  { img: eskEkran, alt: 'Strona eskapizm', tag: 'strona', caseId: 'eskapizm' },
];
const mid = Math.floor(cards.length / 2);
// Podniesienie jako ułamek szerokości karty, żeby skalowało się z ekranem.
const lift = (i: number) => +(0.2 - Math.abs(i - mid) * 0.045).toFixed(3);

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', name: 'Realizacje', inLanguage: 'pl', url: 'https://mioduszewsky.com/pl/realizacje/',
      hasPart: cases.filter((c) => c.href).map((c) => ({ '@type': 'Article', headline: c.title, url: `https://mioduszewsky.com${c.href}` })) },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'mioduszewsky', item: 'https://mioduszewsky.com/pl/' },
      { '@type': 'ListItem', position: 2, name: 'Realizacje', item: 'https://mioduszewsky.com/pl/realizacje/' } ] },
  ],
};
---
<VariantLayout
  title="Realizacje: od problemu firmy do działającego narzędzia · mioduszewsky"
  description="Opisy realizacji od problemu firmy, przez decyzje po drodze, do tego, co działa dziś. Z tym, czego jeszcze nie ma."
  bg="#f8f9f2" fg="#000000" switcher={false} robots="index, follow, max-image-preview:large" locale="pl" alternatePath="/">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <div class="work">
    <a class="skip" href="#main">Przejdź do treści</a>
    <header class="nav">
      <a class="mark" href="/pl/" aria-label="mioduszewsky. Strona główna.">
        <video autoplay loop muted playsinline preload="metadata" aria-hidden="true" poster="/logo3d/logo-nav-poster.webp">
          <source src="/logo3d/logo-nav.mp4" type="video/mp4;codecs=hvc1" />
          <source src="/logo3d/logo-nav.webm" type="video/webm" />
        </video>
      </a>
      <SiteMenu locale="pl" alternatePath="/" />
    </header>

    <main id="main" class="stage">
      <header class="hero">
        <p class="kicker">Realizacje</p>
        <h1>Co było do rozwiązania i&nbsp;jak to rozwiązałem.</h1>
        <p class="lead" set:html={P('Każdy opis zaczyna się od problemu firmy i kończy na tym, co działa dziś. Piszę też, czego jeszcze nie ma.')} />
      </header>

      <ul class="fan" aria-label="Case studies">
        {cards.map((c, i) => {
          const cs = byId[c.caseId];
          const Tag = cs.href ? 'a' : 'div';
          return (
            <li style={`--i:${i}; --lift:${lift(i)}; z-index:${cards.length - i}`} class:list={['card', { soon: !cs.href }]}>
              <Tag class="sheet" href={cs.href} aria-label={cs.href ? `${cs.name}: ${cs.title}` : undefined}>
                <span class="tag"><b>{cs.name}</b><span>{cs.href ? 'Czytaj case' : 'wkrótce'}{cs.href && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>}</span></span>
                <Image src={c.img} alt={c.alt} widths={[480, 800, 1280]} sizes="(min-width: 768px) 38vw, 78vw" loading={i === mid ? 'eager' : 'lazy'} />
              </Tag>
            </li>
          );
        })}
      </ul>
    </main>
    <BrandFooter locale="pl" inset />
  </div>
</VariantLayout>

<style>
  .work {
    --ivory: #f8f9f2; --ink: #111; --dim: #5f5b4e; --rule: rgb(17 17 17 / .14);
    --blue: #0522ff; --brand: #ffcc33; --cad-red: #c70404;
    --gutter: clamp(20px, 5vw, 96px); --focus: var(--blue);
    font-family: 'GeneralSansV', sans-serif; background: var(--ivory); color: var(--ink); overflow-x: clip;
  }
  @font-face { font-family: 'NohemiV'; src: url('/fonts/Nohemi-Variable.woff2') format('woff2'); font-weight: 100 900; font-display: swap; }
  @font-face { font-family: 'GeneralSansV'; src: url('/fonts/GeneralSans-Variable.woff2') format('woff2'); font-weight: 200 700; font-display: swap; }
  @font-face { font-family: 'JBMono'; src: url('/fonts/JetBrainsMono-Regular.woff2') format('woff2'); font-weight: 400; font-display: swap; }
  .work :is(h1,p,ul) { margin: 0; }
  .work ul { padding: 0; list-style: none; }
  .work h1 { text-wrap: balance; }
  .work p { text-wrap: pretty; }
  .work :is(a,button):focus-visible { outline: 3px solid var(--focus); outline-offset: 4px; }
  .work ::selection { background: var(--brand); }
  .skip { position: fixed; top: 12px; left: 12px; z-index: 150; padding: 12px 20px; background: var(--brand); color: var(--ink); transform: translateY(-200%); }
  .skip:focus { transform: none; }
  .nav { height: 104px; box-sizing: border-box; padding: 24px var(--gutter); display: flex; align-items: center; justify-content: space-between; position: relative; z-index: 90; }
  .mark video { width: clamp(155px, 18vw, 220px); height: auto; display: block; filter: drop-shadow(0 5px 10px rgb(0 0 0 / .26)); }

  /* Jeden ekran: nagłówek na górze, wachlarz wypełnia resztę i dochodzi do dolnej krawędzi. */
  .stage { min-height: calc(100svh - 104px); display: flex; flex-direction: column; }
  .hero { padding: clamp(16px, 5vh, 64px) var(--gutter) 0; text-align: center; }
  .kicker { font-size: 16px; color: var(--dim); }
  h1 { margin: 16px auto 0 !important; max-width: 14em; font-family: 'NohemiV', sans-serif; font-weight: 500; font-size: clamp(36px, 5.4vw, 84px); line-height: 1.02; letter-spacing: -.035em; }
  .lead { margin: clamp(16px, 2.4vw, 28px) auto 0 !important; max-width: 34em; font-size: 19px; line-height: 1.55; color: var(--dim); }

  /* Wachlarz: środkowa karta najwyżej, najechana wyjeżdża, reszta opada do linii bazowej.
     Dół ucina krawędź ekranu, boki krawędź strony, góra zostaje otwarta. */
  .fan {
    --w: clamp(300px, min(38vw, 62svh), 600px);
    flex: 1; min-height: clamp(340px, 30vw, 460px); margin-top: clamp(24px, 4vh, 48px);
    display: flex; justify-content: center; align-items: flex-end;
    clip-path: inset(-100vh 0 0 0);
  }
  .card {
    --y: calc(var(--w) * var(--lift) * -1);
    flex: none; width: var(--w);
    margin-left: calc(var(--w) * -.62); margin-bottom: calc(var(--w) * -.34);
    transform: perspective(5000px) rotateY(-45deg) translateY(var(--y));
    transition: transform .35s cubic-bezier(.25, .1, .25, 1);
    animation: rise .7s cubic-bezier(.19, 1, .22, 1) both; animation-delay: calc(var(--i) * 60ms);
  }
  .card:first-child { margin-left: 0; }
  .fan:has(.card:is(:hover, :focus-within)) .card { --y: 0px; }
  .fan:has(.card:is(:hover, :focus-within)) .card:is(:hover, :focus-within) { --y: calc(var(--w) * -.3); }
  @keyframes rise { from { translate: 0 220px; opacity: 0; } }
  .sheet {
    display: block; background: #fff; color: inherit; text-decoration: none; border-radius: 10px; overflow: hidden;
    box-shadow: 1px 0 1px rgb(0 0 0 / .01), 2.4px 0 2.4px rgb(0 0 0 / .03), 6.4px 0 6.4px rgb(0 0 0 / .08), 20px 0 20px rgb(0 0 0 / .25);
  }
  .soon .sheet { cursor: default; }
  .sheet img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; }
  /* Pasek z nazwą na górze karty: widać go, gdy karta wyjeżdża. */
  .tag { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 16px; border-bottom: 1px solid var(--rule); font-size: 15px; line-height: 1.2; white-space: nowrap; }
  .tag b { font-family: 'NohemiV', sans-serif; font-weight: 500; font-size: 18px; letter-spacing: -.01em; }
  .tag span { display: inline-flex; align-items: center; gap: 6px; color: var(--dim); }
  .tag svg { width: 16px; height: 16px; color: var(--blue); }
  a.sheet:focus-visible { outline-offset: -3px; }

  /* Telefon: pas kart przewijany palcem, karty płasko, każda z nazwą. */
  @media (max-width: 767px) {
    .stage { min-height: 0; }
    .lead { font-size: 17px; }
    .fan {
      --w: 78vw; flex: none; min-height: 0; overflow-x: auto; overflow-y: hidden; clip-path: none;
      justify-content: flex-start; align-items: stretch; gap: 12px;
      padding: 16px var(--gutter) 32px; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter);
      scrollbar-width: none; overscroll-behavior-x: contain;
    }
    .fan::-webkit-scrollbar { display: none; }
    .card { margin: 0 !important; transform: none; transition: none; animation: none; scroll-snap-align: start; }
    .sheet { box-shadow: 0 10px 24px rgb(0 0 0 / .12); }
  }
  @media (prefers-reduced-motion: reduce) {
    .card { animation: none; transition: none; }
  }
</style>

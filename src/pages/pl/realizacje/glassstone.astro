  .pp-po li:last-child span { color: var(--mute); }

  /* 4. Narzędzia */
  .tools { padding-bottom: var(--sec); }
  .steps { list-style: none; padding: 0; border-top: var(--line) solid var(--ink); }
  .steps > li { display: grid; grid-template-columns: var(--cols); gap: var(--cgap); padding: var(--in) 0; border-bottom: var(--line) solid var(--ink); align-items: start; }

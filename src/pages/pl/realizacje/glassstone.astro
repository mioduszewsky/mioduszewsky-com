  .end-txt { display: grid; gap: 24px; grid-column: 8 / -1; }
  .end-txt p { font-size: clamp(17px, 1.4vw, 20px); line-height: 1.55; max-width: 26em; }
  .end-act { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; }
  .btn { display: inline-block; padding: 18px 30px; border-radius: 999px; background: var(--white); color: var(--cob); text-decoration: none; font-size: 16px; font-weight: 700; }

---
// Case study GlassStone, wersja 3 (30.09.2026), kierunek „Arkusz”.
// Strona jest złożona jak arkusz produkcyjny GlassStone: rysunek klienta jest głównym
// eksponatem, metryczka to tabelka rysunkowa, każdy rysunek ma ten sam panel i podpis „Rys.”.
// v1 (18f736f) i v2 (97b2cb6) odrzucone; opis kierunku i referencje: docs/case-studies/RUNDA-3.md (Drive).
// Treść: docs/case-studies/glassstone/COPY.md, fakty: FAKTY.md. Nowe są tylko podpisy rysunków.
// Skala pisma: tytuł, śródtytuł, tekst, podpis (+ liczby w rozmiarze tytułu). Mono tylko w rysunkach.
import VariantLayout from '../../../layouts/VariantLayout.astro';
import SiteMenu from '../../../components/SiteMenu.astro';
import BrandFooter from '../../../components/BrandFooter.astro';

const contact = '/pl/kontakt/?service=' + encodeURIComponent('Aplikacja lub system') + '#ctForm';
// Opinia pojawia się dopiero po akceptacji Filipa (docs/case-studies/OPINIE-ROZMOWA.md).
const quote: { text: string; name: string; role: string } | null = null;
const P = (t: string) => t.replace(/(^|[\s(„])([wziouaWZIOUA]) /g, '$1$2&nbsp;');
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Article', headline: 'Szkic z pomiaru zamienia się w rysunek na produkcję', inLanguage: 'pl',
      about: 'Narzędzie pomiarowe dla GlassStone: odręczny szkic blatu zamieniany na rysunek DXF i PDF',
      author: { '@type': 'Person', name: 'Kacper Mioduszewski', url: 'https://mioduszewsky.com/pl/' },
      image: 'https://mioduszewsky.com/case/glassstone/szkic.webp',
      mainEntityOfPage: 'https://mioduszewsky.com/pl/realizacje/glassstone/' },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'mioduszewsky', item: 'https://mioduszewsky.com/pl/' },
      { '@type': 'ListItem', position: 2, name: 'GlassStone', item: 'https://mioduszewsky.com/pl/realizacje/glassstone/' } ] },
  ],
};

// Arkusz Z-19618 odtworzony wektorowo z rysunku generatora (jednostka = 1 mm).
// Bez numeru zlecenia i bez pola montażysty (FAKTY.md, zgoda na publikację).
const dimH = (x1: number, x2: number, y: number, ext: number, label: string, ty = -14) =>
  `<path d="M${x1} ${y - ext} V${y + 12} M${x2} ${y - ext} V${y + 12} M${x1} ${y} H${x2}" pathLength="1"/>` +
  `<text class="t-dim" x="${(x1 + x2) / 2}" y="${y + ty}" text-anchor="middle">${label}</text>`;
const dimV = (y1: number, y2: number, x: number, ext: number, label: string) =>
  `<path d="M${x + ext} ${y1} H${x - 12} M${x + ext} ${y2} H${x - 12} M${x} ${y1} V${y2}" pathLength="1"/>` +
  `<text class="t-dim" x="${x - 16}" y="${(y1 + y2) / 2}" text-anchor="middle" transform="rotate(-90 ${x - 16} ${(y1 + y2) / 2})">${label}</text>`;
const cross = (x: number, y: number) => `<path d="M${x - 18} ${y - 18} L${x + 18} ${y + 18} M${x + 18} ${y - 18} L${x - 18} ${y + 18}" pathLength="1"/>`;

const blatGlowny = `
  <g class="ln-body">
    <rect x="0" y="0" width="1707" height="600" pathLength="1"/>
    <rect x="112.5" y="115" width="345" height="395" rx="10" pathLength="1"/>
    <rect x="1269" y="65" width="275" height="485" pathLength="1"/>
    <circle cx="200" cy="55" r="15" pathLength="1"/>
    <circle cx="285" cy="55" r="17.5" pathLength="1"/>
    ${cross(1180, 0)}${cross(1707, 0)}
  </g>
  <g class="ln-dim">
    ${dimH(0, 1707, 700, 90, '1707')}
    ${dimV(0, 600, -110, 90, '600')}
    ${dimH(0, 285, -90, -70, '285')}
    ${dimH(1406.5, 1707, -90, -70, '300')}
    <path class="t-in" d="M285 510 V600" pathLength="1"/><text class="t-dim t-in" x="300" y="572">90</text>
    <path class="t-in" d="M1406.5 550 V660" pathLength="1"/><text class="t-dim t-in" x="1421" y="656">50</text>
  </g>
  <g class="ln-note">
    <path d="M1725 -18 L1790 -120 H2000" pathLength="1"/>
    <path d="M1198 -18 L1250 -170 H1420" pathLength="1"/>
  </g>
  <g class="tx">
    <text class="t-dim t-dia" x="322" y="70">ø30 ø35</text>
    <text class="t-body" x="285" y="326" text-anchor="middle">ZLEW</text>
    <text class="t-body" x="1406" y="322" text-anchor="middle">PŁYTA</text>
    <text class="t-note" x="1800" y="-134">FAZA+POLER 30 MM</text>
    <text class="t-note" x="1260" y="-184">FAZA+POLER</text>
    <text class="t-body" x="0" y="800">BLAT GŁÓWNY</text>
    <text class="t-note" x="0" y="890">PRZEDNIA KRAWĘDŹ BLATU U4 DO 10 CM</text>
  </g>`;
const blat563 = `
  <g class="ln-body">
    <rect x="0" y="0" width="1707" height="563" pathLength="1"/>
    <circle cx="763" cy="284" r="17.5" pathLength="1"/>
  </g>
  <g class="ln-dim">
    ${dimH(0, 1707, 640, 60, '1707')}
    ${dimH(0, 763, 720, 60, '763')}
    ${dimV(0, 563, -110, 90, '563')}
  </g>
  <g class="ln-note"><path d="M763 266 V-60 H880" pathLength="1"/></g>
  <g class="tx">
    <text class="t-dim" x="890" y="-48">ø35</text>
    <text class="t-body" x="0" y="820">BLAT 563</text>
  </g>`;
const baner = `
  <g class="ln-body">
    <rect x="0" y="0" width="600" height="300" pathLength="1"/>
    <rect x="62" y="109" width="210" height="70" rx="35" pathLength="1"/>
  </g>
  <g class="ln-dim">
    ${dimH(0, 600, 380, 60, '600')}
    ${dimH(0, 167, 460, 160, '165')}
    ${dimV(0, 300, -90, 70, '300')}
  </g>
  <g class="ln-note"><path d="M167 109 V-50 H300" pathLength="1"/></g>
  <g class="tx">
    <text class="t-dim" x="310" y="-38">210×70</text>
    <text class="t-body" x="0" y="560">BANER ŚCIENNY</text>
  </g>`;
const tabelka = `
  <g class="ln-frame">
    <rect x="0" y="0" width="2430" height="130" pathLength="1"/>
    <path d="M0 50 H2430 M360 0 V130 M1400 0 V130 M1750 0 V130 M2100 0 V130" pathLength="1"/>
  </g>
  <g class="tx">
    <text class="t-lab" x="16" y="36">PRODUKT</text><text class="t-tab" x="16" y="104">Blaty</text>
    <text class="t-lab" x="376" y="36">MATERIAŁ</text><text class="t-tab" x="376" y="104">kamień kwarcowy</text>
    <text class="t-lab" x="1416" y="36">GRUBOŚĆ</text><text class="t-tab" x="1416" y="104">20 mm</text>
    <text class="t-lab" x="1766" y="36">WYKOŃCZENIE</text><text class="t-tab" x="1766" y="104">poler</text>
    <text class="t-lab" x="2116" y="36">PROFIL</text><text class="t-tab" x="2116" y="104">P1</text>
    <text class="t-sm" x="2430" y="-24" text-anchor="end">TOLERANCJA WYKONANIA BLATÓW WYNOSI +/- 3 MM</text>
  </g>`;
const sheetFull = `
  <g transform="translate(250 1380)">${blatGlowny}</g>
  <g transform="translate(250 250)">${blat563}</g>
  <g transform="translate(2140 230)">${baner}</g>
  <g transform="translate(250 2400)">${tabelka}</g>`;
const sheetCrop = `<g transform="translate(250 1380)">${blatGlowny}</g>`;

// Rys. 2: trzy reguły z ich rysunków, każda na wycinku płyty.
const rules = [
  { title: 'Każde wycięcie jest kotowane do środka, od bliższej krawędzi płyty.', svg: `
      <g class="ln-body"><path d="M0 40 H560 M0 40 V400"/><rect x="100" y="150" width="240" height="200" rx="10"/></g>
      <g class="ln-axis"><path d="M220 120 V380 M70 250 H370"/></g>
      <g class="ln-dim">${dimH(0, 220, 110, 60, '285', -14)}</g>
      <g class="tx"><text class="t-body" x="160" y="330" text-anchor="middle">ZLEW</text></g>` },
  { title: 'Czerwona przerywana linia to podpórki od spodu blatu, 65 mm od krawędzi.', svg: `
      <g class="ln-body"><path d="M0 360 H560 M0 40 V360"/></g>
      <g class="ln-sup"><path d="M40 295 H540"/></g>
      <g class="ln-dim"><path d="M460 295 H480 M460 360 H480 M470 283 V372"/></g>
      <g class="tx"><text class="t-dim" x="488" y="348">65</text></g>
      <g class="tx"><text class="t-note" x="40" y="270">PODPÓRKI</text></g>` },
  { title: 'Krzyżyk to miejsce obróbki, zawsze o tej samej wielkości.', svg: `
      <g class="ln-body"><path d="M0 120 H400 V400"/><path d="M362 82 L438 158 M438 82 L362 158"/></g>
      <g class="ln-note"><path d="M438 82 L470 30 H560"/></g>
      <g class="ln-dim"><path d="M380 140 L418 178 M400 120 L374 146 M438 158 L412 184"/></g>
      <g class="tx"><text class="t-note" x="330" y="18">FAZA+POLER</text><text class="t-dim" x="300" y="200">25</text></g>` },
];

const steps = [
  { t: 'Zdjęcie kartki', d: 'Filip fotografuje szkic na pomiarze.' },
  { t: 'Propozycja modelu', d: 'Model odczytuje wymiary i wypełnia formularz.' },
  { t: 'Sprawdzenie i podpis', d: 'Człowiek porównuje ze zdjęciem i poprawia.', check: true },
  { t: 'DXF i PDF', d: 'Dopiero wtedy powstaje rysunek na produkcję.' },
];
---
<VariantLayout
  title="Narzędzie pomiarowe dla GlassStone: szkic zamienia się w rysunek produkcyjny · mioduszewsky"
  description="Pomiarowiec GlassStone rysuje blat długopisem. Zbudowałem narzędzie, które robi z tego rysunek DXF i PDF na produkcję. Człowiek sprawdza i podpisuje. Jak do tego doszliśmy."
  bg="#f8f9f2" fg="#000000" switcher={false} robots="index, follow, max-image-preview:large" locale="pl" alternatePath="/">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <div class="case">
    <a class="skip" href="#main">Przejdź do treści</a>
    <header class="nav">
      <a class="mark" href="/pl/" aria-label="mioduszewsky. Strona główna.">
        <video autoplay loop muted playsinline preload="metadata" aria-hidden="true" poster="/logo3d/logo-nav-poster.webp">
          <source src="/logo3d/logo-nav.mp4" type="video/mp4;codecs=hvc1" />
          <source src="/logo3d/logo-nav.webm" type="video/webm" />
        </video>
      </a>
      <SiteMenu locale="pl" alternatePath="/" />
    </header>

    <main id="main">
      <article>
        <header class="wrap hero">
          <p class="kicker">Realizacja dla GlassStone</p>
          <h1>Szkic z pomiaru zamienia się w&nbsp;rysunek na produkcję.</h1>
          <p class="lead" set:html={P('GlassStone robi blaty z kamienia, lustra i balustrady szklane. Każdy pomiar kończy się odręcznym szkicem, który ktoś w biurze przerysowuje w AutoCADzie. Zbudowałem w ich aplikacji narzędzie, które robi z tego szkicu rysunek DXF i PDF. Człowiek sprawdza wymiary i podpisuje.')} />
          <dl class="block">
            <div><dt>Klient</dt><dd>GlassStone, kamień, szkło, wnętrza</dd></div>
            <div><dt>Zakres</dt><dd>strona, panel, narzędzie pomiarowe</dd></div>
            <div><dt>Kto używa</dt><dd>pomiarowiec i biuro</dd></div>
            <div><dt>Stan</dt><dd>testy beta od września 2026</dd></div>
          </dl>
        </header>

        <figure class="wrap fig fig-hero">
          <div class="panel pair">
            <div class="photo">
              <img src="/case/glassstone/szkic.webp" srcset="/case/glassstone/szkic-800.webp 800w, /case/glassstone/szkic.webp 1600w" sizes="(min-width: 900px) 40vw, 92vw" width="1600" height="1535" alt="Odręczny szkic trzech elementów blatu na kartce trzymanej w dłoni: blat główny 1707 na 600 z wycięciem zlewu i płyty, blat 563 i baner ścienny z otworem na gniazdka." fetchpriority="high" />
              <p class="tag">Szkic z pomiaru</p>
            </div>
            <div class="sheet">
              <svg class="dwg dwg-full" viewBox="0 0 2800 2570" role="img" aria-label="Rysunek produkcyjny z generatora: baner ścienny 600 na 300 z otworem 210 na 70, blat 563 na 1707 z otworem 35 mm, blat główny 1707 na 600 z wycięciem zlewu i płyty, dwa punkty obróbki krawędzi i tabelka z materiałem, grubością 20 mm i wykończeniem." set:html={sheetFull} />
              <svg class="dwg dwg-crop" viewBox="70 1200 2000 1050" role="img" aria-label="Rysunek blatu głównego z generatora: obrys 1707 na 600 mm, wycięcie zlewu i płyty, dwa otwory na baterię i dozownik, dwa punkty obróbki krawędzi." set:html={sheetCrop} />
              <p class="tag">Rysunek z generatora</p>
            </div>
          </div>
          <figcaption><span>Rys. 1</span> Ten sam blat: kartka z pomiaru i rysunek, który z niej powstał.</figcaption>
        </figure>

        <section class="wrap sec">
          <h2>Długopis, kartka i&nbsp;20 do 40 minut w&nbsp;AutoCADzie.</h2>
          <div class="txt">
            <p set:html={P('Filip jeździ na pomiary. Mierzy kuchnię i rysuje blat na kartce przypiętej do deski, na miejscu albo w samochodzie. Potem ktoś w biurze przerysowuje ten szkic w AutoCADzie. Według zespołu zajmuje to od 20 do 40 minut na jedno zlecenie. Gotowy rysunek jedzie do zakładu, który tnie płytę.')} />
            <p class="strong" set:html={P('Najdroższe jest to, czego nie widać na kartce. Jeden zły wymiar i płyta idzie do kosza.')} />
          </div>
        </section>

        <section class="wrap sec">
          <h2>Najpierw nauczyłem się czytać ich rysunki.</h2>
          <div class="txt">
            <p set:html={P('Dostałem pary: zdjęcie szkicu i gotowy rysunek tego samego zlecenia. Położyłem je obok siebie i szukałem reguł, których nikt nie spisał.')} />
          </div>
        </section>

        <figure class="wrap fig">
          <ol class="panel rules">
            {rules.map((r) => (
              <li>
                <svg class="dwg" viewBox="-40 -10 640 440" aria-hidden="true" set:html={r.svg} />
                <p set:html={P(r.title)} />
              </li>
            ))}
          </ol>
          <figcaption><span>Rys. 2</span> Trzy reguły odczytane z ich gotowych rysunków.</figcaption>
        </figure>

        <section class="wrap sec">
          <div aria-hidden="true"></div>
          <div class="txt">
            <p set:html={P('Czego nie umiałem odczytać, o to pytałem. „60” na szkicu to odległość od tylnej krawędzi zlewu do środka otworu na baterię. „165” to odległość od krawędzi baneru ściennego do gniazdka. Wyjaśnił mi to Filip i obie liczby stały się regułami w kodzie.')} />
            <p set:html={P('Jedną rzecz wymyśliłem sam i musiałem ją wyrzucić: nazywałem elementy po swojemu, a pomiarowiec nazywa je inaczej. Dziś podpisy są takie, jak na jego kartce.')} />
            <p class="soft">U Ciebie też ktoś przepisuje papier do systemu? <a href={contact}>Zacznijmy od takiej samej rozmowy.</a></p>
          </div>
        </section>

        <section class="wrap sec">
          <h2>Ten sam rysunek, tylko bez przerysowywania.</h2>
          <div class="txt">
            <p set:html={P('Generator odtworzył wszystkie wymiary na dwóch zleceniach referencyjnych, co do milimetra: 8 z 8 i 20 z 20. Rysunek wychodzi w ich formacie, z ich tabelką i kolorami warstw, więc zakład nie musi niczego zmieniać po swojej stronie.')} />
          </div>
        </section>

        <figure class="wrap fig">
          <div class="panel nums">
            <p><strong>8<small>/8</small></strong><span>wymiarów zgodnych, zlecenie referencyjne pierwsze</span></p>
            <p><strong>20<small>/20</small></strong><span>wymiarów zgodnych, zlecenie referencyjne drugie</span></p>
          </div>
          <figcaption><span>Rys. 3</span> Rysunek z generatora porównany z rysunkiem zrobionym ręcznie w AutoCADzie.</figcaption>
        </figure>

        <section class="wrap sec">
          <h2>Zły wymiar nie przejdzie dalej.</h2>
          <div class="txt">
            <p set:html={P('Pod generatorem stoi walidator. Sprawdza geometrię i sens: blat kuchenny ma inne dopuszczalne otwory niż baner ścienny. Wstrzyknąłem mu 20 celowych błędów i wyłapał 20. Na prawdziwym zleceniu sam zadał dwa pytania, których nikt nie zadał: czy 325 mm głębokości to na pewno blat kuchenny i dlaczego wycięcie zlewu nie ma otworu na baterię.')} />
            <p set:html={P('Sprawdzenie działa dwa razy: od razu w przeglądarce i drugi raz na serwerze. Przeglądarka nie ma prawa sama zapisać rysunku na produkcję.')} />
          </div>
        </section>

        <figure class="wrap fig">
          <div class="panel valid">
            <ol class="ticks" aria-label="20 celowych błędów, wszystkie zatrzymane">
              {Array.from({ length: 20 }, (_, i) => (
                <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5 L10 17 L19 7" pathLength="1" /></svg><span class="sr">błąd {i + 1} zatrzymany</span></li>
              ))}
            </ol>
            <div class="asks">
              <p>Czy 325 mm głębokości to na pewno blat kuchenny?</p>
              <p>Dlaczego wycięcie zlewu nie ma otworu na baterię?</p>
            </div>
          </div>
          <figcaption><span>Rys. 4</span> 20 celowych błędów, 20 zatrzymanych. Obok dwa pytania, które walidator zadał sam na prawdziwym zleceniu.</figcaption>
        </figure>

        <section class="wrap sec">
          <h2>Zdjęcie szkicu wypełnia formularz. Decyzja zostaje u&nbsp;ludzi.</h2>
          <div class="txt">
            <p set:html={P('Filip robi zdjęcie kartki. Model odczytuje wymiary i wypełnia formularz. To jest dopiero propozycja. Człowiek porównuje ją ze zdjęciem, poprawia, zaznacza, że sprawdził wszystkie wymiary, i podpisuje. Dopiero wtedy powstaje DXF i PDF.')} />
            <p class="strong" set:html={P('Tak to zaprojektowałem z jednego powodu: odczyt pisma odręcznego się myli, a pomyłka kosztuje płytę.')} />
          </div>
        </section>

        <figure class="wrap fig">
          <ol class="panel flow">
            {steps.map((s) => (
              <li>
                <h3 set:html={P(s.t)} />
                <p set:html={P(s.d)} />
                {s.check && <p class="check"><span aria-hidden="true"></span>Sprawdziłem wszystkie wymiary</p>}
              </li>
            ))}
          </ol>
          <figcaption><span>Rys. 5</span> Model proponuje, człowiek sprawdza i podpisuje.</figcaption>
        </figure>

        <section class="wrap sec">
          <div class="side">
            <h2>Działa tam, gdzie jest pomiar.</h2>
            <p class="big" aria-hidden="true">6,5&nbsp;s</p>
          </div>
          <div class="txt">
            <p set:html={P('Pomiar nie zawsze jest tam, gdzie jest zasięg. Narzędzie ściąga wszystko, czego potrzebuje, jednym przyciskiem przy zasięgu. Przy odciętej sieci rysunek powstaje w 6,5 sekundy.')} />
            <p set:html={P('Przy okazji znalazłem dwa błędy w ich istniejącej aplikacji, przez które nigdy nie działała bez sieci, choć miała to w założeniach. Naprawiłem oba.')} />
          </div>
        </section>

        <section class="wrap sec">
          <h2>Narzędzie należy do firmy.</h2>
          <div class="txt">
            <p set:html={P('Dane, zdjęcia i klucze do AI są na koncie GlassStone i na ich rachunku. Rozważałem postawienie części na moim koncie w chmurze. Odrzuciłem to, bo przy rozstaniu firma zostałaby z narzędziem, które nie jest jej.')} />
          </div>
        </section>

        <section class="wrap sec">
          <h2>Uczciwie o&nbsp;tym, gdzie jesteśmy.</h2>
          <div class="txt">
            <p set:html={P('Narzędzie jest w testach u Filipa i Marcina. Nie zastępuje jeszcze AutoCADa w każdym zleceniu. Blaty w kształcie L i U, skosy i nieregularne obrysy narzędzie dziś zatrzymuje, żeby nie narysowało ich źle. Pierwszą wersję edytora wyrzuciłem, bo miała trzy kolumny i za dużo naraz. Druga prowadzi krok po kroku: zdjęcie, rysunek, eksport. Na telefonie ma osobny układ.')} />
          </div>
        </section>

        <figure class="wrap fig">
          <ul class="panel shapes">
            <li><svg class="dwg" viewBox="-20 -20 440 340" aria-hidden="true"><path class="ln-stop" d="M0 0 H400 V120 H140 V300 H0 Z"/></svg><p>Kształt L</p></li>
            <li><svg class="dwg" viewBox="-20 -20 440 340" aria-hidden="true"><path class="ln-stop" d="M0 0 H400 V300 H280 V120 H120 V300 H0 Z"/></svg><p>Kształt U</p></li>
            <li><svg class="dwg" viewBox="-20 -20 440 340" aria-hidden="true"><path class="ln-stop" d="M0 0 H400 L300 300 H0 Z"/></svg><p>Skos</p></li>
          </ul>
          <figcaption><span>Rys. 6</span> Tych blatów narzędzie dziś nie rysuje. Zatrzymuje je bramka.</figcaption>
        </figure>

        {quote ? (
          <figure class="wrap quote">
            <blockquote><p>{quote.text}</p></blockquote>
            <figcaption>{quote.name}, {quote.role}</figcaption>
          </figure>
        ) : import.meta.env.DEV && (
          <aside class="wrap quote-todo" aria-hidden="true">Tu stanie cytat Filipa po rozmowie. Na produkcji blok się nie pokaże, dopóki cytat nie jest zaakceptowany.</aside>
        )}
      </article>

      <section class="end" aria-labelledby="end-h">
        <div class="wrap end-in">
          <h2 id="end-h">Masz w&nbsp;firmie coś, co ktoś przepisuje ręcznie?</h2>
          <div>
            <p>Opisz mi to w&nbsp;15 minut. Powiem, czy da się to zautomatyzować i&nbsp;co by to zmieniło.</p>
            <a class="btn" href={contact}>Umów 15 minut</a>
            <p class="more"><a href="/pl/uslugi/aplikacje-i-systemy/">Aplikacja lub system: jak pracuję</a></p>
          </div>
        </div>
      </section>
    </main>
    <BrandFooter locale="pl" inset />
  </div>
</VariantLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    // Dwa ruchy na stronie: arkusz kreśli się raz, gdy wjeżdża w ekran, i 20 błędów odhacza się po kolei.
    document.querySelectorAll<SVGSVGElement>('.fig-hero .dwg').forEach((dwg) => {
      const q = (sel: string) => dwg.querySelectorAll(sel);
      gsap.set(q('.ln-body > *, .ln-dim > path, .ln-note > *, .ln-frame > *'), { strokeDasharray: 1, strokeDashoffset: 1 });
      gsap.set(q('text'), { opacity: 0 });
      gsap.timeline({ scrollTrigger: { trigger: dwg, start: 'top 85%', once: true } })
        .to(q('.ln-body > *'), { strokeDashoffset: 0, duration: 1.1, stagger: .05, ease: 'power2.inOut' })
        .to(q('.ln-dim > path, .ln-frame > *'), { strokeDashoffset: 0, duration: .6, stagger: .02 }, '-=.5')
        .to(q('text'), { opacity: 1, duration: .3, stagger: .01 }, '-=.3')
        .to(q('.ln-note > *'), { strokeDashoffset: 0, duration: .4 }, '-=.2');
    });
    const ticks = document.querySelectorAll('.ticks path');
    if (ticks.length) {
      gsap.set(ticks, { strokeDasharray: 1, strokeDashoffset: 1 });
      gsap.to(ticks, { strokeDashoffset: 0, duration: .25, stagger: .06, ease: 'power1.out',
        scrollTrigger: { trigger: '.ticks', start: 'top 80%', once: true } });
    }
  });
  window.addEventListener('pagehide', () => mm.revert(), { once: true });
</script>

<style>
  .case {

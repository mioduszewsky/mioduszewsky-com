  /* Dokumenty: pętla podpisu obok protokołu, kolumny w proporcji obrazów (1600/1112 i 700/806), więc oba mają tę samą wysokość. */
  .step-media.pair { grid-template-columns: minmax(0, 1.439fr) minmax(0, .8685fr); column-gap: var(--cgap); align-items: start; }
  .num { font-weight: 800; font-size: clamp(44px, 5vw, 80px); line-height: 1; letter-spacing: -.05em; color: var(--cob); }
  .label { font-size: 12px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  .steps h3 { font-weight: 750; font-size: clamp(22px, 2.1vw, 36px); line-height: 1.15; letter-spacing: -.02em; }
  .step-txt > p:last-child { font-size: clamp(16px, 1.3vw, 21px); line-height: 1.6; max-width: 30em; }
  .shot img { border: var(--line) solid #d5d8dd; border-radius: 12px; }

  .draw { padding: var(--sec) 0; }
  .draw-in { display: grid; grid-template-columns: var(--cols); gap: var(--cgap); align-items: center; }
  .draw-txt { grid-column: 1 / span 5; display: grid; gap: 18px; }
  .draw-txt h2 { font-size: clamp(32px, 3.6vw, 60px); margin-bottom: 6px; }
  .draw-shot { grid-column: 6 / -1; }
  .draw-txt p { font-size: clamp(17px, 1.35vw, 20px); line-height: 1.6; color: rgb(255 255 255 / .88); max-width: 32em; }

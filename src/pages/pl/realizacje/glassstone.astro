---
// Case study GlassStone, wersja 2026-11 (zlecenie Fincha 22.11.2026). Zastępuje case „szkic ze zdjęcia → rysunek” (odrzucony przez Kacpra).
// Ta sama rodzina co eskapizm, Cannversity i Igor: rama mioduszewsky (lockup, menu, stopka), w środku kolor i krój klienta.
// GlassStone: biel, czerń i kobalt #1F3BFF z glassstone.pl, krój Geist (OFL, plik z repo klienta), nazwa wersalikami jak „KAMIEŃ I SZKŁO” na ich stronie.
// Treść: docs/case-studies/glassstone/zadania/2026-11-22-nowy-case/COPY.md (Drive), każde zdanie ze źródłem w FAKTY.md obok.
// Ujęcia panelu: podgląd deweloperski z main klienta na danych przykładowych (zero zapytań do ich bazy), nazwa zleceniodawcy
// zamieniona na „Zleceniodawca”, logo i stopka zleceniodawcy na protokole zasłonięte. Skrypty: ~/zrzuty-agentow/2026-11-22-case-glassstone/skrypty.
// Telefon: każde narzędzie pokazane pełnym ekranem z telefonu, od krawędzi do krawędzi; rysunek (narzędzie na iPada) ujęciami z iPada na całą szerokość.
import VariantLayout from '../../../layouts/VariantLayout.astro';
import CaseLockup from '../../../components/realizacje/CaseLockup.astro';
import BrandFooter from '../../../components/BrandFooter.astro';
import ExtArrow from '../../../components/realizacje/ExtArrow.astro';
import { nextCase } from '../../../content/realizacje-kolejnosc';

const live = 'https://glassstone.pl/?utm_source=mioduszewsky&utm_medium=realizacje&utm_campaign=case-glassstone';
const contact = '/pl/kontakt/?utm_source=realizacje&utm_content=glassstone#ctForm';
const next = nextCase('glassstone', 'pl');
const url = 'https://mioduszewsky.com/pl/realizacje/glassstone/';
const dir = '/case/glassstone';
// „AutoCAD-a” i odmiany nie łamią się na łączniku (na 390 px zostawało samo „a” w nowej linii, uwaga Fincha 22.11)
const P = (t: string) => t.replace(/(^|[\s(„])([wziouaWZIOUA]) /g, '$1$2&nbsp;').replace(/AutoCAD-(\p{L}+)/gu, '<span class="nw">AutoCAD-$1</span>');

const wiersze: [string, string][] = [
  ['Strona', 'Kamień i szkło po równo, dwie wyceny od pierwszego ekranu'],
  ['Panel', 'Zlecenia, kalendarz i dokumenty z podpisem klienta'],
  ['W testach', 'Rysunek na iPadzie w formacie AutoCAD-a'],
];

const kroki = [
  { f: 'kalendarz', etykieta: 'Kalendarz', tytul: 'Dzień zaczyna się w Kalendarzu',
    tekst: 'Panel otwiera się na dzisiejszych pomiarach i montażach. Kalendarz jest spięty z Kalendarzem Google, którego ekipa już używa: wpis dodany w Google pojawia się w panelu zwykle po kilku sekundach, a termin zmieniony w karcie wraca do Google.',
    podpis: 'Kalendarz, widok Dziś. Dane przykładowe.',
    alt: 'Kalendarz w panelu GlassStone, widok Dziś: wpisy z Kalendarza Google do przypisania, czwartek 29 października z trzema montażami i jednym pomiarem. Dane przykładowe.' },
  { f: 'zlecenia', etykieta: 'Zlecenia', tytul: 'Każde zlecenie na jednej tablicy',
    tekst: 'Etapy ekipa ustawia sama, każdy z własnym alarmem, gdy zlecenie stoi. Plakietka na kafelku mówi, czy to sprzedaż GlassStone, czy montaż dla zleceniodawcy. Zapytanie ze strony ląduje w „Nowe”.',
    podpis: 'Zlecenia w etapach: na iPadzie tablica, w telefonie lista. Dane przykładowe.',
    alt: 'Zlecenia w panelu GlassStone pogrupowane w etapy Nowe, Wycena, Zamówione i W realizacji, w Nowe zapytanie ze strony, przy zleceniach materiał, miejscowość, termin i kwota. Dane przykładowe.' },
  { f: 'karta', etykieta: 'Dokumenty', tytul: 'Dokumenty podpisane na iPadzie',
    tekst: 'Wzory zleceniodawcy wyglądają jak na papierze. Dane zlecenia Filip wpisuje raz i trafiają w pola wszystkich dokumentów, a klient podpisuje palcem albo rysikiem. Komplet wysyła z karty przyciskiem „Wyślij komplet”. Kolejny zleceniodawca to jego PDF-y i mapa pól, bez programowania.',
    podpis: 'Karta zlecenia. Dane przykładowe.',
    alt: 'Karta zlecenia w panelu GlassStone w telefonie: klient, wartość zlecenia, etap W realizacji, montaż dziś, przyciski Zadzwoń, Nawiguj, Dokument, Rysunek i Notatka, pod nimi dane klienta i montażu. Dane przykładowe.' },
];

// Menu panelu przed przebudową: odczyt z bazy 22.10.2026 (discovery-2026-10-22/2-PANEL.md, FAKTY G32), bez ocen, same liczby.
const menuPrzed: [string, string][] = [
  ['Montaże', '1 termin w historii, ostatni 16.05'],
  ['CRM', '9 zleceń, ostatnia zmiana 07.07'],
  ['Wiadomości', '0 zapytań'],
  ['Analityka', '0 wyników miesięcy'],
  ['Rysunki', '4 pomiary, ruch do 21.10'],
  ['Blog', '4 wpisy, ostatni 23.03'],
  ['Portfolio', '18 realizacji, 16.03'],
  ['Materiały', '6 pozycji, 23.03'],
  ['Opinie', '5 pozycji, 16.03'],
];
const menuPo: [string, string][] = [
  ['Zlecenia', 'od zapytania ze strony do podpisu'],
  ['Kalendarz', 'ekran startowy, spięty z Google'],
  ['Rysunki', 'w testach'],
  ['Więcej', 'realizacje, analityka, etapy, zgłoszenia'],
];

const naCoDzien: [string, string][] = [
  ['Zgłoś Kacprowi', 'Na każdym ekranie panelu jest cichy przycisk. Dotknięcie robi zrzut ekranu, zbiera ostatnie kroki i wysyła mi mail.'],
  ['Zmiany', 'Każdą zmianę sprawdzam na koncie testowym z zablokowanymi zapisami. Na produkcję idzie po mojej decyzji, z planem wycofania.'],
  ['Bez zasięgu', 'Ekipa pracuje na iPadzie, często u klienta bez zasięgu. Zmiany zapisują się na urządzeniu i wysyłają same, gdy wróci sieć.'],
  ['Konta', 'Baza, kalendarz i poczta stoją na kontach GlassStone.'],
];

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Article', headline: 'GlassStone: strona i panel zleceń na iPadzie', inLanguage: 'pl',
      about: 'Nowa strona glassstone.pl i panel GlassStone: zlecenia, kalendarz spięty z Kalendarzem Google, dokumenty podpisywane na iPadzie, rysunek w formacie AutoCAD-a w testach',
      author: { '@type': 'Person', name: 'Kacper Mioduszewski', url: 'https://mioduszewsky.com/pl/' },
      image: `https://mioduszewsky.com${dir}/strona-1440.webp`, mainEntityOfPage: url },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'mioduszewsky', item: 'https://mioduszewsky.com/pl/' },
      { '@type': 'ListItem', position: 2, name: 'GlassStone', item: url } ] },
  ],
};
---
<VariantLayout
  title="GlassStone: strona i panel zleceń · mioduszewsky"
  description="Przebudowałem stronę glassstone.pl i panel, w którym ekipa prowadzi zlecenie od zapytania ze strony do podpisu klienta na iPadzie."
  bg="#ffffff" fg="#0d0d0d" switcher={false} robots="index, follow, max-image-preview:large" locale="pl">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <div class="case">
    <a class="skip" href="#main">Przejdź do treści</a>
    <!-- Case tylko po polsku: bez hreflang do EN, przełącznik języka prowadzi na /work/ (jak w poprzedniej wersji). -->
    <CaseLockup locale="pl" client="glassstone" alternatePath="/work/" tone="light" fit={{ h: .487, base: 381 / 385 }} />

    <main id="main">
      <article>
        <!-- 1. Otwarcie: nazwa wersalikami Geist na całą szerokość (jak „KAMIEŃ I SZKŁO” na glassstone.pl), pod kreską
             zdanie i trzy wiersze, obok pierwszy ekran nowej strony. -->
        <header class="open">
          <div class="wrap">
            <p class="metka">Kamień i szkło na wymiar, Wrocław</p>
            <h1 class="name"><span class="name-in" aria-hidden="true"><span class="glass">GLASS</span>STONE</span><span class="sr">GlassStone: strona i iPad, na którym ekipa prowadzi zlecenie od zapytania do podpisu.</span></h1>
            <div class="rule" aria-hidden="true"></div>
          </div>
          <div class="wrap open-body">
            <div class="open-txt">
              <p class="zdanie" aria-hidden="true" set:html={P('Strona i iPad, na którym ekipa prowadzi zlecenie od zapytania do podpisu.')} />
              <dl class="rows">
                {wiersze.map(([k, v]) => <div><dt>{k}</dt><dd set:html={P(v)} /></div>)}
              </dl>
              <a class="live" href={live} target="_blank" rel="noopener">Zobacz glassstone.pl<ExtArrow weight={600} /></a>
            </div>
            <figure class="open-shot">
              <div class="loop" data-loop data-d={`${dir}/strona.mp4`} data-m={`${dir}/strona-m.mp4`} style="aspect-ratio: 1920 / 1200">
                <img src={`${dir}/strona-poster.webp`} width="1920" height="1200" fetchpriority="high" decoding="async"
                  alt="Nagranie glassstone.pl: pierwszy ekran „Kamień i szkło” z dwiema wycenami, przewijanie do oferty, potem strona Realizacje i filtr Szkło." />
                <video muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
              </div>
            </figure>
          </div>
        </header>

        <!-- 2. Strona: kobalt glassstone.pl, komputer obok telefonu (na telefonie jedno pod drugim, od krawędzi do krawędzi). -->
        <section class="cobalt site" data-tone="dark" aria-labelledby="s2-h">
          <div class="wrap head">
            <div class="head-h">
              <p class="kicker">Strona</p>
              <h2 id="s2-h" set:html={P('Kamień i szkło dostały tyle samo miejsca.')} />
            </div>
            <div class="head-txt">
              <p class="lead" set:html={P('Od pierwszego ekranu są dwie osobne wyceny, kamienia i szkła. Przy kontakcie stoją Filip od kamienia i Marcin od szkła.')} />
              <p class="lead" set:html={P('Realizacje da się przefiltrować: kamień, szkło, kuchnie, łazienki, lokale.')} />
              <p class="lead" set:html={P('Zapytanie z formularza zakłada zlecenie w panelu i wysyła mail na biuro@glassstone.pl z przyciskiem do karty klienta.')} />
            </div>
          </div>
          <div class="wrap duo">
            <figure class="desk">
              <img src={`${dir}/realizacje-1440.webp`} width="2880" height="1800" loading="lazy" decoding="async"
                alt="Strona Realizacje na glassstone.pl: filtry Wszystkie, Kamień, Szkło, Kuchnie, Łazienki i Lokale, pod nimi zdjęcia realizacji z miejscowością i liczbą zdjęć." />
              <figcaption>Realizacje z filtrami, na komputerze.</figcaption>
            </figure>
            <figure class="phone">
              <img src={`${dir}/strona-390.webp`} width="780" height="1688" loading="lazy" decoding="async"
                alt="glassstone.pl w telefonie: osobno Kamień z telefonem do Filipa i Szkło z telefonem do Marcina, każde z przyciskiem Wycena." />
              <figcaption>Pierwszy ekran w telefonie.</figcaption>
            </figure>
          </div>
        </section>

        <!-- 3. Rozmowa: dane z bazy i rozmowa z Filipem, zanim powstał nowy panel. Menu panelu jako cztery pozycje. -->
        <section class="paper talk" aria-labelledby="s3-h">
          <div class="wrap talk-in">
            <div class="talk-h">
              <p class="kicker kicker-c">Zanim cokolwiek przebudowałem</p>
              <h2 id="s3-h" set:html={P('Najpierw dane i rozmowa, potem panel.')} />
            </div>
            <div class="talk-txt">
              <p set:html={P('Sprawdziłem w bazie, z czego ekipa korzysta: dziewięć pozycji menu, przy każdej liczba wpisów i data ostatniego.')} />
              <p set:html={P('Potem rozmowa z Filipem o dniu pracy. Dokumenty od firmy, dla której montują, przychodziły jako PDF bez pól, a Filip wypełniał je ręcznie u klienta.')} />
              <p set:html={P('W menu zostało to, czego używają w pracy: Zlecenia, Kalendarz i Rysunki. Reszta jest pod „Więcej”.')} />
            </div>
          </div>
          <div class="wrap pp">
            <figure class="pp-col pp-przed">
              <figcaption class="pp-h"><b>Przed</b> Menu panelu, 9 pozycji. Odczyt z bazy 22.10.2026.</figcaption>
              <ol>{menuPrzed.map(([k, v]) => <li><span>{k}</span><em set:html={P(v)} /></li>)}</ol>
            </figure>
            <figure class="pp-col pp-po">
              <figcaption class="pp-h"><b>Po</b> Menu panelu dziś.</figcaption>
              <ol>{menuPo.map(([k, v]) => <li><span>{k}</span><em set:html={P(v)} /></li>)}</ol>
            </figure>
          </div>
        </section>

        <!-- 4. Narzędzia: trzy bloki, tekst z lewej, pełny ekran iPada z prawej; na telefonie pełny ekran z telefonu. -->
        <section class="paper tools" aria-labelledby="s4-h">
          <div class="wrap">
            <h2 id="s4-h" class="sr">Narzędzia w panelu</h2>
            <ol class="steps">
              {kroki.map((k, i) => (
                <li>
                  <div class="step-txt">
                    <p class="num" aria-hidden="true">0{i + 1}</p>
                    <p class="label">{k.etykieta}</p>
                    <h3 set:html={P(k.tytul)} />
                    <p set:html={P(k.tekst)} />
                  </div>
                  <div class:list={['step-media', k.f === 'karta' && 'pair']}>
                    {k.f === 'karta' && (
                      <figure class="shot" data-tone="light">
                        <div class="loop" data-loop data-d={`${dir}/podpis.mp4`} data-m={`${dir}/podpis-m.mp4`} style="aspect-ratio: 1600 / 1112">
                          <img src={`${dir}/podpis-poster.webp`} width="1600" height="1112" loading="lazy" decoding="async"
                            alt="Nagranie: klient podpisuje się palcem na linii „zamawiający” protokołu odbioru, potem na karcie zlecenia dotknięcie przycisku Wyślij komplet. Dane przykładowe." />
                          <video muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
                        </div>
                        <figcaption set:html={P('Podpis klienta palcem na protokole, potem „Wyślij komplet” na karcie. Dane przykładowe, stopka zleceniodawcy zasłonięta.')} />
                      </figure>
                    )}
                    <figure class:list={['shot', k.f === 'karta' && 'm-only']} data-tone="light">
                      <picture>
                        <source media="(max-width: 700px)" srcset={`${dir}/${k.f}-tel.webp`} width="1170" height="2532" />
                        <img src={`${dir}/${k.f}-ipad.webp`} width="2360" height="1640" loading="lazy" decoding="async" alt={k.alt} />
                      </picture>
                      <figcaption set:html={P(k.podpis)} />
                    </figure>
                    {k.f === 'karta' && (
                      <figure class="shot doc" data-tone="light">
                        <img src={`${dir}/dokument.webp`} width="700" height="806" loading="lazy" decoding="async"
                          alt="Protokół odbioru montażu po podpisie: zamawiający, data i numer zamówienia wpisane z danych zlecenia, lista punktów do zaznaczenia i podpis klienta nad słowem zamawiający. Dane przykładowe." />
                        <figcaption set:html={P('Protokół po podpisie: zamawiający, data i numer z danych zlecenia, podpis klienta. Dane przykładowe.')} />
                      </figure>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </section>

        <!-- 5. Rysunek: ciemny pas, bo to osobna sprawa i jest w testach. Tekst obok pętli z iPada (na telefonie rysunku się nie zakłada). -->
        <section class="ink draw" data-tone="dark" aria-labelledby="s5-h">
          <div class="wrap draw-in">
            <div class="draw-txt">
              <p class="kicker kicker-c">W testach</p>
              <h2 id="s5-h" set:html={P('Rysunek na iPadzie, w formacie AutoCAD-a.')} />
              <p set:html={P('Filip wybiera kształt blatu i wpisuje wymiary z miary albo rysuje rysikiem na kartce, a „Zrób z tego rysunek” zamienia kartkę w rysunek. Z każdego rysunku wychodzi PDF i DXF, czyli plik, który otwiera AutoCAD. Rysunek i pliki działają też bez zasięgu, a kartka zamienia się w rysunek, gdy wróci sieć.')} />
              <p set:html={P('Cel jest jeden: żeby chłopaki rysowali sami, bez licencji AutoCAD-a, która kosztuje 9&nbsp;933&nbsp;zł rocznie za stanowisko (cennik Autodesk z 23.11.2026). Narzędzie jest w testach. Zanim zastąpi AutoCAD-a, Filip sprawdzi je na swoim iPadzie, a zleceniodawca musi przyjąć plik bez poprawek.')} />
            </div>
            <figure class="draw-shot">
              <div class="loop" data-loop data-d={`${dir}/kartka.mp4`} data-m={`${dir}/kartka-m.mp4`} style="aspect-ratio: 1600 / 1112">
                <img src={`${dir}/kartka-poster.webp`} width="1600" height="1112" loading="lazy" decoding="async"
                  alt="Nagranie z iPada: odręczny obrys blatu L rysikiem na Kartce z wymiarami 1800 i 2600, potem blat L w edytorze i wymiary wpisywane po kolei, na końcu gotowa płyta z wymiarami." />
                <video muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
              </div>
              <figcaption>Kartka rysikiem, potem blat L w edytorze: wymiary wpisywane po kolei.</figcaption>
            </figure>
          </div>
        </section>

        <!-- 6. Na co dzień: nagłówek obok czterech pozycji w dwóch kolumnach (runda 3: bez pustej połowy pod krótkim nagłówkiem). -->
        <section class="paper daily" aria-labelledby="s6-h">
          <div class="wrap daily-in">
            <h2 id="s6-h" set:html={P('Jak to prowadzimy na co dzień.')} />
            <dl class="rows rows-big">
              {naCoDzien.map(([k, v]) => <div><dt>{k}</dt><dd set:html={P(v)} /></div>)}
            </dl>
          </div>
        </section>
      </article>

      <!-- 7. Wyjście: kobaltowy blok, pod kreską następna realizacja z pętli. -->
      <section class="end cobalt" data-tone="dark" aria-labelledby="end-h">
        <div class="wrap end-in">
          <h2 id="end-h" set:html={P('Ekipa pracuje u klientów, a papiery wypełnia ręcznie?')} />
          <div class="end-txt">
            <p set:html={P('Napisz, jak wygląda Wasz dzień od zapytania do montażu. Odpiszę, co z tego da się przenieść na iPada.')} />
            <div class="end-act">
              <a class="btn" href={contact}>Napisz do mnie</a>
              <a class="live" href={live} target="_blank" rel="noopener">Zobacz glassstone.pl<ExtArrow weight={600} /></a>
            </div>
          </div>
        </div>
        <a class="next" href={next.href}>
          <span class="wrap next-in"><span class="next-k">Następna realizacja</span><span class="next-n">{next.name}<span aria-hidden="true"> →</span></span></span>
        </a>
      </section>
    </main>
    <div class="foot"><BrandFooter locale="pl" full /></div>
  </div>
</VariantLayout>

<script>
  // Pętle (jak w eskapizmie, Loop.astro): plakat jako obraz od razu, wideo bez src. Źródło (komputer albo lżejszy plik na telefon)
  // wstawiane ok. ekran przed sekcją, gra tylko, gdy widać co najmniej 15% pętli. Przy prefers-reduced-motion wideo nie ładuje się
  // wcale, a włączone w trakcie zwalnia źródło i zostawia plakat. Przycisk pauzy na każdej pętli (WCAG 2.2.2); wybór zostaje po przewinięciu.
  // Jeden stan i jeden licznik ponowień na pętlę (recenzja Codexa 23.11: canplay i obserwator nie odpalają już dwóch łańcuchów play()).
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const narrow = matchMedia('(max-width: 767px)');
  type St = { v: HTMLVideoElement; b: HTMLButtonElement; inview: boolean; user: boolean; tries: number; timer?: number };
  const loops = [...document.querySelectorAll<HTMLElement>('.case [data-loop]')];
  const st = new Map<HTMLElement, St>();
  // stała nazwa i aria-pressed (wciśnięty = nagranie zatrzymane), bez zmieniania nazwy, żeby czytnik nie mówił „Wznów, wciśnięty”
  const label = (s: St) => { s.b.setAttribute('aria-pressed', String(s.user)); s.b.setAttribute('aria-label', 'Zatrzymaj nagranie'); };
  // WebKit potrafi odrzucić play() tuż po wczytaniu mimo muted i playsinline: kilka ponowień, póki pętla ma grać
  const sync = (el: HTMLElement) => {
    const s = st.get(el); if (!s) return;
    clearTimeout(s.timer);
    if (s.inview && !s.user && !still.matches && el.dataset.loaded) {
      // AbortError = play() przerwane przez pause() albo nowe źródło: to nie błąd odtwarzania, nie zużywa ponowień
      if (s.v.paused) s.v.play().then(() => { s.tries = 0; }).catch((e) => { if (e?.name !== 'AbortError' && s.tries++ < 4) s.timer = window.setTimeout(() => sync(el), 700); });
    } else { s.tries = 0; s.v.pause(); }
  };
  const load = (el: HTMLElement) => {
    const s = st.get(el); if (!s || el.dataset.loaded || still.matches) return;
    const src = document.createElement('source'); src.src = (narrow.matches ? el.dataset.m : el.dataset.d) || ''; src.type = 'video/mp4';
    s.v.poster = el.querySelector('img')?.currentSrc || '';
    s.v.append(src); s.v.preload = 'auto'; s.v.load(); el.dataset.loaded = '1'; s.b.hidden = false;
  };
  const unload = (el: HTMLElement) => {
    const s = st.get(el); if (!s || !el.dataset.loaded) return;
    clearTimeout(s.timer); s.v.pause(); s.v.querySelectorAll('source').forEach((x) => x.remove()); s.v.preload = 'none'; s.v.load();
    delete el.dataset.loaded; s.b.hidden = true;
  };
  const near = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting && !still.matches) { load(e.target as HTMLElement); near.unobserve(e.target); } }), { rootMargin: '100% 0px' });
  const seen = new IntersectionObserver((es) => es.forEach((e) => {
    const el = e.target as HTMLElement, s = st.get(el); if (!s) return;
    s.inview = e.isIntersecting && e.intersectionRatio >= .15; sync(el);
  }), { threshold: [0, .15] });
  loops.forEach((el) => {
    const v = el.querySelector('video'); if (!v) return;
    const b = document.createElement('button'); b.type = 'button'; b.className = 'lp'; b.hidden = true; el.append(b);
    const s: St = { v, b, inview: false, user: false, tries: 0 }; st.set(el, s); label(s);
    b.addEventListener('click', () => { s.user = !s.user; label(s); sync(el); });
    v.addEventListener('canplay', () => sync(el));
    near.observe(el); seen.observe(el);
  });
  still.addEventListener('change', () => loops.forEach((el) => { if (still.matches) unload(el); else near.observe(el); }));
</script>

<style>
  .case {
    /* Kolory glassstone.pl: kobalt #1F3BFF (akcent strony i panelu), czerń, biel, szarość tła panelu. */

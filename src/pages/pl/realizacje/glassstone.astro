  .loop video { position: absolute; inset: 0; }
  /* Pauza pętli: mały okrągły przycisk w rogu, pałki pauzy albo trójkąt odtwarzania. */
  .case :global(.lp) { position: absolute; left: 12px; bottom: 12px; z-index: 2; width: 36px; height: 36px; padding: 0; border: 0; border-radius: 50%; background: rgb(13 13 13 / .6); color: #fff; display: grid; place-items: center; cursor: pointer; }
  .case :global(.lp[hidden]) { display: none; }
  .case :global(.lp)::before { content: ''; box-sizing: border-box; width: 10px; height: 12px; border-inline: 3px solid currentColor; }
  .case :global(.lp[aria-pressed="true"])::before { width: 0; height: 0; margin-left: 3px; border-inline: 0; border-block: 7px solid transparent; border-left: 11px solid currentColor; }
  .case :global(.lp):hover { background: rgb(13 13 13 / .8); }
  /* przycisk powstaje w skrypcie, więc nie łapie ogólnej reguły :focus-visible z zakresem Astro; obwódka biała z kobaltem, widoczna na każdym kadrze */
  .case :global(.lp:focus-visible) { outline: 3px solid #fff; outline-offset: 2px; box-shadow: 0 0 0 6px var(--cob); }

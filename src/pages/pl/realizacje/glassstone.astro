  h2 { font-weight: 750; font-size: clamp(34px, 4.4vw, 68px); line-height: 1.02; letter-spacing: -.04em; max-width: 14em; }
  .kicker { font-size: 13px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  .kicker-c { color: var(--cob); }
  .lead { font-size: clamp(17px, 1.4vw, 20px); line-height: 1.55; max-width: 32em; }

  /* 2. Strona na kobalcie */
  .cobalt { background: var(--cob); color: var(--white); }
  .cobalt figcaption { color: rgb(255 255 255 / .82); }
  .site { padding: var(--sec) 0; }
  .site .head { display: grid; grid-template-columns: var(--cols); gap: var(--cgap); align-items: end; }
  .site .head-h { grid-column: 1 / span 6; display: grid; gap: 16px; }
  .site .head-txt { grid-column: 7 / -1; display: grid; gap: 14px; }
  .site .lead { color: rgb(255 255 255 / .9); }
  .duo { margin-top: var(--in); display: grid; grid-template-columns: var(--cols); gap: var(--cgap); align-items: end; }
  .duo .desk { grid-column: 1 / span 9; }
  .duo .phone { grid-column: 10 / -1; }
  .duo img { border-radius: 12px; background: var(--white); }

  /* 3. Rozmowa */
  .paper { background: var(--white); }
  .talk { padding: var(--sec) 0; }
  .talk-in { display: grid; grid-template-columns: var(--cols); gap: var(--cgap); align-items: start; }
  .talk-h { grid-column: 1 / span 6; display: grid; gap: 16px; }
  .talk-txt { grid-column: 7 / -1; display: grid; gap: 18px; padding-top: 6px; }
  .talk-txt p { font-size: clamp(17px, 1.35vw, 20px); line-height: 1.6; max-width: 32em; }
  /* Przed i po: dziewięć pozycji z liczbami z bazy obok czterech dzisiejszych. */
  .pp { display: grid; grid-template-columns: var(--cols); gap: var(--cgap); margin-top: var(--in); }
  .pp-col { margin: 0; display: grid; grid-template-rows: auto 1fr; }
  /* „Po” ma 4 pozycje, „Przed” 9: wiersze „Po” rozciągnięte na wysokość „Przed”, bez pustej połaci pod listą. */
  .pp-po ol { display: grid; grid-auto-rows: 1fr; }
  .pp-przed { grid-column: 1 / span 7; }
  .pp-po { grid-column: 8 / -1; }
  .pp-h { padding: 0 0 12px; font-size: 14px; color: var(--mute); border-bottom: var(--line) solid var(--ink); }
  .pp-h b { display: block; font-size: 13px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--ink); margin-bottom: 4px; }
  .pp ol { list-style: none; padding: 0; margin: 0; }
  .pp li { display: grid; grid-template-columns: minmax(0, 9em) minmax(0, 1fr); gap: 12px; padding: 11px 0; border-bottom: 1px solid #dfe2e6; align-items: baseline; }
  .pp li span { font-weight: 650; font-size: clamp(16px, 1.25vw, 18px); }
  .pp li em { font-style: normal; font-size: 15px; color: var(--mute); font-variant-numeric: tabular-nums; }
  .pp-przed li span { color: #6b7178; } /* szary „przed” z kontrastem 4,5:1 na bieli (recenzja Codexa 23.11) */

---
// Case study GlassStone, wersja 2 (30.09.2026): jedna kolumna do czytania.
// Wersja 1 (18f736f) odrzucona przez Kacpra: za dużo rozmiarów pisma, drobne etykiety
// wersalikami, wklejane kawałki zrzutów, układ jak podstrony usług. Zasady tej wersji:
// dwa kroje, cztery rozmiary (tytuł, śródtytuł, tekst, podpis), jeden eksponat.
// Treść: docs/case-studies/glassstone/COPY.md, fakty: FAKTY.md (Drive).
import VariantLayout from '../../../layouts/VariantLayout.astro';
import SiteMenu from '../../../components/SiteMenu.astro';
import BrandFooter from '../../../components/BrandFooter.astro';

const contact = '/pl/kontakt/?service=' + encodeURIComponent('Aplikacja lub system') + '#ctForm';
// Opinia pojawia się dopiero po akceptacji Filipa (docs/case-studies/OPINIE-ROZMOWA.md).
const quote: { text: string; name: string; role: string } | null = null;
const nbsp = (t: string) => t.replace(/(^|[\s(])([wziouaWZIOUA]) /g, '$1$2 ');
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Article', headline: 'Szkic z pomiaru zamienia się w rysunek na produkcję', inLanguage: 'pl',
      about: 'Narzędzie pomiarowe dla GlassStone: odręczny szkic blatu zamieniany na rysunek DXF i PDF',
      author: { '@type': 'Person', name: 'Kacper Mioduszewski', url: 'https://mioduszewsky.com/pl/' },
      image: 'https://mioduszewsky.com/case/glassstone/szkic.webp',
      mainEntityOfPage: 'https://mioduszewsky.com/pl/realizacje/glassstone/' },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'mioduszewsky', item: 'https://mioduszewsky.com/pl/' },
      { '@type': 'ListItem', position: 2, name: 'GlassStone', item: 'https://mioduszewsky.com/pl/realizacje/glassstone/' } ] },
  ],
};
const P = (t: string) => nbsp(t);
---
<VariantLayout
  title="Narzędzie pomiarowe dla GlassStone: szkic zamienia się w rysunek produkcyjny · mioduszewsky"
  description="Pomiarowiec GlassStone rysuje blat długopisem. Zbudowałem narzędzie, które robi z tego rysunek DXF i PDF na produkcję. Człowiek sprawdza i podpisuje. Jak do tego doszliśmy."
  bg="#f8f9f2" fg="#000000" switcher={false} robots="index, follow, max-image-preview:large" locale="pl" alternatePath="/">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <div class="case">
    <a class="skip" href="#main">Przejdź do treści</a>
    <header class="nav">
      <a class="mark" href="/pl/" aria-label="mioduszewsky. Strona główna.">
        <video autoplay loop muted playsinline preload="metadata" aria-hidden="true" poster="/logo3d/logo-nav-poster.webp">
          <source src="/logo3d/logo-nav.mp4" type="video/mp4;codecs=hvc1" />
          <source src="/logo3d/logo-nav.webm" type="video/webm" />
        </video>
      </a>
      <SiteMenu locale="pl" alternatePath="/" />
    </header>

    <main id="main">
      <article>
        <header class="col head">
          <p class="kicker">Realizacja dla GlassStone</p>
          <h1>Szkic z pomiaru zamienia się w&nbsp;rysunek na produkcję.</h1>
          <p class="lead" set:html={P('GlassStone robi blaty z kamienia, lustra i balustrady szklane. Każdy pomiar kończy się odręcznym szkicem, który ktoś w biurze przerysowuje w AutoCADzie. Zbudowałem w ich aplikacji narzędzie, które robi z tego szkicu rysunek DXF i PDF. Człowiek sprawdza wymiary i podpisuje.')} />
          <dl class="facts">
            <div><dt>Zakres</dt><dd>narzędzie pomiarowe w ich aplikacji</dd></div>
            <div><dt>Wynik testów</dt><dd>100% wymiarów zgodnych co do milimetra</dd></div>
            <div><dt>Stan</dt><dd>testy beta od września 2026</dd></div>
          </dl>
        </header>

        <figure class="wide pair">
          <div class="pane">
            <img src="/case/glassstone/szkic.webp" srcset="/case/glassstone/szkic-800.webp 800w, /case/glassstone/szkic.webp 1600w" sizes="(min-width: 1000px) 460px, 92vw" width="1600" height="1535" alt="Odręczny szkic trzech elementów blatu na kartce przypiętej do deski: blat główny 1707 na 600 z wycięciem zlewu i płyty, blat 563 i baner ścienny z otworem na gniazdka." fetchpriority="high" />
          </div>
          <div class="pane sheet">
            <svg class="dwg" viewBox="-280 -230 2600 1130" role="img" aria-label="Rysunek techniczny blatu głównego z generatora: obrys 1707 na 600 mm, wycięcie zlewu 285 od lewej krawędzi i 90 od przedniej, wycięcie płyty 300 od prawej i 50 od przedniej, dwa otwory na baterię i dozownik, dwa punkty obróbki krawędzi.">
              <g class="ln-body">
                <rect x="0" y="0" width="1707" height="600" pathLength="1" />
                <rect x="112.5" y="115" width="345" height="395" rx="10" pathLength="1" />
                <rect x="1269" y="65" width="275" height="485" pathLength="1" />
                <circle cx="200" cy="55" r="15" pathLength="1" />
                <circle cx="285" cy="55" r="17.5" pathLength="1" />
                <path d="M1162 -18 L1198 18 M1198 -18 L1162 18" pathLength="1" />
                <path d="M1689 -18 L1725 18 M1725 -18 L1689 18" pathLength="1" />
              </g>
              <g class="ln-dim">
                <path d="M0 620 V740 M1707 620 V740 M0 710 H1707" pathLength="1" />
                <path d="M-20 0 H-150 M-20 600 H-150 M-120 0 V600" pathLength="1" />
                <path d="M0 -30 V-130 M285 -30 V-130 M0 -100 H285" pathLength="1" />
                <path d="M1406.5 -30 V-130 M1707 -40 V-130 M1406.5 -100 H1707" pathLength="1" />
                <path d="M285 510 V600" pathLength="1" />
                <path d="M1406.5 550 V600" pathLength="1" />
              </g>
              <g class="ln-note">
                <path d="M1725 -18 L1800 -110 H2020" pathLength="1" />
                <path d="M1198 -18 L1260 -160 H1440" pathLength="1" />
              </g>
              <g class="tx">
                <text class="t-dim" x="853" y="690" text-anchor="middle">1707</text>
                <text class="t-dim" x="-140" y="300" text-anchor="middle" transform="rotate(-90 -140 300)">600</text>
                <text class="t-dim" x="142" y="-118" text-anchor="middle">285</text>
                <text class="t-dim" x="1556" y="-118" text-anchor="middle">300</text>
                <text class="t-dim" x="305" y="570">90</text>
                <text class="t-dim" x="1426" y="590">50</text>
                <text class="t-dim t-sm" x="232" y="-12" text-anchor="middle">ø30 ø35</text>
                <text class="t-body" x="285" y="325" text-anchor="middle">ZLEW</text>
                <text class="t-body" x="1406" y="320" text-anchor="middle">PŁYTA</text>
                <text class="t-note" x="1810" y="-128">FAZA+POLER 30 MM</text>
                <text class="t-note" x="1270" y="-178">FAZA+POLER</text>
                <text class="t-body t-sm" x="0" y="820">BLAT GŁÓWNY</text>
                <text class="t-note t-sm" x="0" y="870">PRZEDNIA KRAWĘDŹ BLATU U4 DO 10 CM</text>
              </g>
            </svg>
          </div>
          <figcaption>Ten sam blat: kartka z pomiaru i rysunek, który z niej powstał.</figcaption>
        </figure>

        <div class="col body">
          <h2>Długopis, kartka i 20 do 40 minut w AutoCADzie</h2>
          <p set:html={P('Filip jeździ na pomiary. Mierzy kuchnię i rysuje blat na kartce przypiętej do deski, na miejscu albo w samochodzie. Potem ktoś w biurze przerysowuje ten szkic w AutoCADzie. Według zespołu zajmuje to od 20 do 40 minut na jedno zlecenie. Gotowy rysunek jedzie do zakładu, który tnie płytę.')} />
          <p set:html={P('Najdroższe jest to, czego nie widać na kartce. Jeden zły wymiar i płyta idzie do kosza.')} />

          <h2>Najpierw nauczyłem się czytać ich rysunki</h2>
          <p set:html={P('Dostałem pary: zdjęcie szkicu i gotowy rysunek tego samego zlecenia. Położyłem je obok siebie i szukałem reguł, których nikt nie spisał:')} />
          <ul>
            <li>każde wycięcie jest kotowane do środka, od bliższej krawędzi płyty;</li>
            <li>czerwona przerywana linia to podpórki od spodu blatu, 65&nbsp;mm od krawędzi;</li>
            <li>krzyżyk to miejsce obróbki, zawsze o tej samej wielkości.</li>
          </ul>
          <p set:html={P('Czego nie umiałem odczytać, o to pytałem. „60” na szkicu to odległość od tylnej krawędzi zlewu do środka otworu na baterię. „165” to odległość od krawędzi baneru ściennego do gniazdka. Wyjaśnił mi to Filip i obie liczby stały się regułami w kodzie.')} />
          <p set:html={P('Jedną rzecz wymyśliłem sam i musiałem ją wyrzucić: nazywałem elementy po swojemu, a pomiarowiec nazywa je inaczej. Dziś podpisy są takie, jak na jego kartce.')} />
          <p class="soft">U Ciebie też ktoś przepisuje papier do systemu? <a href={contact}>Zacznijmy od takiej samej rozmowy.</a></p>

          <h2>Ten sam rysunek, tylko bez przerysowywania</h2>
          <p set:html={P('Generator odtworzył wszystkie wymiary na dwóch zleceniach referencyjnych, co do milimetra: 8 z 8 i 20 z 20. Rysunek wychodzi w ich formacie, z ich tabelką i kolorami warstw, więc zakład nie musi niczego zmieniać po swojej stronie.')} />

          <h2>Zły wymiar nie przejdzie dalej</h2>
          <p set:html={P('Pod generatorem stoi walidator. Sprawdza geometrię i sens: blat kuchenny ma inne dopuszczalne otwory niż baner ścienny. Wstrzyknąłem mu 20 celowych błędów i wyłapał 20. Na prawdziwym zleceniu sam zadał dwa pytania, których nikt nie zadał: czy 325 mm głębokości to na pewno blat kuchenny i dlaczego wycięcie zlewu nie ma otworu na baterię.')} />
          <p set:html={P('Sprawdzenie działa dwa razy: od razu w przeglądarce i drugi raz na serwerze. Przeglądarka nie ma prawa sama zapisać rysunku na produkcję.')} />

          <h2>Zdjęcie szkicu wypełnia formularz, decyzja zostaje u&nbsp;ludzi</h2>
          <p set:html={P('Filip robi zdjęcie kartki. Model odczytuje wymiary i wypełnia formularz. To jest dopiero propozycja. Człowiek porównuje ją ze zdjęciem, poprawia, zaznacza, że sprawdził wszystkie wymiary, i podpisuje. Dopiero wtedy powstaje DXF i PDF.')} />
          <p set:html={P('Tak to zaprojektowałem z jednego powodu: odczyt pisma odręcznego się myli, a pomyłka kosztuje płytę.')} />

          <h2>Działa tam, gdzie jest pomiar</h2>
          <p set:html={P('Pomiar nie zawsze jest tam, gdzie jest zasięg. Narzędzie ściąga wszystko, czego potrzebuje, jednym przyciskiem przy zasięgu. Przy odciętej sieci rysunek powstaje w 6,5 sekundy.')} />
          <p set:html={P('Przy okazji znalazłem dwa błędy w ich istniejącej aplikacji, przez które nigdy nie działała bez sieci, choć miała to w założeniach. Naprawiłem oba.')} />

          <h2>Narzędzie należy do firmy</h2>
          <p set:html={P('Dane, zdjęcia i klucze do AI są na koncie GlassStone i na ich rachunku. Rozważałem postawienie części na moim koncie w chmurze. Odrzuciłem to, bo przy rozstaniu firma zostałaby z narzędziem, które nie jest jej.')} />

          <h2>Uczciwie o tym, gdzie jesteśmy</h2>
          <p set:html={P('Narzędzie jest w testach u Filipa i Marcina. Nie zastępuje jeszcze AutoCADa w każdym zleceniu. Blaty w kształcie L i U, skosy i nieregularne obrysy narzędzie dziś zatrzymuje, żeby nie narysowało ich źle. Pierwszą wersję edytora wyrzuciłem, bo miała trzy kolumny i za dużo naraz. Druga prowadzi krok po kroku: zdjęcie, rysunek, eksport. Na telefonie ma osobny układ.')} />

          {quote ? (
            <figure class="quote">
              <blockquote><p>{quote.text}</p></blockquote>
              <figcaption>{quote.name}, {quote.role}</figcaption>
            </figure>
          ) : import.meta.env.DEV && (
            <aside class="quote-todo" aria-hidden="true">Tu stanie cytat Filipa po rozmowie. Na produkcji blok się nie pokaże, dopóki cytat nie jest zaakceptowany.</aside>
          )}
        </div>
      </article>

      <section class="end" aria-labelledby="end-h">
        <div class="col">
          <h2 id="end-h">Masz w firmie coś, co ktoś przepisuje ręcznie?</h2>
          <p>Opisz mi to w&nbsp;15 minut. Powiem, czy da się to zautomatyzować i&nbsp;co by to zmieniło.</p>
          <a class="btn" href={contact}>Umów 15 minut</a>
          <p class="more"><a href="/pl/uslugi/aplikacje-i-systemy/">Jak pracuję przy aplikacjach i systemach</a></p>
        </div>
      </section>
    </main>
    <BrandFooter locale="pl" inset />
  </div>
</VariantLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const dwg = document.querySelector<SVGSVGElement>('.dwg');
    if (!dwg) return;
    // Jedyny ruch na stronie: rysunek kreśli się raz, gdy wjeżdża w ekran.
    const q = (sel: string) => dwg.querySelectorAll(sel);
    gsap.set(q('.ln-body > *, .ln-dim > *, .ln-note > *'), { strokeDasharray: 1, strokeDashoffset: 1 });
    gsap.set(q('.tx text'), { opacity: 0 });
    gsap.timeline({ scrollTrigger: { trigger: dwg, start: 'top 85%', once: true } })
      .to(q('.ln-body > *'), { strokeDashoffset: 0, duration: 1, stagger: .1, ease: 'power2.inOut' })
      .to(q('.ln-dim > *'), { strokeDashoffset: 0, duration: .6, stagger: .06 }, '-=.4')
      .to(q('.tx text'), { opacity: 1, duration: .3, stagger: .03 }, '-=.3')
      .to(q('.ln-note > *'), { strokeDashoffset: 0, duration: .4 }, '-=.2');
  });
  window.addEventListener('pagehide', () => mm.revert(), { once: true });
</script>

<style>
  .case {
    --ivory: #f8f9f2; --ink: #111; --dim: #6b6759; --blue: #0522ff; --brand: #ffcc33;
    --cad-dim: #1c9a3c; --cad-note: #e06a1b;
    --gutter: clamp(20px, 5vw, 96px); --focus: var(--blue);
    font-family: 'GeneralSansV', sans-serif; background: var(--ivory); color: var(--ink); overflow-x: clip;
  }
  @font-face { font-family: 'NohemiV'; src: url('/fonts/Nohemi-Variable.woff2') format('woff2'); font-weight: 100 900; font-display: swap; }
  @font-face { font-family: 'GeneralSansV'; src: url('/fonts/GeneralSans-Variable.woff2') format('woff2'); font-weight: 200 700; font-display: swap; }
  .case :is(h1,h2,p,figure,dl,dd,ul,blockquote) { margin: 0; }
  .case :is(h1,h2) { text-wrap: balance; }
  .case :is(a,button):focus-visible { outline: 3px solid var(--focus); outline-offset: 4px; }
  .case ::selection { background: var(--brand); }
  .skip { position: fixed; top: 12px; left: 12px; z-index: 150; padding: 12px 20px; background: var(--brand); color: var(--ink); transform: translateY(-200%); }
  .skip:focus { transform: none; }
  .nav { height: 104px; box-sizing: border-box; padding: 24px var(--gutter); display: flex; align-items: center; justify-content: space-between; position: relative; z-index: 90; }
  .mark video { width: clamp(155px, 18vw, 220px); height: auto; display: block; filter: drop-shadow(0 5px 10px rgb(0 0 0 / .26)); }

  /* Jedna kolumna. Cztery rozmiary pisma: tytuł, śródtytuł, tekst, podpis. */
  .col { box-sizing: content-box; max-width: 660px; margin-inline: auto; padding-inline: 20px; }
  .head { padding-top: clamp(40px, 10vh, 112px); }
  .kicker { font-size: 16px; color: var(--dim); margin-bottom: 20px !important; }
  h1 { font-family: 'NohemiV', sans-serif; font-weight: 520; font-size: clamp(36px, 5vw, 60px); line-height: 1.08; letter-spacing: -.025em; }
  .lead { margin-top: 28px !important; font-size: 21px; line-height: 1.6; }
  .facts { margin-top: 36px !important; border-top: 1px solid rgb(0 0 0 / .14); }
  .facts div { display: flex; gap: 16px; padding: 12px 0; border-bottom: 1px solid rgb(0 0 0 / .14); font-size: 16px; }
  .facts dt { width: 120px; flex: none; color: var(--dim); }

  .case .wide { max-width: 1000px; margin: clamp(56px, 9vh, 96px) auto 0; padding-inline: 20px; box-sizing: content-box; }
  .pair { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 16px; }
  .pair figcaption { grid-column: 1 / -1; }
  .pane { border-radius: 6px; overflow: hidden; background: #fff; border: 1px solid rgb(0 0 0 / .1); display: grid; place-items: center; }
  .pane img { width: 100%; height: auto; display: block; }
  .sheet { padding: 20px; }
  .dwg { width: 100%; height: auto; }
  .dwg :is(rect, circle, path) { fill: none; vector-effect: non-scaling-stroke; }
  .ln-body > * { stroke: #111; stroke-width: 1.5; }
  .ln-dim > * { stroke: var(--cad-dim); stroke-width: 1; }
  .ln-note > * { stroke: #111; stroke-width: 1; }
  .dwg text { font-family: 'GeneralSansV', sans-serif; font-size: 52px; }
  .t-dim { fill: var(--cad-dim); } .t-body { fill: #111; font-weight: 560; } .t-note { fill: var(--cad-note); }
  .dwg .t-sm { font-size: 40px; }
  figcaption { margin-top: 12px; font-size: 16px; color: var(--dim); }

  .body { padding-top: 24px; font-size: 19px; line-height: 1.7; }
  .body h2 { font-family: 'NohemiV', sans-serif; font-weight: 540; font-size: 28px; line-height: 1.2; letter-spacing: -.015em; margin-top: 64px !important; }
  .body h2 + p, .body h2 + ul { margin-top: 16px !important; }
  .body p + p, .body ul + p, .body p + ul { margin-top: 20px !important; }
  .body ul { padding-left: 1.2em; }
  .body li + li { margin-top: 8px; }
  .body a { color: var(--ink); text-decoration-color: var(--blue); text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .soft { padding: 16px 20px; background: #fff; border-radius: 6px; }
  .quote { margin-top: 64px !important; padding-left: 24px; border-left: 3px solid var(--brand); }
  .quote p { font-size: 24px; line-height: 1.5; }
  .quote figcaption { font-size: 16px; }
  .quote-todo { margin-top: 64px; padding: 16px; border: 1px dashed #c70404; color: #c70404; font-size: 16px; }

  .end { margin-top: 120px; padding: 96px 0; background: var(--ink); color: var(--ivory); }
  .end h2 { font-family: 'NohemiV', sans-serif; font-weight: 520; font-size: clamp(30px, 4vw, 44px); line-height: 1.12; letter-spacing: -.02em; }
  .end p { margin-top: 20px !important; font-size: 19px; line-height: 1.6; color: rgb(248 249 242 / .75); }
  .btn { display: inline-block; margin-top: 32px; padding: 16px 32px; border-radius: 999px; background: var(--brand); color: var(--ink); text-decoration: none; font-size: 16px; font-weight: 600; }
  .btn:hover { background: var(--ivory); }
  .end :focus-visible { outline-color: var(--brand); }
  .end .more a { color: var(--ivory); text-underline-offset: 4px; font-size: 16px; }

  @media (max-width: 700px) {
    .lead { font-size: 19px; }
    .body { font-size: 18px; }
    .body h2 { font-size: 24px; margin-top: 48px !important; }
    .pair { grid-template-columns: 1fr; }
    .facts div { flex-direction: column; gap: 2px; }
    .dwg text { font-size: 84px; }
    .dwg .t-body { font-size: 68px; }
    .dwg .t-note, .dwg .t-sm, .ln-note { display: none; }
    .end { padding: 72px 0; }
  }
</style>

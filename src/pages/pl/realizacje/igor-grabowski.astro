---
// Case study Igora Grabowskiego, wersja 2 (30.09.2026), kierunek C „Jego strona na jego kolorze”.
// Referencja wybrana przez Kacpra: Locomotive × The Drake Hotel (strona klienta w dużej skali na polu
// w kolorze marki, dookoła własny materiał klienta). U Igora: nagrania jego strony na jego niebieskim,
// dookoła jego posty z Instagrama, które wysuwają się zza ekranu tak, jak prace spod słów na jego stronie.
// Sekcje idą rytmem jego marki: papier, niebieski, atrament. v1 „Karta obiektu” (6b89028) odrzucona.
// v3 (01.10.2026, uwagi Kacpra): nav w kolorze sceny, bez sekcji o językach, liczby 13/11/0 przy swoich sekcjach,
// w tekście imię Igora zamiast „jego”, newsletter pokazany jako okienko na żywej stronie.
// Tablica kierunków: docs/case-studies/igor/runda-2/TABLICA.html. Treść: igor/COPY.md, fakty: FAKTY.md.
import VariantLayout from '../../../layouts/VariantLayout.astro';
import SiteMenu from '../../../components/SiteMenu.astro';
import BrandFooter from '../../../components/BrandFooter.astro';

const contact = '/pl/kontakt/?service=' + encodeURIComponent('Strona internetowa') + '#ctForm';
// Opinia pojawia się dopiero po akceptacji Igora (docs/case-studies/OPINIE-ROZMOWA.md).
const quote: { text: string; name: string; role: string } | null = null;
const P = (t: string) => t.replace(/(^|[\s(„])([wziouaWZIOUA]) /g, '$1$2&nbsp;');
const url = 'https://mioduszewsky.com/pl/realizacje/igor-grabowski/';
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Article', headline: 'Strona kolekcji, na której prace wysuwają się spod słów', inLanguage: 'pl',
      about: 'Strona kolekcji sztuki cyfrowej i współczesnej Igora Grabowskiego, igorgrabowski.com',
      author: { '@type': 'Person', name: 'Kacper Mioduszewski', url: 'https://mioduszewsky.com/pl/' },
      image: 'https://mioduszewsky.com/case/igor/strona-glowna.webp',
      mainEntityOfPage: url },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'mioduszewsky', item: 'https://mioduszewsky.com/pl/' },
      { '@type': 'ListItem', position: 2, name: 'Igor Grabowski', item: url } ] },
  ],
};

const posts = [
  { src: 'ig-darmowe-targi', alt: 'Post Igora z Instagrama: Darmowe targi sztuki? To jest bardzo uczciwa cena.' },
  { src: 'ig-nie-rozumiesz', alt: 'Post Igora z Instagrama: sala muzeum i napis Nie rozumiesz sztuki współczesnej? To nie znaczy, że jesteś głupi.' },
  { src: 'ig-pierwsza-reakcja', alt: 'Post Igora z Instagrama: Pierwsza reakcja nie musi być mądra.' },
];
---
<VariantLayout
  title="Strona kolekcji sztuki dla Igora Grabowskiego: prace wysuwają się spod słów · mioduszewsky"
  description="Igor Grabowski kolekcjonuje sztukę cyfrową i współczesną. Zrobiłem stronę tej kolekcji: pięć słów, pod nimi prace, 13 prac, 12 nazwisk, polski i angielski, domena igorgrabowski.com."
  bg="#1533f5" fg="#000000" switcher={false} robots="index, follow, max-image-preview:large" locale="pl" alternatePath="/">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <div class="case">
    <a class="skip" href="#main">Przejdź do treści</a>
    <header class="nav">
      <a class="mark" href="/pl/" aria-label="mioduszewsky. Strona główna.">
        <video autoplay loop muted playsinline preload="metadata" aria-hidden="true" poster="/logo3d/logo-nav-poster.webp">
          <source src="/logo3d/logo-nav.mp4" type="video/mp4;codecs=hvc1" />
          <source src="/logo3d/logo-nav.webm" type="video/webm" />
        </video>
      </a>
      <SiteMenu locale="pl" alternatePath="/" />
    </header>

    <main id="main">
      <article>
        <header class="stage">
          <div class="wrap">
            <p class="kicker">Realizacja dla Igora Grabowskiego</p>
            <h1>Strona kolekcji, na której prace wysuwają się spod słów.</h1>
            <p class="lead" set:html={P('Igor Grabowski kolekcjonuje sztukę cyfrową i współczesną, od pierwszego zakupu w galerii w 2020 roku. Zrobiłem stronę tej kolekcji: pięć słów na jednym ekranie, a pod każdym prace, które wysuwają się po najechaniu kursorem. Strona działa po polsku i po angielsku, na domenie igorgrabowski.com.')} />
          </div>

          <div class="wrap set">
            <div class="screen">
              <video class="vid" autoplay loop muted playsinline preload="metadata" width="1280" height="800" poster="/case/igor/strona-glowna.webp" aria-label="Nagranie strony głównej igorgrabowski.com: kursor przesuwa się po słowach Prace i O kolekcji, spod każdego wysuwają się dwie prace z kolekcji.">
                <source src="/case/igor/strona-glowna.webm" type="video/webm" />
                <source src="/case/igor/strona-glowna.mp4" type="video/mp4" />
              </video>
            </div>
            <div class="phone">
              <video class="vid" autoplay loop muted playsinline preload="metadata" width="390" height="660" poster="/case/igor/telefon.webp" aria-label="Nagranie strony głównej na telefonie: prace wysuwają się same przy kolejnych słowach.">
                <source src="/case/igor/telefon.webm" type="video/webm" />
                <source src="/case/igor/telefon.mp4" type="video/mp4" />
              </video>
            </div>
            {posts.map((p, i) => (
              <img class={`post post-${i + 1}`} src={`/case/igor/${p.src}.webp`} width="720" height="900" alt={p.alt} loading="eager" />
            ))}
          </div>

          <div class="wrap live"><a href="https://www.igorgrabowski.com/" target="_blank" rel="noopener">Zobacz stronę na żywo<span aria-hidden="true"> ↗</span></a></div>
        </header>

        <section class="paper">
          <div class="wrap duo">
            <div>
              <h2>Kolekcja Igora, prace dwunastu artystów i&nbsp;artystek.</h2>
              <div class="txt">
                <p set:html={P('Igor nie jest artystą. Na stronie wiszą prace Refika Anadola, Damiena Hirsta, Ivony Tau i dziewięciu innych osób. Strona ma pokazać kolekcję i człowieka, który ją zbiera, a nazwiska artystów muszą się zgadzać co do litery.')} />
                <p set:html={P('Cała strona główna to jeden ruch: najeżdżasz na słowo, spod niego wysuwają się dwie prace. Zrobiłem dwie różne wersje strony. Na domenie stoi ta, w której ten ruch prowadzi całą stronę.')} />
                <p set:html={P('Igor mówi o sztuce na Instagramie prostym językiem. Spod „O kolekcji” wysuwają się posty z tego Instagrama, więc strona mówi głosem Igora.')} />
              </div>
            </div>
            <figure class="voice">
              <img src="/case/igor/ig-oprowadzanie.webp" width="720" height="900" loading="lazy" alt="Post Igora z Instagrama na niebieskim tle: Jeśli chcesz sobie pomóc, idź na oprowadzanie. Zapytaj edukatora." />
              <img src="/case/igor/ig-muzea.webp" width="720" height="900" loading="lazy" alt="Post Igora z Instagrama na niebieskim tle: Z mojego doświadczenia, na początku przygody ze sztuką najlepiej chodzić do dużych muzeów na oprowadzania." />
              <figcaption>Posty Igora z&nbsp;Instagrama</figcaption>
            </figure>
          </div>
        </section>

        <section class="paper">
          <div class="wrap">
            <div class="numhead notehead">
              <figure class="note">
                <div class="note-screen" role="img" aria-label="Odtworzona notatka Igora w aplikacji Notatki na iPhonie: tytuł Refik Anadol, pod nim praca Unsupervised (NFT) ze zdjęciem, Neo Organic Ivony Tau z linkiem do objkt.com i City Life 3.">
                  <div class="note-bar" aria-hidden="true"><span class="note-back">‹ Notatki</span><span class="note-shared">Udostępniona</span></div>
                  <div class="note-body" aria-hidden="true">
                    <p class="note-h">Refik Anadol</p>
                    <p class="note-i">Unsupervised - Data Universe - MoMA #1522</p>
                    <p>(NFT)</p>
                    <img src="/case/igor/notatka-refik-anadol.webp" width="480" height="481" loading="lazy" alt="" />
                    <p>Neo Organic (NFT) by Ivona Tau</p>
                    <p class="note-a">https://objkt.com/tokens/KT1TGYitS9YhQWMSuthQpUXAUazz3itWiyaN/6</p>
                    <img src="/case/igor/notatka-neo-organic.webp" width="480" height="479" loading="lazy" alt="" />
                    <p>City Life 3 by Ana Maria Caballero + Ivona Tau (NFT)</p>
                    <img src="/case/igor/notatka-city-life-3.webp" width="480" height="480" loading="lazy" alt="" />
                  </div>
                </div>
                <figcaption>Notatka Igora, pierwsze pozycje z&nbsp;13</figcaption>
              </figure>
              <div>
                <h2>Lista prac przyszła w&nbsp;Notatkach z&nbsp;iPhone’a.</h2>
                <div class="txt">
                  <p set:html={P('Igor wpisał kolekcję do Notatek na iPhonie: tytuły, nazwiska, linki i zdjęcia prac. Potem udostępnił mi notatkę. Do przygotowania treści wystarczyła aplikacja, której Igor używa na co dzień.')} />
                  <p set:html={P('Z notatki zrobiłem galerię w tej samej kolejności, z tytułami i technikami przepisanymi słowo w słowo. Etykieta NFT stoi tylko tam, gdzie Igor ją wpisał. Poprawki przyszły równie prosto, w jednym dokumencie.')} />
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="blue">
          <div class="wrap">
            <h2>Każda praca w&nbsp;całości.</h2>
            <div class="txt">
              <p set:html={P('Każda praca jest pokazana w całości, bez przycinania do jednego formatu. Równy rytm galerii daje stała wysokość kadru. Przy czterech pracach wideo jest podpis, że to kadr z wideo, tak jak oznaczył je Igor.')} />
            </div>
          </div>
          <div class="wrap set set-gal">
            <div class="screen">
              <video class="vid" autoplay loop muted playsinline preload="none" width="1120" height="700" poster="/case/igor/galeria.webp" aria-label="Nagranie galerii igorgrabowski.com: przewijanie przez prace Refika Anadola, Ivony Tau, Any Marii Caballero, Leandera Herzoga i Williama Mapana, każda w całości z podpisem.">
                <source src="/case/igor/galeria.webm" type="video/webm" />
                <source src="/case/igor/galeria.mp4" type="video/mp4" />
              </video>
            </div>
            <div class="phone">
              <img class="vid" src="/case/igor/obrazy-telefon.webp" width="780" height="1320" loading="lazy" alt="Galeria na telefonie: nagłówek Prace z mojej kolekcji, filtr Wszystkie, NFT, Fizyczne i pierwsza praca w całości." />
            </div>
          </div>
          <div class="wrap numhead numhead-gal">
            <p class="big"><strong>11</strong><span>prac cyfrowych z&nbsp;linkiem do oryginału</span></p>
            <div>
              <h2>Z&nbsp;galerii prosto do oryginału.</h2>
              <div class="txt">
                <p set:html={P('Każda z 11 prac cyfrowych ma link do swojej strony na verse.works, OpenSea, objkt.com albo IYK. Dwie są fizyczne: grafika Tadeusza Dominika i print Rafała Dominika i Marii Mencwel. Przy każdym nazwisku są prace tej osoby z kolekcji i link do Instagrama, a klik w nazwisko otwiera jej galerię.')} />
              </div>
            </div>
          </div>
        </section>

        <section class="ink">
          <div class="wrap">
            <h2>Newsletter w&nbsp;barwach Igora.</h2>
            <div class="txt">
              <p set:html={P('Igor ma newsletter w MailerLite. Gotowy kod wyglądał jak każdy inny formularz MailerLite, więc zrobiłem własny, w kolorach marki Igora, który zapisuje prosto na konto w MailerLite. Wysuwa się z rogu raz, po przewinięciu ponad jednej trzeciej strony albo po 25 sekundach. Link do zapisu jest w każdej stopce i w menu.')} />
            </div>
          </div>
          <div class="wrap nl">
            <div class="screen">
              <picture>
                <source media="(max-width: 700px)" srcset="/case/igor/newsletter-okno-telefon.webp" width="640" height="1090" />
                <img class="vid" src="/case/igor/newsletter-okno.webp" width="1600" height="1000" loading="lazy" alt="Galeria igorgrabowski.com z wysuniętym w prawym dolnym rogu okienkiem newslettera: niebieska karta, nagłówek Newsletter o sztuce, pola imię i e-mail, przycisk Zapisz mnie." />
              </picture>
            </div>
          </div>
        </section>

        <section class="paper">
          <div class="wrap numhead">
            <p class="big"><strong>4</strong><span>dni od notatki do strony na igorgrabowski.com</span></p>
            <div>
              <h2>Notatka w&nbsp;piątek, kolekcja na domenie we&nbsp;wtorek.</h2>
              <div class="txt">
                <p set:html={P('Igor udostępnił notatkę w piątek wieczorem. We wtorek kolekcja stała już na domenie igorgrabowski.com, z HTTPS i z pocztą działającą na tej samej domenie. Dzień później weszła runda poprawek Igora.')} />
              </div>
            </div>
          </div>
        </section>

        {quote ? (
          <figure class="wrap quote">
            <blockquote><p>{quote.text}</p></blockquote>
            <figcaption>{quote.name}, {quote.role}</figcaption>
          </figure>
        ) : import.meta.env.DEV && (
          <aside class="wrap quote-todo" aria-hidden="true">Tu stanie cytat Igora po rozmowie. Na produkcji blok się nie pokaże, dopóki cytat nie jest zaakceptowany.</aside>
        )}
      </article>

      <section class="end" aria-labelledby="end-h">
        <div class="wrap end-in">
          <h2 id="end-h">Pokazujesz kolekcję albo swoją pracę tylko na Instagramie?</h2>
          <div>
            <p>Opisz mi ją w&nbsp;15 minut. Powiem, jak mogłaby wyglądać jej strona i&nbsp;co trzeba przygotować.</p>
            <a class="btn" href={contact}>Umów 15 minut</a>
            <p class="more"><a href="/pl/realizacje/glassstone/">Druga realizacja: szkic z&nbsp;pomiaru zamienia się w&nbsp;rysunek na produkcję</a></p>
          </div>
        </div>
      </section>
    </main>
    <BrandFooter locale="pl" inset />
  </div>
</VariantLayout>

<script>
  import { gsap } from 'gsap';
  // Pętle nagrań grają tylko w ekranie i tylko bez prefers-reduced-motion; inaczej zostaje plakat.
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const vids = document.querySelectorAll<HTMLVideoElement>('.case video.vid');
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    const v = e.target as HTMLVideoElement;
    if (e.isIntersecting && !still.matches) v.play().catch(() => {}); else v.pause();
  }), { threshold: .2 });
  vids.forEach((v) => { if (still.matches) { v.removeAttribute('autoplay'); v.pause(); } io.observe(v); });
  // Jeden ruch: posty Igora wysuwają się zza ekranu jego strony, tak jak prace spod słów na jego stronie.
  const mm = gsap.matchMedia();
  mm.add('(min-width: 901px) and (prefers-reduced-motion: no-preference)', () => {
    gsap.from('.stage .post', { x: (i) => [260, 200, -260][i], y: (i) => [120, -80, 60][i], scale: .7, opacity: 0, duration: 1.1, stagger: .14, delay: .35, ease: 'expo.out' });
  });
  window.addEventListener('pagehide', () => mm.revert(), { once: true });
</script>

<style>
  .case {
    --ivory: #f8f9f2; --ink: #111; --dim: #5f5b4e; --rule: rgb(17 17 17 / .16);
    --igor: #1533f5; --cyan: #38c8f5; --atrament: #0a0d28; --brand: #ffcc33;
    --gutter: clamp(20px, 5vw, 96px); --focus: var(--igor);
    font-family: 'GeneralSansV', sans-serif; background: var(--ivory); color: var(--ink); overflow-x: clip;
  }
  @font-face { font-family: 'NohemiV'; src: url('/fonts/Nohemi-Variable.woff2') format('woff2'); font-weight: 100 900; font-display: swap; }
  @font-face { font-family: 'GeneralSansV'; src: url('/fonts/GeneralSans-Variable.woff2') format('woff2'); font-weight: 200 700; font-display: swap; }
  .case :is(h1,h2,p,figure,ol,blockquote) { margin: 0; }
  .case ol { padding: 0; list-style: none; }
  .case :is(h1,h2) { text-wrap: balance; }
  .case p { text-wrap: pretty; }
  .case :is(a,button):focus-visible { outline: 3px solid var(--focus); outline-offset: 4px; }
  .case ::selection { background: var(--brand); color: var(--ink); }
  .skip { position: fixed; top: 12px; left: 12px; z-index: 150; padding: 12px 20px; background: var(--brand); color: var(--ink); transform: translateY(-200%); }
  .skip:focus { transform: none; }
  .nav { background: var(--igor); height: 104px; box-sizing: border-box; padding: 24px var(--gutter); display: flex; align-items: center; justify-content: space-between; position: relative; z-index: 90; }
  /* Nav na tej stronie w kolorze sceny: biała pigułka menu i biały przełącznik języka. */
  .case .nav :global(.menu-toggle) { background: #fff; border-color: #fff; }
  .case .nav :global(.language-switch) { color: #fff; }
  .case .nav :global(.language-switch:focus-visible), .case .nav :global(.menu-toggle:focus-visible) { outline-color: #fff; }
  .mark video { width: clamp(155px, 18vw, 220px); height: auto; display: block; filter: drop-shadow(0 5px 10px rgb(0 0 0 / .26)); }
  .wrap { max-width: 1320px; margin-inline: auto; padding-inline: var(--gutter); box-sizing: border-box; }

  h2 { font-family: 'NohemiV', sans-serif; font-weight: 600; font-size: clamp(32px, 4.4vw, 64px); line-height: 1.02; letter-spacing: -.03em; max-width: 14em; }
  .h2-2 { margin-top: clamp(56px, 7vw, 96px) !important; }
  .txt { margin-top: 24px; max-width: 34em; font-size: 19px; line-height: 1.65; }
  .txt p + p { margin-top: 18px !important; }

  /* Scena: pełny niebieski Igora, jego strona w dużej skali, dookoła jego posty. */
  .stage { background: var(--igor); color: #fff; padding: clamp(32px, 6vw, 80px) 0 clamp(48px, 6vw, 80px); overflow: clip; }
  .stage ::selection { background: #fff; color: var(--igor); }
  .stage .kicker { font-size: 16px; color: rgb(255 255 255 / .75); }
  h1 { margin-top: 20px !important; font-family: 'NohemiV', sans-serif; font-weight: 600; font-size: clamp(38px, 7.4vw, 116px); line-height: .98; letter-spacing: -.04em; max-width: 12em; }
  .lead { margin-top: clamp(24px, 3vw, 40px) !important; max-width: 36em; font-size: 21px; line-height: 1.6; color: rgb(255 255 255 / .88); }

  .set { position: relative; margin-top: clamp(56px, 7vw, 104px); display: grid; grid-template-columns: minmax(0, 1fr); }
  .screen { position: relative; z-index: 2; border-radius: 12px; overflow: hidden; background: #fff; box-shadow: 0 40px 80px -30px rgb(5 10 60 / .55), 0 0 0 1px rgb(255 255 255 / .25); }
  .vid { display: block; width: 100%; height: auto; }
  .stage .screen { width: 78%; margin-inline: auto; }
  .phone { position: absolute; z-index: 3; right: 5%; bottom: -6%; width: 17%; border-radius: 22px; overflow: hidden; background: #fff; box-shadow: 0 30px 60px -20px rgb(5 10 60 / .6), 0 0 0 6px #fff; }
  .post { position: absolute; z-index: 1; width: 17%; height: auto; box-shadow: 0 24px 50px -18px rgb(5 10 60 / .55); border-radius: 4px; }
  /* Posty wychodzą zza ekranu (z-index niżej), nie zasłaniają jego strony. */
  .post-1 { left: calc(var(--gutter) * .5); top: -4%; rotate: -7deg; }
  .post-2 { left: calc(var(--gutter) * .7); bottom: -10%; rotate: 5deg; }
  .post-3 { right: calc(var(--gutter) * .5); top: 4%; rotate: 8deg; }

  .live { margin-top: clamp(64px, 8vw, 104px); }
  .live a { color: #fff; font-size: 18px; text-decoration-color: var(--cyan); text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .stage :focus-visible { outline-color: #fff; }

  /* Rytm marki Igora: papier, niebieski, atrament. */
  .paper { padding: clamp(80px, 10vw, 144px) 0 0; }
  .paper + .blue, .paper + .ink { margin-top: clamp(80px, 10vw, 144px); }
  .blue { background: var(--igor); color: #fff; padding: clamp(80px, 10vw, 144px) 0; }
  .ink { background: var(--atrament); color: #fff; padding: clamp(80px, 10vw, 144px) 0; }
  .blue .txt, .ink .txt { color: rgb(255 255 255 / .86); }
  .blue :focus-visible, .ink :focus-visible { outline-color: #fff; }

  .duo { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(40px, 6vw, 112px); align-items: center; }
  .voice { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .voice img { width: 100%; height: auto; display: block; box-shadow: 0 24px 50px -24px rgb(17 17 17 / .45); border-radius: 4px; }
  .voice img:first-child { rotate: -3deg; }
  .voice img:nth-child(2) { rotate: 4deg; margin-top: 48px; }
  .voice figcaption { grid-column: 1 / -1; margin-top: 12px; font-size: 15px; color: var(--dim); }


  .set-gal { margin-top: clamp(48px, 6vw, 80px); }
  .set-gal .screen { width: 84%; }
  .set-gal .phone { right: 0; bottom: -8%; width: 20%; }

  /* Duże liczby stoją przy sekcjach, które je wyjaśniają. */
  .numhead { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 6vw, 112px); align-items: start; }
  .big strong { display: block; font-family: 'NohemiV', sans-serif; font-weight: 600; font-size: clamp(120px, 19vw, 300px); line-height: .8; letter-spacing: -.06em; color: var(--igor); }

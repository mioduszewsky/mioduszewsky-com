---
// Case study Igora Grabowskiego, wersja 1 (30.09.2026), kierunek „Karta obiektu”.
// Strona kolekcji jest pokazana jak obiekt w muzeum: na górze karta obiektu (jak Tate i Whitney),
// każdy eksponat wisi w passe-partout na ścianie i ma obok etykietę z numerem „Kat.”, a spis prac
// jest listą z katalogu wystawy w kolejności z notatki Igora.
// Opis kierunku i referencje: docs/case-studies/igor/RUNDA-1.md (Drive). Treść: igor/COPY.md, fakty: FAKTY.md.
// Wspólna z GlassStone jest tylko rama marki: nav, kroje, stopka, przycisk.
import VariantLayout from '../../../layouts/VariantLayout.astro';
import SiteMenu from '../../../components/SiteMenu.astro';
import BrandFooter from '../../../components/BrandFooter.astro';

const contact = '/pl/kontakt/?service=' + encodeURIComponent('Strona internetowa') + '#ctForm';
// Opinia pojawia się dopiero po akceptacji Igora (docs/case-studies/OPINIE-ROZMOWA.md).
const quote: { text: string; name: string; role: string } | null = null;
const P = (t: string) => t.replace(/(^|[\s(„])([wziouaWZIOUA]) /g, '$1$2&nbsp;');
const url = 'https://mioduszewsky.com/pl/realizacje/igor-grabowski/';
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Article', headline: 'Strona kolekcji, na której prace wysuwają się spod słów', inLanguage: 'pl',
      about: 'Strona kolekcji sztuki cyfrowej i współczesnej Igora Grabowskiego, igorgrabowski.com',
      author: { '@type': 'Person', name: 'Kacper Mioduszewski', url: 'https://mioduszewsky.com/pl/' },
      image: 'https://mioduszewsky.com/case/igor/strona-glowna.webp',
      mainEntityOfPage: url },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'mioduszewsky', item: 'https://mioduszewsky.com/pl/' },
      { '@type': 'ListItem', position: 2, name: 'Igor Grabowski', item: url } ] },
  ],
};

// Spis prac 1:1 z żywej strony (~/aigor-reveal/src/content.tsx, PL), w kolejności z notatki Igora.
const works = [
  { a: 'Refik Anadol', t: 'Unsupervised - Data Universe - MoMA #1522', m: 'NFT' },
  { a: 'Ivona Tau', t: 'Neo-Organic Matter III', m: 'NFT' },
  { a: 'Ana Maria Caballero · Ivona Tau', t: 'City Life 3', m: 'NFT' },
  { a: 'Sasha Stiles', t: 'Words beyond words #228', m: '' },
  { a: 'Leander Herzog', t: 'Infinite Garden 2900 Flowers #12010', m: 'NFT' },
  { a: 'Damien Hirst', t: 'The Currency „Now come to finish” #371', m: 'NFT · seria Currency' },
  { a: 'William Mapan', t: 'Etudes #207', m: '' },
  { a: 'William Mapan', t: 'Superpositions #230', m: 'NFT' },
  { a: 'Tadeusz Dominik', t: 'Pustynia Piaskowa II', m: '2009 · Grafika komputerowa · 61 × 78 cm' },
  { a: 'ClownVamp', t: 'Puppies #108', m: 'NFT' },
  { a: 'Tabor Robak', t: 'Human Resources #6874', m: 'NFT · seria Human Resources' },
  { a: 'Rafał Dominik', t: 'Andrzej', m: 'NFT' },
  { a: 'Rafał Dominik · Maria Mencwel', t: 'Kompozycja', m: 'Fine Art print 7/20' },
];
---
<VariantLayout
  title="Strona kolekcji sztuki dla Igora Grabowskiego: prace wysuwają się spod słów · mioduszewsky"
  description="Igor Grabowski kolekcjonuje sztukę cyfrową i współczesną. Zrobiłem mu stronę kolekcji: pięć słów, pod nimi prace, 13 prac, 12 nazwisk, dwa języki, jego domena."
  bg="#f8f9f2" fg="#000000" switcher={false} robots="index, follow, max-image-preview:large" locale="pl" alternatePath="/">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <div class="case">
    <a class="skip" href="#main">Przejdź do treści</a>
    <header class="nav">
      <a class="mark" href="/pl/" aria-label="mioduszewsky. Strona główna.">
        <video autoplay loop muted playsinline preload="metadata" aria-hidden="true" poster="/logo3d/logo-nav-poster.webp">
          <source src="/logo3d/logo-nav.mp4" type="video/mp4;codecs=hvc1" />
          <source src="/logo3d/logo-nav.webm" type="video/webm" />
        </video>
      </a>
      <SiteMenu locale="pl" alternatePath="/" />
    </header>

    <main id="main">
      <article>
        <header class="wrap hero">
          <div class="hero-t">
            <p class="kicker">Realizacja dla Igora Grabowskiego</p>
            <h1>Strona kolekcji, na której prace wysuwają się spod słów.</h1>
            <p class="lead" set:html={P('Igor Grabowski kolekcjonuje sztukę cyfrową i współczesną, od pierwszego zakupu w galerii w 2020 roku. Zrobiłem mu stronę kolekcji: pięć słów na jednym ekranie, a pod każdym prace, które wysuwają się po najechaniu kursorem. 13 prac, 12 nazwisk, po polsku i po angielsku, na jego domenie.')} />
          </div>
          <aside class="record" aria-label="Karta obiektu">
            <p class="rec-name">igorgrabowski.com</p>
            <p class="rec-title">Strona kolekcji, 2026</p>
            <dl>
              <div><dt>Właściciel</dt><dd>Igor Grabowski, kolekcjoner, Warszawa</dd></div>
              <div><dt>W&nbsp;kolekcji</dt><dd>13 prac, 12 nazwisk</dd></div>
              <div><dt>Języki</dt><dd>polski, angielski</dd></div>
              <div><dt>Czas</dt><dd>czerwiec i&nbsp;lipiec 2026</dd></div>
            </dl>
            <a class="rec-link" href="https://www.igorgrabowski.com/" target="_blank" rel="noopener">Zobacz stronę na żywo<span aria-hidden="true"> ↗</span></a>
          </aside>
        </header>

        <figure class="wall wall-first">
          <div class="wrap hang hang-1">
            <div class="mat mat-desk">
              <video class="shot" autoplay loop muted playsinline preload="metadata" width="1280" height="800" poster="/case/igor/strona-glowna.webp" aria-label="Nagranie strony głównej igorgrabowski.com: kursor przesuwa się po słowach Prace i O kolekcji, spod każdego wysuwają się dwie prace z kolekcji.">
                <source src="/case/igor/strona-glowna.webm" type="video/webm" />
                <source src="/case/igor/strona-glowna.mp4" type="video/mp4" />
              </video>
            </div>
            <div class="mat mat-phone">
              <video class="shot" autoplay loop muted playsinline preload="metadata" width="390" height="660" poster="/case/igor/telefon.webp" aria-label="Nagranie strony głównej na telefonie: prace wysuwają się same przy kolejnych słowach.">
                <source src="/case/igor/telefon.webm" type="video/webm" />
                <source src="/case/igor/telefon.mp4" type="video/mp4" />
              </video>
            </div>
            <figcaption class="label">
              <span class="kat">Kat. 1</span>
              <strong>Strona główna</strong>
              <span set:html={P('Na komputerze prace wysuwają się pod kursorem, na telefonie same, co trzy sekundy.')} />
            </figcaption>
          </div>
        </figure>

        <section class="wrap sec">
          <h2>Kolekcjoner pokazuje cudze prace.</h2>
          <div class="txt">
            <p set:html={P('Igor nie jest artystą. Na jego stronie wiszą prace Refika Anadola, Damiena Hirsta, Ivony Tau i dziewięciu innych osób. Strona ma pokazać kolekcję i człowieka, który ją zbiera, a nazwiska artystów muszą się zgadzać co do litery.')} />
            <p set:html={P('Cała strona główna to jeden ruch: najeżdżasz na słowo, spod niego wysuwają się dwie prace. Zrobiłem dwie różne wersje strony. Na domenie stoi ta, w której ten ruch prowadzi całą stronę.')} />
          </div>
        </section>

        <section class="wrap sec">
          <h2>Kolejność jest jego.</h2>
          <div class="txt">
            <p set:html={P('Igor przysłał listę prac w notatce. Na stronie jest dokładnie w tej kolejności, z tytułami i technikami przepisanymi słowo w słowo. Etykieta NFT stoi tylko tam, gdzie on ją napisał.')} />
          </div>
        </section>

        <figure class="wrap list-fig">
          <ol class="checklist">
            {works.map((w, i) => (
              <li>
                <span class="no">{i + 1}</span>
                <span class="who">{w.a}</span>
                <span class="what"><em>{w.t}</em>{w.m && <span class="med">{w.m}</span>}</span>
              </li>
            ))}
          </ol>
          <figcaption class="label label-inline">
            <span class="kat">Kat. 2</span>
            <strong>Spis prac</strong>
            <span set:html={P('W kolejności z notatki Igora. Tytuły, nazwiska i techniki bez zmian.')} />
          </figcaption>
        </figure>

        <section class="wrap sec">
          <h2>Każda praca w&nbsp;całości.</h2>
          <div class="txt">
            <p set:html={P('Każda praca jest pokazana w całości, bez przycinania do jednego formatu. Równy rytm galerii daje stała wysokość kadru. Przy czterech pracach wideo jest podpis, że to kadr z wideo, tak jak oznaczył je Igor.')} />
          </div>
        </section>

        <figure class="wall">
          <div class="wrap hang hang-3">
            <div class="mat mat-desk">
              <img class="shot" src="/case/igor/obrazy.webp" width="1600" height="1000" loading="lazy" alt="Galeria igorgrabowski.com: nagłówek Prace z mojej kolekcji, filtr Wszystkie, NFT, Fizyczne i pierwsza praca, Refik Anadol, Unsupervised, z podpisem Kadr z pracy wideo i linkiem Zobacz pełną pracę." />
            </div>
            <div class="mat mat-phone">
              <img class="shot" src="/case/igor/obrazy-telefon.webp" width="780" height="1320" loading="lazy" alt="Ta sama galeria na telefonie: nagłówek, filtr i pierwsza praca w całości." />
            </div>
            <figcaption class="label">
              <span class="kat">Kat. 3</span>
              <strong>Galeria prac</strong>
              <span>Filtr: wszystkie, NFT, fizyczne.</span>
            </figcaption>
          </div>
        </figure>

        <section class="wrap sec">
          <h2>Z&nbsp;galerii prosto do oryginału.</h2>
          <div class="txt">
            <p set:html={P('11 prac cyfrowych ma link do swojej strony na verse.works, OpenSea, objkt.com albo IYK. Dwie są fizyczne: grafika Tadeusza Dominika i print Rafała Dominika i Marii Mencwel. Przy każdym nazwisku jest lista jego prac w kolekcji i Instagram, a klik w nazwisko otwiera galerię tej osoby.')} />
          </div>
        </section>

        <section class="wrap sec">
          <h2>Dwa języki na jedno wydarzenie.</h2>
          <div class="txt">
            <p set:html={P('Igor potrzebował strony na wydarzenie z anglojęzyczną publicznością. Strona działa po polsku i po angielsku, a na ten czas angielski był domyślny.')} />
            <p set:html={P('Jego poprawki przyszły w jednym dokumencie: linki, tytuły, podpisy kadrów. Jedna z nich zmieniła „Artyści” na „Artyści i artystki”, żeby nie pomijać artystek. Hasło nadal mieści się w jednej linii na telefonie.')} />
          </div>
        </section>

        <figure class="wall">
          <div class="wrap hang hang-4">
            <div class="trip">
              <div class="mat"><picture><source media="(max-width: 700px)" srcset="/case/igor/artysci-telefon.webp" width="780" height="1320" /><img class="shot" src="/case/igor/artysci.webp" width="1600" height="1000" loading="lazy" alt="Podstrona Artyści i artystki: białe tło, nagłówek Nazwiska z kolekcji, pod nim Refik Anadol i Ivona Tau z listą prac i linkiem do Instagrama." /></picture></div>
              <div class="mat"><picture><source media="(max-width: 700px)" srcset="/case/igor/okolekcji-telefon.webp" width="780" height="1320" /><img class="shot" src="/case/igor/okolekcji.webp" width="1600" height="1000" loading="lazy" alt="Podstrona O kolekcji: niebieskie tło, nagłówek Jak to się zaczęło, bio Igora i trzy fakty: inżynier, potem IT, od 2020, NFT." /></picture></div>
              <div class="mat mat-wide"><img class="shot" src="/case/igor/newsletter.webp" width="1600" height="1000" loading="lazy" alt="Podstrona Newsletter: granatowe tło, nagłówek Newsletter o sztuce, obok biały formularz z polami imię i e-mail." /></div>
            </div>
            <figcaption class="label">
              <span class="kat">Kat. 4</span>
              <strong>Artyści i&nbsp;artystki, O&nbsp;kolekcji, Newsletter</strong>
              <span>Trzy podstrony w trzech kolorach jego marki.</span>
            </figcaption>
          </div>
        </figure>

        <section class="wrap sec">
          <h2>Newsletter w&nbsp;jego barwach.</h2>
          <div class="txt">
            <p set:html={P('Igor ma newsletter w MailerLite. Gotowy kod wyglądał jak każdy inny formularz MailerLite, więc zrobiłem własny formularz w jego kolorach, który zapisuje do jego konta. Wysuwa się z rogu raz, po przewinięciu ponad jednej trzeciej strony albo po 25 sekundach. Link do zapisu jest w każdej stopce i w menu.')} />
          </div>
        </section>

        <section class="wrap sec">
          <h2>Bez paska zgody na cookies.</h2>
          <div class="txt">
            <p set:html={P('Strona nie śledzi odwiedzających: nie ma analityki ani ciasteczek, a fonty są na jej własnym serwerze. Dlatego nie potrzebuje paska zgody na cookies. Polityka prywatności opisuje dokładnie to, co strona robi.')} />
          </div>
        </section>

        {quote ? (
          <figure class="wrap quote">
            <blockquote><p>{quote.text}</p></blockquote>
            <figcaption>{quote.name}, {quote.role}</figcaption>
          </figure>
        ) : import.meta.env.DEV && (
          <aside class="wrap quote-todo" aria-hidden="true">Tu stanie cytat Igora po rozmowie. Na produkcji blok się nie pokaże, dopóki cytat nie jest zaakceptowany.</aside>
        )}
      </article>

      <section class="end" aria-labelledby="end-h">
        <div class="wrap end-in">
          <h2 id="end-h">Pokazujesz kolekcję albo swoją pracę tylko na Instagramie?</h2>
          <div>
            <p>Opisz mi ją w&nbsp;15 minut. Powiem, jak mogłaby wyglądać jej strona i&nbsp;co trzeba przygotować.</p>
            <a class="btn" href={contact}>Umów 15 minut</a>
            <p class="more"><a href="/pl/realizacje/glassstone/">Druga realizacja: szkic z&nbsp;pomiaru zamienia się w&nbsp;rysunek na produkcję</a></p>
          </div>
        </div>
      </section>
    </main>
    <BrandFooter locale="pl" inset />
  </div>
</VariantLayout>

<script>
  // Pętle nagrań grają tylko w ekranie i tylko bez prefers-reduced-motion; inaczej zostaje plakat.
  const vids = document.querySelectorAll<HTMLVideoElement>('.case .shot[autoplay]');
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    const v = e.target as HTMLVideoElement;
    if (e.isIntersecting && !still.matches) v.play().catch(() => {}); else v.pause();
  }), { threshold: .2 });
  vids.forEach((v) => { if (still.matches) { v.removeAttribute('autoplay'); v.pause(); } io.observe(v); });
</script>

<style>
  .case {
    --ivory: #f8f9f2; --wall: #ebe9e2; --ink: #111; --dim: #5f5b4e; --rule: rgb(17 17 17 / .16);
    --igor: #1533f5; --brand: #ffcc33;
    --gutter: clamp(20px, 5vw, 96px); --focus: var(--igor);
    font-family: 'GeneralSansV', sans-serif; background: var(--ivory); color: var(--ink); overflow-x: clip;
  }
  @font-face { font-family: 'NohemiV'; src: url('/fonts/Nohemi-Variable.woff2') format('woff2'); font-weight: 100 900; font-display: swap; }
  @font-face { font-family: 'GeneralSansV'; src: url('/fonts/GeneralSans-Variable.woff2') format('woff2'); font-weight: 200 700; font-display: swap; }
  .case :is(h1,h2,p,figure,dl,dd,ol,blockquote) { margin: 0; }
  .case ol { padding: 0; list-style: none; }
  .case :is(h1,h2) { text-wrap: balance; }
  .case p { text-wrap: pretty; }
  .case :is(a,button):focus-visible { outline: 3px solid var(--focus); outline-offset: 4px; }
  .case ::selection { background: var(--brand); }
  .skip { position: fixed; top: 12px; left: 12px; z-index: 150; padding: 12px 20px; background: var(--brand); color: var(--ink); transform: translateY(-200%); }
  .skip:focus { transform: none; }
  .nav { height: 104px; box-sizing: border-box; padding: 24px var(--gutter); display: flex; align-items: center; justify-content: space-between; position: relative; z-index: 90; }
  .mark video { width: clamp(155px, 18vw, 220px); height: auto; display: block; filter: drop-shadow(0 5px 10px rgb(0 0 0 / .26)); }
  .wrap { max-width: 1320px; margin-inline: auto; padding-inline: var(--gutter); box-sizing: border-box; }

  /* Hero: tytuł po lewej, karta obiektu po prawej (jak strona obiektu w Tate i Whitney). */
  .hero { padding-top: clamp(32px, 9vh, 104px); display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: clamp(32px, 6vw, 112px); align-items: end; }
  .kicker { font-size: 16px; color: var(--dim); }
  h1 { margin-top: 20px !important; font-family: 'NohemiV', sans-serif; font-weight: 500; font-size: clamp(36px, 6.2vw, 96px); line-height: 1.02; letter-spacing: -.035em; }
  .lead { margin-top: clamp(28px, 4vw, 48px) !important; max-width: 34em; font-size: 21px; line-height: 1.6; }
  .record { border-top: 1.5px solid var(--ink); padding-top: 20px; }
  .rec-name { font-weight: 600; font-size: 21px; line-height: 1.3; }
  .rec-title { font-style: italic; font-size: 21px; line-height: 1.3; }
  .record dl { margin-top: 20px; }
  .record dl div { display: grid; grid-template-columns: 7.5em minmax(0, 1fr); gap: 12px; padding: 10px 0; border-top: 1px solid var(--rule); font-size: 16px; line-height: 1.45; }
  .record dt { color: var(--dim); }
  .rec-link { display: inline-block; margin-top: 20px; color: var(--ink); font-size: 16px; text-decoration-color: var(--igor); text-decoration-thickness: 2px; text-underline-offset: 5px; }

  /* Ściana: eksponat w passe-partout, obok etykieta jak w galerii. */
  .wall { margin-top: clamp(64px, 9vw, 128px) !important; background: var(--wall); padding-block: clamp(40px, 7vw, 112px); }
  .wall-first { margin-top: clamp(56px, 7vw, 96px) !important; }
  .mat { background: #fff; padding: clamp(10px, 2.2vw, 36px); box-shadow: 0 1px 0 rgb(17 17 17 / .08), 0 18px 40px -18px rgb(17 17 17 / .28); outline: 1px solid rgb(17 17 17 / .12); outline-offset: -1px; }
  .shot { display: block; width: 100%; height: auto; background: #fff; box-shadow: inset 0 0 0 1px var(--rule); }
  img.shot, video.shot { border: 1px solid rgb(17 17 17 / .1); box-sizing: border-box; }
  .hang { display: grid; grid-template-columns: minmax(0, 9fr) minmax(0, 3fr); gap: clamp(20px, 3vw, 48px); align-items: end; }
  .wall .wrap { max-width: 1560px; }
  .hang-1, .hang-3 { grid-template-columns: minmax(0, 8.6fr) minmax(0, 2.5fr) minmax(0, 1.7fr); }
  .label { display: flex; flex-direction: column; gap: 4px; font-size: 16px; line-height: 1.45; color: var(--ink); max-width: 17em; }
  .label strong { font-weight: 600; }
  .label > span:last-child { color: var(--dim); }
  .kat { font-size: 14px; color: var(--igor); font-variant-numeric: tabular-nums; margin-bottom: 6px; }

  /* Tekst sekcji jak tekst na ścianie wystawy: wcięta kolumna, śródtytuł nad tekstem. */
  .sec { margin-top: clamp(64px, 9vw, 128px) !important; padding-left: calc(var(--gutter) + (100% - 2 * var(--gutter)) * 2 / 12); }
  .wall + .sec { margin-top: clamp(56px, 7vw, 104px) !important; }
  .sec + .sec { margin-top: clamp(48px, 6vw, 80px) !important; }
  h2 { max-width: 16em; font-family: 'NohemiV', sans-serif; font-weight: 500; font-size: clamp(28px, 2.9vw, 42px); line-height: 1.1; letter-spacing: -.022em; }
  .txt { margin-top: 20px; max-width: 36em; font-size: 19px; line-height: 1.65; }
  .txt p + p { margin-top: 20px !important; }

  /* Spis prac jak lista w katalogu wystawy. */
  .list-fig { margin-top: clamp(40px, 5vw, 64px) !important; display: grid; grid-template-columns: minmax(0, 9fr) minmax(0, 3fr); gap: clamp(20px, 3vw, 48px); align-items: end; }
  .checklist { border-top: 1.5px solid var(--ink); }
  .checklist li { display: grid; grid-template-columns: 3em minmax(0, 4fr) minmax(0, 7fr); gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--rule); font-size: 17px; line-height: 1.4; }
  .no { color: var(--igor); font-variant-numeric: tabular-nums; }
  .who { font-weight: 600; }
  .what em { font-style: italic; }
  .med { display: block; margin-top: 2px; font-size: 15px; color: var(--dim); }

  .trip { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(16px, 2vw, 32px); align-items: start; }
  .hang-4 { grid-template-columns: 1fr; }
  .hang-4 .label { max-width: 36em; }

  .quote { margin-top: 96px !important; }
  .quote p { font-size: 28px; line-height: 1.4; max-width: 30em; }
  .quote figcaption { margin-top: 12px; font-size: 16px; }
  .quote-todo { margin-top: 64px; padding: 16px var(--gutter); color: #c70404; font-size: 16px; }

  .end { margin-top: clamp(96px, 12vw, 160px); padding: clamp(72px, 9vw, 128px) 0; background: var(--ink); color: var(--ivory); }
  .end-in { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(24px, 5vw, 96px); align-items: start; }

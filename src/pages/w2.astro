---
// W2 „CHROM" — ciemna scena 3D: metaliczna typografia, lewitujący telefon, szkło.
import VariantLayout from '../layouts/VariantLayout.astro';
import PhoneFrame from '../components/frames/PhoneFrame.astro';
import eskapizmScroll from '../assets/live/eskapizm-scroll.webp';
import woodspotScroll from '../assets/live/woodspot-scroll.webp';

const uslugi = [
  { n: 'Plan projektu', d: 'Rozkładam pomysł na części. Dostajesz mapę: co budować, w jakiej kolejności, za ile.' },
  { n: 'Strona internetowa', d: 'Jedna strona pod cel albo pełna strona firmy. Od projektu po wdrożenie.' },
  { n: 'Aplikacja lub system', d: 'Sklep, zapisy, panel klienta, pierwsza wersja produktu. Działa i zarabia.' },
];
---

<VariantLayout title="W2 — CHROM · mioduszewsky" bg="#07060a" fg="#f5f2ff">
  <main class="w2">
    <div class="orbs" aria-hidden="true"><i class="o1"></i><i class="o2"></i><i class="o3"></i></div>

    <header class="nav">
      <span class="mono">MIODUSZEWSKY — WROCŁAW</span>
      <a class="pill" href="mailto:kacper@mioduszewsky.com">Napisz ↳</a>
    </header>

    <!-- Hero: chrom + lewitujący telefon w 3D -->
    <section class="hero">
      <p class="mono dim">Kacper Mioduszewski · od pomysłu do startu</p>
      <h1 class="chrome">STRONY,<br />APLIKACJE<br /><span class="amber">&amp; PLANY PROJEKTÓW</span></h1>
      <div class="stage" aria-hidden="false">
        <div class="float3d">
          <PhoneFrame src={eskapizmScroll} alt="eskapizm.com — poskroluj" label="eskapizm.com — żywy projekt, poskroluj" href="https://eskapizm.com" />
        </div>
        <div class="floor"></div>
      </div>
      <p class="claim">
        Buduję pierwsze wersje, które <em>wyglądają jak przyszłość</em>
        i działają jak dobrze naoliwiona maszyna. Projekt, treść i wdrożenie — jedne ręce.
      </p>
    </section>

    <!-- Usługi: wytłoczone 3D nagłówki + szkło -->
    <section class="uslugi">
      <h2 class="extrude">OFERTA</h2>
      <div class="cards">
        {uslugi.map((u, i) => (
          <a class="glass" href={`mailto:kacper@mioduszewsky.com?subject=${encodeURIComponent(u.n)}`} style={`--d:${i * 0.08}s`}>
            <span class="mono dim">0{i + 1}</span>
            <h3>{u.n}</h3>
            <p>{u.d}</p>
            <span class="go">→</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Drugi projekt -->
    <section class="work2">
      <div class="work2-txt">
        <h2 class="chrome sm">DOWODY<br /><span class="amber">NIE OBIETNICE</span></h2>
        <p class="claim">Każdy ekran obok jest przewijalny — to prawdziwe, żywe projekty, nie makiety z porfolio stockowego.</p>
        <a class="pill big" href="mailto:kacper@mioduszewsky.com">Opowiedz mi o swoim projekcie ↳</a>
      </div>
      <div class="float3d slow">
        <PhoneFrame src={woodspotScroll} alt="WoodSpot deck — poskroluj" label="woodspot — deck wydarzenia" />
      </div>
    </section>

    <footer class="foot">
      <span class="mono dim">© 2026 mioduszewsky · Wrocław (CET) · zaprojektowane i zbudowane samodzielnie</span>
    </footer>
  </main>
</VariantLayout>

<style>
  .w2 {
    font-family: 'Space Grotesk Variable', sans-serif;
    position: relative;
    overflow: clip;
  }
  ::selection { background: #ffb703; color: #07060a; }
  .mono { font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; }
  .dim { color: #8d87a6; }
  .amber { color: #ffb703; -webkit-text-fill-color: #ffb703; }

  .orbs { position: fixed; inset: 0; z-index: -1; filter: blur(70px) saturate(1.3); }
  .orbs i { position: absolute; border-radius: 50%; opacity: 0.55; }
  .o1 { width: 46vw; height: 46vw; left: -12vw; top: -10vh; background: conic-gradient(from 40deg, #2b1a4d, #7c5cff, #1a0f33, #b45cff, #2b1a4d); animation: drift 22s ease-in-out infinite alternate; }
  .o2 { width: 34vw; height: 34vw; right: -8vw; top: 30vh; background: conic-gradient(from 200deg, #4d2a08, #ffb703, #331c05, #ff7a3d, #4d2a08); animation: drift 27s ease-in-out infinite alternate-reverse; }
  .o3 { width: 30vw; height: 30vw; left: 30vw; bottom: -14vh; background: conic-gradient(#123, #3ddbd9, #112, #7c5cff, #123); animation: drift 31s ease-in-out infinite alternate; }
  @keyframes drift { to { translate: 6vw -4vh; scale: 1.15; } }

  .nav { display: flex; justify-content: space-between; align-items: center; padding: 22px 4vw; }
  .pill {
    font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase;
    color: #07060a; background: linear-gradient(120deg, #e8e6f2, #fff, #b9b4cf, #fff);
    padding: 10px 22px; border-radius: 999px; text-decoration: none;
  }
  .pill:hover { filter: brightness(1.1); }
  .pill.big { display: inline-block; margin-top: 1.6rem; padding: 14px 28px; }

  .hero { text-align: center; padding: 6vh 4vw 0; }
  .chrome {
    font-family: 'Unbounded Variable';
    font-weight: 800;
    font-size: clamp(2.6rem, 9vw, 9rem);
    line-height: 0.98;
    letter-spacing: -0.01em;
    background: linear-gradient(175deg, #fdfdff 8%, #a49fc0 28%, #fff 42%, #55506e 58%, #e8e6f6 72%, #8d87a6 88%);
    background-size: 100% 220%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: sheen 7s ease-in-out infinite alternate;
    margin-top: 1.2rem;
  }
  .chrome.sm { font-size: clamp(2rem, 5vw, 4.6rem); text-align: left; }
  @keyframes sheen { to { background-position: 0 100%; } }

  .stage { position: relative; margin: 6vh auto 0; width: fit-content; perspective: 1400px; }
  .float3d { transform-style: preserve-3d; animation: float 9s ease-in-out infinite; }
  .float3d.slow { animation-duration: 12s; }
  @keyframes float {
    0%, 100% { transform: rotateY(-14deg) rotateX(4deg) translateY(0); }
    50% { transform: rotateY(14deg) rotateX(-3deg) translateY(-18px); }
  }
  .floor {
    position: absolute; left: 50%; bottom: -46px; translate: -50% 0;
    width: 70%; height: 60px; border-radius: 50%;
    background: radial-gradient(ellipse, rgba(124, 92, 255, 0.5), transparent 70%);
    filter: blur(14px);
  }
  .claim { max-width: 52ch; margin: 7vh auto 0; font-size: clamp(1rem, 1.5vw, 1.2rem); line-height: 1.6; color: #cfcadf; }
  .claim em { font-style: normal; color: #ffb703; }

  .uslugi { padding: 14vh 4vw 6vh; text-align: center; }
  .extrude {
    font-family: 'Unbounded Variable';
    font-weight: 900;
    font-size: clamp(3rem, 11vw, 10rem);
    color: #0b0a12;
    text-shadow:
      1px 1px 0 #7c5cff, 2px 2px 0 #7c5cff, 3px 3px 0 #6a4ce6, 4px 4px 0 #5a3fd0,
      6px 6px 0 #452fa8, 8px 8px 0 #33217e, 11px 11px 0 #221457, 14px 14px 30px rgba(0,0,0,0.6);
    letter-spacing: 0.02em;
  }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; margin-top: 7vh; text-align: left; }
  .glass {
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(18px);
    border-radius: 22px;
    padding: 28px 26px 60px;
    text-decoration: none;
    color: inherit;
    transition: translate 0.25s ease, background 0.25s ease;
  }
  .glass:hover { translate: 0 -8px; background: rgba(255, 255, 255, 0.09); }
  .glass h3 { font-family: 'Unbounded Variable'; font-weight: 700; font-size: 1.35rem; margin: 14px 0 10px; }
  .glass p { font-size: 14px; line-height: 1.55; color: #b9b4cf; }
  .go { position: absolute; right: 22px; bottom: 18px; font-size: 1.4rem; color: #ffb703; }

  .work2 { display: flex; flex-wrap: wrap; gap: 6vw; align-items: center; justify-content: center; padding: 10vh 4vw; }
  .work2-txt { max-width: 480px; }
  .work2-txt .claim { margin: 1.4rem 0 0; text-align: left; }

  .foot { text-align: center; padding: 6vh 4vw 4vh; }

  @media (prefers-reduced-motion: reduce) {
    .float3d, .orbs i, .chrome { animation: none !important; }
  }
</style>

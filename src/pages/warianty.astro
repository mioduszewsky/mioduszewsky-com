---
// Rozdzielnia wariantów designu — klikasz i porównujesz.
import VariantLayout from '../layouts/VariantLayout.astro';

const list = [
  { href: '/w1', n: 'BETON', d: 'Neo-brutalizm: surowy papier, twarde bordery, typografia na osi szerokości, cennik z targu.' },
  { href: '/w2', n: 'CHROM', d: 'Ciemna scena 3D: metaliczna typografia, lewitujący telefon, szkło i opary koloru.' },
  { href: '/w3', n: 'NOKTURN', d: 'Immersyjne scrollytelling: noc → świt → dzień, serif Fraunces, narracja rozdziałami.' },
  { href: '/w4', n: 'AFISZ', d: 'Punkowy plakat / ransom note: wycinki, taśma, naklejki, kupon do oderwania.' },
  { href: '/w5', n: 'ATELIER', d: 'Quiet luxury: Clash Display + Sentient, maślany scroll, maskowane reveale, magnetyczne CTA, dmuchane logo 3D.' },
];
---

<VariantLayout title="Warianty designu · mioduszewsky" bg="#101010" fg="#f4efe4">
  <main class="idx">
    <p class="eyebrow">mioduszewsky.com — 4 kierunki do klikania (07.2026)</p>
    <ul>
      {list.map((v, i) => (
        <li>
          <a href={v.href}>
            <span class="nr">W{i + 1}</span>
            <span class="name">{v.n}</span>
            <span class="desc">{v.d}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="note">W każdym wariancie ekrany telefonów są przewijalne — w środku żywe projekty.</p>
  </main>
</VariantLayout>

<style>
  .idx { min-height: 100svh; display: flex; flex-direction: column; justify-content: center; padding: 10vh 6vw; font-family: 'Space Grotesk Variable', sans-serif; }
  .eyebrow { font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; opacity: 0.6; margin-bottom: 5vh; }
  ul { list-style: none; }
  li a {
    display: grid; grid-template-columns: 70px auto 1fr; gap: 3vw; align-items: baseline;
    padding: 3vh 0; border-top: 1px solid rgba(244, 239, 228, 0.2);
    color: inherit; text-decoration: none;
  }
  li:last-child a { border-bottom: 1px solid rgba(244, 239, 228, 0.2); }
  li a:hover { background: rgba(244, 239, 228, 0.05); }
  li a:hover .name { translate: 12px 0; color: #ffb703; }
  .nr { font-size: 12px; letter-spacing: 0.2em; opacity: 0.5; }
  .name { font-family: 'Unbounded Variable'; font-weight: 800; font-size: clamp(2rem, 6vw, 5rem); transition: translate 0.2s; }
  .desc { font-size: 14px; line-height: 1.5; opacity: 0.7; max-width: 44ch; }
  .note { margin-top: 5vh; font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.5; }
  @media (max-width: 700px) { li a { grid-template-columns: auto 1fr; } .desc { display: none; } }
</style>

---
// W5 „ATELIER × WANDAL" — quiet luxury z warstwą buntu: sprayowe skreślenia,
// odręczne dopiski (Shantell Sans, pełny PL), splaty po kliknięciu.
// Baza: Clash Display + Sentient, Lenis, maskowane reveale, magnetyczne CTA.
import '@fontsource-variable/shantell-sans';
import VariantLayout from '../layouts/VariantLayout.astro';
import PhoneFrame from '../components/frames/PhoneFrame.astro';
import eskapizmScroll from '../assets/live/eskapizm-scroll.webp';
import woodspotScroll from '../assets/live/woodspot-scroll.webp';

const uslugi = [
  { nr: '01', n: 'Plan projektu', d: 'Zanim wydasz pierwszą złotówkę: rozkładam pomysł na części i dostajesz konkretną mapę. Co budować, w jakiej kolejności i czym to uruchomić.' },
  { nr: '02', n: 'Strona internetowa', d: 'Jedna strona pod cel albo pełna strona firmy. Projekt, treść i wdrożenie. Gotowa, żeby pokazywać ją klientom bez tłumaczenia się.' },
  { nr: '03', n: 'Aplikacja lub system', d: 'Sklep, system zapisów, panel klienta, pierwsza wersja produktu. Coś, co pracuje na Ciebie od pierwszego dnia.' },
];
---

<VariantLayout title="W5 — ATELIER · mioduszewsky" bg="#f3f1ea" fg="#17150f">
  <main class="w5">
    <!-- Wspólne filtry spray (inline SVG = działa też w Safari) -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <filter id="sprayF" x="-40%" y="-40%" width="180%" height="180%">
          <feTurbulence type="fractalNoise" baseFrequency="0.55" numOctaves="2" result="n" />
          <feDisplacementMap in="SourceGraphic" in2="n" scale="14" />
          <feGaussianBlur stdDeviation="0.55" />
        </filter>
        <filter id="sprayMist" x="-60%" y="-60%" width="220%" height="220%">
          <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="3" result="n" />
          <feDisplacementMap in="SourceGraphic" in2="n" scale="30" />
          <feGaussianBlur stdDeviation="1.6" />
        </filter>
      </defs>
    </svg>

    <!-- Kurtyna wejściowa -->
    <div class="veil" aria-hidden="true">
      <video class="veil-word" autoplay loop muted playsinline preload="auto">
        <source src="/logo3d/logo.mp4" type="video/mp4;codecs=hvc1" />
        <source src="/logo3d/logo.webm" type="video/webm" />
      </video>
    </div>

    <!-- Custom cursor -->
    <div class="cur" aria-hidden="true"></div>

    <header class="nav">
      <a class="mark" href="#" aria-label="mioduszewsky">
        <video autoplay loop muted playsinline preload="auto" aria-hidden="true">
          <source src="/logo3d/logo.mp4" type="video/mp4;codecs=hvc1" />
          <source src="/logo3d/logo.webm" type="video/webm" />
        </video>
      </a>
      <a class="btn mag" href="mailto:kacper@mioduszewsky.com"><span class="btn-in">Napisz do mnie</span></a>
    </header>

    <!-- HERO -->
    <section class="hero">
      <p class="label rv">( Strony · Aplikacje · Plany projektów )</p>
      <h1>
        <span class="ln"><span class="ln-in">Buduję <span class="fix">ładne<svg class="strike" viewBox="0 0 200 44" preserveAspectRatio="none" aria-hidden="true"><g class="strike-mist" filter="url(#sprayMist)"><path d="M6 25 C 60 18, 138 30, 194 21" /><path d="M10 33 C 68 26, 132 37, 190 26" /></g><g class="strike-ink" filter="url(#sprayF)"><path class="draw" d="M6 25 C 60 18, 138 30, 194 21" /><path class="draw" d="M10 33 C 68 26, 132 37, 190 26" /></g></svg><span class="tag tag-fix" aria-hidden="true">działające!</span></span> rzeczy,</span></span>
        <span class="ln"><span class="ln-in">które <em>zaczynają</em></span></span>
        <span class="ln"><span class="ln-in">biznesy<span class="spray-dot" aria-hidden="true"><svg viewBox="0 0 60 60"><circle cx="30" cy="30" r="15" filter="url(#sprayMist)" /></svg></span></span></span>
      </h1>
      <div class="hero-b">
        <p class="hero-sub rv">
          Od pomysłu do startu: projekt, treść i wdrożenie w jednych rękach.
          Bez szablonów i bez lania wody. Pierwsza wersja, która działa i zarabia.
        </p>
        <span class="hero-line-v rv" aria-hidden="true"></span>
      </div>
    </section>

    <!-- REALIZACJE -->
    <section class="work">
      <div class="sec-head">
        <p class="label rv">Wybrane realizacje</p>
        <p class="label dim rv">( ekrany są przewijalne — to żywe projekty )</p>
      </div>

      <article class="proj">
        <div class="proj-t">
          <span class="ln"><span class="ln-in idx">№ 01</span></span>
          <h2 class="ln"><span class="ln-in">eskapizm</span></h2>
          <p class="proj-d rv">
            Plany podróży po Azji, szyte na miarę. Strona, sklep, aplikacja z planami
            i system AI do ich budowania. <em>Zaprojektowane i zbudowane od zera.</em>
          </p>
          <a class="tlink rv" href="https://eskapizm.com" target="_blank" rel="noopener">eskapizm.com<i>↗</i></a>
        </div>
        <div class="proj-f" data-parallax>
          <div class="phone-hold">
            <PhoneFrame src={eskapizmScroll} alt="eskapizm.com — poskroluj" />
            <div class="spray-note" aria-hidden="true">
              <svg viewBox="0 0 160 90"><path d="M8 76 C 50 66, 96 44, 138 18 M120 14 L 140 16 L 132 36" filter="url(#sprayF)" /></svg>
              <span class="tag">psst, to żyje.<br />poskroluj!</span>
            </div>
          </div>
        </div>
      </article>

      <article class="proj flip">
        <div class="proj-t">
          <span class="ln"><span class="ln-in idx">№ 02</span></span>
          <h2 class="ln"><span class="ln-in">woodspot</span></h2>
          <p class="proj-d rv">
            Interaktywny deck wydarzenia z modelem finansowym. Dokument,
            który <em>sprzedaje pomysł</em> lepiej niż prezentacja.
          </p>
        </div>
        <div class="proj-f" data-parallax>
          <PhoneFrame src={woodspotScroll} alt="WoodSpot — poskroluj" />
        </div>
      </article>
    </section>

    <!-- MANIFEST -->
    <section class="manif">
      <p class="manif-t">
        <span class="ln"><span class="ln-in">Kupujesz stronę,</span></span>
        <span class="ln"><span class="ln-in">a <em>przemyślany plan wejścia</em></span></span>
        <span class="ln"><span class="ln-in">dostajesz w cenie. <span class="tag tag-manif" aria-hidden="true">serio.</span></span></span>
      </p>
    </section>

    <!-- USŁUGI -->
    <section class="serv">
      <p class="label rv">Z czym możesz przyjść</p>
      <div class="rows">
        {uslugi.map((u, i) => (
          <a class="srow" href={`mailto:kacper@mioduszewsky.com?subject=${encodeURIComponent(u.n)}`}>
            <span class="idx idx-wrap">
              {u.nr}
              {i === 0 && (
                <svg class="spray-circle" viewBox="0 0 90 60" aria-hidden="true">
                  <path class="draw" d="M22 14 C 48 4, 84 12, 85 29 C 86 46, 56 56, 30 52 C 8 48, 2 34, 14 22 C 20 16, 30 12, 38 11" filter="url(#sprayF)" />
                </svg>
              )}
            </span>
            <span class="sname">{u.n}</span>
            <span class="sdesc">{u.d}</span>
            <span class="sarr">↗</span>
            {i === 0 && <span class="tag tag-row" aria-hidden="true">od tego bym zaczął</span>}
          </a>
        ))}
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="foot">
      <p class="label rv">( Następny krok )</p>
      <a class="foot-h" href="mailto:kacper@mioduszewsky.com">
        <span class="ln"><span class="ln-in">Porozmawiajmy</span></span>
        <span class="ln"><span class="ln-in"><em>o Twoim projekcie.</em> <span class="tag tag-foot" aria-hidden="true">bez ściemy.</span></span></span>
      </a>
      <div class="foot-b">
        <a class="btn mag big" href="mailto:kacper@mioduszewsky.com"><span class="btn-in">kacper@mioduszewsky.com</span></a>
        <a class="btn mag ghost" href="https://instagram.com/mioduszewsky" target="_blank" rel="noopener"><span class="btn-in">Instagram</span></a>
      </div>
      <div class="meta">
        <span>© 2026 mioduszewsky</span>
        <span>Wrocław, PL (CET)</span>
        <span>Zaprojektowane i zbudowane samodzielnie</span>
      </div>
    </footer>
  </main>

  <script>
    import Lenis from 'lenis';
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const EASE = 'cubic-bezier(0.19, 1, 0.22, 1)';

    if (!reduced) {
      const lenis = new Lenis({ duration: 1.25, smoothWheel: true });
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((t) => lenis.raf(t * 1000));
      gsap.ticker.lagSmoothing(0);
    }

    /* Kurtyna wejściowa + intro hero + „psiknięcie" skreślenia */
    const veil = document.querySelector<HTMLElement>('.veil')!;
    const strikePaths = gsap.utils.toArray<SVGPathElement>('.strike .draw');
    const strikeMist = document.querySelector<SVGGElement>('.strike-mist');
    const intro = () => {
      strikePaths.forEach((p) => {
        const len = p.getTotalLength();
        p.style.strokeDasharray = `${len}`;
        p.style.strokeDashoffset = `${len}`;
      });
      gsap.set(['.tag-fix', '.spray-dot svg'], { opacity: 0 });
      if (strikeMist) gsap.set(strikeMist, { opacity: 0 });
      const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
      tl.fromTo('.veil-word', { opacity: 0, y: 24, scale: 0.96 }, { opacity: 1, y: 0, scale: 1, duration: 0.55 })
        .to(veil, { yPercent: -100, duration: 0.9, ease: 'expo.inOut' }, 0.8)
        .fromTo('.hero .ln-in', { y: '112%' }, {
          y: 0, duration: 1.2, stagger: 0.09,
          onComplete: () => document.querySelectorAll<HTMLElement>('.hero .ln').forEach((l) => (l.style.overflow = 'visible')),
        }, 1.1)
        .fromTo('.nav', { opacity: 0, y: -14 }, { opacity: 1, y: 0, duration: 0.8 }, 1.3)
        .fromTo('.hero .rv', { opacity: 0, y: 22 }, { opacity: 1, y: 0, duration: 0.9, stagger: 0.08 }, 1.4)
        .to(strikePaths, { strokeDashoffset: 0, duration: 0.42, ease: 'power2.in', stagger: 0.16 }, 2.0)
        .to(strikeMist, { opacity: 1, duration: 0.3 }, 2.25)
        .fromTo('.tag-fix', { scale: 0.7, rotate: -14 }, { opacity: 1, scale: 1, rotate: -7, duration: 0.45, ease: 'back.out(2.4)', immediateRender: false }, 2.5)
        .fromTo('.spray-dot svg', { scale: 0.4 }, { opacity: 1, scale: 1, duration: 0.3, ease: 'power4.out', immediateRender: false }, 2.7);
    };
    if (reduced) {
      veil.remove();
      document.querySelectorAll<HTMLElement>('.ln-in, .rv, .nav').forEach((el) => { el.style.transform = 'none'; el.style.opacity = '1'; });
      document.querySelectorAll<HTMLElement>('.ln').forEach((l) => (l.style.overflow = 'visible'));
    } else {
      intro();
    }

    /* Kółko sprayem na 001 — rysuje się gdy wjedzie w kadr */
    const circlePath = document.querySelector<SVGPathElement>('.spray-circle .draw');
    if (circlePath && !reduced) {
      const len = circlePath.getTotalLength();
      circlePath.style.strokeDasharray = `${len}`;
      circlePath.style.strokeDashoffset = `${len}`;
      gsap.to(circlePath, {
        strokeDashoffset: 0, duration: 0.7, ease: 'power2.inOut',
        scrollTrigger: { trigger: '.spray-circle', start: 'top 78%' },
      });
    }

    /* Maskowane linie + delikatne reveale na scrollu */
    if (!reduced) {
      document.querySelectorAll<HTMLElement>('main section:not(.hero) .ln-in, footer .ln-in').forEach((el) => {
        gsap.fromTo(el, { y: '112%' }, {
          y: 0, duration: 1.15, ease: 'expo.out',
          scrollTrigger: { trigger: el.closest('.ln'), start: 'top 88%' },
          onComplete: () => ((el.closest('.ln') as HTMLElement).style.overflow = 'visible'),
        });
      });
      document.querySelectorAll<HTMLElement>('main section:not(.hero) .rv, footer .rv, .srow, .meta').forEach((el) => {
        gsap.fromTo(el, { opacity: 0, y: 26 }, {
          opacity: 1, y: 0, duration: 1, ease: 'power3.out',
          scrollTrigger: { trigger: el, start: 'top 90%' },
        });
      });
      /* Parallax ramek */
      document.querySelectorAll<HTMLElement>('[data-parallax]').forEach((el) => {
        gsap.fromTo(el, { y: 60 }, {
          y: -60, ease: 'none',
          scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: 0.8 },
        });
      });
    }

    /* Magnetyczne przyciski */
    if (!reduced && matchMedia('(pointer: fine)').matches) {
      document.querySelectorAll<HTMLElement>('.mag').forEach((btn) => {
        const inner = btn.querySelector<HTMLElement>('.btn-in')!;
        btn.addEventListener('mousemove', (e) => {
          const r = btn.getBoundingClientRect();
          const x = (e.clientX - r.left - r.width / 2) * 0.35;
          const y = (e.clientY - r.top - r.height / 2) * 0.45;
          gsap.to(btn, { x, y, duration: 0.4, ease: 'power2.out' });
          gsap.to(inner, { x: x * 0.4, y: y * 0.4, duration: 0.4 });
        });
        btn.addEventListener('mouseleave', () => {
          gsap.to([btn, inner], { x: 0, y: 0, duration: 0.7, ease: 'elastic.out(1, 0.4)' });
        });
      });

      /* Custom cursor */
      const cur = document.querySelector<HTMLElement>('.cur')!;
      const qx = gsap.quickTo(cur, 'x', { duration: 0.35, ease: 'power3.out' });
      const qy = gsap.quickTo(cur, 'y', { duration: 0.35, ease: 'power3.out' });
      addEventListener('mousemove', (e) => { qx(e.clientX); qy(e.clientY); });
      document.querySelectorAll('a, button').forEach((el) => {
        el.addEventListener('mouseenter', () => gsap.to(cur, { scale: 2.6, duration: 0.3 }));
        el.addEventListener('mouseleave', () => gsap.to(cur, { scale: 1, duration: 0.3 }));
      });
    } else {
      document.querySelector('.cur')?.remove();
    }

    /* Psiknięcie sprejem na klik/tap (poza linkami) */
    if (!reduced) {
      const NS = 'http://www.w3.org/2000/svg';
      addEventListener('pointerdown', (e) => {
        const t = e.target as HTMLElement;
        if (t.closest('a, button, .phone-screen, .variant-switch')) return;
        if (document.querySelectorAll('.splat').length > 7) return;
        const svg = document.createElementNS(NS, 'svg');
        svg.setAttribute('viewBox', '0 0 120 120');
        svg.classList.add('splat');
        const g = document.createElementNS(NS, 'g');
        g.setAttribute('filter', 'url(#sprayMist)');
        for (let i = 0; i < 7; i++) {
          const c = document.createElementNS(NS, 'circle');
          const a = Math.random() * Math.PI * 2;
          const d = i === 0 ? 0 : 14 + Math.random() * 34;
          c.setAttribute('cx', String(60 + Math.cos(a) * d));
          c.setAttribute('cy', String(60 + Math.sin(a) * d));
          c.setAttribute('r', String(i === 0 ? 15 + Math.random() * 7 : 2.5 + Math.random() * 6));
          g.appendChild(c);
        }
        svg.appendChild(g);
        svg.style.left = `${e.clientX}px`;
        svg.style.top = `${e.clientY}px`;
        svg.style.rotate = `${Math.random() * 360}deg`;
        document.body.appendChild(svg);
        gsap.fromTo(svg, { scale: 0.3, opacity: 0.95 }, { scale: 1, opacity: 0.85, duration: 0.25, ease: 'power4.out' });
        gsap.to(svg, { opacity: 0, duration: 0.9, delay: 1.6, onComplete: () => svg.remove() });
      });
    }
  </script>
</VariantLayout>

<style>
  .w5 {
    --ivory: #f3f1ea;
    --ink: #17150f;
    --dim: #8b8677;
    --blue: #2438ff;
    --brand: #ffcc33;
    font-family: 'GeneralSansV', sans-serif;
    background: var(--ivory);
    color: var(--ink);
    overflow-x: clip;
  }
  @font-face { font-family: 'NohemiV'; src: url('/fonts/Nohemi-Variable.woff2') format('woff2'); font-weight: 100 900; font-display: swap; }
  @font-face { font-family: 'ClashV'; src: url('/fonts/ClashDisplay-Variable.woff2') format('woff2'); font-weight: 200 700; font-display: swap; }
  @font-face { font-family: 'GeneralSansV'; src: url('/fonts/GeneralSans-Variable.woff2') format('woff2'); font-weight: 200 700; font-display: swap; }
  @font-face { font-family: 'GeneralSansV'; src: url('/fonts/GeneralSans-VariableItalic.woff2') format('woff2'); font-weight: 200 700; font-style: italic; font-display: swap; }
  @font-face { font-family: 'SentientV'; src: url('/fonts/Sentient-Variable.woff2') format('woff2'); font-weight: 200 700; font-display: swap; }
  @font-face { font-family: 'SentientV'; src: url('/fonts/Sentient-VariableItalic.woff2') format('woff2'); font-weight: 200 700; font-style: italic; font-display: swap; }

  ::selection { background: var(--blue); color: var(--ivory); }
  .w5 a { cursor: none; }
  @media (pointer: coarse) { .w5 a { cursor: auto; } }

  .veil {
    position: fixed; inset: 0; z-index: 200; background: var(--ink);
    display: grid; place-items: center;
  }
  .veil-word {
    width: clamp(260px, 50vw, 680px); height: auto; display: block;
    opacity: 0;
  }

  .cur {
    position: fixed; top: -40px; left: -40px; z-index: 300; width: 14px; height: 14px;
    border-radius: 50%; background: var(--blue); pointer-events: none;
    mix-blend-mode: exclusion;
  }

  .nav {
    position: fixed; inset-inline: 0; top: 0; z-index: 90;
    display: flex; align-items: flex-start; justify-content: space-between;
    padding: 20px 3vw; pointer-events: none;
  }
  .nav a { pointer-events: auto; }
  .mark { display: block; }
  .mark video {
    height: clamp(46px, 4.6vw, 68px); width: auto; display: block;
    filter: drop-shadow(0 5px 10px color-mix(in srgb, var(--ink) 26%, transparent));
    transition: scale 0.4s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .mark:hover video { scale: 1.05; }

  .btn {
    display: inline-block; position: relative; text-decoration: none; color: var(--ink);
    border: 1px solid var(--ink); border-radius: 999px; padding: 10px 22px;
    font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase;
    background: var(--ivory);
    transition: background 0.35s, color 0.35s;
    will-change: transform;
  }
  .btn .btn-in { display: inline-block; }
  .btn:hover { background: var(--ink); color: var(--ivory); }
  .btn.big { padding: 16px 34px; font-size: 13px; background: var(--ink); color: var(--ivory); }
  .btn.big:hover { background: var(--blue); border-color: var(--blue); }
  .btn.ghost { color: var(--ink); }

  .label { font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: var(--dim); }
  .label.dim { color: color-mix(in srgb, var(--dim) 70%, transparent); }

  /* maskowane linie */
  .ln { display: block; overflow: hidden; }
  .ln-in { display: inline-block; will-change: transform; }

  .hero { min-height: 100svh; display: flex; flex-direction: column; justify-content: center; padding: 18vh 3vw 10vh; }
  .hero h1 {
    font-family: 'NohemiV', 'ClashV', sans-serif; font-weight: 520; letter-spacing: -0.025em;
    font-size: clamp(3.2rem, 9.5vw, 9.8rem); line-height: 1.0; margin-top: 3vh;
  }
  .hero h1 em, .proj-d em, .manif em, .foot-h em {
    font-family: 'SentientV'; font-style: italic; font-weight: 380; letter-spacing: -0.01em;
  }
  .hero-b { display: flex; justify-content: flex-end; margin-top: 6vh; }
  .hero-sub { max-width: 40ch; font-size: clamp(1rem, 1.4vw, 1.2rem); line-height: 1.65; color: #4c483c; border-top: 1px solid color-mix(in srgb, var(--ink) 18%, transparent); padding-top: 1.4rem; }

  .work { padding: 10vh 3vw; }
  .sec-head { display: flex; justify-content: space-between; border-top: 1px solid color-mix(in srgb, var(--ink) 18%, transparent); padding-top: 1rem; margin-bottom: 10vh; }
  .proj { display: grid; grid-template-columns: 1fr 1fr; gap: 5vw; align-items: center; margin-bottom: 16vh; }
  .proj.flip .proj-t { order: 2; }
  .proj-t .idx { font-size: 12px; letter-spacing: 0.3em; color: var(--dim); }
  .proj-t h2 { font-family: 'NohemiV', 'ClashV', sans-serif; font-weight: 520; font-size: clamp(2.6rem, 6vw, 6rem); letter-spacing: -0.02em; margin: 0.6rem 0 1.4rem; }
  .proj-d { max-width: 40ch; font-size: clamp(1rem, 1.35vw, 1.15rem); line-height: 1.65; color: #4c483c; }
  .tlink { display: inline-block; margin-top: 1.6rem; color: var(--ink); text-decoration: none; font-size: 13px; letter-spacing: 0.18em; text-transform: uppercase; position: relative; }
  .tlink i { font-style: normal; margin-left: 8px; color: var(--blue); display: inline-block; transition: translate 0.3s; }
  .tlink::after { content: ""; position: absolute; left: 0; bottom: -5px; height: 1px; width: 100%; background: var(--ink); transform-origin: right; transition: transform 0.45s cubic-bezier(0.19, 1, 0.22, 1); }
  .tlink:hover::after { transform: scaleX(0.2); }
  .tlink:hover i { translate: 4px -4px; }
  .proj-f { display: flex; justify-content: center; }

  .manif { padding: 18vh 3vw; text-align: center; background: var(--ink); color: var(--ivory); }
  .manif-t { font-family: 'NohemiV', 'ClashV', sans-serif; font-weight: 460; font-size: clamp(1.9rem, 4.6vw, 4.4rem); line-height: 1.12; letter-spacing: -0.02em; }
  .manif em { color: var(--brand); }

  .serv { padding: 14vh 3vw; }
  .rows { margin-top: 5vh; }
  .srow {
    display: grid; grid-template-columns: 60px 1fr 1.2fr 40px; gap: 3vw; align-items: baseline;
    padding: 30px 6px; text-decoration: none; color: var(--ink);
    border-top: 1px solid color-mix(in srgb, var(--ink) 16%, transparent);

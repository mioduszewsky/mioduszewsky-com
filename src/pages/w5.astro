  .splat {
    position: fixed; z-index: 250; width: 150px; height: 150px;
    translate: -50% -50%; pointer-events: none;
  }
  /* podczas malowania sprayem: bez zaznaczania tekstu, kursor „celownik" */
  :global(body.spraying) { user-select: none; -webkit-user-select: none; cursor: crosshair; }
  .row-peek {
    /* poziomy kadr = hero z desktopu 1:1, bez ściskania strony do pionu */
    position: fixed; left: 0; top: 0; z-index: 80;
    width: min(360px, 28vw); aspect-ratio: 16 / 10; object-fit: cover; object-position: top;
    border-radius: 12px; pointer-events: none; opacity: 0;
    box-shadow: 0 24px 60px rgba(23, 21, 15, 0.32), 0 0 0 1px rgba(23, 21, 15, 0.08);
    will-change: transform;
  }
</style>

---
// W5 „ATELIER × WANDAL" — quiet luxury z warstwą buntu: sprayowe skreślenia,
// odręczne dopiski (Shantell Sans, pełny PL), splaty po kliknięciu.
// Baza: Clash Display + Sentient, Lenis, maskowane reveale, magnetyczne CTA.
import '@fontsource-variable/shantell-sans';
import VariantLayout from '../layouts/VariantLayout.astro';
import LanguageSwitch from '../components/LanguageSwitch.astro';
import PhoneFrame from '../components/frames/PhoneFrame.astro';
import { homePl } from '../content/home-pl';
import { routes, type Locale } from '../i18n/site';
import thumbWoodspot from '../assets/live/thumb-woodspot.webp';
import thumbGlassstone from '../assets/live/thumb-glassstone.webp';
import thumbCannversity from '../assets/live/thumb-cannversity.webp';

// Tryb prod (index): bez przełącznika wariantów, z indeksowaniem i meta description.
interface Props { prod?: boolean; title?: string; locale?: Locale; }
const { prod = false, title: titleProp, locale = 'en' } = Astro.props;
const isPl = locale === 'pl';
/* Polskie teksty to zwykle stringi, wiec zakreslacz nie mial jak w nich zaistniec
   (w wersji EN siedzi wprost w JSX). Gwiazdki w tresci znacza fraze do podkreslenia.
   Wstrzykujemy wlasny, statyczny tekst z content/, nie dane z zewnatrz. */
const mark = (s: string) => s.replace(/\*([^*]+)\*/g, '<em>$1</em>');
const p = isPl ? homePl : undefined;
const r = routes[locale];
const alt = routes[isPl ? 'en' : 'pl'];
const title = titleProp || p?.meta.title || 'W5 — ATELIER · mioduszewsky';

// Copy EN wg docs/strategy/LANDING_COPY_DRAFT.md (decyzja Kacpra 16.07.2026:
// strona po angielsku, ceny USD jak na Contrze).
// Flagowy produkt „Complete Website Build" = JEDEN produkt (decyzja 21.07.2026).
// Klient NIE wybiera landing vs company — to Kacper decyduje na rozmowie o zakresie.
// Landing/company to tylko widełki-przewodnik ceny, nie dwie osobne oferty do wyboru.
// Plan projektu zdjęty ze strony (zostaje na Contrze); reszta = dodatki „beyond the website".
const beyondEn = [
  { nr: '01', n: 'AI implementation', p: 'from $1,200', d: 'For companies that already have customers and want to improve a specific process. I map it, define what to automate and build the workflow, agent, integration or dashboard.' },
  { nr: '02', n: 'Application or system', p: 'from $3,000', d: 'A first working version of a product, application, dashboard or business system. Something that works for the business from day one.' },
  { nr: '03', n: 'Build + Iterate', p: 'from $1,500 / mo', d: 'Ongoing development after launch for selected projects: maintenance, iterations, product decisions and new versions.' },
];
const beyond = p?.offer.beyond || beyondEn;
/* Manifest: spray przekresla fraze z pierwszej linii. Tekst zostaje jednym stringiem
   w tresci, a tutaj dzielimy go na trzy czesci — inaczej kazdy jezyk musialby trzymac
   zdanie w kawalkach i latwo bylo je rozjechac przy redakcji. */
const manifLine1 = p?.manifest.line1 || 'The goal is not another step.';
const manifCross = p?.manifest.cross || 'another step';
const crossAt = manifLine1.indexOf(manifCross);
const manifPre = crossAt >= 0 ? manifLine1.slice(0, crossAt) : manifLine1;
const manifHit = crossAt >= 0 ? manifCross : '';
const manifPost = crossAt >= 0 ? manifLine1.slice(crossAt + manifCross.length) : '';
---

<VariantLayout
  title={title}
  bg="#f8f9f2"
  fg="#000000"
  switcher={!prod}
  robots={prod ? 'index, follow, max-image-preview:large' : undefined}
  description={prod ? (p?.meta.description || 'Landing pages, company websites, AI implementations and web apps. One person from idea to launch: strategy, copy, design and build.') : undefined}
  locale={locale}
  alternatePath={alt.home}
>
  <main class="w5">
    <!-- Wspólne filtry spray (inline SVG = działa też w Safari) -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <filter id="sprayF" x="-40%" y="-40%" width="180%" height="180%">
          <feTurbulence type="fractalNoise" baseFrequency="0.55" numOctaves="2" result="n" />
          <feDisplacementMap in="SourceGraphic" in2="n" scale="14" />
          <feGaussianBlur stdDeviation="0.55" />
        </filter>
        <filter id="sprayMist" x="-60%" y="-60%" width="220%" height="220%">
          <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="3" result="n" />
          <feDisplacementMap in="SourceGraphic" in2="n" scale="30" />
          <feGaussianBlur stdDeviation="1.6" />
        </filter>
      </defs>
    </svg>

    <!-- Kurtyna wejściowa -->
    <div class="veil" aria-hidden="true">
      <!-- Mobile bierze mały wariant nav (200-560 KB zamiast 1.3-2 MB) — na
           ~370px szerokości kurtyny pełna rozdzielczość i tak się nie przydaje -->
      <video class="veil-word" autoplay loop muted playsinline preload="auto" poster="/logo3d/logo-poster.webp">
        <source src="/logo3d/logo-nav.mp4" type="video/mp4;codecs=hvc1" media="(max-width: 640px)" />
        <source src="/logo3d/logo-nav.webm" type="video/webm" media="(max-width: 640px)" />
        <source src="/logo3d/logo.mp4" type="video/mp4;codecs=hvc1" />
        <source src="/logo3d/logo.webm" type="video/webm" />
      </video>
    </div>

    <!-- Custom cursor -->
    <div class="cur" aria-hidden="true"></div>

    <!-- Watchdog: gdy główny moduł JS nie wstanie (błąd sieci, stary browser),
         kurtyna NIE może zostać na ekranie na zawsze. Inline = działa zawsze. -->
    <script is:inline>
      setTimeout(function () {
        if (!window.__w5ok) document.documentElement.classList.add('js-stalled');
      }, 5000);
    </script>
    <noscript>
      <style>
        .veil { display: none !important; }
        .cur { display: none !important; }
      </style>
    </noscript>

    <header class="nav">
      <a class="mark" href={r.home} aria-label={isPl ? 'mioduszewsky. Wróć na początek strony.' : 'mioduszewsky'}>
        <video autoplay loop muted playsinline preload="auto" aria-hidden="true" poster="/logo3d/logo-nav-poster.webp">
          <source src="/logo3d/logo-nav.mp4" type="video/mp4;codecs=hvc1" />
          <source src="/logo3d/logo-nav.webm" type="video/webm" />
        </video>
      </a>
      <div class="nav-actions">
        <LanguageSwitch locale={locale} href={alt.home} />
        <a class="btn mag" href={r.contact}><span class="btn-in">{p?.nav.cta || 'Book a call'}</span></a>
      </div>
    </header>

    <!-- Sticky CTA (pojawia się po zjechaniu z hero). Wrapper trzyma slide-in/centrowanie
         (transform), .sticky-cta w środku jest .mag i dostaje SWÓJ własny transform od
         magnetyzmu — rozdzielone, żeby oba się nie nadpisywały. -->
    <div class="sticky-cta-wrap">
      <a class="sticky-cta mag" href={r.contact} aria-label={p?.nav.stickyAria || 'Book a 15-minute call'}>
        <span class="btn-in">{p?.nav.sticky || 'Book a 15-min call'}</span>
        <i aria-hidden="true">→</i>
      </a>
    </div>

    <!-- HERO + PROBLEM: sprayowa nitka rysowana scrollem -->
    <div class="thread-zone">
      <div class="thread t-wide" data-start="560,13" data-end-y="566" data-max-w="760" aria-hidden="true">
        <svg viewBox="0 0 600 600" fill="none">
          <path class="td" pathLength="1" d="M560 13 C 606 84, 470 126, 380 154 C 290 182, 250 231, 300 287 C 350 340, 470 350, 452 406 C 442 456, 432 512, 440 566 L 410 538 L 440 566 L 470 538" />
        </svg>
      </div>
    <!-- HERO -->
    <section class="hero">
      <p class="label rv">{p?.hero.label || '( Websites · AI · Apps )'}</p>
      {isPl ? (
        <h1 aria-label={p!.hero.aria}>
          <span class="ln"><span class="ln-in">{p!.hero.line1}</span></span>
          <span class="ln"><span class="ln-in"><em>{p!.hero.em}</em> <span class="hero-end">{p!.hero.line3}<span class="spray-dot" aria-hidden="true"><svg viewBox="0 0 60 60"><circle cx="30" cy="30" r="15" /></svg></span></span></span></span>
        </h1>
      ) : (
        <h1>
          <span class="ln"><span class="ln-in">A <span class="fix">generic<svg class="strike" viewBox="0 0 200 44" preserveAspectRatio="none" aria-hidden="true"><g class="strike-mist" filter="url(#sprayMist)"><path d="M6 25 C 60 18, 138 30, 194 21" /><path d="M10 33 C 68 26, 132 37, 190 26" /></g><g class="strike-ink" filter="url(#sprayF)"><path class="draw" d="M6 25 C 60 18, 138 30, 194 21" /><path class="draw" d="M10 33 C 68 26, 132 37, 190 26" /></g></svg><span class="tag tag-fix" aria-hidden="true">working!</span></span> website</span></span>
          <span class="ln"><span class="ln-in">you can <em>finally</em></span></span>
          <span class="ln"><span class="ln-in">send people <span class="hero-end">to<span class="spray-dot" aria-hidden="true"><svg viewBox="0 0 60 60"><circle cx="30" cy="30" r="15" /></svg></span></span></span></span>
        </h1>
      )}
      <div class="hero-b">
        <div class="hero-cta rv">
          <a class="btn mag big" href={r.contact}><span class="btn-in">{p?.nav.sticky || 'Book a 15-min call'}</span></a>
        </div>
        <p class="hero-sub rv">
          {p?.hero.sub ? <Fragment set:html={mark(p.hero.sub)} /> : <Fragment>I plan, write, design and build your website, start to finish. <em>One person</em> takes the project from an idea to a working page.</Fragment>}
        </p>
      </div>
    </section>

    <!-- LEAD: problem, który biorę na siebie -->
    <section class="lead">
      <p class="label rv">{p?.problem.label || '( The problem )'}</p>
      <h2 class="sec-h">
        <span class="ln"><span class="ln-in">{p?.problem.h1 || 'Having a website is not the same'}</span></span>
        <span class="ln"><span class="ln-in">{p?.problem.h2 ? <Fragment set:html={mark(p.problem.h2)} /> : <Fragment>as having one you <em>trust</em>.</Fragment>}</span></span>
      </h2>
      <p class="lead-intro rv">{p?.problem.intro || 'Maybe you have not started yet. Maybe it stalled somewhere. Or maybe it works, just not hard enough. It usually goes one of these ways:'}</p>
      <div class="lead-rows">
        <div class="lrow rv">
          <span class="idx">01</span>
          <h3>{p?.problem.rows[0][0] || 'You do not know where to start'}</h3>
          <p>{p?.problem.rows[0][1] || 'A developer, a designer, a copywriter, or all three? So the idea stays an idea.'}</p>
        </div>
        <div class="lrow rv">
          <span class="idx">02</span>
          <h3>{p?.problem.rows[1][0] || 'The website stayed behind'}</h3>
          <p>{p?.problem.rows[1][1] || 'Your business grew, the website did not.'}</p>
        </div>
        <div class="lrow rv">
          <span class="idx">03</span>
          <h3>{p?.problem.rows[2][0] || 'You tried AI'}</h3>
          <p>{p?.problem.rows[2][1] || 'It gave you a page fast, but the offer stayed unclear.'}</p>
        </div>
      </div>
      <p class="lead-close rv">{p?.problem.close ? <Fragment set:html={mark(p.problem.close)} /> : <Fragment>So the problem is rarely another tool. It is knowing what to build, and whether the result is ready to meet customers. <em>That is the part I take off your plate.</em></Fragment>}</p>
    </section>
    </div>

    <!-- REALIZACJE -->
    <section class="work">
      <div class="sec-head">
        <p class="label rv">{p?.work.label || 'Selected work'}</p>
        <p class="label dim rv">{p?.work.hint || '( these are not screenshots, but live websites )'}</p>
      </div>

      <article class="proj">
        <div class="proj-t">
          <span class="ln"><span class="ln-in idx">№ 01</span></span>
          <h2 class="ln"><span class="ln-in">eskapizm</span></h2>
          <p class="proj-d rv">{p?.work.eskapizm || <Fragment>A travel-planning platform: public website, sales flow, checkout, client application, content management and operational tools. <em>Designed and built from zero, as one connected system.</em></Fragment>}</p>
          <a class="tlink rv" href="https://eskapizm.com" target="_blank" rel="noopener">eskapizm.com<i aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7" /><path d="M8 7h9v9" /></svg></i></a>
        </div>
        <div class="proj-f" data-parallax>
          <div class="phone-hold">
            <PhoneFrame url={isPl ? 'https://eskapizm.com' : 'https://eskapizm.com/en'} alt={p?.work.eskapizmAlt || 'eskapizm.com - scroll it'} screenbg="#fbfff7" fallbackText={isPl ? 'strona chwilowo się nie ładuje' : undefined} fallbackLinkText={isPl ? 'otwórz w nowej karcie ↗' : undefined} />
            <div class="spray-note" aria-hidden="true">
              <svg viewBox="0 0 160 90"><path d="M8 76 C 50 66, 96 44, 138 18 M 116 20 L 140 16 L 136 40" /></svg>
              <span class="tag">{isPl ? <Fragment>psst, działa.<br />przewiń</Fragment> : <Fragment>psst, it's live.<br />scroll it!</Fragment>}</span>
            </div>
          </div>
        </div>
      </article>

      <article class="proj flip">
        <div class="proj-t">
          <span class="ln"><span class="ln-in idx">№ 02</span></span>
          <h2 class="ln"><span class="ln-in">aigor.grabowski</span></h2>
          <p class="proj-d rv">{p?.work.aigor || <Fragment>A website for an art collection: works, artists and acquisition history. <em>Designed to sell a story.</em></Fragment>}</p>
        </div>
        <div class="proj-f" data-parallax>
          <div class="phone-hold">
            <PhoneFrame url={isPl ? 'https://www.igorgrabowski.com/' : 'https://www.igorgrabowski.com/?lang=en'} alt={p?.work.aigorAlt || 'igorgrabowski.com - scroll it'} fallbackText={isPl ? 'strona chwilowo się nie ładuje' : undefined} fallbackLinkText={isPl ? 'otwórz w nowej karcie ↗' : undefined} />
            <div class="spray-note spray-note-r" aria-hidden="true">
              <svg viewBox="0 0 160 90"><path d="M8 76 C 50 66, 96 44, 138 18 M 116 20 L 140 16 L 136 40" /></svg>
              <span class="tag">{isPl ? <Fragment>to one pager.<br />tu klikasz</Fragment> : <Fragment>it's a one pager.<br />click around</Fragment>}</span>
            </div>
          </div>
        </div>
      </article>

      <div class="more">
        <p class="label rv">{p?.work.more || 'More work'}</p>
        <a class="mrow rv" href="https://glassstone.pl" target="_blank" rel="noopener" data-thumb={thumbGlassstone.src}>
          <span class="mname">GlassStone</span>
          <span class="mdesc">{p?.work.glassstone || 'Company website with a portfolio gallery, publishing tools and an admin panel. A system the business keeps using after launch.'}</span>
          <span class="sarr" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7" /><path d="M8 7h9v9" /></svg></span>
        </a>
        <a class="mrow rv" href="https://www.cannversity.com" target="_blank" rel="noopener" data-thumb={thumbCannversity.src}>
          <span class="mname">Cannversity</span>
          <span class="mdesc">{p?.work.cannversity || 'A platform translating a complex offer and a broader strategy into a structure people can understand and navigate.'}</span>
          <span class="sarr" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7" /><path d="M8 7h9v9" /></svg></span>
        </a>
        <!-- Wewnętrzny dokument, nie strona publiczna: bez linku, tylko podgląd na hover -->
        <div class="mrow mrow-static rv" data-thumb={thumbWoodspot.src}>
          <span class="mname">{p?.work.decksName || 'Internal project decks'}</span>
          <span class="mdesc">{p?.work.decks || 'Interactive presentations and financial models connecting an idea to real limits and a business decision.'}</span>
        </div>
        <p class="work-note rv">{p?.work.disclaimer || 'These examples show the scope and type of work delivered, not proof of guaranteed revenue, conversion or cost savings.'}</p>
      </div>
    </section>

    <!-- MANIFEST: czarny panel rozrasta się do pełnej szerokości na scrollu -->
    <section class="manif">
      <div class="manif-in">
        <p class="manif-t">
          <span class="ln"><span class="ln-in">{manifPre}<span class="fix">{manifHit}<svg class="strike manif-strike" viewBox="0 0 200 44" preserveAspectRatio="none" aria-hidden="true"><g class="strike-mist manif-mist" filter="url(#sprayMist)"><path d="M6 25 C 60 18, 138 30, 194 21" /><path d="M10 33 C 68 26, 132 37, 190 26" /></g><g class="strike-ink" filter="url(#sprayF)"><path class="mdraw" d="M6 25 C 60 18, 138 30, 194 21" /><path class="mdraw" d="M10 33 C 68 26, 132 37, 190 26" /></g></svg></span>{manifPost}</span></span>
          <span class="ln"><span class="ln-in">{p?.manifest.line2 ? <Fragment set:html={mark(p.manifest.line2)} /> : <Fragment>It is the <em>last</em> one.</Fragment>}</span></span>
          <span class="ln"><span class="ln-in">{p?.manifest.line3 || 'You go live.'}</span></span>
        </p>
        <p class="manif-sub rv">{p?.manifest.sub || 'Send it in an email. Run a campaign to it. Show it to a customer. Build on it after launch.'}</p>
      </div>
    </section>

    <!-- JAK PRACUJĘ (OLD vs NEW + WHY ME z draftu) -->
    <section class="how">
      <p class="label rv">{p?.how.label || '( How I work )'}</p>
      <h2 class="sec-h">
        <span class="ln"><span class="ln-in">{p?.how.h1 || 'A good website is not the one'}</span></span>
        <span class="ln"><span class="ln-in">{p?.how.h2 || <Fragment>with the <em>most polish</em>.</Fragment>}</span></span>
      </h2>
      <div class="how-cols">
        <div class="how-col rv">
          <h3 class="how-t how-t-old"><span class="fix">{p?.how.oldTitle || 'The usual way'}<svg class="strike strike-sm" viewBox="0 0 200 44" preserveAspectRatio="none" aria-hidden="true"><g filter="url(#sprayF)"><path d="M6 25 C 60 18, 138 30, 194 21" /></g></svg></span></h3>
          <ol class="how-list">
            {(p?.how.oldList || ['You write a brief.', 'Someone designs the page.', 'Someone else writes the copy.', 'A developer receives the files later.', 'Every person sees one part of the project.']).map((item) => <li>{item}</li>)}
          </ol>
          {(p ? p.how.oldOut : 'You become the person responsible for making sure those parts still fit together.') && (
            <p class="how-out">{p?.how.oldOut || 'You become the person responsible for making sure those parts still fit together.'}</p>
          )}
        </div>
        <div class="how-col rv">
          <h3 class="how-t">{p?.how.newTitle || 'The way I work'}</h3>
          <ol class="how-list">
            {(p?.how.newList || ['What are you selling?', 'Who needs to understand it?', 'What should they do after visiting the page?', 'What must be included and what can be removed?', 'Only then do I write, design and build.']).map((item) => <li>{item}</li>)}
          </ol>
          <p class="how-out">{p?.how.newOut ? <Fragment set:html={mark(p.how.newOut)} /> : <Fragment>You speak directly with <em>the person doing the work</em>, the whole way through.</Fragment>}</p>
        </div>
      </div>
      <div class="how-why">
        {isPl ? (
          <>
            <p class="how-why-t rv how-why-full how-me">Siemka, tu <span class="lp" data-lp="/about/me-portrait.jpg" data-tilt="-4">Kacper</span>. Zanim zacząłem robić strony, pracowałem przy prowadzeniu projektów i startupów. Designu i developmentu nauczyłem się później, bo chciałem sam zamieniać pomysły w działające produkty.</p>
            <p class="how-why-t rv">Biorę to, co masz w głowie i w biznesie, i przekładam na <span class="lp" data-tap data-lp="/about/building.jpg" data-tilt="-3">działającą stronę</span>. Patrzę na cały ciąg: <em>decyzja, oferta, treść, design, wdrożenie i publikacja</em>.</p>
            <p class="how-why-t rv how-why-full"><span class="lp" data-tap data-lp="/about/eskapizm.jpg" data-tilt="4">eskapizm</span> to spółka, którą współprowadzę. <span class="dim2"><span class="lp" data-tap data-lp="/about/cannversity.jpg" data-tilt="-2">Cannversity</span> powstało, kiedy wchodziłem głębiej w branżę konopną.</span> Oba nauczyły mnie patrzeć na stronę przez pryzmat tego, co ma zrobić dla firmy.</p>
          </>
        ) : (
          <>
            <p class="how-why-t rv how-why-full how-me">Behind mioduszewsky there is one person, not an agency. I am <span class="lp" data-lp="/about/me-portrait.jpg" data-tilt="-4">Kacper</span>, and I build from Wrocław. I build things to keep working long after the first impression fades.</p>
            <p class="how-why-t rv">I am not the best specialist in every single discipline. <span class="dim2">A dedicated designer may draw a prettier system. A specialist developer may write more advanced code.</span> But depth in one craft is not what makes the whole thing work.</p>
            <p class="how-why-t rv">I work across the points where projects usually break: <em>the decision, the offer, the design, the build, the launch</em>. One system, by one person.</p>
            <p class="how-why-t rv how-why-full"><span class="lp" data-tap data-lp="/about/eskapizm.jpg" data-tilt="4">eskapizm</span> and <span class="lp" data-tap data-lp="/about/cannversity.jpg" data-tilt="-2">Cannversity</span>, shown above, are not client work. <span class="dim2">They are my own projects.</span> I run this exact system on <span class="lp" data-tap data-lp="/about/building.jpg" data-tilt="-3">my own business</span> before I ever run it on yours.</p>
          </>
        )}
      </div>
    </section>

    <!-- OFERTA: flagowy „Complete website build" (2 poziomy) + dodatki -->
    <section class="serv">
      <p class="label rv">{p?.offer.label || '( The offer )'}</p>

      <div class="deal">
        <span class="deal-grain" aria-hidden="true"></span>

        <div class="deal-top">
          <div class="deal-main">
            <span class="deal-badge rv">{p?.offer.badge || '30-day launch warranty'}</span>
            <h2 class="deal-h">
              <span class="ln"><span class="ln-in deal-h1">{p?.offer.h1 || 'Complete website'}</span></span>
              <span class="ln"><span class="ln-in deal-h2">{p?.offer.h2 || 'build'}<span class="spray-dot deal-dot" aria-hidden="true"><svg viewBox="0 0 60 60"><circle cx="30" cy="30" r="16" /></svg></span><svg class="deal-strike" viewBox="0 0 300 30" preserveAspectRatio="none" aria-hidden="true"><g class="strike-mist" filter="url(#sprayMist)"><path d="M8 17 C 82 9, 214 22, 292 12" /></g><g class="strike-ink" filter="url(#sprayF)"><path class="draw" d="M8 17 C 82 9, 214 22, 292 12" /><path class="draw" d="M12 23 C 90 15, 206 25, 288 17" /></g></svg></span></span>
            </h2>
            <p class="deal-price rv">{isPl ? <Fragment set:html={mark(p!.offer.price)} /> : <Fragment>from <b>$1,000</b></Fragment>}</p>
            <p class="deal-say rv">{p?.offer.say || 'A website that makes your offer clear and looks professional enough to put in front of customers, partners or investors. On our first call I tell you whether you need a landing page or a full company site, so you do not have to figure that out yourself.'}</p>
            {/* say2 zdjete 24.08: powtarzalo obietnice z „assure" i robilo z oferty scianke tekstu */}

---
// W5 „ATELIER × WANDAL" — quiet luxury z warstwą buntu: sprayowe skreślenia,
// odręczne dopiski (Shantell Sans, pełny PL), splaty po kliknięciu.
// Baza: Clash Display + Sentient, Lenis, maskowane reveale, magnetyczne CTA.
import '@fontsource-variable/shantell-sans';
import VariantLayout from '../layouts/VariantLayout.astro';
import PhoneFrame from '../components/frames/PhoneFrame.astro';
import thumbWoodspot from '../assets/live/thumb-woodspot.webp';
import thumbGlassstone from '../assets/live/thumb-glassstone.webp';
import thumbCannversity from '../assets/live/thumb-cannversity.webp';

// Tryb prod (index): bez przełącznika wariantów, z indeksowaniem i meta description.
interface Props { prod?: boolean; title?: string; }
const { prod = false, title = 'W5 — ATELIER · mioduszewsky' } = Astro.props;

// Copy EN wg docs/strategy/LANDING_COPY_DRAFT.md (decyzja Kacpra 16.07.2026:
// strona po angielsku, ceny USD jak na Contrze).
const services = [
  { nr: '01', n: 'Landing page', p: 'from $1,000', d: 'One page built around one clear goal: a service, product, campaign, launch or lead-generation offer. Offer structure, copy, design, build and launch.' },
  { nr: '02', n: 'Company website', p: 'from $1,500', d: 'A complete website for a company, personal brand or project. A credible place to send customers, partners and leads.' },
  { nr: '03', n: 'Project plan', p: 'from $1,000', d: 'For people who have an idea but do not yet know what should be built first. A defined direction, scope and order of work before you spend money on the build.', tag: true },
  { nr: '04', n: 'AI implementation', p: 'from $1,200', d: 'For companies that already have customers and want to improve a specific process. I map it, define what to automate and build the workflow, agent, integration or dashboard.' },
  { nr: '05', n: 'Application or system', p: 'from $3,000', d: 'A first working version of a product, application, dashboard or business system. Something that works for the business from day one.' },
];
---

<VariantLayout
  title={title}
  bg="#f8f9f2"
  fg="#000000"
  switcher={!prod}
  robots={prod ? 'index, follow, max-image-preview:large' : undefined}
  description={prod ? 'Landing pages, company websites, AI implementations and web apps. One person from idea to launch: strategy, copy, design and build.' : undefined}
>
  <main class="w5">
    <!-- Wspólne filtry spray (inline SVG = działa też w Safari) -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <filter id="sprayF" x="-40%" y="-40%" width="180%" height="180%">
          <feTurbulence type="fractalNoise" baseFrequency="0.55" numOctaves="2" result="n" />
          <feDisplacementMap in="SourceGraphic" in2="n" scale="14" />
          <feGaussianBlur stdDeviation="0.55" />
        </filter>
        <filter id="sprayMist" x="-60%" y="-60%" width="220%" height="220%">
          <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="3" result="n" />
          <feDisplacementMap in="SourceGraphic" in2="n" scale="30" />
          <feGaussianBlur stdDeviation="1.6" />
        </filter>
      </defs>
    </svg>

    <!-- Kurtyna wejściowa -->
    <div class="veil" aria-hidden="true">
      <video class="veil-word" autoplay loop muted playsinline preload="auto" poster="/logo3d/logo-poster.webp">
        <source src="/logo3d/logo.mp4" type="video/mp4;codecs=hvc1" />
        <source src="/logo3d/logo.webm" type="video/webm" />
      </video>
    </div>

    <!-- Custom cursor -->
    <div class="cur" aria-hidden="true"></div>

    <header class="nav">
      <a class="mark" href="#" aria-label="mioduszewsky">
        <video autoplay loop muted playsinline preload="auto" aria-hidden="true" poster="/logo3d/logo-nav-poster.webp">
          <source src="/logo3d/logo-nav.mp4" type="video/mp4;codecs=hvc1" />
          <source src="/logo3d/logo-nav.webm" type="video/webm" />
        </video>
      </a>
      <a class="btn mag" href="/contact"><span class="btn-in">Book a call</span></a>
    </header>

    <!-- Sticky CTA (pojawia się po zjechaniu z hero) -->
    <a class="sticky-cta" href="/contact" aria-label="Book a 15-minute call">
      <span>Book a 15-min call</span>
      <i aria-hidden="true">→</i>
    </a>

    <!-- HERO -->
    <section class="hero">
      <p class="label rv">( Websites · Apps · Project plans )</p>
      <h1>
        <span class="ln"><span class="ln-in">A <span class="fix">generic<svg class="strike" viewBox="0 0 200 44" preserveAspectRatio="none" aria-hidden="true"><g class="strike-mist" filter="url(#sprayMist)"><path d="M6 25 C 60 18, 138 30, 194 21" /><path d="M10 33 C 68 26, 132 37, 190 26" /></g><g class="strike-ink" filter="url(#sprayF)"><path class="draw" d="M6 25 C 60 18, 138 30, 194 21" /><path class="draw" d="M10 33 C 68 26, 132 37, 190 26" /></g></svg><span class="tag tag-fix" aria-hidden="true">working!</span></span> website</span></span>
        <span class="ln"><span class="ln-in">you can <em>finally</em></span></span>
        <span class="ln"><span class="ln-in">send people to<span class="spray-dot" aria-hidden="true"><svg viewBox="0 0 60 60"><circle cx="30" cy="30" r="15" filter="url(#sprayMist)" /></svg></span></span></span>
      </h1>
      <div class="hero-b">
        <div class="hero-cta rv">
          <a class="btn mag big" href="/contact"><span class="btn-in">Book a 15-min call</span></a>
          <p class="hero-price">Landing pages from $1,000 · Company websites from $1,500</p>
        </div>
        <p class="hero-sub rv">
          I plan, write, design and build landing pages and company websites.
          One person takes the project from an idea to a working page.
          No agency handovers. No design made in isolation.
        </p>
      </div>
    </section>

    <!-- LEAD: problem, który biorę na siebie -->
    <section class="lead">
      <p class="label rv">( The problem )</p>
      <h2 class="sec-h">
        <span class="ln"><span class="ln-in">Having a website is not the same</span></span>
        <span class="ln"><span class="ln-in">as having one you <em>trust</em>.</span></span>
      </h2>
      <div class="lead-rows">
        <div class="lrow rv">
          <span class="idx">01</span>
          <h3>You do not know where to start</h3>
          <p>Is that a developer, a designer, a copywriter, or all three?</p>
        </div>
        <div class="lrow rv">
          <span class="idx">02</span>
          <h3>You tried AI</h3>
          <p>It generated a page, but customers may not understand the offer.</p>
        </div>
        <div class="lrow rv">
          <span class="idx">03</span>
          <h3>Someone technical built it</h3>
          <p>It works. It also looks like something made by someone technical.</p>
        </div>
        <div class="lrow rv">
          <span class="idx">04</span>
          <h3>A designer sent polished screens</h3>
          <p>The project stopped before the website became part of the business.</p>
        </div>
      </div>
      <p class="lead-close rv">The problem is rarely access to another tool. It is knowing what to build and whether the result is ready to meet customers. <em>That is the part I take responsibility for.</em></p>
    </section>

    <!-- REALIZACJE -->
    <section class="work">
      <div class="sec-head">
        <p class="label rv">Selected work</p>
        <p class="label dim rv">( the screens scroll, these are live projects )</p>
      </div>

      <article class="proj">
        <div class="proj-t">
          <span class="ln"><span class="ln-in idx">№ 01</span></span>
          <h2 class="ln"><span class="ln-in">eskapizm</span></h2>
          <p class="proj-d rv">
            A travel-planning platform: public website, sales flow, checkout, client
            application, content management and operational tools.
            <em>Designed and built from zero, as one connected system.</em>
          </p>
          <a class="tlink rv" href="https://eskapizm.com" target="_blank" rel="noopener">eskapizm.com<i>↗</i></a>
        </div>
        <div class="proj-f" data-parallax>
          <div class="phone-hold">
            <PhoneFrame url="https://eskapizm.com/en" alt="eskapizm.com - scroll it" screenbg="#fbfff7" />
            <div class="spray-note" aria-hidden="true">
              <svg viewBox="0 0 160 90"><path d="M8 76 C 50 66, 96 44, 138 18 M120 14 L 140 16 L 132 36" filter="url(#sprayF)" /></svg>
              <span class="tag">psst, it's live.<br />scroll it!</span>
            </div>
          </div>
        </div>
      </article>

      <article class="proj flip">
        <div class="proj-t">
          <span class="ln"><span class="ln-in idx">№ 02</span></span>
          <h2 class="ln"><span class="ln-in">aigor.grabowski</span></h2>
          <p class="proj-d rv">
            A website for an AI-art collection: works, artists and acquisition
            history. <em>Designed to sell a story.</em>
          </p>
        </div>
        <div class="proj-f" data-parallax>
          <PhoneFrame url="https://www.igorgrabowski.com/?lang=en" alt="igorgrabowski.com - scroll it" />
        </div>
      </article>

      <div class="more">
        <p class="label rv">More work</p>
        <a class="mrow rv" href="https://glassstone.pl" target="_blank" rel="noopener" data-thumb={thumbGlassstone.src}>
          <span class="mname">GlassStone</span>
          <span class="mdesc">Company website with a portfolio gallery, publishing tools and an admin panel. A system the business keeps using after launch.</span>
          <span class="sarr">↗</span>
        </a>
        <a class="mrow rv" href="https://www.cannversity.com" target="_blank" rel="noopener" data-thumb={thumbCannversity.src}>
          <span class="mname">Cannversity</span>
          <span class="mdesc">A platform translating a complex offer and a broader strategy into a structure people can understand and navigate.</span>
          <span class="sarr">↗</span>
        </a>
        <!-- Wewnętrzny dokument, nie strona publiczna: bez linku, tylko podgląd na hover -->
        <div class="mrow mrow-static rv" data-thumb={thumbWoodspot.src}>
          <span class="mname">Private event platform</span>
          <span class="mdesc">An internal deck prepared to start the project: interactive presentation and a financial model connecting the event concept, operational limits and business decisions.</span>
        </div>
        <p class="work-note rv">These examples show the scope and type of work delivered, not proof of guaranteed revenue, conversion or cost savings.</p>
      </div>
    </section>

    <!-- MANIFEST: czarny panel rozrasta się do pełnej szerokości na scrollu -->
    <section class="manif">
      <div class="manif-in">
        <p class="manif-t">
          <span class="ln"><span class="ln-in">The goal is not to give you</span></span>
          <span class="ln"><span class="ln-in"><em>more files.</em></span></span>
          <span class="ln"><span class="ln-in">It is a page you can use. <span class="tag tag-manif" aria-hidden="true">for real.</span></span></span>
        </p>
        <p class="manif-sub rv">Send it in an email. Run a campaign to it. Show it to a customer. Build on it after launch.</p>
      </div>
    </section>

    <!-- JAK PRACUJĘ (OLD vs NEW + WHY ME z draftu) -->
    <section class="how">
      <p class="label rv">( How I work )</p>
      <h2 class="sec-h">
        <span class="ln"><span class="ln-in">A good website is not the one</span></span>
        <span class="ln"><span class="ln-in">with the <em>most polish</em>.</span></span>
      </h2>
      <div class="how-cols">
        <div class="how-col rv">
          <h3 class="how-t how-t-old"><span class="fix">The usual way<svg class="strike strike-sm" viewBox="0 0 200 44" preserveAspectRatio="none" aria-hidden="true"><g filter="url(#sprayF)"><path d="M6 25 C 60 18, 138 30, 194 21" /></g></svg></span></h3>
          <ol class="how-list">
            <li>You write a brief.</li>
            <li>Someone designs the page.</li>
            <li>Someone else writes the copy.</li>
            <li>A developer receives the files later.</li>
            <li>Every person sees one part of the project.</li>
          </ol>
          <p class="how-out">You become the person responsible for making sure those parts still fit together.</p>
        </div>
        <div class="how-col rv">
          <h3 class="how-t">The way I work</h3>
          <ol class="how-list">
            <li>What are you selling?</li>
            <li>Who needs to understand it?</li>
            <li>What should they do after visiting the page?</li>
            <li>What must be included and what can be removed?</li>
            <li>Only then do I write, design and build.</li>
          </ol>
          <p class="how-out">You speak directly with the person doing the work, from the first conversation to launch.</p>
        </div>
      </div>
      <div class="how-why">
        <p class="how-why-t rv">I am not the best specialist in every single discipline. <span class="dim2">A dedicated designer may draw a prettier system. A specialist developer may write more advanced code.</span> That is not the comparison I am trying to win.</p>
        <p class="how-why-t rv">I work across the points where projects usually break: <em>the decision, the offer, the design, the build, the launch</em>. One system, by one person.</p>
        <p class="how-why-t rv how-why-full">eskapizm and Cannversity, shown above, are not client work. <span class="dim2">They are my own companies.</span> I run this exact system on my own business before I ever run it on yours.</p>
      </div>
    </section>

    <!-- USŁUGI -->
    <section class="serv">
      <p class="label rv">( Services )</p>
      <h2 class="sec-h">
        <span class="ln"><span class="ln-in">Choose what needs</span></span>
        <span class="ln"><span class="ln-in">to <em>exist first</em>.</span></span>
      </h2>
      <div class="rows">
        {services.map((u) => (
          <a class="srow" href={`/contact?service=${encodeURIComponent(u.n)}`}>
            <span class="idx idx-wrap">
              {u.nr}
              {u.tag && (
                <svg class="spray-circle" viewBox="0 0 90 60" aria-hidden="true">
                  <path class="draw" d="M22 14 C 48 4, 84 12, 85 29 C 86 46, 56 56, 30 52 C 8 48, 2 34, 14 22 C 20 16, 30 12, 38 11" filter="url(#sprayF)" />
                </svg>
              )}
            </span>
            <span class="sname">{u.n}</span>
            <span class="sdesc">{u.d}</span>
            <span class="sprice">{u.p}</span>
            <span class="sarr">↗</span>
            {u.tag && <span class="tag tag-row" aria-hidden="true">where I'd start</span>}
          </a>
        ))}
      </div>
      <p class="serv-note rv">Long-term advertising, ongoing SEO and guaranteed sales results are not part of the scope.</p>
    </section>

    <!-- PROCES -->
    <section class="proc">
      <p class="label rv">( Process )</p>
      <h2 class="sec-h">
        <span class="ln"><span class="ln-in">What working together</span></span>
        <span class="ln"><span class="ln-in"><em>actually</em> looks like.</span></span>
      </h2>
      <div class="proc-flow">
        <article class="pstep rv">
          <span class="pn">01</span>
          <h3>We talk about the business</h3>
          <p>What exists today, what needs to change and what the project should achieve.</p>
        </article>
        <article class="pstep rv">
          <span class="pn">02</span>
          <h3>I define the scope</h3>
          <p>A clear proposal: what will be built, what is not included and how it is priced.</p>
        </article>
        <article class="pstep rv">
          <span class="pn">03</span>
          <h3>You <span class="hl-y">book the build</span></h3>
          <p>Work is paid upfront: in full for small projects, stage by stage for larger ones.</p>
        </article>
        <article class="pstep rv">
          <span class="pn">04</span>
          <h3>I build it</h3>
          <p>The same person who discussed the business writes, designs and implements.</p>
        </article>
        <article class="pstep rv">
          <span class="pn">05</span>
          <h3>We launch</h3>
          <p>The page or system goes live and starts receiving real use.</p>
        </article>
        <article class="pstep rv">
          <span class="pn">06</span>
          <h3>We iterate when it helps</h3>
          <p>Ongoing development for selected projects. Build + Iterate from $1,500 per month.</p>
        </article>
      </div>
    </section>

    <!-- FAQ (+ „czego nie obiecuję" z draftu) -->
    <section class="faq">
      <p class="label rv">( Fair questions )</p>
      <div class="faq-list">
        <details class="rv">
          <summary>Can AI build the website for me?<span class="fmark" aria-hidden="true"></span></summary>
          <div class="fbody"><p>It can generate text, layouts and code. The harder part is deciding whether the result is clear, credible and appropriate for the business. Using AI is not the problem. Knowing what to keep, what to remove and what needs to be rebuilt is where experience matters.</p></div>
        </details>
        <details class="rv">
          <summary>Do I need to prepare all the copy?<span class="fmark" aria-hidden="true"></span></summary>
          <div class="fbody"><p>No. Copy can be part of the project scope. I still need real information about the business, customers and offer. I will not invent results, testimonials or claims to fill the page.</p></div>
        </details>
        <details class="rv">
          <summary>Do you only work on websites?<span class="fmark" aria-hidden="true"></span></summary>
          <div class="fbody"><p>Websites and landing pages are the main focus. I also build AI workflows, applications, dashboards and internal systems when the project requires more than a public-facing page.</p></div>
        </details>
        <details class="rv">
          <summary>Are you an agency?<span class="fmark" aria-hidden="true"></span></summary>
          <div class="fbody"><p>No. You work directly with one person from the first conversation to implementation. I currently take on a maximum of three active projects at the same time.</p></div>
        </details>
        <details class="rv">
          <summary>Do you guarantee results?<span class="fmark" aria-hidden="true"></span></summary>
          <div class="fbody"><p>No. I do not guarantee revenue or a specific marketing result, and a new website will not fix an unclear offer by itself. I define the problem, build the agreed solution and give you something real to put in front of customers. What happens next also depends on the offer, traffic, market and how the business uses what was built.</p></div>
        </details>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="foot">
      <div class="foot-lead">
        <p class="foot-eyebrow rv">( Let's talk )</p>
        <a class="foot-h" href="/contact">
          <span class="ln"><span class="ln-in">Let's build the website</span></span>
          <span class="ln"><span class="ln-in">your business <em>actually needs</em>.</span></span>
        </a>
        <p class="foot-sub rv">Tell me what you have now, even if it is nothing yet. I will tell you whether the project is a fit and what I would build first.</p>
        <div class="foot-b rv">
          <a class="btn mag big" href="/contact"><span class="btn-in">Book a 15-min call</span></a>
          <a class="foot-write" href="mailto:kacper@mioduszewsky.com">or just write to me</a>
        </div>
      </div>
      <div class="foot-bar">
        <div class="fcol rv">
          <p class="flabel">Contact</p>
          <a href="mailto:kacper@mioduszewsky.com">kacper@mioduszewsky.com</a>
          <a href="https://instagram.com/mioduszewsky" target="_blank" rel="noopener">Instagram</a>
          <a href="https://contra.com/kacper_mioduszewski_i7ytzt28" target="_blank" rel="noopener">Contra</a>
        </div>
        <div class="fcol fcol-badge rv">
          <div class="spin-badge">
            <svg viewBox="0 0 200 200" aria-hidden="true">
              <defs><path id="badgeArc" d="M100,100 m-70,0 a70,70 0 1,1 140,0 a70,70 0 1,1 -140,0" /></defs>
              <text><textPath href="#badgeArc" startOffset="0" textLength="439" lengthAdjust="spacing">CURRENTLY IN WROCŁAW, POLAND · WORKING WORLDWIDE ·&#160;</textPath></text>
            </svg>
            <span class="spin-core" aria-hidden="true"></span>
          </div>
        </div>
        <div class="fcol fcol-right rv">
          <p class="flabel">Availability</p>
          <span>A maximum of three active projects at a time</span>
          <span>One honest conversation, always</span>
        </div>
      </div>
      <div class="meta">
        <span>© 2026 Kacper Mioduszewski</span>
        <span>Designed and built by one person</span>
        <a href="/privacy" style="color:inherit">Privacy</a>
      </div>
    </footer>
  </main>

  <!-- STOPKA-FINAŁ (curtain reveal): treść unosi się i naturalnie odsłania ją u dołu -->
  <footer class="finale" aria-label="Book a call">
    <div class="finale-dal" aria-hidden="true">
      <video autoplay loop muted playsinline preload="metadata" poster="/logo3d/logo-dalmatian-poster.webp">
        <source src="/logo3d/logo-dalmatian.mp4" type="video/mp4;codecs=hvc1" />
        <source src="/logo3d/logo-dalmatian.webm" type="video/webm" />
      </video>
    </div>
    <div class="finale-cta-wrap">
      <a class="finale-cta mag" href="/contact"><span class="btn-in">Book a 15-min call</span><i aria-hidden="true">→</i></a>
      <a class="finale-alt" href="mailto:kacper@mioduszewsky.com">or just write to me</a>
    </div>
    <button class="finale-top" type="button" aria-label="Back to top">
      <span class="finale-top-arrow" aria-hidden="true">↑</span>
      <span>Back to top</span>
    </button>
  </footer>

  <script>
    import Lenis from 'lenis';
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const EASE = 'cubic-bezier(0.19, 1, 0.22, 1)';

    if (!reduced) {
      const lenis = new Lenis({ duration: 1.25, smoothWheel: true });
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((t) => lenis.raf(t * 1000));
      gsap.ticker.lagSmoothing(0);
    }

    /* Kurtyna wejściowa + intro hero + „psiknięcie" skreślenia */
    const veil = document.querySelector<HTMLElement>('.veil')!;
    const strikePaths = gsap.utils.toArray<SVGPathElement>('.strike .draw');
    const strikeMist = document.querySelector<SVGGElement>('.strike-mist');
    const intro = () => {
      strikePaths.forEach((p) => {
        const len = p.getTotalLength();
        p.style.strokeDasharray = `${len}`;
        p.style.strokeDashoffset = `${len}`;
      });
      gsap.set(['.tag-fix', '.spray-dot svg'], { opacity: 0 });
      if (strikeMist) gsap.set(strikeMist, { opacity: 0 });
      const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
      // Kurtyna trzyma logo ~1.9 s w pełnej widoczności (decyzja Kacpra 16.07:
      // widz ma zdążyć przeczytać i obejrzeć logo, zanim się odsłoni).
      tl.fromTo('.veil-word', { opacity: 0, y: 24, scale: 0.96 }, { opacity: 1, y: 0, scale: 1, duration: 0.55 })
        .to(veil, { yPercent: -100, duration: 0.9, ease: 'expo.inOut' }, 2.4)
        .fromTo('.hero .ln-in', { y: '112%' }, {
          y: 0, duration: 1.2, stagger: 0.09,
          onComplete: () => document.querySelectorAll<HTMLElement>('.hero .ln').forEach((l) => (l.style.overflow = 'visible')),
        }, 2.7)
        .fromTo('.nav', { opacity: 0, y: -14 }, { opacity: 1, y: 0, duration: 0.8 }, 2.9)
        .fromTo('.hero .rv', { opacity: 0, y: 22 }, { opacity: 1, y: 0, duration: 0.9, stagger: 0.08 }, 3.0)
        .to(strikePaths, { strokeDashoffset: 0, duration: 0.42, ease: 'power2.in', stagger: 0.16 }, 3.6)
        .to(strikeMist, { opacity: 1, duration: 0.3 }, 3.85)
        .fromTo('.tag-fix', { scale: 0.7, rotate: -14 }, { opacity: 1, scale: 1, rotate: -7, duration: 0.45, ease: 'back.out(2.4)', immediateRender: false }, 4.1)
        .fromTo('.spray-dot svg', { scale: 0.4 }, { opacity: 1, scale: 1, duration: 0.3, ease: 'power4.out', immediateRender: false }, 4.3);
    };
    if (reduced) {
      veil.remove();
      document.querySelectorAll<HTMLElement>('.ln-in, .rv, .nav').forEach((el) => { el.style.transform = 'none'; el.style.opacity = '1'; });
      document.querySelectorAll<HTMLElement>('.ln').forEach((l) => (l.style.overflow = 'visible'));
    } else {
      intro();
    }

    /* Kółko sprayem na 001 — rysuje się gdy wjedzie w kadr */
    const circlePath = document.querySelector<SVGPathElement>('.spray-circle .draw');
    if (circlePath && !reduced) {
      const len = circlePath.getTotalLength();
      circlePath.style.strokeDasharray = `${len}`;
      circlePath.style.strokeDashoffset = `${len}`;
      gsap.to(circlePath, {
        strokeDashoffset: 0, duration: 0.7, ease: 'power2.inOut',
        scrollTrigger: { trigger: '.spray-circle', start: 'top 78%' },
      });
    }

    /* Maskowane linie + delikatne reveale na scrollu */
    if (!reduced) {
      document.querySelectorAll<HTMLElement>('main section:not(.hero) .ln-in, footer .ln-in').forEach((el) => {
        gsap.fromTo(el, { y: '112%' }, {
          y: 0, duration: 1.15, ease: 'expo.out',
          scrollTrigger: { trigger: el.closest('.ln'), start: 'top 88%' },
          onComplete: () => ((el.closest('.ln') as HTMLElement).style.overflow = 'visible'),
        });
      });
      document.querySelectorAll<HTMLElement>('main section:not(.hero) .rv, footer .rv, .srow, .meta').forEach((el) => {
        gsap.fromTo(el, { opacity: 0, y: 26 }, {
          opacity: 1, y: 0, duration: 1, ease: 'power3.out',
          scrollTrigger: { trigger: el, start: 'top 90%' },
        });
      });
      /* Parallax ramek */
      document.querySelectorAll<HTMLElement>('[data-parallax]').forEach((el) => {
        gsap.fromTo(el, { y: 60 }, {
          y: -60, ease: 'none',
          scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: 0.8 },
        });
      });
      /* Manifest: czarna plama (jak psiknięcie sprayem) rozlewa się na pełny
         ekran w rytmie scrolla — pełny bleed, zero pasków po bokach */
      gsap.fromTo('.manif-in', { clipPath: 'circle(9% at 50% 52%)' }, {
        clipPath: 'circle(125% at 50% 52%)', ease: 'none',
        scrollTrigger: { trigger: '.manif', start: 'top 78%', end: 'top 12%', scrub: 0.5 },
      });
    }

    /* Nav chowa się przy scrollu w dół — nic nie nachodzi na ekrany projektów.
       Dodatkowo: wymuś ukrycie gdy odsłania się finał (żeby żółte logo i „Book a
       call" z nawigacji nie śmieciły na czystej ciemnej scenie). */
    const navEl = document.querySelector<HTMLElement>('.nav')!;
    const footForNav = document.querySelector<HTMLElement>('.foot');
    let lastY = 0;
    addEventListener('scroll', () => {
      const y = scrollY;
      const d = y - lastY;
      const inFinale = !!footForNav && footForNav.getBoundingClientRect().bottom < innerHeight * 0.55;
      if (inFinale) { navEl.classList.add('nav-hide'); lastY = y; return; }
      if (Math.abs(d) > 4 || y <= 180) {
        navEl.classList.toggle('nav-hide', d > 0 && y > 180);
        lastY = y;
      }
    }, { passive: true });

    /* Hover-reveal: miniatura realizacji płynie przy kursorze nad wierszem usługi */
    if (!reduced && matchMedia('(pointer: fine)').matches) {
      const peek = document.createElement('img');
      peek.className = 'row-peek';
      peek.alt = '';
      document.body.appendChild(peek);
      gsap.set(peek, { opacity: 0, scale: 0.9, rotate: 3 });
      const pkx = gsap.quickTo(peek, 'x', { duration: 0.45, ease: 'power3.out' });
      const pky = gsap.quickTo(peek, 'y', { duration: 0.45, ease: 'power3.out' });
      /* miniatura płynie NAD linią kursora (nie zasłania czytanego wiersza)
         i nigdy nie wyjeżdża poza viewport */
      const place = (x: number, y: number) => {
        const w = peek.offsetWidth || 320;
        const h = peek.offsetHeight || 200;
        pkx(Math.min(x + 36, innerWidth - w - 16));
        pky(Math.min(Math.max(14, y - h - 28), innerHeight - h - 14));
      };
      let peekOn = false;
      let curThumb = '';
      const hidePeek = () => {
        if (!peekOn) return;
        peekOn = false;
        gsap.to(peek, { opacity: 0, scale: 0.9, duration: 0.22, ease: 'power2.out' });
      };
      const showPeek = (row: HTMLElement, x: number, y: number) => {
        const t = row.dataset.thumb!;
        if (t !== curThumb) { peek.src = t; curThumb = t; }
        if (!peekOn) {
          peekOn = true;
          place(x, y);
          /* teleport na pozycję kursora — bez przelotu przez pół ekranu */
          pkx.tween?.progress(1);
          pky.tween?.progress(1);
          gsap.to(peek, { opacity: 1, scale: 1, duration: 0.35, ease: 'power3.out' });
        } else {
          place(x, y);
        }
      };
      /* JEDNO źródło prawdy: co REALNIE jest pod kursorem. elementFromPoint
         respektuje transformy Lenisa i pointer-events:none (kursor/miniatura),
         więc działa i przy ruchu myszy, i gdy treść przewija się pod nieruchomym
         kursorem. Koniec z gubionym pointerleave i przyklejoną miniaturą. */
      let lastX = -1, lastY = -1;
      const evaluate = () => {
        if (lastX < 0) return;
        const el = document.elementFromPoint(lastX, lastY) as HTMLElement | null;
        const row = el?.closest?.('.mrow[data-thumb]') as HTMLElement | null;
        if (row) showPeek(row, lastX, lastY);
        else hidePeek();
      };
      document.addEventListener('pointermove', (e) => { lastX = e.clientX; lastY = e.clientY; evaluate(); });
      (window as any).__lenis?.on?.('scroll', evaluate);
      addEventListener('wheel', evaluate, { passive: true });
      addEventListener('scroll', evaluate, { passive: true });
      addEventListener('touchmove', evaluate, { passive: true });
      addEventListener('blur', hidePeek);
      document.addEventListener('pointerleave', hidePeek);
      document.addEventListener('visibilitychange', () => { if (document.hidden) hidePeek(); });
    }

    /* Magnetyczne przyciski */
    if (!reduced && matchMedia('(pointer: fine)').matches) {
      document.querySelectorAll<HTMLElement>('.mag').forEach((btn) => {
        const inner = btn.querySelector<HTMLElement>('.btn-in')!;
        btn.addEventListener('mousemove', (e) => {
          const r = btn.getBoundingClientRect();
          const x = (e.clientX - r.left - r.width / 2) * 0.35;
          const y = (e.clientY - r.top - r.height / 2) * 0.45;
          gsap.to(btn, { x, y, duration: 0.4, ease: 'power2.out' });
          gsap.to(inner, { x: x * 0.4, y: y * 0.4, duration: 0.4 });
        });
        btn.addEventListener('mouseleave', () => {
          gsap.to([btn, inner], { x: 0, y: 0, duration: 0.7, ease: 'elastic.out(1, 0.4)' });
        });
      });

      /* Custom cursor — kropka siedzi DOKŁADNIE na czubku pointera (bez smyczy) */
      const cur = document.querySelector<HTMLElement>('.cur')!;
      gsap.set(cur, { x: -200, y: -200 });
      addEventListener('mousemove', (e) => { gsap.set(cur, { x: e.clientX, y: e.clientY }); });
      document.querySelectorAll('a, button').forEach((el) => {
        el.addEventListener('mouseenter', () => gsap.to(cur, { scale: 2.6, duration: 0.3 }));
        el.addEventListener('mouseleave', () => gsap.to(cur, { scale: 1, duration: 0.3 }));
      });
      /* nad żywym ekranem iPhone'a kursor przejmuje strona w środku — nasz znika */
      document.querySelectorAll('.phone-live').forEach((s) => {
        s.addEventListener('pointerenter', () => gsap.to(cur, { opacity: 0, duration: 0.2 }));
        s.addEventListener('pointerleave', () => gsap.to(cur, { opacity: 1, duration: 0.2 }));
      });
    } else {
      document.querySelector('.cur')?.remove();
    }

    /* Spray-paint: TRZYMAJ I PRZECIĄGNIJ = malowanie po stronie (jak puszka).
       TYLKO desktop (pointer: fine) — na dotyku wyłączone. Jeden kolor na pociągnięcie
       (cyklują po palecie marki), ślad z drobnych psiknięć aerozolu. */
    if (!reduced && matchMedia('(pointer: fine)').matches) {
      const NS = 'http://www.w3.org/2000/svg';
      const COLORS = ['#ffcc33', '#0522ff', '#c70404'];
      const MAX = 70;
      let ci = Math.floor(Math.random() * COLORS.length);
      let spraying = false, strokeColor = '', lastX = 0, lastY = 0;
      const drop = (cx: number, cy: number, r: number, fill: string) => {
        const c = document.createElementNS(NS, 'circle');
        c.setAttribute('cx', String(cx)); c.setAttribute('cy', String(cy));
        c.setAttribute('r', String(r)); c.setAttribute('fill', fill);
        return c;
      };
      const puff = (x: number, y: number, color: string, big: boolean) => {
        const splats = document.querySelectorAll('.splat');
        if (splats.length >= MAX) splats[0].remove();
        const size = big ? 150 : 92;
        const nMist = big ? 24 : 12, nCore = big ? 10 : 5;
        const spread = big ? 64 : 34, coreSpread = big ? 24 : 13;
        const svg = document.createElementNS(NS, 'svg');
        svg.setAttribute('viewBox', '0 0 160 160');
        svg.classList.add('splat');
        const mist = document.createElementNS(NS, 'g');
        mist.setAttribute('filter', 'url(#sprayMist)'); mist.setAttribute('opacity', '0.5');
        for (let i = 0; i < nMist; i++) {
          const a = Math.random() * Math.PI * 2, d = 8 + Math.random() * spread;
          mist.appendChild(drop(80 + Math.cos(a) * d, 80 + Math.sin(a) * d, 0.8 + Math.random() * 2.3, color));
        }
        const core = document.createElementNS(NS, 'g');
        core.setAttribute('filter', 'url(#sprayF)');
        for (let i = 0; i < nCore; i++) {
          const a = Math.random() * Math.PI * 2, d = i === 0 ? 0 : 5 + Math.random() * coreSpread;
          core.appendChild(drop(80 + Math.cos(a) * d, 80 + Math.sin(a) * d, i === 0 ? (big ? 8 : 5) + Math.random() * 4 : 2 + Math.random() * 4, color));
        }
        svg.append(mist, core);
        svg.style.left = `${x}px`; svg.style.top = `${y}px`;
        svg.style.width = svg.style.height = `${size}px`;
        svg.style.rotate = `${Math.random() * 360}deg`;
        document.body.appendChild(svg);
        gsap.fromTo(svg, { scale: 0.2, opacity: 1 }, { scale: 1, opacity: 0.92, duration: 0.22, ease: 'power4.out' });
        gsap.to(svg, { opacity: 0, duration: 1.1, delay: 2.4, onComplete: () => svg.remove() });
      };
      const valid = (t: HTMLElement) => !t.closest('a, button, input, textarea, label, .phone-screen, .variant-switch');
      addEventListener('pointerdown', (e) => {
        if (e.button !== 0 || !valid(e.target as HTMLElement)) return;
        spraying = true;
        strokeColor = COLORS[ci++ % COLORS.length];
        lastX = e.clientX; lastY = e.clientY;
        document.body.classList.add('spraying');
        getSelection()?.removeAllRanges();
        puff(e.clientX, e.clientY, strokeColor, true);
      });
      addEventListener('pointermove', (e) => {
        if (!spraying) return;
        if (Math.hypot(e.clientX - lastX, e.clientY - lastY) < 15) return;
        lastX = e.clientX; lastY = e.clientY;
        getSelection()?.removeAllRanges();
        puff(e.clientX, e.clientY, strokeColor, false);
      });
      /* blokuj zaznaczanie tekstu w trakcie malowania (user-select sam nie wystarcza) */
      document.addEventListener('selectstart', (e) => { if (spraying) e.preventDefault(); });
      const stop = () => { spraying = false; document.body.classList.remove('spraying'); };
      addEventListener('pointerup', stop);
      addEventListener('pointercancel', stop);
      addEventListener('blur', stop);
    }

    /* Sticky CTA: widoczny po zjechaniu z hero, chowany gdy jasna stopka blisko dołu.
       Finał (.finale) jest fixed pod treścią — go nie obserwujemy. */
    const sticky = document.querySelector<HTMLElement>('.sticky-cta');
    const heroEl = document.querySelector<HTMLElement>('.hero');
    const footEl = document.querySelector<HTMLElement>('.foot');
    if (sticky && heroEl && footEl) {
      const updateSticky = () => {
        const heroOut = heroEl.getBoundingClientRect().bottom < 0;
        const footNear = footEl.getBoundingClientRect().top < innerHeight * 0.9;
        sticky.classList.toggle('show', heroOut && !footNear);
      };
      (window as any).__lenis?.on?.('scroll', updateSticky);
      addEventListener('scroll', updateSticky, { passive: true });
      addEventListener('resize', updateSticky);
      updateSticky();
    }
    /* „Back to top" w finale — płynny powrót na górę (Lenis) */
    document.querySelector('.finale-top')?.addEventListener('click', () => {
      const l = (window as any).__lenis;
      if (l?.scrollTo) l.scrollTo(0, { duration: 1.4 });
      else scrollTo({ top: 0, behavior: 'smooth' });
    });
  </script>
</VariantLayout>

<style>
  .w5 {
    /* kanoniczna paleta marki (decyzja Kacpra 14.07.2026) */
    --ivory: #f8f9f2;
    --ink: #000000;
    --dim: #8b8677;
    --blue: #0522ff;
    --brand: #ffcc33;
    font-family: 'GeneralSansV', sans-serif;
    background: var(--ivory);
    color: var(--ink);
    overflow-x: clip;
  }
  @font-face { font-family: 'NohemiV'; src: url('/fonts/Nohemi-Variable.woff2') format('woff2'); font-weight: 100 900; font-display: swap; }
  @font-face { font-family: 'ClashV'; src: url('/fonts/ClashDisplay-Variable.woff2') format('woff2'); font-weight: 200 700; font-display: swap; }
  @font-face { font-family: 'GeneralSansV'; src: url('/fonts/GeneralSans-Variable.woff2') format('woff2'); font-weight: 200 700; font-display: swap; }
  @font-face { font-family: 'GeneralSansV'; src: url('/fonts/GeneralSans-VariableItalic.woff2') format('woff2'); font-weight: 200 700; font-style: italic; font-display: swap; }

  ::selection { background: var(--blue); color: var(--ivory); }
  .w5 a { cursor: none; }
  @media (pointer: coarse) { .w5 a { cursor: auto; } }

  .veil {
    position: fixed; inset: 0; z-index: 200; background: var(--ink);
    display: grid; place-items: center;
  }
  .veil-word {
    width: clamp(260px, 50vw, 680px); height: auto; display: block;
    opacity: 0;
  }

  .cur {
    /* -7px = połowa średnicy: środek kropki leży dokładnie w punkcie kliknięcia */
    position: fixed; top: -7px; left: -7px; z-index: 300; width: 14px; height: 14px;
    border-radius: 50%; background: var(--blue); pointer-events: none;
    mix-blend-mode: exclusion;
  }

  .nav {
    position: fixed; inset-inline: 0; top: 0; z-index: 90;
    display: flex; align-items: flex-start; justify-content: space-between;
    padding: 20px 3vw; pointer-events: none;
  }
  .nav a { pointer-events: auto; }
  .nav { transition: translate 0.5s cubic-bezier(0.19, 1, 0.22, 1); }
  .nav.nav-hide { translate: 0 -130%; opacity: 0 !important; pointer-events: none; }
  .mark { display: block; }
  .mark video {
    height: clamp(46px, 4.6vw, 68px); width: auto; display: block;
    filter: drop-shadow(0 5px 10px color-mix(in srgb, var(--ink) 26%, transparent));
    transition: scale 0.4s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .mark:hover video { scale: 1.05; }

  .btn {
    display: inline-block; position: relative; text-decoration: none; color: var(--ink);
    border: 1px solid var(--ink); border-radius: 999px; padding: 10px 22px;
    font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase;
    background: var(--ivory);
    transition: background 0.35s, color 0.35s;
    will-change: transform;
  }
  .btn .btn-in { display: inline-block; }
  .btn:hover { background: var(--ink); color: var(--ivory); }
  .btn.big { padding: 16px 34px; font-size: 13px; background: var(--ink); color: var(--ivory); }
  .btn.big:hover { background: var(--blue); border-color: var(--blue); }
  /* Sticky CTA — powtarzany główny cel konwersji */
  .sticky-cta {
    position: fixed; bottom: 22px; left: 50%; z-index: 120;
    display: inline-flex; align-items: center; gap: 10px;
    padding: 13px 24px; border-radius: 999px;
    background: var(--ink); color: var(--ivory); text-decoration: none;
    font-size: 13px; letter-spacing: 0.04em;
    box-shadow: 0 10px 30px color-mix(in srgb, var(--ink) 28%, transparent);
    transform: translate(-50%, 130%); opacity: 0;
    transition: transform 0.5s cubic-bezier(0.19,1,0.22,1), opacity 0.4s, background 0.3s;
  }
  .sticky-cta.show { transform: translate(-50%, 0); opacity: 1; }
  .sticky-cta:hover { background: var(--blue); }
  .sticky-cta i { font-style: normal; transition: translate 0.3s; }
  .sticky-cta:hover i { translate: 4px 0; }
  @media (max-width: 620px) { .sticky-cta { font-size: 12px; padding: 12px 20px; bottom: 16px; } }
  .btn.ghost { color: var(--ink); }

  .label { font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: var(--dim); }
  .label.dim { color: color-mix(in srgb, var(--dim) 70%, transparent); }

  /* maskowane linie */
  .ln { display: block; overflow: hidden; }
  .ln-in { display: inline-block; will-change: transform; }

  .hero { min-height: 100svh; display: flex; flex-direction: column; justify-content: center; padding: 18vh 3vw 10vh; }
  .hero h1 {
    font-family: 'NohemiV', 'ClashV', sans-serif; font-weight: 520; letter-spacing: -0.025em;
    font-size: clamp(3.2rem, 9.5vw, 9.8rem); line-height: 1.0; margin-top: 3vh;
  }
  /* Wyróżnienia: pociągnięcie żółtym markerem zamiast kursywy (decyzja 16.07:
     italic/serif czytał się jako AI-maniera) */
  .hero h1 em, .proj-d em, .foot-h em, .sec-h em, .lead-close em, .how-why-t em {
    font-style: normal;
    padding: 0 0.08em;
    background:
      linear-gradient(100deg, transparent 1.5%, color-mix(in srgb, var(--brand) 72%, transparent) 6% 94%, transparent 98.5%)
      no-repeat 0 68% / 100% 56%;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
  }
  .hero-b { display: flex; justify-content: space-between; align-items: flex-end; gap: 4vw; margin-top: 6vh; }
  .hero-cta { display: flex; flex-direction: column; align-items: flex-start; gap: 1.1rem; }
  .hero-price { font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim); }
  .hero-sub { max-width: 40ch; font-size: clamp(1rem, 1.4vw, 1.2rem); line-height: 1.65; color: #4c483c; border-top: 1px solid color-mix(in srgb, var(--ink) 18%, transparent); padding-top: 1.4rem; }

  /* wspólny nagłówek sekcji (lead / how / serv / proc) — celowo o oczko
     mniejszy niż hero, żeby sekcje nie atakowały (feedback 16.07) */
  .sec-h {
    font-family: 'NohemiV', 'ClashV', sans-serif; font-weight: 520;
    font-size: clamp(1.8rem, 3.4vw, 3.1rem); line-height: 1.08; letter-spacing: -0.02em;
    margin-top: 2vh;
  }

  /* LEAD */
  .lead { padding: 12vh 3vw 4vh; }
  .lead-rows { margin-top: 5vh; }
  .lrow {
    display: grid; grid-template-columns: 60px 1fr 1.4fr; gap: 3vw; align-items: baseline;
    padding: 22px 6px; border-top: 1px solid color-mix(in srgb, var(--ink) 16%, transparent);
  }
  .lrow:last-child { border-bottom: 1px solid color-mix(in srgb, var(--ink) 16%, transparent); }
  .lrow .idx { font-size: 12px; letter-spacing: 0.24em; color: var(--dim); }
  .lrow h3 { font-family: 'NohemiV', 'ClashV', sans-serif; font-weight: 540; font-size: clamp(1.15rem, 1.8vw, 1.55rem); letter-spacing: -0.015em; margin: 0; }
  .lrow p { font-size: 14.5px; line-height: 1.6; color: #4c483c; max-width: 58ch; margin: 0; }
  .lead-close {
    max-width: 56ch; margin-top: 6vh; color: var(--ink);
    font-size: clamp(1.05rem, 1.5vw, 1.3rem); line-height: 1.55;
  }

  .work { padding: 10vh 3vw; }
  .sec-head { display: flex; justify-content: space-between; border-top: 1px solid color-mix(in srgb, var(--ink) 18%, transparent); padding-top: 1rem; margin-bottom: 10vh; }
  .proj { display: grid; grid-template-columns: 1fr 1fr; gap: 5vw; align-items: center; margin-bottom: 16vh; }
  .proj.flip .proj-t { order: 2; }
  .proj-t .idx { font-size: 12px; letter-spacing: 0.3em; color: var(--dim); }
  .proj-t h2 { font-family: 'NohemiV', 'ClashV', sans-serif; font-weight: 520; font-size: clamp(2.6rem, 6vw, 6rem); letter-spacing: -0.02em; margin: 0.6rem 0 1.4rem; }
  .proj-d { max-width: 40ch; font-size: clamp(1rem, 1.35vw, 1.15rem); line-height: 1.65; color: #4c483c; }
  .tlink { display: inline-block; margin-top: 1.6rem; color: var(--ink); text-decoration: none; font-size: 13px; letter-spacing: 0.18em; text-transform: uppercase; position: relative; }
  .tlink i { font-style: normal; margin-left: 8px; color: var(--blue); display: inline-block; transition: translate 0.3s; }
  .tlink::after { content: ""; position: absolute; left: 0; bottom: -5px; height: 1px; width: 100%; background: var(--ink); transform-origin: right; transition: transform 0.45s cubic-bezier(0.19, 1, 0.22, 1); }
  .tlink:hover::after { transform: scaleX(0.2); }
  .tlink:hover i { translate: 4px -4px; }
  .proj-f { display: flex; justify-content: center; }

  /* MORE WORK — kompaktowa lista pod żywymi makietami */
  .more { margin-top: -4vh; }
  .mrow {
    display: grid; grid-template-columns: 1fr 1.6fr 40px; gap: 3vw; align-items: baseline;
    padding: 22px 6px; text-decoration: none; color: var(--ink);
    border-top: 1px solid color-mix(in srgb, var(--ink) 16%, transparent);
    transition: padding-left 0.4s cubic-bezier(0.19, 1, 0.22, 1), background 0.4s;
  }
  .mrow:last-of-type { border-bottom: 1px solid color-mix(in srgb, var(--ink) 16%, transparent); }
  .mrow:hover { padding-left: 18px; background: color-mix(in srgb, var(--ink) 4%, transparent); }
  .mrow:hover .sarr { opacity: 1; translate: 0 0; }
  .mname { font-family: 'NohemiV', 'ClashV', sans-serif; font-weight: 540; font-size: clamp(1.2rem, 2.2vw, 1.9rem); letter-spacing: -0.015em; }
  .mdesc { font-size: 14px; line-height: 1.6; color: #4c483c; max-width: 62ch; }
  .work-note { margin-top: 3.5vh; font-size: 12px; line-height: 1.6; color: var(--dim); max-width: 62ch; }

  .manif { padding: 0; }
  .manif-in {
    /* pełny bleed; bez JS / reduced-motion po prostu czarna sekcja,
       z JS clip-path rozlewa ją jak psiknięcie sprayem */
    background: var(--ink); color: var(--ivory); text-align: center;
    padding: 18vh 3vw;
    will-change: clip-path;
  }
  .manif-t { font-family: 'NohemiV', 'ClashV', sans-serif; font-weight: 460; font-size: clamp(1.9rem, 4.6vw, 4.4rem); line-height: 1.12; letter-spacing: -0.02em; }
  .manif em { color: var(--brand); font-style: normal; }
  .manif-sub { margin-top: 4.5vh; font-size: clamp(0.9rem, 1.25vw, 1.05rem); letter-spacing: 0.03em; color: color-mix(in srgb, var(--ivory) 60%, transparent); }

  /* HOW I WORK */
  .how { padding: 10vh 3vw 8vh; }
  .how-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 4vw; margin-top: 7vh; }
  .how-col { border-top: 1px solid color-mix(in srgb, var(--ink) 16%, transparent); padding-top: 1.4rem; }
  .how-t { font-family: 'NohemiV', 'ClashV', sans-serif; font-weight: 540; font-size: clamp(1.3rem, 2vw, 1.8rem); letter-spacing: -0.015em; margin-bottom: 1.5rem; }
  .how-t-old { color: var(--dim); }
  .strike-sm { fill: none; stroke: var(--spray); stroke-linecap: round; }
  .strike-sm path { stroke-width: 3; opacity: 0.9; }
  .how-list { list-style: none; padding: 0; margin: 0; }
  .how-list li {
    padding: 0.62rem 0; font-size: 15px; line-height: 1.6; color: #4c483c;
    border-top: 1px dashed color-mix(in srgb, var(--ink) 12%, transparent);
  }
  .how-list li:first-child { border-top: none; }
  .how-out { margin-top: 1.4rem; font-size: 16px; line-height: 1.6; font-weight: 500; color: var(--ink); }
  /* WHY ME: dwa statementy obok siebie — widoczne, ale bez połaci pustki */
  .how-why {
    margin-top: 7vh; display: grid; grid-template-columns: 1fr 1fr; gap: 4vw;
    border-top: 1px solid color-mix(in srgb, var(--ink) 16%, transparent); padding-top: 4vh;
  }
  .how-why-t {
    font-family: 'NohemiV', 'ClashV', sans-serif; font-weight: 480;
    font-size: clamp(1.15rem, 1.7vw, 1.6rem); line-height: 1.35; letter-spacing: -0.01em;
    color: var(--ink); max-width: 44ch;
  }
  .how-why-full { grid-column: 1 / -1; max-width: 70ch; margin-top: 1rem; }
  .dim2 { color: var(--dim); }

  .serv { padding: 14vh 3vw; }
  .rows { margin-top: 5vh; }
  .srow {
    display: grid; grid-template-columns: 60px 1fr 1.2fr max-content 40px; gap: 3vw; align-items: baseline;
    padding: 30px 6px; text-decoration: none; color: var(--ink);
    border-top: 1px solid color-mix(in srgb, var(--ink) 16%, transparent);
    transition: padding-left 0.4s cubic-bezier(0.19, 1, 0.22, 1), background 0.4s;
  }
  .srow:last-child { border-bottom: 1px solid color-mix(in srgb, var(--ink) 16%, transparent); }
  .srow:hover { padding-left: 22px; background: color-mix(in srgb, var(--ink) 4%, transparent); }
  .srow .idx { font-size: 12px; letter-spacing: 0.24em; color: var(--dim); }
  .sname { font-family: 'NohemiV', 'ClashV', sans-serif; font-weight: 540; font-size: clamp(1.5rem, 3vw, 2.6rem); letter-spacing: -0.015em; }
  .sdesc { font-size: 14.5px; line-height: 1.6; color: #4c483c; max-width: 52ch; }
  .sarr { font-size: 1.3rem; color: var(--blue); opacity: 0; translate: -8px 4px; transition: opacity 0.3s, translate 0.35s; }
  .srow:hover .sarr { opacity: 1; translate: 0 0; }
  .sprice { font-size: 12.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink); white-space: nowrap; justify-self: end; }
  .serv-note { margin-top: 3vh; font-size: 12px; line-height: 1.6; color: var(--dim); }

  /* PROCES — kompaktowe wiersze: numer | krok | opis (jedna linia wysokości) */
  .proc { padding: 8vh 3vw; }
  /* Proces = siatka z gigantycznymi „ghost" numerami (celowo NIE lista jak serv/faq) */
  .proc-flow {
    display: grid; grid-template-columns: repeat(3, 1fr);
    column-gap: clamp(1.5rem, 3vw, 3.5rem); row-gap: clamp(2.5rem, 5vw, 4.5rem);
    margin-top: 6vh;
  }
  .pstep { position: relative; }
  .pn {
    display: block; font-family: 'NohemiV', 'ClashV', sans-serif; font-weight: 600;
    font-size: clamp(3.4rem, 6vw, 6rem); line-height: 0.86; letter-spacing: -0.04em;
    color: transparent; -webkit-text-stroke: 1.4px color-mix(in srgb, var(--ink) 32%, transparent);
    margin-bottom: 0.7rem; transition: color 0.4s, -webkit-text-stroke-color 0.4s;
  }
  .pstep:hover .pn { color: var(--blue); -webkit-text-stroke-color: var(--blue); }
  .pstep h3 { font-family: 'NohemiV', 'ClashV', sans-serif; font-weight: 540; font-size: clamp(1.15rem, 1.8vw, 1.5rem); letter-spacing: -0.015em; margin: 0 0 0.5rem; }
  .pstep p { font-size: 14px; line-height: 1.6; color: #4c483c; max-width: 36ch; margin: 0; }
  .hl-y { background: linear-gradient(100deg, transparent 2%, color-mix(in srgb, var(--brand) 80%, transparent) 6% 94%, transparent 98%); padding: 0 0.08em; }
  @media (max-width: 900px) { .proc-flow { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .proc-flow { grid-template-columns: 1fr; row-gap: 2.5rem; } .pn { font-size: clamp(3rem, 18vw, 4.2rem); } }

  /* FAQ */
  .faq { padding: 6vh 3vw 14vh; }
  .faq-list { margin-top: 4vh; }
  .faq details { border-top: 1px solid color-mix(in srgb, var(--ink) 16%, transparent); }
  .faq details:last-child { border-bottom: 1px solid color-mix(in srgb, var(--ink) 16%, transparent); }
  .faq summary {
    list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 2rem;
    padding: 24px 6px; cursor: pointer;
    font-family: 'NohemiV', 'ClashV', sans-serif; font-weight: 540;
    font-size: clamp(1.1rem, 1.9vw, 1.55rem); letter-spacing: -0.01em;
    transition: padding-left 0.4s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary:hover { padding-left: 18px; }
  .fmark { position: relative; flex: none; width: 15px; height: 15px; }
  .fmark::before, .fmark::after {
    content: ""; position: absolute; inset: 0; margin: auto; background: var(--blue);
    transition: rotate 0.35s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .fmark::before { width: 15px; height: 2px; }
  .fmark::after { width: 2px; height: 15px; }
  .faq details[open] .fmark::after { rotate: 90deg; }
  .fbody { padding: 0 6px 28px; }
  .fbody p { max-width: 68ch; font-size: 15px; line-height: 1.7; color: #4c483c; margin: 0; }

  /* STOPKA — jasna, pełnoekranowa sekcja domykająca (decyzja).
     Nagłówek + CTA wyśrodkowane, info + meta u dołu. Ciemny FINAŁ odsłania się niżej. */
  .foot { position: relative; min-height: 100vh; display: flex; flex-direction: column; padding: 9vh 3vw 3.5vh; }
  .foot-lead { flex: 1; display: flex; flex-direction: column; justify-content: center; }
  .foot-eyebrow { font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: var(--dim); margin-bottom: 1.6rem; }
  .foot-h { display: block; text-decoration: none; color: var(--ink); font-family: 'NohemiV', 'ClashV', sans-serif; font-weight: 520; font-size: clamp(2.4rem, 5.6vw, 5.6rem); line-height: 1.04; letter-spacing: -0.025em; }
  .foot-sub { margin-top: 2.6vh; max-width: 46ch; font-size: clamp(1rem, 1.3vw, 1.18rem); line-height: 1.62; color: #4c483c; }
  .foot-b { display: flex; align-items: center; gap: 26px; flex-wrap: wrap; margin-top: 4.5vh; }
  .foot-write { color: var(--ink); text-decoration: none; font-size: 13px; letter-spacing: 0.02em; border-bottom: 1px solid color-mix(in srgb, var(--ink) 35%, transparent); padding-bottom: 2px; transition: color 0.25s, border-color 0.25s; }
  .foot-write:hover { color: var(--blue); border-color: var(--blue); }

  .foot-bar {
    display: grid; grid-template-columns: 1fr auto 1fr; gap: 4vw; align-items: center;
    margin-top: 5vh; padding-top: 3vh;
    border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
  }
  .fcol-right { text-align: right; align-items: flex-end; }
  .fcol { display: flex; flex-direction: column; gap: 0.5rem; font-size: 13.5px; line-height: 1.5; color: #4c483c; }
  .fcol a { color: var(--ink); text-decoration: none; width: fit-content; position: relative; }
  .fcol a::after { content: ""; position: absolute; left: 0; bottom: -2px; height: 1px; width: 100%; background: var(--ink); transform: scaleX(0); transform-origin: left; transition: transform 0.35s cubic-bezier(0.19, 1, 0.22, 1); }
  .fcol a:hover::after { transform: scaleX(1); }
  .flabel { font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: var(--dim); margin-bottom: 0.5rem; }

  /* Obracający się badge zamiast kolumny „Studio" */
  .fcol-badge { align-items: center; }
  .spin-badge { position: relative; width: clamp(118px, 12vw, 150px); aspect-ratio: 1; display: grid; place-items: center; }
  .spin-badge svg { width: 100%; height: 100%; animation: badgeSpin 24s linear infinite; }
  .spin-badge text { font-family: 'Space Grotesk Variable', monospace; font-size: 12.5px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; fill: var(--ink); }
  .spin-core { position: absolute; width: 9px; height: 9px; border-radius: 50%; background: var(--blue); }
  @keyframes badgeSpin { to { rotate: 360deg; } }
  @media (prefers-reduced-motion: reduce) { .spin-badge svg { animation: none; } }

  .meta { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-top: 3vh; padding-top: 1.2rem; border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent); font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--dim); }

  /* FINAŁ jako CURTAIN REVEAL — przypięty do dołu okna, odsłaniany gdy .w5 się unosi.
     Naturalne, przyjemne zakończenie z głównym CTA „Book a call". */
  .finale {
    /* finał jest poza .w5 — własne zmienne palety I czcionka (inaczej serif z przeglądarki) */
    --ink: #000000; --ivory: #f8f9f2; --brand: #ffcc33; --dim: #8b8677; --blue: #0522ff;
    --dal-w: min(80vw, 1100px);            /* szerokość wordmarku */
    font-family: 'GeneralSansV', sans-serif;
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 0;
    height: 100vh; background: #000000; color: var(--ivory);
    overflow: clip;
  }
  .finale::before {
    content: ""; position: absolute; top: 50%; left: 50%; translate: -50% -50%;
    width: min(1200px, 96vw); aspect-ratio: 2.2 / 1;
    background: radial-gradient(ellipse at center, color-mix(in srgb, var(--ivory) 12%, transparent) 0%, transparent 60%);
  }
  /* Dalmatyńczyk DOKŁADNIE na środku ekranu (pion + poziom) */
  .finale-dal { position: absolute; top: 50%; left: 50%; translate: -50% -50%; z-index: 1; width: var(--dal-w); }
  .finale-dal video { width: 100%; aspect-ratio: 2048 / 506; height: auto; display: block; filter: drop-shadow(0 24px 54px rgba(0, 0, 0, 0.7)); }
  /* CTA tuż pod wordmarkiem (offset = ~pół wysokości futra + odstęp) */
  .finale-cta-wrap {
    position: absolute; left: 50%; top: 50%; translate: -50% 0;
    margin-top: calc(var(--dal-w) * 0.106 + 3.5vh);
    z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 1.1rem;
  }
  .finale-cta {
    display: inline-flex; align-items: center; gap: 14px; text-decoration: none;
    font-family: 'GeneralSansV', sans-serif; font-weight: 500;
    background: var(--ivory); color: var(--ink); border-radius: 999px;
    padding: 19px 40px; font-size: clamp(15px, 1.3vw, 17px); letter-spacing: 0.01em;
    transition: background 0.3s, color 0.3s;
  }
  .finale-cta:hover { background: var(--brand); }
  .finale-cta i { font-style: normal; transition: translate 0.3s; }
  .finale-cta:hover i { translate: 5px 0; }
  .finale-alt { color: color-mix(in srgb, var(--ivory) 58%, transparent); text-decoration: none; font-size: 13px; letter-spacing: 0.04em; border-bottom: 1px solid color-mix(in srgb, var(--ivory) 28%, transparent); padding-bottom: 2px; transition: color 0.25s; }
  .finale-alt:hover { color: var(--ivory); }
  @media (max-width: 560px) { .finale-cta { padding: 16px 30px; } .finale-dal { width: 92vw; } }
  /* Subtelny powrót na górę (zastępuje zabrane żółte logo jako kotwicę) */
  /* „Back to top" na samej górze, nad wordmarkiem */
  .finale-top {
    position: absolute; left: 50%; top: clamp(26px, 6vh, 60px); translate: -50% 0;
    z-index: 2; display: inline-flex; flex-direction: column; align-items: center; gap: 6px;
    background: none; border: 0; cursor: pointer; padding: 8px;
    font-family: 'GeneralSansV', sans-serif; font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
    color: color-mix(in srgb, var(--ivory) 42%, transparent); transition: color 0.3s;
  }
  .finale-top:hover { color: var(--ivory); }
  .finale-top-arrow { font-size: 15px; letter-spacing: 0; transition: translate 0.35s cubic-bezier(0.19,1,0.22,1); }
  .finale-top:hover .finale-top-arrow { translate: 0 -4px; }

  /* ── Warstwa WANDAL: spray, dopiski, splaty ─────────────────── */
  /* curtain reveal: treść (.w5) unosi się i odsłania fixed .finale pod spodem */
  .w5 { --spray: #c70404; position: relative; z-index: 1; margin-bottom: 100vh; }
  .tag {
    font-family: 'Shantell Sans Variable', cursive;
    font-weight: 560;
    color: var(--spray);
    font-size: clamp(0.95rem, 1.5vw, 1.35rem);
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-transform: none;
    white-space: nowrap;
  }
  .fix { position: relative; display: inline-block; }
  .fix .strike {
    position: absolute; inset: 14% -5% auto; width: 110%; height: 66%;
    fill: none; stroke: var(--spray); stroke-linecap: round;
    pointer-events: none; overflow: visible;
  }
  .strike-ink path { stroke-width: 4.5; }
  .strike-ink path:last-child { stroke-width: 3.5; opacity: 0.92; }
  .strike-mist path { stroke-width: 7; opacity: 0.12; }
  .tag-fix {
    position: absolute; left: 10%; top: -0.68em; rotate: -7deg; display: inline-block;
    transform-origin: 20% 80%;
  }
  .spray-dot { display: inline-block; width: 0.4em; height: 0.4em; margin-left: 0.08em; }
  .spray-dot svg { width: 100%; height: 100%; overflow: visible; }
  .spray-dot circle { fill: var(--spray); }

  .hero { position: relative; }

  .phone-hold { position: relative; display: inline-block; }
  .spray-note { position: absolute; left: -46%; bottom: 4%; width: 60%; pointer-events: none; }
  .spray-note svg { width: 70%; fill: none; stroke: var(--spray); stroke-width: 6; stroke-linecap: round; }
  .spray-note .tag { display: block; rotate: -6deg; margin-top: 2px; }

  .tag-manif { color: var(--brand); rotate: -5deg; display: inline-block; vertical-align: super; font-size: 0.42em; margin-left: 0.2em; }

  .idx-wrap { position: relative; }
  .spray-circle {
    position: absolute; left: 50%; top: 50%; translate: -50% -50%;
    width: 108px; height: 72px; fill: none; stroke: var(--spray); stroke-width: 3;
    stroke-linecap: round; pointer-events: none; overflow: visible;
  }
  .tag-row {
    position: absolute; right: 4%; top: 14px; rotate: 3deg; font-size: 1.05rem;
  }
  .srow { position: relative; }

  .tag-foot { font-size: 0.34em; rotate: -6deg; display: inline-block; vertical-align: middle; margin-left: 0.3em; }


  a:focus-visible, .btn:focus-visible {
    outline: 2px solid var(--blue); outline-offset: 4px; border-radius: 4px;
  }
  .btn:focus-visible { border-radius: 999px; }

  @media (max-width: 860px) {
    .nav { padding: 14px 5vw; }
    .hero { padding-inline: 5vw; }
    .hero-b { flex-direction: column-reverse; align-items: flex-start; gap: 2.4rem; margin-top: 8vh; }
    .work, .serv, .foot, .lead, .how, .proc, .faq { padding-inline: 5vw; }
    .manif-in { padding-inline: 6vw; }
    .sec-head { flex-direction: column; gap: 6px; margin-bottom: 7vh; }
    .lrow { grid-template-columns: 44px 1fr; grid-template-rows: auto auto; row-gap: 8px; padding: 22px 2px; }
    .lrow .idx { grid-row: 1; }
    .lrow h3 { grid-column: 2; grid-row: 1; }
    .lrow p { grid-column: 2; grid-row: 2; }
    .lead-close { margin-top: 5vh; }
    .spray-note { left: auto; right: 0; bottom: -9%; width: 62%; }
    .spray-note svg { width: 56%; }
    .proj { grid-template-columns: 1fr; gap: 6vh; margin-bottom: 12vh; }
    .proj.flip .proj-t { order: 0; }
    .more { margin-top: 0; }
    .mrow { grid-template-columns: 1fr 30px; grid-template-rows: auto auto; row-gap: 8px; padding: 20px 2px; }
    .mrow:hover { padding-left: 2px; }
    .mname { grid-column: 1; grid-row: 1; }
    .mrow .sarr { grid-column: 2; grid-row: 1; opacity: 1; translate: 0 0; }
    .mdesc { grid-column: 1 / -1; grid-row: 2; font-size: 13.5px; }
    .how-cols { grid-template-columns: 1fr; gap: 3rem; margin-top: 5vh; }
    .how-why { grid-template-columns: 1fr; gap: 1.6rem; margin-top: 5vh; }
    .srow {
      grid-template-columns: 44px 1fr 30px;
      grid-template-rows: auto auto auto;
      row-gap: 10px; padding: 24px 2px;
    }
    .srow:hover { padding-left: 2px; }
    .srow .idx { grid-row: 1; }
    .sname { grid-column: 2; grid-row: 1; }
    .sarr { grid-column: 3; grid-row: 1; opacity: 1; translate: 0 0; }
    .sprice { grid-column: 2 / -1; grid-row: 2; justify-self: start; }
    .sdesc { display: block; grid-column: 2 / -1; grid-row: 3; font-size: 13.5px; }
    .tag-row { display: none; }
    .step { grid-template-columns: 44px 1fr; grid-template-rows: auto auto; row-gap: 6px; padding: 18px 2px; }
    .step .idx { grid-row: 1; }
    .step h3 { grid-column: 2; grid-row: 1; }
    .step p { grid-column: 2; grid-row: 2; }
    .faq summary { padding: 20px 2px; }
    .faq summary:hover { padding-left: 2px; }
    .fbody { padding: 0 2px 24px; }
    .foot { min-height: auto; padding: 12vh 5vw 5vh; }
    .foot-b .btn { width: 100%; text-align: center; }
    .foot-b { gap: 18px; }
    .foot-bar { grid-template-columns: 1fr; gap: 2.4rem; margin-top: 6vh; text-align: left; }
    .fcol-right { text-align: left; align-items: flex-start; }
    .fcol-badge { align-items: flex-start; }
    .meta { flex-direction: column; gap: 6px; }
  }
</style>

<style is:global>

  <script>
    import Lenis from 'lenis';
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const EASE = 'cubic-bezier(0.19, 1, 0.22, 1)';
    const coarse = matchMedia('(pointer: coarse)').matches;

    /* iOS Safari nie odpala :active bez JAKIEGOKOLWIEK listenera touchstart —
       bez tej linii cały tap-feedback (scale 0.96, tła wierszy) nie działa na iPhone */
    addEventListener('touchstart', () => {}, { passive: true });

    /* Haptyka: krótki impuls na realnych akcjach. Android ma navigator.vibrate;
       iOS nie wystawia żadnego API (hack z input switch załatany w iOS 26.5),
       tam zostaje wizualny press-feedback. */
    const buzz = (pattern: number | number[] = 8) => {
      if (coarse) try { navigator.vibrate?.(pattern); } catch {}
    };
    if (coarse) {
      document.querySelectorAll('.btn, .sticky-cta, .finale-cta, .finale-top, .srow, .mrow[href], .tlink').forEach((el) => {
        el.addEventListener('pointerdown', () => buzz(8), { passive: true });
      });
    }

    if (!reduced) {
      const lenis = new Lenis({ duration: 1.25, smoothWheel: true });
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((t) => lenis.raf(t * 1000));
      gsap.ticker.lagSmoothing(0);
      (window as any).__lenis = lenis;
    }

    /* Kurtyna wejściowa + intro hero + „psiknięcie" skreślenia */
    const veil = document.querySelector<HTMLElement>('.veil')!;
    const strikePaths = gsap.utils.toArray<SVGPathElement>('.strike .draw');
    const strikeMist = document.querySelector<SVGGElement>('.strike-mist');
    let afterLanguageSwitch = false;
    try {
      const switchedAt = Number(sessionStorage.getItem('mioduszewsky:language-switch'));
      sessionStorage.removeItem('mioduszewsky:language-switch');
      afterLanguageSwitch = Number.isFinite(switchedAt) && switchedAt > 0 && Date.now() - switchedAt < 10_000;
    } catch {}
    const intro = () => {
      strikePaths.forEach((p) => {
        const len = p.getTotalLength();
        p.style.strokeDasharray = `${len}`;
        p.style.strokeDashoffset = `${len}`;
      });
      gsap.set(['.tag-fix', '.spray-dot svg'], { opacity: 0 });
      if (strikeMist) gsap.set(strikeMist, { opacity: 0 });
      const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
      // Pełne intro zostaje przy pierwszym wejściu. Po zmianie języka kurtyna
      // jest tylko krótkim łącznikiem marki i odsłania treść po ~0.6 s.
      const M = matchMedia('(max-width: 640px)').matches ? -0.9 : 0;
      const curtainAt = afterLanguageSwitch ? 0.18 : 2.4 + M;
      const heroAt = afterLanguageSwitch ? 0.3 : 2.7 + M;
      const navAt = afterLanguageSwitch ? 0.38 : 2.9 + M;
      const detailsAt = afterLanguageSwitch ? 0.42 : 3.0 + M;
      const accentAt = afterLanguageSwitch ? 0.72 : 3.3 + M;
      tl.fromTo('.veil-word', { opacity: 0, y: 24, scale: 0.96 }, { opacity: 1, y: 0, scale: 1, duration: afterLanguageSwitch ? 0.16 : 0.55 })
        .to(veil, {
          yPercent: -100, duration: afterLanguageSwitch ? 0.42 : 0.9, ease: 'expo.inOut',
          onComplete: () => document.dispatchEvent(new CustomEvent('mioduszewsky:curtainDone')),
        }, curtainAt)
        .fromTo('.hero .ln-in', { y: '112%' }, {
          y: 0, duration: afterLanguageSwitch ? 0.55 : 1.2, stagger: afterLanguageSwitch ? 0.04 : 0.09,
          onComplete: () => document.querySelectorAll<HTMLElement>('.hero .ln').forEach((l) => (l.style.overflow = 'visible')),
        }, heroAt)
        .fromTo('.nav', { opacity: 0, y: -14 }, { opacity: 1, y: 0, duration: afterLanguageSwitch ? 0.4 : 0.8 }, navAt)
        .fromTo('.hero .rv', { opacity: 0, y: 22 }, { opacity: 1, y: 0, duration: afterLanguageSwitch ? 0.5 : 0.9, stagger: afterLanguageSwitch ? 0.04 : 0.08 }, detailsAt)
        .add(() => document.querySelectorAll('.hero h1 em').forEach((el) => el.classList.add('lit')), accentAt)
        .to(strikePaths, { strokeDashoffset: 0, duration: afterLanguageSwitch ? 0.3 : 0.42, ease: 'power2.in', stagger: afterLanguageSwitch ? 0.08 : 0.16 }, accentAt + 0.3)
        .to(strikeMist, { opacity: 1, duration: 0.3 }, accentAt + 0.55)
        .fromTo('.tag-fix', { scale: 0.7, rotate: -14 }, { opacity: 1, scale: 1, rotate: -7, duration: 0.45, ease: 'back.out(2.4)', immediateRender: false }, accentAt + 0.8)
        .fromTo('.spray-dot svg', { scale: 0.4 }, { opacity: 1, scale: 1, duration: 0.3, ease: 'power4.out', immediateRender: false }, accentAt + 1);
    };
    if (reduced) {
      veil.remove();
      document.querySelectorAll<HTMLElement>('.ln-in, .rv, .nav').forEach((el) => { el.style.transform = 'none'; el.style.opacity = '1'; });
      document.querySelectorAll<HTMLElement>('.ln').forEach((l) => (l.style.overflow = 'visible'));
      document.dispatchEvent(new CustomEvent('mioduszewsky:curtainDone'));
    } else {
      intro();
    }
    /* Watchdog odwołany DOPIERO gdy los kurtyny jest przesądzony (intro
       zaplanowane albo veil usunięty) — wcześniejszy throw = kurtyna znika po 5 s */
    (window as any).__w5ok = true;

    /* Kółko sprayem na 001 — rysuje się gdy wjedzie w kadr */
    const circlePath = document.querySelector<SVGPathElement>('.spray-circle .draw');
    if (circlePath && !reduced) {
      const len = circlePath.getTotalLength();
      circlePath.style.strokeDasharray = `${len}`;
      circlePath.style.strokeDashoffset = `${len}`;
      gsap.to(circlePath, {
        strokeDashoffset: 0, duration: 0.7, ease: 'power2.inOut',
        scrollTrigger: { trigger: '.spray-circle', start: 'top 78%' },
      });
    }

    /* Maskowane linie + delikatne reveale na scrollu */
    if (!reduced) {
      document.querySelectorAll<HTMLElement>('main section:not(.hero) .ln-in, footer .ln-in').forEach((el) => {
        gsap.fromTo(el, { y: '112%' }, {
          y: 0, duration: 1.15, ease: 'expo.out',
          scrollTrigger: { trigger: el.closest('.ln'), start: 'top 88%' },
          onComplete: () => ((el.closest('.ln') as HTMLElement).style.overflow = 'visible'),
        });
      });
      document.querySelectorAll<HTMLElement>('main section:not(.hero) .rv, footer .rv, .srow, .meta').forEach((el) => {
        gsap.fromTo(el, { opacity: 0, y: 26 }, {
          opacity: 1, y: 0, duration: 1, ease: 'power3.out',
          scrollTrigger: { trigger: el, start: 'top 90%' },
        });
      });
      /* Parallax ramek */
      document.querySelectorAll<HTMLElement>('[data-parallax]').forEach((el) => {
        gsap.fromTo(el, { y: 60 }, {
          y: -60, ease: 'none',
          scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: 0.8 },
        });
      });
      /* Proces na dotyku: brak hovera, więc numer podświetla się na niebiesko, gdy
         krok mija środek ekranu — 1..6 zapalają się w rytmie czytania na scrollu */
      if (matchMedia('(hover: none)').matches) {
        document.querySelectorAll<HTMLElement>('.pstep').forEach((step) => {
          const pn = step.querySelector<HTMLElement>('.pn');
          if (!pn) return;
          ScrollTrigger.create({
            trigger: step, start: 'top center', end: 'bottom center',
            onToggle: (self) => pn.classList.toggle('pn-lit', self.isActive),
          });
        });
      }
      /* Żółty marker „maluje się" od lewej, gdy tekst wjeżdża w kadr
         (hero ma własny moment w timeline intro — patrz wyżej) */
      document.querySelector('.w5')?.classList.add('em-anim');
      /* Zakreslacz zeruje sie inline, a nie regula z `:not(.lit)`: czesc fraz jest
         wstrzykiwana przez set:html i nie dostaje atrybutu scope'u Astro, wiec
         kaskada bywa nieprzewidywalna. Inline styl jest jednoznaczny. */
      document.querySelectorAll<HTMLElement>('.hero-sub em, .proj-d em, .foot-h em, .sec-h em, .lead-close em, .how-out em, .how-why-t em').forEach((el) => {
        el.style.backgroundSize = '0% var(--mk-h, 56%)';
        ScrollTrigger.create({
          trigger: el, start: 'top 86%', once: true,
          onEnter: () => { el.classList.add('lit'); el.style.backgroundSize = '100% var(--mk-h, 56%)'; },
        });
      });
      /* OFERTA: spray-podkreślenie rysuje się, kropka i dopisek „psikają" — ten sam
         język gestów co hero (te same filtry sprayF/sprayMist, kolor --spray). */
      /* Nitka sprayem rysuje sie w rytmie scrolla przez hero i problem. Ten sam
         mechanizm co skreslenie: dlugosc sciezki na dasharray, scroll odsłania ją
         przez dashoffset. */
      const thread = gsap.utils.toArray<SVGPathElement>('.thread .td');
      if (thread.length) {
        /* pathLength="1" normalizuje dlugosc, wiec dash dziala tez dla wariantu
           schowanego przez media query (getTotalLength zwracalby tam zero) */
        thread.forEach((p) => { p.style.strokeDasharray = '1'; p.style.strokeDashoffset = '1'; });
        /* Linia ma WYCHODZIC z czerwonej kropki po hasle, a nie mijac ja bokiem:
           kazdy wariant deklaruje swoj punkt startu w data-start, a SVG jest tak
           przesuwany, zeby ten punkt padal na srodek kropki. */
        const anchorThread = () => {
          const zone = document.querySelector<HTMLElement>('.thread-zone');
          const dot = document.querySelector<HTMLElement>('.hero .spray-dot');
          const circle = dot?.querySelector('circle');
          if (!zone || !dot || !circle) return;
          /* offsetLeft/Top, NIE getBoundingClientRect: w trakcie intro kropka jedzie
             razem z linia naglowka (transform), wiec rect podawalby pozycje za nisko */
          let x = 0, y = 0;
          let n: HTMLElement | null = dot;
          while (n && n !== zone) { x += n.offsetLeft; y += n.offsetTop; n = n.offsetParent as HTMLElement | null; }
          /* kolo jest mniejsze od pudelka i siedzi w nim nizej (baseline) — roznice
             obu prostokatow liczymy na zywo, oba lapia ten sam transform */
          const dRect = dot.getBoundingClientRect();
          const cRect = circle.getBoundingClientRect();
          const dx = cRect.left + cRect.width / 2 - (dRect.left + dRect.width / 2);
          const dy = cRect.top + cRect.height / 2 - (dRect.top + dRect.height / 2);
          /* celujemy w widoczny tekst sekcji, nie w krawedz .lead: sekcja ma spory
             padding-gorny, wiec kotwiczenie do niej zostawialo pol ekranu pustki */
          const leadTop = (() => {
            const label = document.querySelector<HTMLElement>('.lead .label');
            if (!label) return 0;
            let v = 0;
            let m: HTMLElement | null = label;
            while (m && m !== zone) { v += m.offsetTop; m = m.offsetParent as HTMLElement | null; }
            return v;
          })();
          document.querySelectorAll<HTMLElement>('.thread').forEach((wrap) => {
            if (!wrap.offsetParent) return;
            const svg = wrap.querySelector('svg')!;
            const [px, py] = (wrap.dataset.start || '0,0').split(',').map(Number);
            /* wariant pionowy dopasowuje sie do realnego dystansu kropka -> sekcja
               problemu: na telefonie zalezy on od wysokosci ekranu, wiec sztywna
               proporcja konczylaby strzalke raz za wysoko, raz za nisko */
            const endY = Number(wrap.dataset.endY || 0);
            if (endY && leadTop) {
              const dist = Math.max(320, leadTop - (y + dot.offsetHeight / 2 + dy) - 26);
              let wpx = (dist / (endY - py)) * svg.viewBox.baseVal.width;
              /* wariant szeroki ma trzymac swoja skale — dopasowanie moze go tylko
                 przyciac, gdy zabraknie miejsca, nigdy rozdmuchac ani zmniejszyc
                 ponizej rozsadku */
              const cap = Number(wrap.dataset.maxW || 0);
              if (cap) wpx = Math.min(wpx, innerWidth * 0.58, cap);
              wrap.style.width = `${wpx}px`;
            }
            const scale = wrap.getBoundingClientRect().width / svg.viewBox.baseVal.width;
            wrap.style.left = `${x + dot.offsetWidth / 2 + dx - px * scale}px`;
            wrap.style.top = `${y + dot.offsetHeight / 2 + dy - py * scale}px`;
          });
        };
        anchorThread();
        addEventListener('resize', anchorThread);
        /* pierwszy pomiar leci przed dojsciem fontow — bez tego kotwica laduje obok */
        document.fonts?.ready.then(anchorThread);
        ScrollTrigger.addEventListener('refresh', anchorThread);
        /* Grot jest czescia tej samej, NIEPRZERWANEJ sciezki: dash w SVG startuje od
           nowa po kazdym poleceniu M, wiec kazde podniesienie piora dawalo kawalek
           rysowany wlasnym rytmem, wiszacy obok linii. */
        /* tempo rysowania idzie za dlugoscia linii, nie za wysokoscia calej sekcji:
           inaczej na telefonie (sekcja duzo wyzsza niz rysunek) kreska konczyla sie
           daleko przed sekcja problemu i przez pol ekranu nic sie nie dzialo */
        const visibleThread = () => document.querySelector<HTMLElement>('.thread:not([style*="display: none"])');
        gsap.to(thread, {
          strokeDashoffset: 0, ease: 'none',
          scrollTrigger: {
            trigger: '.thread-zone', start: 'top top', scrub: 0.6,
            end: () => {
              const wrap = [...document.querySelectorAll<HTMLElement>('.thread')].find((el) => el.offsetParent);
              return `+=${Math.round((wrap?.offsetHeight || 800) * 1.1)}`;
            },
            invalidateOnRefresh: true,
          },
        });
      }
      const dealDraw = gsap.utils.toArray<SVGPathElement>('.deal-strike .draw');
      if (dealDraw.length) {
        dealDraw.forEach((p) => { const len = p.getTotalLength(); p.style.strokeDasharray = `${len}`; p.style.strokeDashoffset = `${len}`; });
        gsap.set(['.deal-dot svg', '.deal-strike .strike-mist'], { opacity: 0 });
        ScrollTrigger.create({
          trigger: '.deal-h2', start: 'top 80%', once: true,
          onEnter: () => {
            gsap.timeline()
              .to('.deal-strike .draw', { strokeDashoffset: 0, duration: 0.5, ease: 'power2.in', stagger: 0.14 })
              .to('.deal-strike .strike-mist', { opacity: 1, duration: 0.3 }, '-=0.15')
              .fromTo('.deal-dot svg', { scale: 0.3 }, { opacity: 1, scale: 1, duration: 0.35, ease: 'power4.out' }, '-=0.25');
          },
        });
      }
      /* Manifest: czarna plama (jak psiknięcie sprayem) rozlewa się na pełny
         ekran w rytmie scrolla — pełny bleed, zero pasków po bokach */
      gsap.fromTo('.manif-in', { clipPath: 'circle(9% at 50% 52%)' }, {
        clipPath: 'circle(125% at 50% 52%)', ease: 'none',
        scrollTrigger: { trigger: '.manif', start: 'top 78%', end: 'top 12%', scrub: 0.5 },
      });
      /* Spray przekreslajacy fraze w manifescie: ten sam gest co w hero, ale wlasny
         moment. Sciezki celowo NIE maja klasy `.draw` — ta jest zbierana globalnie do
         intro hero i psiknelaby sie kilka ekranow przed swoja sekcja. */
      const manifDraw = gsap.utils.toArray<SVGPathElement>('.manif-strike .mdraw');
      if (manifDraw.length) {
        manifDraw.forEach((path) => {
          const len = path.getTotalLength();
          path.style.strokeDasharray = `${len}`;
          path.style.strokeDashoffset = `${len}`;
        });
        gsap.set('.manif-mist', { opacity: 0 });
        ScrollTrigger.create({
          trigger: '.manif-t', start: 'top 62%', once: true,
          onEnter: () => {
            gsap.timeline()
              .to(manifDraw, { strokeDashoffset: 0, duration: 0.5, ease: 'power2.in', stagger: 0.14 })
              .to('.manif-mist', { opacity: 1, duration: 0.3 }, '-=0.15');
          },
        });
      }
    }

    /* Nav (żółte logo + „Book a call") jest WIDOCZNY cały czas.
       Chowa się TYLKO gdy odsłania się finał dalmatyńczyka (żeby nie śmiecił na
       czystej ciemnej scenie). Poza finałem — zawsze na wierzchu. */
    const navEl = document.querySelector<HTMLElement>('.nav')!;
    const footForNav = document.querySelector<HTMLElement>('.foot');
    const updateNav = () => {
      const inFinale = !!footForNav && footForNav.getBoundingClientRect().bottom < innerHeight * 0.5;
      navEl.classList.toggle('nav-hide', inFinale);
    };
    addEventListener('scroll', updateNav, { passive: true });
    addEventListener('resize', updateNav);
    updateNav();

    /* Hover-reveal: miniatura realizacji płynie przy kursorze nad wierszem usługi */
    if (!reduced && matchMedia('(pointer: fine)').matches) {
      const peek = document.createElement('img');
      peek.className = 'row-peek';
      peek.alt = '';
      document.body.appendChild(peek);
      gsap.set(peek, { opacity: 0, scale: 0.9, rotate: 3 });
      const pkx = gsap.quickTo(peek, 'x', { duration: 0.45, ease: 'power3.out' });
      const pky = gsap.quickTo(peek, 'y', { duration: 0.45, ease: 'power3.out' });
      /* miniatura płynie NAD linią kursora (nie zasłania czytanego wiersza)
         i nigdy nie wyjeżdża poza viewport */
      const place = (x: number, y: number) => {
        const w = peek.offsetWidth || 320;
        const h = peek.offsetHeight || 200;
        pkx(Math.min(x + 36, innerWidth - w - 16));
        pky(Math.min(Math.max(14, y - h - 28), innerHeight - h - 14));
      };
      let peekOn = false;
      let curThumb = '';
      let shownAtY = 0;
      const hidePeek = () => {
        if (!peekOn) return;
        peekOn = false;
        gsap.to(peek, { opacity: 0, scale: 0.9, duration: 0.22, ease: 'power2.out' });
      };
      const showPeek = (row: HTMLElement, x: number, y: number) => {
        const t = row.dataset.thumb!;
        if (t !== curThumb) { peek.src = t; curThumb = t; }
        shownAtY = scrollY;
        if (!peekOn) {
          peekOn = true;
          place(x, y);
          /* teleport na pozycję kursora — bez przelotu przez pół ekranu */
          pkx.tween?.progress(1);
          pky.tween?.progress(1);
          gsap.to(peek, { opacity: 1, scale: 1, duration: 0.35, ease: 'power3.out' });
        } else {
          place(x, y);
        }
      };
      /* JEDNO źródło prawdy: co REALNIE jest pod kursorem. elementFromPoint
         respektuje transformy Lenisa i pointer-events:none (kursor/miniatura),
         więc działa i przy ruchu myszy, i gdy treść przewija się pod nieruchomym
         kursorem. Koniec z gubionym pointerleave i przyklejoną miniaturą. */
      let lastX = -1, lastY = -1;
      /* canShow tylko z realnego ruchu myszy. Ticker moze WYLACZNIE chowac —
         wczesniej tez pokazywal, wiec przy scrollu pod nieruchomym kursorem
         miniatura wisiala i przeskakiwala po kolejnych wierszach, ktore same
         wjezdzaly pod kursor. */
      const evaluate = (canShow = false) => {
        if (lastX < 0) return;
        const el = document.elementFromPoint(lastX, lastY) as HTMLElement | null;
        const row = el?.closest?.('.mrow[data-thumb]') as HTMLElement | null;
        if (row && canShow) showPeek(row, lastX, lastY);
        else if (!row) hidePeek();
      };
      document.addEventListener('pointermove', (e) => { lastX = e.clientX; lastY = e.clientY; evaluate(true); });

      /* Bulletproof: dopóki miniatura jest widoczna, co KLATKĘ sprawdzaj co realnie
         jest pod kursorem (działa dla każdego scrolla — Lenis, natywny, momentum).
         Gdy wiersz zjedzie spod nieruchomego kursora przy scrollu → natychmiast chowa.
         Pokazujemy tylko na realny ruch myszy (pointermove), więc scroll pod
         nieruchomym kursorem NIE „przyklei" miniatury. */
      /* Kursor stoi, a tresc ucieka = chowamy. Porownujemy pozycje scrolla z ta
         z momentu pokazania, zamiast sluchac zdarzenia 'scroll' — Lenis dowozi je
         tez w bezruchu (inercja, rAF), wiec miniatura nie pokazalaby sie wcale. */
      gsap.ticker.add(() => {
        if (!peekOn) return;
        if (Math.abs(scrollY - shownAtY) > 24) { hidePeek(); return; }
        evaluate(false);
      });
      addEventListener('blur', hidePeek);
      document.addEventListener('pointerleave', hidePeek);
      document.addEventListener('visibilitychange', () => { if (document.hidden) hidePeek(); });
    }

    /* Magnetyczne przyciski */
    if (!reduced && matchMedia('(pointer: fine)').matches) {
      document.querySelectorAll<HTMLElement>('.mag').forEach((btn) => {
        const inner = btn.querySelector<HTMLElement>('.btn-in')!;
        btn.addEventListener('mousemove', (e) => {
          const r = btn.getBoundingClientRect();
          const x = (e.clientX - r.left - r.width / 2) * 0.35;
          const y = (e.clientY - r.top - r.height / 2) * 0.45;
          gsap.to(btn, { x, y, duration: 0.4, ease: 'power2.out' });
          gsap.to(inner, { x: x * 0.4, y: y * 0.4, duration: 0.4 });
        });
        btn.addEventListener('mouseleave', () => {
          gsap.to([btn, inner], { x: 0, y: 0, duration: 0.7, ease: 'elastic.out(1, 0.4)' });
        });
        /* press przez GSAP: magnetyzm wpisuje inline scale:none, więc CSS :active
           nie działa na .mag — dociśnięcie musi iść tym samym kanałem */
        btn.addEventListener('pointerdown', () => gsap.to(btn, { scale: 0.96, duration: 0.15, ease: 'power2.out' }));
        const release = () => gsap.to(btn, { scale: 1, duration: 0.35, ease: 'back.out(2.2)' });
        btn.addEventListener('pointerup', release);
        btn.addEventListener('pointerleave', release);
      });

      /* Custom cursor — kropka siedzi DOKŁADNIE na czubku pointera (bez smyczy).
         cursor:none tylko gdy kropka realnie istnieje (klasa has-cur na body) —
         przy reduced-motion zostaje natywny kursor. */
      const cur = document.querySelector<HTMLElement>('.cur')!;
      document.body.classList.add('has-cur');
      gsap.set(cur, { x: -200, y: -200 });
      addEventListener('mousemove', (e) => { gsap.set(cur, { x: e.clientX, y: e.clientY }); });
      let curScale = 1;
      document.querySelectorAll('a, button, summary').forEach((el) => {
        el.addEventListener('mouseenter', () => { curScale = 2.6; gsap.to(cur, { scale: curScale, duration: 0.3 }); });
        el.addEventListener('mouseleave', () => { curScale = 1; gsap.to(cur, { scale: curScale, duration: 0.3 }); });
      });
      /* tactile press: kropka dociska się przy wciśnięciu i odbija po puszczeniu */
      addEventListener('pointerdown', () => gsap.to(cur, { scale: curScale * 0.55, duration: 0.15, ease: 'power2.out' }));
      addEventListener('pointerup', () => gsap.to(cur, { scale: curScale, duration: 0.35, ease: 'back.out(2.2)' }));
      /* nad żywym ekranem iPhone'a kursor przejmuje strona w środku — nasz znika */
      document.querySelectorAll('.phone-live').forEach((s) => {
        s.addEventListener('pointerenter', () => gsap.to(cur, { opacity: 0, duration: 0.2 }));
        s.addEventListener('pointerleave', () => gsap.to(cur, { opacity: 1, duration: 0.2 }));
      });
    } else {
      document.querySelector('.cur')?.remove();
    }

    /* Spray-paint: TRZYMAJ I PRZECIĄGNIJ = malowanie po stronie (jak puszka).
       TYLKO desktop (pointer: fine) — na dotyku wyłączone. Jeden kolor na pociągnięcie
       (cyklują po palecie marki), ślad z drobnych psiknięć aerozolu. */
    if (!reduced && matchMedia('(pointer: fine)').matches) {
      const NS = 'http://www.w3.org/2000/svg';
      const COLORS = ['#c70404'];
      const MAX = 70;
      let ci = Math.floor(Math.random() * COLORS.length);
      let spraying = false, strokeColor = '', lastX = 0, lastY = 0;
      const drop = (cx: number, cy: number, r: number, fill: string) => {
        const c = document.createElementNS(NS, 'circle');
        c.setAttribute('cx', String(cx)); c.setAttribute('cy', String(cy));
        c.setAttribute('r', String(r)); c.setAttribute('fill', fill);
        return c;
      };
      const puff = (x: number, y: number, color: string, big: boolean) => {
        const splats = document.querySelectorAll('.splat');
        if (splats.length >= MAX) splats[0].remove();
        const size = big ? 150 : 92;
        const nMist = big ? 24 : 12, nCore = big ? 10 : 5;
        const spread = big ? 64 : 34, coreSpread = big ? 24 : 13;
        const svg = document.createElementNS(NS, 'svg');
        svg.setAttribute('viewBox', '0 0 160 160');
        svg.classList.add('splat');
        const mist = document.createElementNS(NS, 'g');
        mist.setAttribute('filter', 'url(#sprayMist)'); mist.setAttribute('opacity', '0.5');
        for (let i = 0; i < nMist; i++) {
          const a = Math.random() * Math.PI * 2, d = 8 + Math.random() * spread;
          mist.appendChild(drop(80 + Math.cos(a) * d, 80 + Math.sin(a) * d, 0.8 + Math.random() * 2.3, color));
        }
        const core = document.createElementNS(NS, 'g');
        core.setAttribute('filter', 'url(#sprayF)');
        for (let i = 0; i < nCore; i++) {
          const a = Math.random() * Math.PI * 2, d = i === 0 ? 0 : 5 + Math.random() * coreSpread;
          core.appendChild(drop(80 + Math.cos(a) * d, 80 + Math.sin(a) * d, i === 0 ? (big ? 8 : 5) + Math.random() * 4 : 2 + Math.random() * 4, color));
        }
        svg.append(mist, core);
        svg.style.left = `${x}px`; svg.style.top = `${y}px`;
        svg.style.width = svg.style.height = `${size}px`;
        svg.style.rotate = `${Math.random() * 360}deg`;
        document.body.appendChild(svg);
        gsap.fromTo(svg, { scale: 0.2, opacity: 1 }, { scale: 1, opacity: 0.92, duration: 0.22, ease: 'power4.out' });
        gsap.to(svg, { opacity: 0, duration: 1.1, delay: 2.4, onComplete: () => svg.remove() });
      };
      const valid = (t: HTMLElement) => !t.closest('a, button, input, textarea, label, .phone-screen, .variant-switch');
      /* spray tylko z wciśniętym Alt/Option — normalny drag ma zaznaczać tekst */
      addEventListener('pointerdown', (e) => {
        if (e.button !== 0 || !e.altKey || !valid(e.target as HTMLElement)) return;
        spraying = true;
        strokeColor = COLORS[ci++ % COLORS.length];
        lastX = e.clientX; lastY = e.clientY;
        document.body.classList.add('spraying');
        getSelection()?.removeAllRanges();
        puff(e.clientX, e.clientY, strokeColor, true);
      });
      addEventListener('pointermove', (e) => {
        if (!spraying) return;
        if (Math.hypot(e.clientX - lastX, e.clientY - lastY) < 15) return;
        lastX = e.clientX; lastY = e.clientY;
        getSelection()?.removeAllRanges();
        puff(e.clientX, e.clientY, strokeColor, false);
      });
      /* blokuj zaznaczanie tekstu w trakcie malowania (user-select sam nie wystarcza) */
      document.addEventListener('selectstart', (e) => { if (spraying) e.preventDefault(); });
      const stop = () => { spraying = false; document.body.classList.remove('spraying'); };
      addEventListener('pointerup', stop);
      addEventListener('pointercancel', stop);
      addEventListener('blur', stop);
    }

    /* Sticky CTA: widoczny po zjechaniu z hero, chowany gdy jasna stopka blisko dołu.
       Finał (.finale) jest fixed pod treścią — go nie obserwujemy. */
    const sticky = document.querySelector<HTMLElement>('.sticky-cta-wrap');
    const navBtn = document.querySelector<HTMLElement>('.nav-actions');
    const heroEl = document.querySelector<HTMLElement>('.hero');
    const footEl = document.querySelector<HTMLElement>('.foot');
    if (sticky && heroEl && footEl) {
      const updateSticky = () => {
        const heroOut = heroEl.getBoundingClientRect().bottom < 0;
        const footNear = footEl.getBoundingClientRect().top < innerHeight * 0.5;
        sticky.classList.toggle('show', heroOut && !footNear);
        navBtn?.classList.toggle('hide', heroOut);
      };
      (window as any).__lenis?.on?.('scroll', updateSticky);
      addEventListener('scroll', updateSticky, { passive: true });
      addEventListener('resize', updateSticky);
      updateSticky();
    }
    /* „Back to top" w finale — płynny powrót na górę (Lenis) */
    document.querySelector('.finale-top')?.addEventListener('click', () => {
      const l = (window as any).__lenis;
      if (l?.scrollTo) l.scrollTo(0, { duration: 1.4 });
      else scrollTo({ top: 0, behavior: 'smooth' });
    });
    /* Logo w nav = też płynny powrót na górę (zamiast skoku i #hash w URL) */
    document.querySelector('.nav .mark')?.addEventListener('click', (e) => {
      e.preventDefault();
      const l = (window as any).__lenis;
      if (l?.scrollTo) l.scrollTo(0, { duration: 1.2 });
      else scrollTo({ top: 0, behavior: 'smooth' });
    });

    /* FAQ: płynne otwieranie/zamykanie <details> — natywnie treść skacze bez
       przejścia. Reduced motion → natywny toggle. Po zmianie wysokości strony
       odświeżamy pozycje ScrollTriggerów (sekcje niżej mają swoje reveale). */
    if (!reduced) {
      document.querySelectorAll<HTMLDetailsElement>('.faq details').forEach((d) => {
        const sum = d.querySelector('summary')!;
        const body = d.querySelector<HTMLElement>('.fbody')!;
        let busy = false;
        sum.addEventListener('click', (e) => {
          e.preventDefault();
          if (busy) return;
          busy = true;
          buzz(8);
          if (!d.open) {
            d.open = true;
            gsap.fromTo(body, { height: 0, paddingBottom: 0, opacity: 0, y: 6 }, {
              height: 'auto', paddingBottom: 28, opacity: 1, y: 0, duration: 0.55, ease: 'expo.out',
              clearProps: 'all',
              onComplete: () => { busy = false; ScrollTrigger.refresh(); },
            });
          } else {
            /* klasa .closing cofa plusik od razu, nie dopiero po animacji */
            d.classList.add('closing');
            gsap.to(body, {
              height: 0, paddingBottom: 0, opacity: 0, duration: 0.38, ease: 'power3.inOut',
              onComplete: () => {
                d.open = false;
                d.classList.remove('closing');
                gsap.set(body, { clearProps: 'all' });
                busy = false;
                ScrollTrigger.refresh();
              },
            });
          }
        });
      });
    }

    /* Futro w stopce (11 MB webm/mp4) ładuje się w tle zaraz po tym, jak reszta
       strony jest gotowa — NIE czeka aż user dojedzie do finału scrollem. Ma stać
       gotowe na czas, zamiast ładować się na jego oczach w trakcie dojazdu. */
    {
      const fv = document.querySelector('.finale-video') as HTMLVideoElement | null;
      /* Save-Data / 2G: 6-12 MB futra zostaje na posterze, nie dociągamy */
      const conn = (navigator as any).connection;
      const skipHeavy = !!(conn?.saveData || /(^|\b)2g/.test(conn?.effectiveType || ''));
      if (fv && !skipHeavy) {
        const load = () => {
          fv.querySelectorAll('source[data-src]').forEach((s) => {
            const el = s as HTMLSourceElement;
            if (el.dataset.src) { el.src = el.dataset.src; delete el.dataset.src; }
          });
          fv.load();
          fv.play().catch(() => {});
        };
        if (document.readyState === 'complete') load();
        else addEventListener('load', load, { once: true });
      }
    }
  </script>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    // LINK-PREVIEW: hover na słowie odsłania zdjęcie Kacpra (native, bez React).
    // Zdjęcia ładują się leniwie dopiero przy pierwszym najechaniu.
    {
      const finePointer = matchMedia('(pointer: fine)').matches;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (finePointer) {
        document.querySelectorAll<HTMLElement>('.lp').forEach((el) => {
          let card: HTMLElement | null = null;
          let raf = 0;
          let curX = 0;
          let tgtX = 0;
          const tilt = parseFloat(el.dataset.tilt || '0');
          const src = el.dataset.lp || '';

          const build = () => {
            card = document.createElement('span');
            card.className = 'lp-card';
            card.style.setProperty('--tilt', tilt + 'deg');
            const img = document.createElement('img');
            img.src = src;
            img.alt = '';
            img.decoding = 'async';
            card.appendChild(img);
            el.appendChild(card);
          };
          const loop = () => {
            curX += (tgtX - curX) * 0.15;
            if (card) card.style.setProperty('--lp-x', curX.toFixed(1) + 'px');
            if (Math.abs(tgtX - curX) > 0.3) { raf = requestAnimationFrame(loop); }
            else { curX = tgtX; if (card) card.style.setProperty('--lp-x', curX + 'px'); raf = 0; }
          };

          el.addEventListener('pointerenter', () => {
            if (!card) build();
            requestAnimationFrame(() => el.classList.add('lp-on'));
          });
          el.addEventListener('pointerleave', () => {
            el.classList.remove('lp-on');
            tgtX = 0;
            if (!reduce && !raf) raf = requestAnimationFrame(loop);
          });
          if (!reduce) {
            el.addEventListener('pointermove', (e) => {
              const r = el.getBoundingClientRect();
              const off = (e.clientX - (r.left + r.width / 2)) / 3;
              tgtX = Math.max(-42, Math.min(42, off));
              if (!raf) raf = requestAnimationFrame(loop);
            });
          }
        });
      } else {
        // Dotyk: bez hovera. Domyślnie karta odsłania się na scrollu — dokładnie ten
        // sam moment co podświetlenie numerów w Process (słowo mija środek ekranu),
        // żeby pojawiało się w rytmie czytania, a nie akurat w trakcie tapa. Słowa
        // oznaczone [data-tap] (eskapizm/Cannversity/my own business — trzy w tym
        // samym zdaniu na tej samej linijce, ich okna scrolla zawsze by się pokryły)
        // dostają zamiast tego tap. Tylko JEDNA karta otwarta naraz w obu trybach.
        let openEl: HTMLElement | null = null;
        const closeOpen = () => { if (openEl) { openEl.classList.remove('lp-on'); openEl = null; } };
        document.querySelectorAll<HTMLElement>('.lp').forEach((el) => {
          let card: HTMLElement | null = null;
          const tilt = parseFloat(el.dataset.tilt || '0');
          const src = el.dataset.lp || '';
          const build = () => {
            card = document.createElement('span');
            card.className = 'lp-card';
            card.style.setProperty('--tilt', tilt + 'deg');
            card.style.setProperty('--lp-x', '0px');
            const img = document.createElement('img');
            img.src = src;
            img.alt = '';
            img.decoding = 'async';
            card.appendChild(img);
            el.appendChild(card);
            // karta wyśrodkowana na słowie — przy krawędzi ekranu dogięta z powrotem w kadr
            requestAnimationFrame(() => {
              const r = card!.getBoundingClientRect();
              let shift = 0;
              if (r.left < 10) shift = 10 - r.left;
              else if (r.right > innerWidth - 10) shift = innerWidth - 10 - r.right;
              if (shift) card!.style.setProperty('--lp-x', shift + 'px');
            });
          };
          const open = () => {
            if (openEl && openEl !== el) openEl.classList.remove('lp-on');
            if (!card) build();
            el.classList.add('lp-on');
            openEl = el;
          };
          if (el.hasAttribute('data-tap')) {
            el.addEventListener('click', (e) => {
              e.stopPropagation();
              if (openEl === el) { closeOpen(); return; }
              open();
            });
          } else {
            ScrollTrigger.create({
              // Słowo samo w sobie ma ~17px wysokości — "top center/bottom center" dałoby
              // okno aktywne tylko na te 17px scrolla (mignięcie, nie efekt). Pasmo liczone
              // od procentu wysokości ekranu (nie od wysokości słowa) daje spokojny czas na
              // przeczytanie, zanim karta zniknie.
              trigger: el, start: 'top 65%', end: 'top 35%',
              onToggle: (self) => {
                if (self.isActive) open();
                else { el.classList.remove('lp-on'); if (openEl === el) openEl = null; }
              },
            });
          }
        });
        document.addEventListener('click', () => closeOpen());
      }
    }
  </script>
</VariantLayout>


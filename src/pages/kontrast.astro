---
/*
  PODGLĄD ROBOCZY — porównanie natężenia kontrastu w hero i w sekcji problemu.
  Nie jest częścią strony produkcyjnej: noindex, brak analytics, brak GSAP.
  Markery są od razu „zapalone", żeby oceniać kolor, a nie animację.
  Do skasowania po decyzji.
*/
const variants = [
  {
    id: 'now',
    kicker: 'Stan obecny',
    name: 'Żółty marker, 72% krycia',
    ratio: '1,30 : 1',
    note: 'Działa odcieniem, nie jasnością. W słońcu i przy niższej jasności ekranu marker praktycznie znika.',
  },
  {
    id: 'blue',
    kicker: 'Wariant 1',
    name: 'Niebieski wychodzi z hoveru',
    ratio: '7,40 : 1',
    note: 'Marker bez zmian. Zmienia się to, co dziś widać dopiero po najechaniu myszką — czyli na telefonie nigdy.',
  },
  {
    id: 'block',
    kicker: 'Wariant 2',
    name: 'Czarny blok zamiast markera',
    ratio: '19,82 : 1',
    note: 'Najmocniejszy możliwy kontrast. Blok czyta się jak gest korektorski, nie jak dekoracja.',
  },
  {
    id: 'yellow',
    kicker: 'Wariant 3',
    name: 'Żółty na pełnej mocy',
    ratio: '1,42 : 1',
    note: 'Pełne krycie i grubsze pasmo, a pod sekcją problemu żółte tło. Kontrast nadal niski — siła bierze się z ilości, nie z jasności.',
  },
];
---

<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Kontrast — podgląd roboczy</title>
  </head>
  <body>
    <header class="page-head">
      <p class="page-kicker">( Podgląd roboczy · nie jest to strona produkcyjna )</p>
      <h1 class="page-h">Ile kontrastu w hero.</h1>
      <p class="page-sub">
        Każdy blok pokazuje to samo: hero i początek sekcji problemu. Oceniaj na telefonie,
        przy takiej jasności ekranu, jakiej normalnie używasz. Liczba przy nazwie to kontrast
        akcentu wobec kremowego tła.
      </p>
    </header>

    {variants.map((v) => (
      <section class={`vw vw-${v.id}`}>
        <div class="vw-tag">
          <span class="vw-kicker">{v.kicker}</span>
          <span class="vw-name">{v.name}</span>
          <span class="vw-ratio">{v.ratio}</span>
        </div>
        <p class="vw-note">{v.note}</p>

        <div class="demo">
          <div class="demo-hero">
            <p class="label">( Strony · AI · aplikacje )</p>
            <h2 class="hero-h">
              Dobra strona<br /><em>mówi</em> za Ciebie<span class="dot" aria-hidden="true"></span>
            </h2>
            <p class="hero-sub">
              Buduję strony internetowe, wdrożenia AI i aplikacje. <em>Całość robię sam</em>,
              więc nie zszywasz projektu z kawałków od kilku wykonawców.
            </p>
            <div class="hero-cta">
              <a class="btn" href="#">Umów 15 minut</a>
              <a class="alt" href="#">albo po prostu napisz</a>
            </div>
          </div>

          <div class="demo-lead">
            <p class="label">( Problem )</p>
            <h3 class="sec-h">Potrzebujesz strony.<br />Nagle masz cały projekt <em>na głowie</em>.</h3>
            <p class="lead-intro">
              Ile z tego spada na Ciebie, zależy od tego, w którym miejscu jesteś dzisiaj.
              Zwykle w jednym z trzech:
            </p>
            <p class="lead-close">
              Strona składa się z kilku różnych decyzji: co powiedzieć, jak to ułożyć, jak pokazać
              i jak zbudować. <em>Ja prowadzę te rzeczy razem</em>, żeby na końcu powstała jedna
              działająca całość.
            </p>
          </div>
        </div>
      </section>
    ))}

    <footer class="page-foot">
      <p>Po decyzji ten plik znika — <code>src/pages/kontrast.astro</code>.</p>
    </footer>

    <style is:global>
      @font-face { font-family: 'NohemiV'; src: url('/fonts/Nohemi-Variable.woff2') format('woff2'); font-weight: 100 900; font-display: swap; }
      @font-face { font-family: 'GeneralSansV'; src: url('/fonts/GeneralSans-Variable.woff2') format('woff2'); font-weight: 200 700; font-display: swap; }

      :root {
        --ivory: #f8f9f2;
        --ink: #000000;
        --dim: #8b8677;
        --blue: #0522ff;
        --brand: #ffcc33;
        --spray: #c70404;
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0; background: var(--ivory); color: var(--ink);
        font-family: 'GeneralSansV', system-ui, sans-serif;
        overflow-x: hidden;
      }

      /* --- nagłówek podglądu ------------------------------------------------ */
      .page-head { padding: 8vh 5vw 4vh; max-width: 720px; }
      .page-kicker { font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--dim); margin: 0 0 1.2rem; }
      .page-h { font-family: 'NohemiV', sans-serif; font-weight: 520; letter-spacing: -0.03em; font-size: clamp(2rem, 6vw, 3rem); line-height: 1.02; margin: 0 0 1.2rem; }
      .page-sub { font-size: 15px; line-height: 1.6; color: #4c483c; margin: 0; max-width: 52ch; }

      /* --- ramka wariantu --------------------------------------------------- */
      .vw { border-top: 1px solid color-mix(in srgb, var(--ink) 16%, transparent); padding: 5vh 5vw 7vh; }
      .vw-tag { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 1rem; margin-bottom: 0.5rem; }
      .vw-kicker { font-size: 10.5px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--dim); }
      .vw-name { font-family: 'NohemiV', sans-serif; font-weight: 600; font-size: clamp(1.1rem, 3.4vw, 1.4rem); letter-spacing: -0.02em; }
      .vw-ratio { font-size: 12px; letter-spacing: 0.08em; color: var(--dim); font-variant-numeric: tabular-nums; }
      .vw-note { font-size: 13.5px; line-height: 1.55; color: #4c483c; margin: 0 0 3.5vh; max-width: 56ch; }

      /* --- wspólna makieta -------------------------------------------------- */
      .demo { border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent); border-radius: 14px; overflow: hidden; }
      .demo-hero, .demo-lead { padding: clamp(1.6rem, 5vw, 2.6rem); }
      .demo-lead { border-top: 1px solid color-mix(in srgb, var(--ink) 12%, transparent); }
      .label { font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: var(--dim); margin: 0 0 1.4rem; }
      .hero-h {
        font-family: 'NohemiV', sans-serif; font-weight: 520; letter-spacing: -0.045em;
        font-size: clamp(2.2rem, 11vw, 3.4rem); line-height: 1.0; margin: 0 0 2.6rem;
      }
      .dot { display: inline-block; width: 0.16em; height: 0.16em; border-radius: 50%; background: var(--spray); margin-left: 0.22em; vertical-align: 0.08em; }
      .hero-sub {
        max-width: 40ch; font-size: 1rem; line-height: 1.65; color: #4c483c; margin: 0;
        border-top: 1px solid color-mix(in srgb, var(--ink) 18%, transparent); padding-top: 1.4rem;
      }
      .hero-cta { margin-top: 2rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1.4rem; }
      .btn {
        display: inline-block; text-decoration: none; background: var(--ink); color: var(--ivory);
        border-radius: 999px; padding: 15px 30px; font-size: 12.5px; letter-spacing: 0.14em; text-transform: uppercase;
      }
      .alt { font-size: 14px; color: #4c483c; text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
      .sec-h {
        font-family: 'NohemiV', sans-serif; font-weight: 560; letter-spacing: -0.035em;
        font-size: clamp(1.7rem, 7.6vw, 2.4rem); line-height: 1.05; margin: 0 0 1.8rem;
      }
      .lead-intro, .lead-close { font-size: 15px; line-height: 1.62; color: #4c483c; max-width: 48ch; margin: 0 0 1.4rem; }
      .lead-close { margin-bottom: 0; }

      /* ====================================================================
         WARIANT „stan obecny" — żółty marker 72% krycia
         ==================================================================== */
      .vw-now em, .vw-yellow em, .vw-blue em {
        font-style: normal;
        padding: 0 0.08em; margin: 0 -0.08em;
        box-decoration-break: clone; -webkit-box-decoration-break: clone;
      }
      .vw-now em {
        background: linear-gradient(100deg, transparent 1.5%, color-mix(in srgb, var(--brand) 72%, transparent) 6% 94%, transparent 98.5%)
          no-repeat 0 68% / 100% 56%;
      }
      .vw-now .hero-sub em, .vw-now .lead-close em { background-size: 100% 72%; }

      /* ====================================================================
         WARIANT 1 — niebieski wychodzi z hoveru
         Marker bez zmian; zmienia się wszystko, co dziś czeka na kursor.
         ==================================================================== */
      .vw-blue em {
        background: linear-gradient(100deg, transparent 1.5%, color-mix(in srgb, var(--brand) 72%, transparent) 6% 94%, transparent 98.5%)
          no-repeat 0 68% / 100% 56%;
      }
      .vw-blue .hero-sub em, .vw-blue .lead-close em { background-size: 100% 72%; }
      .vw-blue .label { color: var(--blue); }
      .vw-blue .alt { color: var(--blue); text-decoration-color: var(--blue); text-decoration-thickness: 2px; }
      .vw-blue .btn { background: var(--blue); }
      .vw-blue .demo-lead { border-top-color: var(--blue); border-top-width: 2px; }
      .vw-blue .lead-intro::after {
        content: ""; display: block; width: 56px; height: 3px; border-radius: 2px;
        background: var(--blue); margin-top: 1.4rem;
      }

      /* ====================================================================
         WARIANT 2 — czarny blok zamiast markera
         ==================================================================== */
      /* Boczne „rozlanie" bloku robi box-shadow, nie padding: padding rozpychal
         wiersz i wypychal czerwona kropke do wlasnej linii. */
      .vw-block em {
        font-style: normal; background: var(--ink); color: var(--ivory);
        padding: 0.04em 0; margin: 0;
        box-shadow: 0.16em 0 0 var(--ink), -0.16em 0 0 var(--ink);
        box-decoration-break: clone; -webkit-box-decoration-break: clone;
      }

      /* ====================================================================
         WARIANT 3 — żółty na pełnej mocy + żółte tło pod sekcją problemu
         ==================================================================== */
      .vw-yellow em {
        background: var(--brand);
        padding: 0.06em 0; margin: 0;
        box-shadow: 0.14em 0 0 var(--brand), -0.14em 0 0 var(--brand);
      }
      .vw-yellow .demo-lead { background: var(--brand); border-top-color: transparent; }
      .vw-yellow .demo-lead .label { color: color-mix(in srgb, var(--ink) 62%, transparent); }
      .vw-yellow .demo-lead .lead-intro, .vw-yellow .demo-lead .lead-close { color: color-mix(in srgb, var(--ink) 78%, transparent); }
      .vw-yellow .demo-lead em { background: var(--ink); color: var(--brand); box-shadow: 0.14em 0 0 var(--ink), -0.14em 0 0 var(--ink); }

      /* --- stopka ----------------------------------------------------------- */
      .page-foot { padding: 4vh 5vw 10vh; border-top: 1px solid color-mix(in srgb, var(--ink) 16%, transparent); }
      .page-foot p { font-size: 12.5px; color: var(--dim); margin: 0; }
      .page-foot code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }

      @media (min-width: 1100px) {
        .page-head { padding-inline: 6vw; }
        .vw { padding-inline: 6vw; }
        .demo { display: grid; grid-template-columns: 1.1fr 1fr; }
        .demo-lead { border-top: 0; border-left: 1px solid color-mix(in srgb, var(--ink) 12%, transparent); }
        .vw-blue .demo-lead { border-left-color: var(--blue); border-left-width: 2px; border-top: 0; }
        .vw-yellow .demo-lead { border-left-color: transparent; }
      }
    </style>
  </body>
</html>

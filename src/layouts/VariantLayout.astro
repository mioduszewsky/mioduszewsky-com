---
// Wspólny layout eksperymentalnych wariantów designu (/w1-/w4).
// Fonty: WSZYSTKIE z pełnym latin-ext (ą ć ę ł ń ó ś ź ż) — warunek zero.
import '@fontsource-variable/unbounded';
import '@fontsource-variable/anybody';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/syne';
import '@fontsource-variable/archivo';
import Analytics from '@vercel/analytics/astro';
import { POSTHOG_KEY, POSTHOG_HOST, GA4_ID, GOOGLE_ADS_ID, META_PIXEL_ID, TRACKING_ENABLED } from '../config/tracking';
import { layoutCopy, routes, type Locale } from '../i18n/site';

interface Props {
  title: string;
  bg?: string;
  fg?: string;
  /** przełącznik W1-W7 w rogu — wyłączany na produkcyjnym indexie */
  switcher?: boolean;
  /** nadpisanie meta robots (warianty domyślnie noindex) */
  robots?: string;
  /** meta description — podawana tylko na produkcyjnym indexie */
  description?: string;
  /** język dokumentu i komunikatów wspólnych */
  locale?: Locale;
  /** dokładny odpowiednik tej strony w drugim języku */
  alternatePath?: string;
  /** osobna grafika social dla wersji językowej */
  ogImagePath?: string;
}
const {
  title,
  bg = '#111',
  fg = '#fff',
  switcher = true,
  robots = 'noindex, nofollow',
  description,
  locale = 'en',
  alternatePath,
  ogImagePath = locale === 'pl' ? '/og-pl.png' : '/og.png',
} = Astro.props;

// SEO: kanoniczny host = docelowa domena produkcyjna.
const SITE = 'https://mioduszewsky.com';
const canonical = new URL(Astro.url.pathname, SITE).href;
const ogImage = new URL(ogImagePath, SITE).href;
const indexable = robots.includes('index') && !robots.includes('noindex');
const c = layoutCopy[locale];
const alternate = alternatePath ? new URL(alternatePath, SITE).href : undefined;
const englishUrl = locale === 'en' ? canonical : alternate;
const polishUrl = locale === 'pl' ? canonical : alternate;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'mioduszewsky',
  url: SITE,
  image: ogImage,
  description: description || c.defaultDescription,
  inLanguage: locale === 'pl' ? 'pl-PL' : 'en',
  founder: { '@type': 'Person', name: 'Kacper Mioduszewski' },
  areaServed: c.areaServed,
  address: { '@type': 'PostalAddress', addressLocality: 'Wrocław', addressCountry: 'PL' },
  sameAs: [
    'https://instagram.com/mioduszewsky',
    'https://contra.com/kacper_mioduszewski_i7ytzt28',
  ],
};

const variants = [
  { href: '/w1', label: 'W1' },
  { href: '/w2', label: 'W2' },
  { href: '/w3', label: 'W3' },
  { href: '/w4', label: 'W4' },
  { href: '/w5', label: 'W5' },
  { href: '/w6', label: 'W6' },
  { href: '/w7', label: 'W7' },
];
const current = Astro.url.pathname.replace(/\/$/, '');
---

<!doctype html>
<html lang={locale === 'pl' ? 'pl' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={robots} />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>

    <!-- Favicon: balonowe „m" 3D (wybór Kacpra 20.07.2026, opcja A) -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    {englishUrl && <link rel="alternate" hreflang="en" href={englishUrl} />}
    {polishUrl && <link rel="alternate" hreflang="pl-PL" href={polishUrl} />}
    {englishUrl && <link rel="alternate" hreflang="x-default" href={englishUrl} />}
    <meta name="theme-color" content="#f8f9f2" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="mioduszewsky" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale === 'pl' ? 'pl_PL' : 'en_US'} />
    {alternate && <meta property="og:locale:alternate" content={locale === 'pl' ? 'en_US' : 'pl_PL'} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />

    {indexable && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <Analytics />
    <style define:vars={{ bg, fg }}>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { background: var(--bg); color: var(--fg); }
      body { min-height: 100svh; overflow-x: clip; -webkit-font-smoothing: antialiased; }
      img { max-width: 100%; }
      .variant-switch {
        position: fixed;
        bottom: 14px;
        right: 14px;
        z-index: 999;
        display: flex;
        gap: 6px;
        font-family: 'Space Grotesk Variable', monospace;
        font-size: 12px;
      }
      .variant-switch a {
        display: grid;
        place-items: center;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #000;
        color: #fff;
        text-decoration: none;
        border: 1px solid rgba(255, 255, 255, 0.35);
        opacity: 0.82;
      }
      .variant-switch a:hover { opacity: 1; }
      .variant-switch a.active { background: #fff; color: #000; font-weight: 700; }
    </style>
  </head>
  <body>
    <slot />
    {switcher && (
      <nav class="variant-switch" aria-label="Przełącznik wariantów">
        {variants.map((v) => (
          <a href={v.href} class:list={[current === v.href && 'active']}>{v.label}</a>
        ))}
      </nav>
    )}

    {TRACKING_ENABLED && (
      <div class="cookie-banner" id="cookieBanner" hidden>
        <p>
          {c.cookie.text} <a href={routes[locale].privacy}>{c.cookie.privacy}</a>.
        </p>
        <div class="cookie-actions">
          <button type="button" class="cb-reject" id="cookieReject">{c.cookie.reject}</button>
          <button type="button" class="cb-accept" id="cookieAccept">{c.cookie.accept}</button>
        </div>
      </div>
    )}

    <script define:vars={{ POSTHOG_KEY, POSTHOG_HOST, GA4_ID, GOOGLE_ADS_ID, META_PIXEL_ID, TRACKING_ENABLED }}>
      // UTM musi przeżyć przejście między stronami w tej samej karcie. Zapisujemy
      // tylko wartości faktycznie obecne w adresie, więc wejście organiczne nie
      // kasuje atrybucji z kampanii rozpoczętej chwilę wcześniej.
      // Liczy się pierwsze wejście z UTM w sesji i zapisujemy jego komplet naraz:
      // późniejsze wejście z innego linku nie podmienia źródła ani nie skleja
      // parametrów dwóch kampanii w jedno zgłoszenie.
      const UTM_STORAGE_KEY = 'mioduszewsky:utm';
      const UTM_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
      try {
        const params = new URLSearchParams(location.search);
        const incomingUtm = Object.fromEntries(
          UTM_KEYS.map((key) => [key, params.get(key) || '']).filter(([, value]) => value),
        );
        if (Object.keys(incomingUtm).length && !sessionStorage.getItem(UTM_STORAGE_KEY)) {
          sessionStorage.setItem(UTM_STORAGE_KEY, JSON.stringify(incomingUtm));
        }
      } catch {}
      // Bramka zgody: GA4, Google Ads i piksel Mety NIE ładują się dopóki user nie
      // kliknie Accept. Decyzja pamiętana w localStorage, nie w cookie same w sobie.
      // Spec: systemy/ads/docs/TRACKING-GATE.md.
      const CONSENT_KEY = 'mioduszewsky_consent';

      // PostHog jest wyjątkiem i startuje dla wszystkich, w dwóch trybach:
      //  - przed decyzją: `cookieless_mode: 'on_reject'` + `opt_out_capturing_by_default`,
      //    czyli zero zapisu na urządzeniu (bez cookie, bez localStorage). Unikalnych
      //    użytkowników liczy PostHog po swojej stronie z dziennego hasha, ta sama
      //    kategoria pomiaru co Vercel Web Analytics, który już tu działa przed zgodą.
      //    Bez tego PostHog widział 0,4% ruchu, czyli mierzył akceptację bannera,
      //    a nie zachowanie na stronie.
      //  - po kliknięciu Accept: `opt_in_capturing()` przełącza SDK w tej samej odsłonie
      //    na pełny tryb (cookie, identyfikacja, nagrania sesji) i odtwarza managery sesji.
      // Docs: https://posthog.com/docs/data/cookieless-tracking
      // Uwaga: tryb bezcookiowy wymaga włączonego "Cookieless server hash mode"
      // w ustawieniach projektu PostHog (Project Settings > Web analytics).
      // `person_profiles` zostaje na 'identified_only' (a nie 'never'), żeby po zgodzie
      // działał `identify()` i event celu Lead z formularza kontaktowego.
      let phRequested = false;
      let phConsented = false;
      let phRejected = false;

      function loadPostHog() {
        if (!POSTHOG_KEY || phRequested || phRejected) return;
        phRequested = true;
        const s = document.createElement('script');
        s.src = POSTHOG_HOST + '/static/array.js';
        s.onload = function () {
          if (phRejected) return;
          const base = { api_host: POSTHOG_HOST, person_profiles: 'identified_only' };
          if (phConsented) {
            window.posthog.init(POSTHOG_KEY, base);
            return;
          }
          window.posthog.init(POSTHOG_KEY, Object.assign({}, base, {
            cookieless_mode: 'on_reject',
            // Brak decyzji = mierzymy bezcookiowo, zamiast nie mierzyć wcale.
            opt_out_capturing_by_default: true,
            // Nagrania i ankiety wymagają storage, więc dopiero po zgodzie.
            disable_session_recording: true,
            disable_surveys: true,
          }));
        };
        document.head.appendChild(s);
      }

      function consentPostHog() {
        if (phConsented) return;
        const wasAnonymous = phRequested;
        phConsented = true;
        phRejected = false;
        // Skrypt jeszcze się ładuje: onload sam zainicjuje pełny tryb (phConsented).
        if (!wasAnonymous) { loadPostHog(); return; }
        try {
          window.posthog?.opt_in_capturing();
          window.posthog?.startSessionRecording();
        } catch {}
      }

      function rejectPostHog() {
        phRejected = true;
        try {
          // Jawne "Odrzuć" wyłącza PostHoga do zera, także pomiar bezcookiowy.
          window.posthog?.set_config({ before_send: () => null });
          window.posthog?.opt_out_capturing();
        } catch {}
      }

      function initTracking() {
        if (window.__trackingConsent) return;
        window.__trackingConsent = true;

        consentPostHog();

        if ((GA4_ID || GOOGLE_ADS_ID) && !window.gtag) {
          const id = GA4_ID || GOOGLE_ADS_ID;
          const s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          if (GA4_ID) window.gtag('config', GA4_ID);
          if (GOOGLE_ADS_ID) window.gtag('config', GOOGLE_ADS_ID);
        }

        // Meta Pixel. Świadomie BEZ fallbacku <noscript><img> z Meta Pixel Code:
        // ten obrazek strzeliłby do Meta bez JS, czyli z pominięciem tej bramki zgody.
        if (META_PIXEL_ID && !window.fbq) {
          !function(f,b,e,v,n,t,s)
          {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};
          if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
          n.queue=[];t=b.createElement(e);t.async=!0;
          t.src=v;s=b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t,s)}(window, document,'script',
          'https://connect.facebook.net/en_US/fbevents.js');
          window.fbq('init', META_PIXEL_ID);
          window.fbq('track', 'PageView');
        }

        document.dispatchEvent(new CustomEvent('mioduszewsky:trackingReady'));
      }

      if (TRACKING_ENABLED) {
        let consent;
        try { consent = localStorage.getItem(CONSENT_KEY); } catch {}

        if (consent === 'accepted') {
          initTracking();
        } else if (consent !== 'rejected') {
          // Pomiar bezcookiowy rusza od razu, nie czeka na klik w bannerze.
          loadPostHog();
          const banner = document.getElementById('cookieBanner');
          const reveal = () => { if (banner) banner.hidden = false; };
          // Strony z kurtyną wejściową (.veil, np. w5) nie mogą pokazać bannera
          // na zaciągniętej kurtynie. Czekamy więc na moment, w którym kurtyna
          // ZACZYNA wjeżdżać do góry — dół ekranu jest wtedy już odsłonięty.
          // `curtainDone` (koniec animacji) zostaje jako zapas dla stron, które
          // nie wysyłają `curtainLifting`.
          // Watchdog to wyłącznie bezpiecznik na wypadek, gdyby żaden z tych
          // sygnałów nie przyszedł (GSAP nie wstał, telefon zaciął skrypt).
          // Przy sprawnej stronie nie odpala się w ogóle.
          if (document.querySelector('.veil')) {
            let curtainDone = false;
            const onCurtainDone = () => { if (curtainDone) return; curtainDone = true; reveal(); };
            document.addEventListener('mioduszewsky:curtainLifting', onCurtainDone, { once: true });
            document.addEventListener('mioduszewsky:curtainDone', onCurtainDone, { once: true });
            setTimeout(onCurtainDone, 2500);
          } else {
            reveal();
          }
        }

        document.getElementById('cookieAccept')?.addEventListener('click', () => {
          try { localStorage.setItem(CONSENT_KEY, 'accepted'); } catch {}
          document.getElementById('cookieBanner').hidden = true;
          initTracking();
        });
        document.getElementById('cookieReject')?.addEventListener('click', () => {
          try { localStorage.setItem(CONSENT_KEY, 'rejected'); } catch {}
          document.getElementById('cookieBanner').hidden = true;
          rejectPostHog();
        });
      }
    </script>

    <style>
      .cookie-banner {
        position: fixed; left: 0; right: 0; bottom: 0; z-index: 1000;
        display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
        gap: 1rem; padding: 14px 20px; background: #100f0c; color: #f8f9f2;
        font-family: 'GeneralSansV', sans-serif; font-size: 13px; line-height: 1.5;
      }
      .cookie-banner[hidden] { display: none; }
      .cookie-banner p { margin: 0; max-width: 62ch; }
      .cookie-banner a { color: #ffcc33; }
      .cookie-actions { display: flex; gap: 10px; flex: none; }
      .cookie-actions button {
        font-family: inherit; font-size: 12px; letter-spacing: 0.04em; cursor: pointer;
        border-radius: 999px; padding: 8px 18px; border: 1px solid rgba(248, 249, 242, 0.4);
        background: transparent; color: #f8f9f2;
      }
      .cb-accept { background: #ffcc33; border-color: #ffcc33; color: #100f0c; font-weight: 600; }
      @media (max-width: 640px) {
        .cookie-banner { flex-direction: column; align-items: flex-start; }
        .cookie-actions { width: 100%; }
        .cookie-actions button { flex: 1; }
      }
    </style>
  </body>
</html>

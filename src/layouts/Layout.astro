---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Kacper Mioduszewski - strony, aplikacje i plany projektów',
  description =
    'Buduję strony internetowe, aplikacje i plany projektów. Od pomysłu do startu - projekt, treść i wdrożenie w jednych rękach.'
} = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- PREVIEW: nie indeksować do czasu podpięcia domeny produkcyjnej -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preload" href="/fonts/Tanker-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Switzer-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JetBrainsMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
    <noscript>
      <style>
        [data-reveal] { opacity: 1 !important; }
        .hero-line > span { transform: none !important; }
      </style>
    </noscript>
  </head>
  <body class="antialiased">
    <slot />
    <script>
      import '../scripts/animation-core.ts';
      import '../scripts/home.ts';
    </script>
  </body>
</html>

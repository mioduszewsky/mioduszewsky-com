---
// Realizacje: strona zbiorcza case studies (30.09.2026). Od 02.10 komponent dla PL i EN.
// Pomysł Kacpra: wachlarz kart w 3D (komponent PortfolioGallery z 21st.dev), wzięta sama mechanika.
// v2: jeden ekran, wyśrodkowany nagłówek, bez kratki i bez dołu. Karty są nawigacją: klik = case.
// v3 (Kacper, 30.09): jedna karta = jedna realizacja = pełny zrzut jej hero sekcji, bez podpisów.
// Kart jest tyle, ile realizacji z żywą stroną. Karty idą po łuku jak wachlarz w dłoni.
// Ruch: pozycje liczy CSS ze zmiennych, skrypt tylko przełącza stan (aktywna karta, rozsunięcie
// sąsiadów, pochylenie za kursorem, etykieta przy kursorze). Animowany jest wyłącznie transform
// i opacity, więc wszystko idzie na kompozytorze. Telefon: pionowa lista pełnych kart.
// v10 (Kacper, 01.10): powrót do v5 (45692b7), jedyna zmiana: karty 4:3 sięgają pod dolną krawędź.
// v11 (Kacper, 01.10): stały odstęp podtytuł-karty (karta rośnie do miejsca pod tekstem), aktywna karta
// wybierana po strefach spoczynku zamiast po elemencie pod kursorem, ruch bez sprężyny.
// v12 (02.10): szerokość kart wraca do skali v10 (37vw), cały wachlarz mieści się w ekranie. Wolne miejsce
// dzieli się po równo nad nagłówkiem i pod podtytułem, karty zawsze schodzą pod dolną krawędź.
// v13 (D5, Kacper i Finch 21.10): telefon (do 599 px) dostaje wachlarz przesuwany palcem zamiast listy kart pod sobą;
// komputer i tablet bez zmian.
import { caseOrder } from '../content/realizacje-kolejnosc';
import { Image } from 'astro:assets';
import VariantLayout from '../layouts/VariantLayout.astro';
import CaseLockup from './realizacje/CaseLockup.astro';
import BrandFooter from './BrandFooter.astro';
import heroGlassstone from '../assets/realizacje/hero-glassstone.webp';
import heroEskapizm from '../assets/realizacje/hero-eskapizm.webp';
// Igor (D5, 21.10): strona „O kolekcji” zamiast strony głównej. Treść strony głównej leży w lewej połowie, a w wachlarzu
// karta z prawej pokazuje tylko prawą połowę, więc była prawie biała; „O kolekcji” ma niebieskie tło i hasła z prawej.
import heroIgor from '../assets/realizacje/hero-igor-kolekcja.webp';
import heroCannversity from '../assets/realizacje/hero-cannversity.webp';

interface Props { locale: 'pl' | 'en' }
const { locale } = Astro.props;
const pl = locale === 'pl';

// Wersje językowe: PL /pl/realizacje/, EN /work/. Ten sam wachlarz, tekst napisany osobno.
const T = pl ? {
  base: '/pl/realizacje/', alt: '/work/', home: 'https://mioduszewsky.com/pl/', crumb: 'Realizacje', cardsLabel: 'Case studies',
  title: 'Case Study · mioduszewsky', h1: 'Case Study', skip: 'Przejdź do treści', mark: 'mioduszewsky. Strona główna.',
  lead: 'Prawdziwe projekty opisane od początku do końca: z jakim problemem przyszła firma, co zbudowałem i co z tego działa dziś.',
  caseLabel: 'Case study', nameEskapizm: 'eskapizm',
} : {
  base: '/work/', alt: '/pl/realizacje/', home: 'https://mioduszewsky.com/', crumb: 'Case studies', cardsLabel: 'Case studies',
  title: 'Case Studies · mioduszewsky', h1: 'Case Studies', skip: 'Skip to content', mark: 'mioduszewsky. Home.',
  lead: 'Real projects, start to finish: the problem a company came in with, what I built, and what is still working today.',
  caseLabel: 'Case study', nameEskapizm: 'eskapizm',
};
const P = (t: string) => pl ? t.replace(/(^|[\s(„])([wziouaWZIOUA]) /g, '$1$2&nbsp;') : t;

// Link pojawia się sam, gdy w folderze danego języka powstanie strona case'u o tym slugu.
const pagesPl = import.meta.glob(['../pages/pl/realizacje/*.astro', '!../pages/pl/realizacje/_*.astro']);
const pagesEn = import.meta.glob(['../pages/work/*.astro', '!../pages/work/_*.astro']);
const hasCase = (slug: string) => `../pages/${pl ? 'pl/realizacje' : 'work'}/${slug}.astro` in (pl ? pagesPl : pagesEn);

// Zrzuty żywych stron w oknie 1280×720 (16:9, skala 2x), 02.10.2026. Okno 1024×768 łapało układ tabletowy
// (Kacper: eskapizm „prostokątny”, nie jak oryginał), 1440×1080 oddalało stronę. 16:9 to desktopowy układ
// w normalnej skali. Igor: strona główna z kursorem na „Prace”, więc widać pracę z kolekcji (sam spis wyglądał biednie),
// z okna 1024×576, bo z 1280×720 strona wyglądała na oddaloną.
// Kolejność kart = pętla „Następna realizacja” z src/content/realizacje-kolejnosc.ts (decyzja Fincha 20.10).
// Karta jest tylko dla case'u z tej listy w danym języku (GlassStone zdjęty do przebudowy, Kacper 21.10).
const order = (slug: string) => caseOrder.findIndex((c) => c.slug === slug);
const cases = [
  { slug: 'glassstone', name: 'GlassStone', img: heroGlassstone, alt: pl ? 'Hero strony GlassStone: Nie sprzedajemy kamienia. Tworzymy wnętrza, w których chce się żyć.' : "GlassStone homepage hero, in Polish: we don't sell stone, we create interiors you want to live in." },
  { slug: 'eskapizm', name: T.nameEskapizm, img: heroEskapizm, alt: pl ? 'Hero strony eskapizm: Kolejny wieczór na planowaniu podróży do Azji? Laptop na biurku w złotej godzinie.' : 'eskapizm homepage hero, in Polish: another evening spent planning a trip to Asia? A laptop on a desk at golden hour.' },
  { slug: 'igor-grabowski', name: 'Igor Grabowski', img: heroIgor, alt: pl ? 'Strona „O kolekcji” Igora Grabowskiego: nagłówek „Jak to się zaczęło.”, z prawej „Inżynier → IT” i „Od 2020”.' : "The About the collection page on Igor Grabowski's site, in Polish: the heading reads \"How it started\", with \"Engineer → IT\" and \"Since 2020\" on the right." },
  { slug: 'cannversity', name: 'Cannversity', img: heroCannversity, alt: pl ? 'Hero strony Cannversity: Od pomysłu do produktu. W branży konopnej.' : 'Cannversity homepage hero, in Polish: from idea to product, in the cannabis industry.' },
].filter((c) => caseOrder.some((o) => o.slug === c.slug && o.locales.includes(locale))).sort((a, b) => order(a.slug) - order(b.slug)).map((c) => ({ ...c, href: hasCase(c.slug) ? `${T.base}${c.slug}/` : undefined }));

const n = cases.length;
const center = (n - 1) / 2;
// Warstwy: środek na wierzchu, brzegi pod spodem, żeby żadna karta nie chowała się za sąsiadami.
const zOf = (i: number) => 20 - Math.round(Math.abs(i - center) * 4) + (i > center ? 1 : 0);

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'CollectionPage', name: T.crumb, inLanguage: locale, url: `https://mioduszewsky.com${T.base}`,
      hasPart: cases.filter((c) => c.href).map((c) => ({ '@type': 'Article', name: c.name, url: `https://mioduszewsky.com${c.href}` })) },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'mioduszewsky', item: T.home },
      { '@type': 'ListItem', position: 2, name: T.crumb, item: `https://mioduszewsky.com${T.base}` } ] },
  ],
};
---
<VariantLayout
  title={T.title}
  description={T.lead}
  bg="#f8f9f2" fg="#000000" switcher={false} robots="index, follow, max-image-preview:large" locale={locale} alternatePath={T.alt}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <div class="work">
    <a class="skip" href="#main">{T.skip}</a>
    <!-- Nagłówek jak w case'ach (21.10): wspólny CaseLockup, bez części „× klient”. Lockup jest fixed,
         więc .nav zostaje pustym miejscem 104 px w układzie i kompozycja pierwszego ekranu się nie rusza. -->
    <CaseLockup locale={locale} alternatePath={T.alt} tone="light" />
    <div class="nav" aria-hidden="true"></div>

    <main id="main" class="stage">
      <header class="hero">
        <h1>{T.h1}</h1>
        <p class="lead" set:html={P(T.lead)} />
      </header>

      <ul class="fan" aria-label={T.cardsLabel}>
        {cases.map((c, i) => {
          const Tag = c.href ? 'a' : 'div';
          const o = i - center;
          return (
            <li class="card" data-name={c.name} data-link={c.href ? '1' : undefined}
              style={`--o:${o}; --enter:${Math.round(Math.abs(o) * 90)}ms; z-index:${zOf(i)}`} data-z={zOf(i)}>
              <Tag class="sheet" href={c.href} aria-label={c.href ? `${T.caseLabel}: ${c.name}` : undefined}>
                <span class="frame">
                  <Image src={c.img} alt={c.alt} widths={[640, 1000, 1600]} sizes="(min-width: 768px) 40vw, 84vw" loading="eager" decoding="async" />
                </span>
              </Tag>
            </li>
          );
        })}
      </ul>
      <div class="m-now" aria-hidden="true">
        <span class="m-pill"><span class="m-name">{cases[0].name}</span><svg class="pill-go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7" /><path d="M8 7h9v9" /></svg></span>
        <span class="m-bars">{cases.map((_, i) => <i class:list={[{ on: i === 0 }]} />)}</span>
      </div>
      <div class="pill" aria-hidden="true"><span class="pill-name"></span><svg class="pill-go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7" /><path d="M8 7h9v9" /></svg></div>
    </main>
    <BrandFooter locale={locale} inset />
  </div>
</VariantLayout>

<script>
  const fan = document.querySelector<HTMLElement>('.fan');
  const pill = document.querySelector<HTMLElement>('.pill');
  // Wachlarz z kursorem: te same progi co w CSS (tablet w pionie ma listę).
  const desk = matchMedia('(hover: hover) and (pointer: fine) and (min-width: 1101px), (hover: hover) and (pointer: fine) and (min-width: 768px) and (orientation: landscape)');
  const calm = matchMedia('(prefers-reduced-motion: reduce)');

  if (fan && pill) {
    const cards = [...fan.querySelectorAll<HTMLElement>('.card')];
    const pillName = pill.querySelector<HTMLElement>('.pill-name')!;
    let active = -1;
    let leaveTimer = 0;
    const zTimers: number[] = [];

    // Naturalna wysokość nagłówka dla CSS: z niej wynika, ile miejsca pod spodem mają karty (patrz .work --w).
    const hero = document.querySelector<HTMLElement>('.hero')!;
    const stage = document.querySelector<HTMLElement>('.stage')!;
    const heroH = () => {
      const h1 = hero.querySelector('h1')!.getBoundingClientRect();
      const lead = hero.querySelector('.lead')!.getBoundingClientRect();
      stage.style.setProperty('--hh', `${Math.ceil(lead.bottom - h1.top + parseFloat(getComputedStyle(hero).paddingTop))}px`);
    };
    new ResizeObserver(heroH).observe(hero);

    const zBase = (i: number) => Number(cards[i].dataset.z);
    cards.forEach((c, i) => { c.style.zIndex = String(zBase(i)); });

    // Wejście: karty rozkładają się od środka, gdy obrazy są gotowe (najdłużej 600 ms).
    const imgs = [...fan.querySelectorAll('img')];
    const ready = () => requestAnimationFrame(() => {
      fan.classList.add('is-ready');
      setTimeout(() => fan.classList.add('is-settled'), 1400);
    });
    Promise.race([
      Promise.all(imgs.map((im) => im.decode().catch(() => {}))),
      new Promise((r) => setTimeout(r, 600)),
    ]).then(ready);

    const resetTilt = (card: HTMLElement) => {
      const sheet = card.querySelector<HTMLElement>('.sheet')!;
      sheet.style.setProperty('--tx', '0deg'); sheet.style.setProperty('--ty', '0deg');
    };

    const setActive = (idx: number) => {
      if (idx === active) return;
      const prev = active;
      active = idx;
      fan.classList.toggle('has-active', idx >= 0);
      cards.forEach((card, i) => {
        const on = i === idx;
        card.classList.toggle('is-active', on);
        // Sąsiedzi rozsuwają się od aktywnej karty, bliżsi mocniej.
        const d = idx < 0 || on ? 0 : Math.sign(i - idx) / Math.sqrt(Math.abs(i - idx));
        card.style.setProperty('--part', d.toFixed(3));
        clearTimeout(zTimers[i]);
        if (on) card.style.zIndex = '50';
        // Poprzednia karta wraca na swoją warstwę dopiero, gdy opadnie, żeby nie przeskoczyła za sąsiada.
        // W tym czasie stoi pod nową aktywną (40 < 50), inaczej potrafiła ją na chwilę przykryć.
        else if (i === prev) { card.style.zIndex = '40'; zTimers[i] = window.setTimeout(() => { card.style.zIndex = String(zBase(i)); }, 450); }
        else card.style.zIndex = String(zBase(i));
        if (!on) resetTilt(card);
      });
      if (idx >= 0) {
        pillName.textContent = cards[idx].dataset.name || '';
        pill.classList.toggle('is-link', !!cards[idx].dataset.link);
      }
      pill.classList.toggle('is-on', idx >= 0 && desk.matches);
    };

    // Pochylenie za kursorem, odblask i etykieta liczone w jednej pętli z wygładzaniem.
    let mx = 0, my = 0, tx = 0, ty = 0, px = 0, py = 0, lx = 0, ly = 0, raf = 0;
    const loop = () => {
      tx += (mx - tx) * 0.14; ty += (my - ty) * 0.14;
      px += (lx - px) * 0.22; py += (ly - py) * 0.22;
      pill.style.transform = `translate3d(${px.toFixed(1)}px, ${py.toFixed(1)}px, 0)`;
      const card = cards[active];
      if (card) {
        const sheet = card.querySelector<HTMLElement>('.sheet')!;
        sheet.style.setProperty('--tx', `${(-ty * 5).toFixed(2)}deg`);
        sheet.style.setProperty('--ty', `${(tx * 6).toFixed(2)}deg`);
        sheet.style.setProperty('--gx', tx.toFixed(3));
        sheet.style.setProperty('--gy', ty.toFixed(3));
      }
      const settled = Math.abs(mx - tx) < 0.001 && Math.abs(my - ty) < 0.001 && Math.abs(lx - px) < 0.3 && Math.abs(ly - py) < 0.3;
      raf = settled ? 0 : requestAnimationFrame(loop);
    };
    const kick = () => { if (!raf) raf = requestAnimationFrame(loop); };

    // Która karta jest aktywna, wynika z położenia kursora względem miejsc kart w spoczynku, a nie
    // z tego, co akurat leży pod kursorem. Karta po najechaniu przesuwa się i rozpycha sąsiadów;
    // przy wyborze po elemencie pod kursorem lądowała wtedy inna karta i wachlarz przeskakiwał.
    // Granica stref ma margines (HYST), więc drganie ręki na styku dwóch kart niczego nie zmienia.
    const HYST = 0.12;
    const k = parseFloat(getComputedStyle(fan).getPropertyValue('--k')) || 0.5;
    const center = (cards.length - 1) / 2;
    const slotAt = (clientX: number) => {
      const r = fan.getBoundingClientRect();
      const step = cards[0].offsetWidth * k;
      const f = (clientX - (r.left + r.width / 2)) / step + center;
      if (active >= 0 && Math.abs(f - active) < 0.5 + HYST) return active;
      return Math.max(0, Math.min(cards.length - 1, Math.round(f)));
    };

    fan.addEventListener('pointermove', (e) => {
      if (!desk.matches || e.pointerType !== 'mouse') return;
      const over = (e.target as Element).closest<HTMLElement>('.card');
      clearTimeout(leaveTimer);
      if (over) {
        setActive(slotAt(e.clientX));
        const card = cards[active];
        if (!calm.matches) {
          const r = card.querySelector('.frame')!.getBoundingClientRect();
          mx = Math.max(-1, Math.min(1, ((e.clientX - r.left) / r.width) * 2 - 1));
          my = Math.max(-1, Math.min(1, ((e.clientY - r.top) / r.height) * 2 - 1));
        }
      }
      lx = e.clientX + 18; ly = e.clientY + 18;
      if (!pill.classList.contains('was-shown')) { px = lx; py = ly; pill.classList.add('was-shown'); }
      kick();
    });
    // Krótka zwłoka przy wyjściu: przejście kursora przez szczelinę między kartami nie zrzuca całego wachlarza.
    fan.addEventListener('pointerleave', () => {
      clearTimeout(leaveTimer);
      leaveTimer = window.setTimeout(() => { setActive(-1); mx = my = 0; kick(); pill.classList.remove('was-shown'); }, 90);
    });
    fan.addEventListener('pointerdown', (e) => { (e.target as Element).closest('.card')?.classList.add('is-press'); });
    addEventListener('pointerup', () => cards.forEach((c) => c.classList.remove('is-press')));
    // Klawiatura: fokus działa jak najechanie, bez etykiety przy kursorze.
    fan.addEventListener('focusin', (e) => { const c = (e.target as Element).closest<HTMLElement>('.card'); if (c) setActive(cards.indexOf(c)); pill.classList.remove('is-on'); });
    fan.addEventListener('focusout', () => setActive(-1));
  }

  // Telefon (D5): wachlarz w bok. Pas z przyciąganiem do środka, pion przewija stronę.
  // Skrypt czyta pozycję pasa raz na klatkę i ustawia każdej karcie odległość od środka (--d ze znakiem, --a bez);
  // pochylenie, zejście w dół i zmniejszenie sąsiadów liczy CSS. Stuknięcie w boczną kartę przewozi ją na środek,
  // w środkową otwiera case. Próg 599 px = ten sam, od którego tablet w pionie ma listę w dwóch kolumnach.
  const phone = matchMedia('(max-width: 599px)');
  const track = document.querySelector<HTMLElement>('.fan');
  const now = document.querySelector<HTMLElement>('.m-now');
  if (track && now) {
    const cs = [...track.querySelectorAll<HTMLElement>('.card')];
    const name = now.querySelector<HTMLElement>('.m-name')!;
    const go = now.querySelector<HTMLElement>('.pill-go')!;
    const bars = [...now.querySelectorAll<HTMLElement>('.m-bars i')];
    let mid = -1, t = false;
    const dist: number[] = [];
    const upd = () => {
      t = false; if (!phone.matches) return;
      const c = track.scrollLeft + track.clientWidth / 2;
      const w = cs[0].offsetWidth || 1;
      let best = 0, bd = 1e9;
      cs.forEach((card, i) => {
        const d = Math.max(-1.5, Math.min(1.5, (card.offsetLeft + card.offsetWidth / 2 - c) / w));
        dist[i] = Math.abs(d);
        card.style.setProperty('--d', d.toFixed(3)); card.style.setProperty('--a', Math.abs(d).toFixed(3));
        card.style.setProperty('z-index', String(10 - Math.round(Math.abs(d) * 4)), 'important'); // lista telefonu ma z-index auto !important
        if (Math.abs(d) < bd) { bd = Math.abs(d); best = i; }
      });
      if (best !== mid) {
        mid = best;
        name.textContent = cs[best].dataset.name || '';
        go.style.display = cs[best].dataset.link ? 'block' : 'none';
        bars.forEach((b, i) => b.classList.toggle('on', i === best));
        cs.forEach((card, i) => card.classList.toggle('is-mid', i === best));
      }
    };
    const req = () => { if (!t) { t = true; requestAnimationFrame(upd); } };
    track.addEventListener('scroll', req, { passive: true });
    addEventListener('resize', req, { passive: true });
    const center = (i: number) => track.scrollTo({ left: cs[i].offsetLeft + cs[i].offsetWidth / 2 - track.clientWidth / 2, behavior: calm.matches ? 'auto' : 'smooth' });
    // dotyk otwiera case tylko przy karcie stojącej na środku (karta w drodze na środek najpierw dojeżdża);
    // Enter z klawiatury (detail 0) otwiera zawsze (recenzja Codexa)
    cs.forEach((card, i) => card.addEventListener('click', (e) => { if (phone.matches && e.detail !== 0 && (dist[i] ?? 1) > .08) { e.preventDefault(); center(i); } }));
    bars.forEach((b, i) => b.addEventListener('click', () => center(i)));
    // klawiatura: karta z fokusem jedzie na środek. Tylko fokus z klawiatury: WebKit daje fokus także przy stuknięciu,
    // a drugie płynne przewinięcie naraz z tym z kliknięcia zatrzymywało pas w pół drogi.
    track.addEventListener('focusin', (e) => { const el = e.target as Element; const i = cs.indexOf(el.closest<HTMLElement>('.card')!); if (phone.matches && i >= 0 && el.matches(':focus-visible')) center(i); });
    // wyjście z trybu telefonu (obrót, poszerzenie okna): wachlarz z kursorem dostaje z powrotem swoje warstwy
    phone.addEventListener('change', () => {
      if (phone.matches) { mid = -1; req(); return; }
      cs.forEach((card) => { card.style.removeProperty('--d'); card.style.removeProperty('--a'); card.style.zIndex = card.dataset.z || ''; card.classList.remove('is-mid'); });
    });
    upd();
  }
</script>

<style>
  .work {
    --ivory: #f8f9f2; --ink: #111; --dim: #5f5b4e;
    --blue: #0522ff; --brand: #ffcc33;
    --gutter: clamp(20px, 5vw, 96px); --focus: var(--blue);
    --ease-out: cubic-bezier(.22, 1, .36, 1);
    --ease-spring: cubic-bezier(.2, 1.18, .32, 1);
    font-family: 'GeneralSansV', sans-serif; background: var(--ivory); color: var(--ink); overflow-x: clip;
  }
  @font-face { font-family: 'NohemiV'; src: url('/fonts/Nohemi-Variable.woff2') format('woff2'); font-weight: 100 900; font-display: swap; }
  @font-face { font-family: 'GeneralSansV'; src: url('/fonts/GeneralSans-Variable.woff2') format('woff2'); font-weight: 200 700; font-display: swap; }
  .work :is(h1,p,ul) { margin: 0; }
  .work ul { padding: 0; list-style: none; }
  .work p { text-wrap: pretty; }
  .work :is(a,button):focus-visible { outline: 3px solid var(--focus); outline-offset: 4px; }
  .work ::selection { background: var(--brand); }
  .skip { position: fixed; top: 12px; left: 12px; z-index: 150; padding: 12px 20px; background: var(--brand); color: var(--ink); transform: translateY(-200%); }
  .skip:focus { transform: none; }
  .nav { height: 104px; }

  /* Jeden ekran: wachlarz stoi na dole i schodzi pod krawędź, nagłówek zajmuje resztę. Wolne miejsce
     (wysokie okna) dzieli się po równo nad nagłówkiem i pod podtytułem, zamiast zbierać się w jednym pasie.
     Szerokość karty: 42vw przy kroku 0,5 (karty 16:9, cały wachlarz w ekranie, brzegi ucięte o kilka procent),
     mniejsza tylko wtedy, gdy pod nagłówkiem brakuje wysokości. --hh to naturalna wysokość nagłówka (skrypt). */
  .stage {
    --gap: clamp(48px, 7vh, 88px);
    --w: clamp(300px, min(42vw, calc((100svh - 104px - var(--hh, 260px) - var(--gap)) / .52)), 1000px);
    min-height: calc(100svh - 104px); display: flex; flex-direction: column; overflow: clip;
  }
  .hero {
    flex: 1 0 auto; display: flex; flex-direction: column; justify-content: center;
    padding: clamp(8px, 4vh, 56px) var(--gutter) 0; text-align: center; position: relative; z-index: 60; pointer-events: none;
  }
  .hero :is(h1, p) { pointer-events: auto; }
  h1 { font-family: 'NohemiV', sans-serif; font-weight: 500; font-size: clamp(48px, 8vw, 128px); line-height: .95; letter-spacing: -.045em; }
  .lead { margin: clamp(16px, 2.4vw, 28px) auto 0 !important; max-width: 30em; font-size: 19px; line-height: 1.55; color: var(--dim); }

  /* Wachlarz po łuku: środek najwyżej, brzegi niżej i lekko przechylone na zewnątrz, jak karty w dłoni.
     Położenie każdej karty wynika z --o (odległość od środka), stan dokłada skrypt.
     ZATWIERDZONY 30.09.2026 (Kacper, wariant A): karty płasko, bez skosu w głąb, środek na wierzchu.
     Warianty ze skosem (B, C z v3) odrzucone. Po wyborze powiększone. */
  /* Wachlarz ma wysokość odstępu i widocznej części karty (52% szerokości z 56%), reszta karty
     schodzi pod ekran. Odstęp od podtytułu nigdy nie jest mniejszy niż --gap. */
  .fan {
    --k: .5; --arc: .06; --rzk: 4deg; --ry0: 0deg; --ry1: 0deg;
    position: relative; flex: none; height: calc(var(--gap) + var(--w) * .52);
    perspective: 2400px; perspective-origin: 50% 0%;
  }
  .card {
    --step: calc(var(--w) * var(--k));
    --part: 0;
    --x: calc(var(--o) * var(--step) + var(--part) * var(--w) * .09);
    --y: calc(var(--o) * var(--o) * var(--w) * var(--arc));
    --rz: calc(var(--o) * var(--rzk));
    --ry: var(--ry0);
    --s: 1;
    position: absolute; left: 50%; top: var(--gap);
    width: var(--w);
    transform: translate3d(calc(-50% + var(--x)), var(--y), 0) rotateZ(var(--rz)) rotateY(var(--ry)) scale(var(--s));
    transform-origin: 50% 100%;
    transition: transform .8s var(--ease-spring), opacity .6s var(--ease-out);
    will-change: transform;
  }
  .fan.has-active .card { --y: calc(var(--o) * var(--o) * var(--w) * var(--arc) + var(--w) * .05); }
  .fan.has-active .card.is-active {
    --x: calc(var(--o) * var(--step) * .8); --y: calc(var(--w) * -.01); --rz: 0deg; --ry: var(--ry1); --s: 1.03;
  }
  /* Po wejściu ruch bez sprężyny: przy szybkim przejeżdżaniu kursorem odbicie z każdej przerwanej
     animacji wyglądało jak szarpnięcie. Jedna gładka krzywa, ta sama dla karty i sąsiadów. */
  .fan.is-settled .card { transition: transform .6s var(--ease-out), opacity .6s var(--ease-out); }
  .fan .card.is-active.is-press { --s: 1.01; transition-duration: .18s; }

  /* Wejście: karty wjeżdżają spod krawędzi, od środka na zewnątrz. Bez skryptu stoją od razu. */
  @media (scripting: enabled) {
    .fan:not(.is-ready) .card { --y: calc(var(--w) * .5); --rz: 0deg; opacity: 0; transition: none; }
    .fan.is-ready:not(.is-settled) .card { transition-delay: var(--enter); transition-duration: 1.1s, .5s; }
  }

  .sheet {
    --tx: 0deg; --ty: 0deg; --gx: 0; --gy: -1;
    display: block; position: relative; border-radius: 12px; color: inherit; text-decoration: none;
    transform: rotateX(var(--tx)) rotateY(var(--ty));
  }
  .card:not([data-link]) .sheet { cursor: default; }
  /* Cień w dwóch warstwach: stały i głęboki dla aktywnej karty, animowana jest tylko przezroczystość. */
  .sheet::before, .sheet::after { content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; }
  .sheet::before {
    box-shadow: 1px 0 1px rgb(0 0 0 / .01), 2.4px 0 2.4px rgb(0 0 0 / .03), 6.4px 0 6.4px rgb(0 0 0 / .08), 20px 0 20px rgb(0 0 0 / .22);
  }
  .sheet::after {
    box-shadow: 0 40px 80px -20px rgb(17 17 17 / .45), 0 18px 36px -18px rgb(17 17 17 / .35);
    opacity: 0; transition: opacity .5s var(--ease-out);
  }
  .is-active .sheet::after { opacity: 1; }
  .frame { display: block; position: relative; overflow: hidden; border-radius: inherit; background: #e9e9e2; transform: translateZ(0); }
  .frame img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; object-position: top; }
  /* Odblask podąża za kursorem na aktywnej karcie. Gradient stoi, przesuwa się cała warstwa
     (transform), więc ruch nie wymusza przemalowania w każdej klatce. */
  .frame::after {
    content: ''; position: absolute; inset: -50%; pointer-events: none;
    background: radial-gradient(30% 35% at 50% 50%, rgb(255 255 255 / .22), transparent 70%);
    transform: translate3d(calc(var(--gx) * 25%), calc(var(--gy) * 25%), 0);
    opacity: 0; transition: opacity .4s var(--ease-out);
  }
  .is-active .frame::after { opacity: 1; }
  .fan .sheet:focus-visible { outline-offset: 6px; }

  /* Etykieta przy kursorze: nazwa realizacji, strzałka tylko przy gotowym case. */
  .pill {
    position: fixed; left: 0; top: 0; z-index: 120; pointer-events: none;
    display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px 10px 16px;
    border-radius: 999px; background: var(--ink); color: var(--ivory);
    font-size: 15px; font-weight: 500; line-height: 1; white-space: nowrap;
    opacity: 0; scale: .6; transform-origin: 0 0;
    transition: opacity .25s var(--ease-out), scale .35s var(--ease-spring);
  }
  .pill.is-on { opacity: 1; scale: 1; }
  .pill-go { width: 16px; height: 16px; color: var(--brand); display: none; }
  .pill.is-link .pill-go { display: block; }

  /* Telefon i tablet dotykowy: pas pełnych kart przewijany palcem, bez łuku. */
  /* Tablet w pionie też dostaje listę: wachlarz na wąskim, wysokim ekranie zostawiał karty małe
     i pół ekranu pustego. Od 600 px dwie kolumny. */
  @media (max-width: 767px), (max-width: 1100px) and (orientation: portrait) {
    .stage { min-height: 0; }
    .hero { flex: none; }
    .lead { font-size: 17px; }
    /* Lista pełnych kart, każda na całą szerokość, więc każdą łatwo stuknąć (telefon do 599 px nadpisuje to wachlarzem w bok). */
    .work .fan {
      flex: none; height: auto; perspective: none;
      display: grid; grid-template-columns: 1fr; gap: 16px;
      padding: 28px var(--gutter) 48px;
    }
    .card { --w: 100%; position: relative; left: auto; top: auto; flex: none; transform: none; z-index: auto !important; }
    /* Gotowe case'y idą na górę listy. */
    .card[data-link] { order: -1; }
    .card:active .sheet { scale: .98; }
    .sheet { transition: scale .25s var(--ease-out); }
    .sheet::before { box-shadow: 0 12px 28px rgb(0 0 0 / .14); }
    .pill { display: none; }
  }
  /* Telefon (D5): wachlarz w bok. Karta na środku 80% szerokości, sąsiedzi wystają po bokach,
     pochyleni i niżej, jak karty w dłoni (ten sam łuk co na komputerze). Jeden ekran zamiast czterech kart pod sobą.
     Pod spodem pigułka z nazwą (jak etykieta przy kursorze na komputerze) i kreski pozycji. */
  .m-now { display: none; }
  @media (max-width: 599px) {
    .work .fan {
      --cw: 80vw;
      display: flex; gap: 0; overflow: auto hidden; overscroll-behavior-x: contain; /* pas nie może przewijać się w pionie: wtedy zabiera stronie pionowy gest */ scroll-snap-type: x mandatory; scrollbar-width: none;
      padding: 28px calc((100% - var(--cw)) / 2) 52px;
    }
    .work .fan::-webkit-scrollbar { display: none; }
    .work .card { --d: 0; --a: 0; flex: 0 0 var(--cw); width: var(--cw); scroll-snap-align: center; scroll-snap-stop: always; order: 0; transform: none; transition: none; }
    /* ruch na wnętrzu karty, nie na samej karcie: WebKit liczy punkt przyciągania z przekształconego pudełka,
       więc z transformem na karcie przyciągał ją ok. 40 px obok środka */
    .work .sheet {
      transform: translate3d(calc(var(--d) * -16%), calc(var(--a) * 14px), 0) rotateZ(calc(var(--d) * 5deg)) scale(calc(1 - var(--a) * .1));
      transform-origin: 50% 100%;
    }
    /* stuknięcie daje karcie fokus, a fokus włącza desktopowy cień aktywnej karty (80 px), którego pas nie zmieści */
    .work .sheet::after, .work .frame::after { display: none; }
    .card:not(.is-mid) .sheet::before { box-shadow: 0 6px 14px -4px rgb(0 0 0 / .14); }
    /* cień mieści się w zapasie pasa (u góry 28 px, u dołu 52 px), inaczej pas ucina go prostą krawędzią */
    .card.is-mid .sheet::before { box-shadow: 0 16px 28px -12px rgb(0 0 0 / .34), 0 6px 12px -6px rgb(0 0 0 / .2); }
    .m-now { display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 0 var(--gutter) 40px; }
    .m-pill { display: inline-flex; align-items: center; gap: 8px; padding: 12px 16px 12px 18px; border-radius: 999px; background: var(--ink); color: var(--ivory); font-size: 16px; font-weight: 500; line-height: 1; }
    .m-pill .pill-go { display: block; }
    /* kreska ma 3 px, pole stuknięcia 24 px wysokości */
    .m-bars { display: flex; margin-block: -10px; }
    .m-bars i { display: block; padding: 10px 3px; cursor: pointer; }
    .m-bars i::before { content: ''; display: block; width: 22px; height: 3px; border-radius: 2px; background: rgb(17 17 17 / .18); transition: background .3s, width .3s; }
    .m-bars i.on::before { width: 36px; background: var(--ink); }
  }
  /* niski telefon (320x568): pigułka z nazwą musi zmieścić się na pierwszym ekranie */
  @media (max-width: 599px) and (max-height: 620px) {
    .lead { font-size: 15px; line-height: 1.5; }
    .work .fan { padding-top: 18px; padding-bottom: 44px; }
    .m-now { gap: 12px; padding-bottom: 28px; }
  }
  @media (min-width: 600px) and (max-width: 1100px) and (orientation: portrait) {
    .work .fan { grid-template-columns: 1fr 1fr; gap: 20px; padding-top: 40px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .card, .sheet, .pill { transition-duration: .01s !important; transition-delay: 0s !important; }
    .fan:not(.is-ready) .card { opacity: 1; }
  }
</style>

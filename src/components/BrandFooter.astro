---
import ContactBadge from './ContactBadge.astro';
import { routes, type Locale } from '../i18n/site';
interface Props { locale?: Locale; inset?: boolean; invitation?: boolean; as?: 'footer' | 'div' }
const { locale = 'pl', inset = false, invitation = false, as: Tag = 'footer' } = Astro.props;
const pl = locale === 'pl';
const r = routes[locale];
---
<Tag class:list={['brand-footer', { inset, invitation }]}>
  {invitation && <div class="footer-invitation"><slot /></div>}
  <div class="fcol">
          <p class="flabel">{pl ? 'Kontakt' : 'Contact'}</p>
          <a href="mailto:kacper@mioduszewsky.com">kacper@mioduszewsky.com</a>
          <a class="sc" href="https://instagram.com/mioduszewsky" target="_blank" rel="noopener">
            <svg class="sc-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.914-.0564 1.2775-.0689 1.6882-.0626 4.947.0062 3.2586.0206 3.6671.0825 4.9473.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.295 1.6361.4961 2.9134.552 1.2773.056 1.6884.069 4.9462.0627 3.2578-.0062 3.668-.0207 4.9478-.0814 1.28-.0607 2.147-.2652 2.9098-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.6682 1.0745-1.3378 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6898.063-4.948-.0063-3.2583-.021-3.6668-.0817-4.9465-.0607-1.2797-.264-2.1487-.5633-2.9117-.3084-.7889-.72-1.4568-1.3876-2.1228C21.2982 1.33 20.628.9208 19.8378.6165 19.074.321 18.2017.1197 16.9244.0645 15.6471.0093 15.236-.005 11.977.0014 8.718.0076 8.31.0215 7.0301.0839m.1402 21.6932c-1.17-.0509-1.8053-.2453-2.2287-.408-.5606-.216-.96-.4771-1.3819-.895-.422-.4178-.6811-.8186-.9-1.378-.1644-.4234-.3624-1.058-.4171-2.228-.0595-1.2645-.072-1.6442-.079-4.848-.007-3.2037.0053-3.583.0607-4.848.05-1.169.2456-1.805.408-2.2282.216-.5613.4762-.96.895-1.3816.4188-.4217.8184-.6814 1.3783-.9003.423-.1651 1.0575-.3614 2.227-.4171 1.2655-.06 1.6447-.072 4.848-.079 3.2033-.007 3.5835.005 4.8495.0608 1.169.0508 1.8053.2445 2.228.408.5608.216.96.4754 1.3816.895.4217.4194.6816.8176.9005 1.3787.1653.4217.3617 1.056.4169 2.2263.0602 1.2655.0739 1.645.0796 4.848.0058 3.203-.0055 3.5834-.061 4.848-.051 1.17-.245 1.8055-.408 2.2294-.216.5604-.4763.96-.8954 1.3814-.419.4215-.8181.6811-1.3783.9-.4224.1649-1.0577.3617-2.2262.4174-1.2656.0595-1.6448.072-4.8493.079-3.2045.007-3.5825-.006-4.848-.0608M16.953 5.5864A1.44 1.44 0 1 0 18.39 4.144a1.44 1.44 0 0 0-1.437 1.4424M5.8385 12.012c.0067 3.4032 2.7706 6.1557 6.173 6.1493 3.4026-.0065 6.157-2.7701 6.1506-6.1733-.0065-3.4032-2.771-6.1565-6.174-6.1498-3.403.0067-6.156 2.771-6.1496 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A3.9996 3.9996 0 0 1 8 12.0077" /></svg>
            <span>Instagram</span>
          </a>
          <a class="sc" href="https://www.linkedin.com/in/kacper-mioduszewski/" target="_blank" rel="noopener">
            <!-- Font Awesome Free 6 „linkedin-in" (CC BY 4.0); viewBox 448x512 przeskalowany do 24x24 po bounding boxie glifu -->
            <svg class="sc-i" viewBox="0 0 24 24" aria-hidden="true"><g transform="scale(0.0535714)"><path d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z" /></g></svg>
            <span>LinkedIn</span>
          </a>
          <a class="sc" href="https://contra.com/kacper_mioduszewski_i7ytzt28" target="_blank" rel="noopener">
            <svg class="sc-i sc-i-contra" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M8.53257 4.1249C7.3761 5.8885 5.86224 7.39707 4.09025 8.54825C2.83892 9.4038 1.46713 10.0996 0.00488281 10.6031V11.0068H11.0004V0.0055542H10.6134C10.1069 1.47971 9.40224 2.86386 8.53213 4.1249H8.53257ZM12.9974 0.0055542V11.054H23.9942V10.6503C22.5324 10.1468 21.1615 9.45101 19.9089 8.59546C18.1386 7.44428 16.6234 5.93571 15.467 4.17211C14.5876 2.89783 13.8772 1.4978 13.3694 0.0055542H12.9974ZM23.9942 12.946H12.9974V23.9945H13.3694C13.8772 22.5027 14.5872 21.1022 15.467 19.8279C16.6234 18.0643 18.1391 16.5557 19.9089 15.4046C21.1615 14.5486 22.5324 13.8532 23.9942 13.3497V12.946ZM11.0008 23.9945V12.9932H0.00532404V13.3969C1.46713 13.9004 2.83936 14.5962 4.09069 15.4518C5.86224 16.6029 7.3761 18.112 8.53301 19.8751C9.40312 21.1362 10.1073 22.5199 10.6143 23.994H11.0013L11.0008 23.9945Z" /></svg>
            <span>Contra</span>
          </a>
        </div>
  <ContactBadge locale={locale} id="footer-contact-orbit" />
  <nav class="legal" aria-label={pl ? 'Informacje i nawigacja' : 'Information and navigation'}>
    <span class="copyright">© 2026 mioduszewsky</span>
    <a href={r.home}>{pl ? 'Strona główna' : 'Home'}</a>
    <a href={r.services}>{pl ? 'Usługi' : 'Services'}</a>
    <a href={pl ? '/pl/polityka-prywatnosci/' : '/privacy/'}>{pl ? 'Polityka prywatności' : 'Privacy policy'}</a>
    <a href={pl ? '/pl/regulamin/' : '/terms/'}>{pl ? 'Regulamin' : 'Terms of service'}</a>
  </nav>
  <p class="copyright-m">© 2026 mioduszewsky</p>
</Tag>
<style>
  .brand-footer { --ink: #000; --blue: #0522ff; --dim: #777265; font-family: 'GeneralSansV', sans-serif; color: var(--ink); background: #f8f9f2; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 24px 4vw; align-items: center; padding-block: 3vh 24px; border-top: 1px solid #0002; }
  .inset { margin-inline: clamp(24px, 5vw, 96px); }
  .fcol { display: flex; flex-direction: column; gap: 0.5rem; font-size: 13.5px; line-height: 1.5; color: #4c483c; }
  .fcol a { color: var(--ink); text-decoration: none; width: fit-content; position: relative; }
  .fcol a::after { content: ""; position: absolute; left: 0; bottom: -2px; height: 1px; width: 100%; background: var(--ink); transform: scaleX(0); transform-origin: left; transition: transform 0.35s cubic-bezier(0.19, 1, 0.22, 1); }
  .fcol a:hover::after { transform: scaleX(1); }
  /* linki społecznościowe: mały monochromatyczny znak marki przed nazwą.
     Podkreślenie na hover przenosi się z całego linku na sam tekst, żeby
     nie przejeżdżało pod ikoną. */
  .fcol a.sc { display: inline-flex; align-items: center; gap: 9px; }
  .fcol a.sc::after { display: none; }
  .sc-i { flex: none; width: 15px; height: 15px; fill: currentColor; }
  /* znak Contry wypełnia kwadrat gęściej niż pozostałe dwa - zmniejszamy sam glif,
     box zostaje 15px, więc wszystkie trzy nazwy startują z tej samej osi */
  .sc-i-contra { transform: scale(0.9); }
  .fcol a.sc span { position: relative; }
  .fcol a.sc span::after {
    content: ""; position: absolute; left: 0; bottom: -2px; height: 1px; width: 100%;
    background: var(--ink); transform: scaleX(0); transform-origin: left;
    transition: transform 0.35s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .fcol a.sc:hover span::after { transform: scaleX(1); }
  .flabel { font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: var(--dim); margin-bottom: 0.5rem; }


  .fcol { gap: 8px; }
  .fcol p { margin: 0 0 8px; }
  .fcol > a { min-height: 28px; display: inline-flex; align-items: center; }
  a:focus-visible { outline: 3px solid var(--blue); outline-offset: 5px; }
  .legal { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 4px 24px; border-top: 1px solid #0002; padding-top: 16px; }
  .legal a, .copyright { display: inline-flex; align-items: center; min-height: 44px; font-size: 12px; color: #4c483c; text-decoration: none; }
  .legal a:hover { color: var(--blue); }
  .copyright-m { display: none; }
  /* Services index: one contact composition, not a CTA followed by another footer. */
  .invitation { grid-template-columns: minmax(0, 1.4fr) minmax(0, .8fr) auto; gap: 48px; align-items: start; border-top: 0; padding-top: 0; margin-top: clamp(64px, 8vw, 120px); }
  .invitation .fcol { padding-top: 8px; }
  .invitation .legal { margin-top: 16px; }
  @media (max-width: 1000px) {
    .invitation { grid-template-columns: minmax(0, 1fr) auto; gap: 40px 24px; }
    .footer-invitation { grid-column: 1 / -1; }
    .invitation .fcol { padding-top: 0; }
    .invitation .legal { margin-top: 0; }
  }
  @media (max-width: 600px) {
    .brand-footer { gap: 24px 12px; }
    .fcol > a { min-height: 44px; }
    .fcol > a[href^="mailto:"] { overflow-wrap: anywhere; display: block; min-height: 0; line-height: 1.6; }
    .brand-footer :global(.contact-badge) { width: 104px; }
    /* plakietka na środku wysokości kolumny kontaktu, nie przyklejona do jej góry */
    .brand-footer :global(.contact-badge) { align-self: center; }
    /* stopka prawna: cztery linki w jednej linii od krawędzi do krawędzi (decyzja Kacpra 23.09.2026),
       copyright osobnym wierszem pod nimi */
    .legal { flex-wrap: nowrap; justify-content: space-between; gap: 0; }
    .legal a { font-size: clamp(10.5px, 3vw, 12px); white-space: nowrap; }
    .copyright { display: none; }
    .copyright-m { display: block; margin: 0; font-size: 11px; color: #4c483c; grid-column: 1 / -1; }
  }
  @media (prefers-reduced-motion: reduce) { .fcol a::after, .fcol a.sc span::after { transition: none; } }
  @media (max-width: 380px) {
    .invitation :global(.contact-badge) { width: 72px; }
  }
</style>

---
import ExtArrow from './realizacje/ExtArrow.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import { routes, type Locale } from '../i18n/site';
import { cannabisHref, cannabisCopy } from '../content/cannabis';
// compact (case'y i strona realizacji, Kacper 20.10, 12:48): poniżej 768 px sam okrągły „+” zamiast „Menu +”,
// a zmiana języka przenosi się do panelu pod plusem. Od 768 px bez zmian.
interface Props { locale: Locale; alternatePath?: string; compact?: boolean }
const { locale, alternatePath, compact = false } = Astro.props;
const pl = locale === 'pl';
const r = routes[locale];
const items = [
  { label: pl ? 'Strona główna' : 'Home', href: r.home },
  { label: pl ? 'Usługi' : 'Services', href: r.services },
  { label: pl ? 'Branża konopna' : 'Cannabis industry', href: cannabisHref('nav', locale), external: true },
  { label: pl ? 'Kontakt' : 'Contact', href: r.contact },
];
---
<div class:list={['site-menu', { 'site-menu--compact': compact }]}>
  <button class="menu-toggle" type="button" popovertarget="site-navigation"><span class="menu-label">Menu</span> <span aria-hidden="true">+</span></button>
  {alternatePath && <LanguageSwitch locale={locale} href={alternatePath} />}
  <div id="site-navigation" class="menu-panel" popover="auto" data-lenis-prevent>
    <div class="menu-top"><span>{pl ? 'Rozejrzyj się' : 'Take a look'}</span><button type="button" popovertarget="site-navigation" popovertargetaction="hide" class="menu-close">{pl ? 'Zamknij' : 'Close'} <span aria-hidden="true">×</span></button></div>
    <nav aria-label={pl ? 'Nawigacja' : 'Navigation'}>
      {items.map(item => <a class="menu-link" href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener' : undefined} aria-label={item.external ? cannabisCopy[locale].navAria : item.label} aria-current={!item.external && Astro.url.pathname === item.href ? 'page' : undefined}>
        <span class="text-roll" aria-hidden="true">
          {[0, 1].map(layer => <span class:list={['roll-line', { 'roll-copy': layer === 1 }]}>{Array.from(item.label).map((letter, i) => <span class="roll-letter" style={`transition-delay:${Math.abs(i - (item.label.length - 1) / 2) * .025}s`}>{letter === ' ' ? '\u00a0' : letter}</span>)}</span>)}
        </span>
        {item.external && <span class="menu-external"><ExtArrow weight={520} /></span>}
      </a>)}
    </nav>
    {compact && alternatePath && <div class="menu-lang"><span>{pl ? 'Język' : 'Language'}</span><LanguageSwitch locale={locale} href={alternatePath} /></div>}
  </div>
</div>
<style>
  .site-menu { display: flex; align-items: center; gap: 20px; pointer-events: auto; color: #000; font-family: 'GeneralSansV', sans-serif; }
  .menu-toggle, .menu-close { display: inline-flex; align-items: center; justify-content: center; gap: 16px; min-height: 44px; border: 0; font: inherit; color: #000; cursor: pointer; }
  /* Kolory przycisku i przełącznika języka ze zmiennych --menu-*: ustawia je ton lockupu case'u (CaseLockup), domyślnie jak dotąd. */
  .menu-toggle { padding: 8px 20px; border: 1px solid var(--menu-line, #000); border-radius: 999px; background: var(--menu-bg, #f8f9f2); color: var(--menu-fg, #000); font-size: 14px; transition: color .2s ease, background-color .2s ease, border-color .2s ease; }
  .menu-toggle span { font-size: 23px; line-height: 1; }
  .menu-toggle .menu-label { font-size: inherit; line-height: inherit; }
  .site-menu :global(.language-switch) { display: inline-flex; min-height: 44px; align-items: center; color: var(--menu-fg, #000); font-size: 12px; font-weight: 650; text-decoration: none; }
  .menu-panel { box-sizing: border-box; position: fixed; inset: 100px 5vw auto auto; margin: 0; width: min(520px, 90vw); max-height: calc(100dvh - 120px); overflow: auto; padding: 28px 32px 32px; background: #f8f9f2; color: #000; border: 1px solid #0003; border-radius: 16px; box-shadow: 0 24px 80px #0002; font-family: 'GeneralSansV', sans-serif; }
  .menu-top { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 24px; font-size: 13px; }
  .menu-close { padding: 0; font-size: 13px; background: transparent; }
  .menu-close span { font-size: 24px; }
  .menu-panel nav { display: flex; flex-direction: column; }
  /* A top-layer popover sits above the custom cursor: retain the native pointer. */
  .menu-panel, .menu-panel :global(*) { cursor: auto !important; }
  .menu-panel a, .menu-panel button, .menu-panel a :global(*), .menu-panel button :global(*) { cursor: pointer !important; }
  .menu-link { display: flex; align-items: center; gap: 12px; padding: 12px 0; min-height: 44px; font-family: 'NohemiV', sans-serif; font-size: clamp(24px, 3vw, 38px); font-weight: 520; letter-spacing: -.035em; color: #000; text-decoration: none; }
  .menu-link[aria-current='page'] { color: #0522ff; }
  /* strzałka linku zewnętrznego jako wektor (ExtArrow): ↗ nie ma w fontach strony i system podstawiał emoji */
  .menu-external { font-size: 22px; color: #0522ff; line-height: 1; }
  .text-roll { position: relative; display: block; overflow: hidden; line-height: 1.3; white-space: nowrap; }
  .roll-line { display: block; }
  .roll-copy { position: absolute; inset: 0; }
  .roll-letter { display: inline-block; }
  .roll-copy .roll-letter { transform: translateY(100%); }
  .menu-link:focus-visible, button:focus-visible, .site-menu :global(.language-switch:focus-visible) { outline: 2px solid #0522ff; outline-offset: 5px; }
  .menu-toggle:focus-visible, .site-menu :global(.language-switch:focus-visible) { outline-color: var(--menu-focus, #0522ff); }
  @media (prefers-reduced-motion: reduce) { .menu-toggle { transition: none; } }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    /* Owner-requested slower decorative roll; links remain immediately clickable.
       Softer acceleration avoids the old sharp snap halfway through each letter. */
    .roll-letter { transition: transform 450ms ease-in-out; }
    .menu-link:hover .roll-letter { transform: translateY(-100%); }
    .menu-link:hover .roll-copy .roll-letter { transform: translateY(0); }
  }
  @media (max-width: 700px) {
    .site-menu { gap: 12px; }
    .menu-toggle { padding-inline: 14px; gap: 10px; }
    .menu-panel { inset: 84px 16px auto; width: auto; max-height: calc(100dvh - 100px); padding: 20px; }
    .menu-link { font-size: clamp(23px, 6.5vw, 32px); }
  }
  /* Tryb compact: zmiana języka w panelu, wiersz jak .menu-top (etykieta z lewej, akcja z prawej). */
  .menu-lang { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 20px; padding-top: 16px; border-top: 1px solid #0002; font-size: 13px; }
  .menu-lang :global(.language-switch) { display: inline-flex; min-height: 44px; align-items: center; color: #000; font-size: 13px; font-weight: 650; text-decoration: none; }
  .menu-lang :global(.language-switch:focus-visible) { outline: 2px solid #0522ff; outline-offset: 5px; }
  @media (min-width: 768px) { .menu-lang { display: none; } }
  @media (max-width: 767px) {
    .site-menu--compact > :global(.language-switch) { display: none; }
    .site-menu--compact .menu-toggle { width: 44px; height: 44px; min-height: 44px; padding: 0; gap: 0; border-radius: 50%; }
    /* napis „Menu” zostaje nazwą przycisku dla czytników ekranu */
    .site-menu--compact .menu-label { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
  }
  /* Native links remain available in older browsers without popover support. */
  @supports not selector(:popover-open) {
    .menu-toggle, .menu-close, .menu-top { display: none; }
    .menu-panel { position: static; width: auto; max-height: none; padding: 0; box-shadow: none; border: 0; }
    .menu-panel nav { flex-direction: row; flex-wrap: wrap; gap: 12px; }
    .menu-link { font: inherit; font-size: 13px; }
  }
</style>
<script>
  const panel = document.getElementById('site-navigation');
  panel?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => {
    if ('hidePopover' in panel && panel.matches(':popover-open')) panel.hidePopover();
  }));
</script>

---
// iPhone frame z żywą stroną w środku — scrollujesz palcem/kółkiem po projekcie.
// Proporcje i detale wg iPhone 15 Pro: cienki bezel, tytanowa rama, Dynamic Island,
// boczne przyciski, pasek statusu iOS przypięty nad przewijaną treścią.
// Dwa tryby: `url` = żywa, klikalna strona w iframe (skalowana do 393px logicznej
// szerokości iPhone'a); `src` = przewijany screenshot (fallback / starsze warianty).
interface Props {
  src?: ImageMetadata;
  /** żywa strona w środku — pełna interakcja: klik, scroll, nawigacja */
  url?: string;
  alt: string;
  label?: string;
  href?: string;
  class?: string;
  /** kolor ikon paska statusu: 'dark' na jasnych stronach, 'light' na ciemnych */
  statusbar?: 'dark' | 'light';
  /** kolor tła ekranu (strip pod paskiem statusu) — dopasuj do tła strony w środku */
  screenbg?: string;
}
import type { ImageMetadata } from 'astro';
const { src, url, alt, label, href, class: cls, statusbar = 'dark', screenbg = '#fff' } = Astro.props;
---

<figure class:list={['phone-frame', cls]}>
  <div class="phone-body">
    <span class="phone-btn btn-action" aria-hidden="true"></span>
    <span class="phone-btn btn-vol-up" aria-hidden="true"></span>
    <span class="phone-btn btn-vol-down" aria-hidden="true"></span>
    <span class="phone-btn btn-power" aria-hidden="true"></span>
    <div class:list={['phone-statusbar', `sb-${statusbar}`]} aria-hidden="true">
      <span class="sb-time">9:41</span>
      <span class="phone-island"></span>
      <span class="sb-icons">
        <svg viewBox="0 0 18 12" class="sb-signal"><rect x="0" y="8" width="3" height="4" rx="0.8"/><rect x="5" y="5.5" width="3" height="6.5" rx="0.8"/><rect x="10" y="3" width="3" height="9" rx="0.8"/><rect x="15" y="0.5" width="3" height="11.5" rx="0.8"/></svg>
        <svg viewBox="0 1 16 12" class="sb-wifi"><path d="M5.702 9.371A3 3 0 0 1 10.298 9.371" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M3.404 7.442A6 6 0 0 1 12.596 7.442" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M1.106 5.513A9 9 0 0 1 14.894 5.513" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><circle cx="8" cy="11.3" r="1.35"/></svg>
        <svg viewBox="0 0 25 12" class="sb-batt"><rect x="0.5" y="0.5" width="21" height="11" rx="3" fill="none" stroke="currentColor" opacity="0.4"/><rect x="2" y="2" width="15" height="8" rx="1.6"/><path d="M23.5 4v4a2.2 2.2 0 0 0 0-4Z" opacity="0.4"/></svg>
      </span>
    </div>
    {url ? (
      <div class="phone-screen phone-live" style={`background:${screenbg}`}>
        <iframe src={url} title={alt} loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
        <!-- Dotyk: nakładka przepuszcza scroll STRONY (iframe nie kradnie palca);
             tap włącza interakcję z żywą makietą, tap poza nią wyłącza z powrotem -->
        <button class="live-guard" type="button" aria-label="Włącz interakcję z żywą stroną">
          <span class="live-chip">tap to browse</span>
        </button>
        <!-- Fallback: żywa strona nie wstała (sieć/awaria) → link zamiast pustego ekranu -->
        <a class="live-fail" href={url} target="_blank" rel="noopener">
          <span>the live site is being shy</span>
          <span class="live-fail-link">open it in a new tab ↗</span>
        </a>
      </div>
    ) : (
      <div class="phone-screen" tabindex="0" data-lenis-prevent style={`background:${screenbg}`} aria-label={`${alt} — przewiń, żeby zobaczyć całość`}>
        <img src={src!.src} alt={alt} draggable="false" />
      </div>
    )}
  </div>
  {label && (
    <figcaption class="phone-caption">
      {href ? <a href={href} target="_blank" rel="noopener">{label} ↗</a> : label}
    </figcaption>
  )}
</figure>

<script>
  // Żywy ekran: strona renderuje się w logicznej szerokości iPhone'a (393px)
  // i jest skalowana transformem do faktycznej szerokości ekranu ramki.
  const LOGICAL_W = 393;
  const TOPBAR = 44; // strip pod paskiem statusu — treść startuje pod nim jak na iPhone
  document.querySelectorAll<HTMLElement>('.phone-live').forEach((screen) => {
    const frame = screen.querySelector<HTMLIFrameElement>('iframe');
    if (!frame) return;
    const fit = () => {
      const s = screen.clientWidth / LOGICAL_W;
      frame.style.transform = `scale(${s})`;
      frame.style.height = `${Math.round((screen.clientHeight - TOPBAR * s) / s)}px`;
      frame.style.top = `${Math.round(TOPBAR * s)}px`;
    };
    fit();
    new ResizeObserver(fit).observe(screen);

    // Awaria żywej strony (host nie odpowiada, brak sieci): iframe ZAWSZE odpala
    // `load` (nawet dla błędu nawigacji), więc jedyny wiarygodny sygnał to probe
    // fetch no-cors — odrzuca wyłącznie przy realnym błędzie sieciowym.
    // Odpalamy dopiero przy wejściu makiety w okolice viewportu (iframe jest lazy).
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        io.disconnect();
        fetch(frame.src, { mode: 'no-cors' }).catch(() => screen.classList.add('live-failed'));
      }
    }, { rootMargin: '300px' });
    io.observe(screen);
  });

  // Dotyk: scroll-guard żywych makiet. Domyślnie palec przewija LANDING
  // (guard zasłania iframe); tap w makietę = tryb interakcji ze stroną w środku,
  // tap gdziekolwiek poza makietą = powrót do zwykłego scrolla.
  if (matchMedia('(pointer: coarse)').matches) {
    document.querySelectorAll<HTMLElement>('.phone-live').forEach((screen) => {
      const guard = screen.querySelector<HTMLButtonElement>('.live-guard');
      if (!guard) return;
      guard.addEventListener('click', () => {
        screen.classList.add('live-on');
        try { navigator.vibrate?.(8); } catch {}
      });
      document.addEventListener('pointerdown', (e) => {
        if (screen.classList.contains('live-on') && !screen.contains(e.target as Node)) {
          screen.classList.remove('live-on');
        }
      }, { passive: true });
    });
  }
</script>

<style>
  .phone-frame {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
  }
  .phone-body {
    position: relative;
    width: min(292px, 76vw);
    aspect-ratio: 393 / 810;
    border-radius: 47px;
    /* tytanowa rama: jasna krawędź + głębia */
    background: linear-gradient(145deg, #6b6b6e 0%, #3c3c3f 30%, #2b2b2e 70%, #55555a 100%);
    padding: 4px;
    box-shadow:
      inset 0 0 1.5px 0.5px rgba(255, 255, 255, 0.35),
      0 24px 60px rgba(0, 0, 0, 0.38),
      0 4px 14px rgba(0, 0, 0, 0.22);
  }
  /* czarny bezel wokół szkła */
  .phone-body::before {
    content: "";
    position: absolute;
    inset: 4px;
    border-radius: 43px;
    background: #050505;
    pointer-events: none;
  }
  /* boczne przyciski */
  .phone-btn {
    position: absolute;
    width: 3px;
    border-radius: 2px;
    background: linear-gradient(90deg, #5a5a5e, #38383c);
  }
  .btn-action   { left: -3px; top: 18%; height: 4.2%; }
  .btn-vol-up   { left: -3px; top: 26%; height: 8%; }
  .btn-vol-down { left: -3px; top: 35.5%; height: 8%; }
  .btn-power    { right: -3px; top: 29%; height: 12%; background: linear-gradient(270deg, #5a5a5e, #38383c); }

  /* pasek statusu iOS — przypięty NAD przewijaną treścią, jak na prawdziwym iPhone */
  .phone-statusbar {
    position: absolute;
    inset: 9px 9px auto;
    height: 40px;
    z-index: 4;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 20px;
    pointer-events: none;
  }
  .sb-dark { color: #050505; }
  .sb-light { color: #f5f5f5; }
  .sb-time {
    font-family: -apple-system, 'SF Pro Text', 'Inter', sans-serif;
    font-size: 13.5px;
    font-weight: 620;
    letter-spacing: -0.01em;
    justify-self: start;
  }
  .phone-island {
    width: 94px;
    height: 27px;
    border-radius: 999px;
    background: #000;
    justify-self: center;
  }
  .sb-icons {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    justify-self: end;
  }
  .sb-icons svg { height: 11px; width: auto; fill: currentColor; }

  .phone-screen {
    /* absolute w ramce: obrazek w środku nie może rozepchnąć aspect-ratio obudowy */
    position: absolute;
    inset: 9px;
    border-radius: 38px;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    background: #fff;
    scrollbar-width: none;
  }
  .phone-screen::-webkit-scrollbar { display: none; }
  .phone-screen img {
    display: block;
    width: 100%;
    height: auto;
    /* treść startuje pod paskiem statusu jak na prawdziwym iPhone;
       przy scrollu wjeżdża pod niego */
    margin-top: 44px;
  }
  /* tryb żywy: iframe scrolluje sam w sobie, ekran nic nie przewija */
  .phone-screen.phone-live { overflow: hidden; }
  .phone-live iframe {
    position: absolute;
    left: 0;
    width: 393px;
    border: 0;
    transform-origin: 0 0;
    background: transparent;
  }
  /* fallback awarii żywej strony — widoczny tylko z klasą .live-failed */
  .live-fail {
    display: none; position: absolute; inset: 0; z-index: 6;
    flex-direction: column; align-items: center; justify-content: center; gap: 8px;
    text-decoration: none; text-align: center; padding: 20px;
    color: #4c483c; font-size: 13px; letter-spacing: 0.02em;
  }
  .phone-live.live-failed .live-fail { display: flex; }
  .phone-live.live-failed iframe, .phone-live.live-failed .live-guard { visibility: hidden; }
  .live-fail-link {
    color: #000; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase;
    border-bottom: 1px solid currentColor; padding-bottom: 2px;
  }

  /* scroll-guard: istnieje tylko na dotyku; na desktopie myszka wchodzi
     w żywą stronę bez pośredników */
  .live-guard { display: none; }
  @media (pointer: coarse) {
    .live-guard {
      position: absolute; inset: 0; z-index: 5;
      display: grid; align-content: end; justify-content: center;
      padding-bottom: 18px;
      background: none; border: 0; cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      /* touch-action domyślne = pan (przewija stronę pod palcem) */
    }
    .phone-live.live-on .live-guard { display: none; }
    .live-chip {
      display: inline-block; padding: 8px 14px; border-radius: 999px;
      background: rgba(5, 5, 5, 0.72); color: #f5f5f5;
      font-family: inherit; font-size: 11px; letter-spacing: 0.14em;
      text-transform: uppercase; white-space: nowrap;
      backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    }
    .live-guard:active .live-chip { background: rgba(5, 5, 5, 0.9); }
  }

  .phone-caption {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.75;
  }
  .phone-caption a { text-decoration: none; color: inherit; }
  .phone-caption a:hover { text-decoration: underline; }
</style>

---
// iPhone frame z żywą stroną w środku — scrollujesz palcem/kółkiem po projekcie.
interface Props {
  src: ImageMetadata;
  alt: string;
  label?: string;
  href?: string;
  class?: string;
}
import type { ImageMetadata } from 'astro';
const { src, alt, label, href, class: cls } = Astro.props;
---

<figure class:list={['phone-frame', cls]}>
  <div class="phone-body">
    <span class="phone-island" aria-hidden="true"></span>
    <div class="phone-screen" tabindex="0" aria-label={`${alt} — przewiń, żeby zobaczyć całość`}>
      <img src={src.src} alt={alt} draggable="false" />
    </div>
  </div>
  {label && (
    <figcaption class="phone-caption">
      {href ? <a href={href} target="_blank" rel="noopener">{label} ↗</a> : label}
    </figcaption>
  )}
</figure>

<style>
  .phone-frame {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
  }
  .phone-body {
    position: relative;
    width: min(300px, 78vw);
    aspect-ratio: 300 / 620;
    border-radius: 46px;
    background: #101010;
    padding: 12px;
    box-shadow:
      inset 0 0 0 2px #3a3a3a,
      inset 0 0 0 5px #0a0a0a,
      0 30px 80px rgba(0, 0, 0, 0.5);
  }
  .phone-island {
    position: absolute;
    top: 22px;
    left: 50%;
    translate: -50% 0;
    width: 86px;
    height: 24px;
    border-radius: 999px;
    background: #000;
    z-index: 3;
  }
  .phone-screen {
    /* absolute w ramce: obrazek w środku nie może rozepchnąć aspect-ratio obudowy */
    position: absolute;
    inset: 12px;
    border-radius: 35px;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    background: #fff;
    scrollbar-width: none;
  }
  .phone-screen::-webkit-scrollbar { display: none; }
  .phone-screen img {
    display: block;
    width: 100%;
    height: auto;
  }
  .phone-caption {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.75;
  }
  .phone-caption a { text-decoration: none; color: inherit; }
  .phone-caption a:hover { text-decoration: underline; }
</style>

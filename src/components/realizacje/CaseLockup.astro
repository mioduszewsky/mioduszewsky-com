---
// Góra strony case'u (decyzja Kacpra 20.10.2026): bez belki, logo „mioduszewsky × klient” unosi się nad treścią.
// Z lewej lockup: wideo 3D mioduszewsky (link do strony głównej), cienki ×, logo klienta (nie link). Z prawej SiteMenu.
// Logo klienta: plik src/assets/realizacje/logo-klientow/<client>.svg (fill="currentColor"), czytany przez glob,
// więc nowy klient = nowy plik, bez edycji komponentu. Brak pliku = nazwa klienta tekstem.
// Ton (dark: żółte wideo, biały klient; light: czarne wideo, czarny klient) wybiera jeden skrypt na dole:
// co leży pod środkiem lockupu, pierwszy przodek z data-tone albo nieprzezroczystym tłem, kontrast wg WCAG.
// Sekcje z filmem lub zdjęciem pod lockupem dostają w markupie data-tone="dark" albo "light" (z obrazu koloru nie odczytasz);
// gdy obraz na telefonie jest inny (np. osobne nagranie pionowe), data-tone-m ustawia ton do 767 px szerokości.
// Ten sam ton steruje przyciskiem Menu i przełącznikiem języka (zmienne --menu-* w SiteMenu).
// Logo mioduszewsky nie idzie za tonem (Kacper 20.10, 09:30): domyślnie zawsze żółte 3D, w pigułce zawsze żółte 3D.
// Płaskie czarne (pełna czerń) tylko tam, gdzie żółte 3D znika: tło pod logo w kolorze zbliżonym do żółci #ffcc33
// (odległość RGB poniżej 90; krem i biel to ok. 200, więc zostają przy 3D) albo sekcja z obrazem oznaczona data-logo="flat".
// Pierwszy ekran ustawia prop logo (do pierwszego pomiaru skryptu, bez mignięcia).
// Chowanie (Sławek, runda 2): ton z tła nie chroni przed treścią pod lockupem (czarne logo na czarnym haśle, 1,0:1).
// Pierwszy ekran: lockup zawsze, bez podkładu. Po 80 px w dół chowa się, w górę wraca. Nie chowa się z focusem w środku
// ani przy otwartym Menu.
// Podkład (pigułka) tylko tam, gdzie bez niego logo byłoby nieczytelne (Kacper 20.10, 11:10), osobno pod lockupem i pod Menu:
// gdy w obrysie pigułki leży treść (tekst, element w linii, przycisk, kreska obramowania, obraz albo film węższy niż ekran)
// albo granica dwóch teł. Nad gładkim tłem i nad filmem sceny na całą szerokość lockup unosi się bez podkładu.
// Test obejmuje same litery i przycisk Menu, nie cały obrys pigułki. Pigułka gaśnie 350 ms po zejściu treści, żeby nie mrugała w przerwach między wierszami.
import SiteMenu from '../SiteMenu.astro';
import { routes, type Locale } from '../../i18n/site';

type Fit = { h: number; base: number };
interface Props {
  locale: Locale;
  /** slug klienta = nazwa pliku SVG w logo-klientow */
  client: string;
  /** nazwa klienta dla czytników ekranu i zastępczo, gdy nie ma pliku SVG */
  clientName?: string;
  alternatePath?: string;
  /** ton pierwszego ekranu (do pierwszego pomiaru skryptu, bez mignięcia) */
  tone?: 'dark' | 'light';
  /** logo mioduszewsky na pierwszym ekranie: '3d' (domyślnie) albo 'flat', gdy otwarcie ma żółte tło */
  logo?: '3d' | 'flat';
  /** dopasowanie logo klienta: h = wysokość pudełka SVG jako ułamek wysokości wideo, base = linia bazowa jako ułamek wysokości SVG */
  fit?: Partial<Fit>;
}
const { locale, client, alternatePath, tone = 'light', logo = '3d', fit } = Astro.props;
const pl = locale === 'pl';
const NAMES: Record<string, string> = { eskapizm: 'eskapizm', cannversity: 'Cannversity', glassstone: 'GlassStone', 'igor-grabowski': 'Igor Grabowski' };
const name = Astro.props.clientName ?? NAMES[client] ?? client;

// Geometria wideo logo-nav (800x222, czarne 600x166, te same proporcje), zmierzona z kanału alfa plakatu:
// litery od 5,9% do 94,1% szerokości, linia bazowa na 67-67,5% wysokości (sprawdzone zrzutem 3x), góra wydłużeń (d, k) na 18%, x-height od 34,2%.
const BOX = 222 / 800, PAD = 47 / 800, BASE = .675;
// Dopasowania logo klientów. eskapizm: viewBox 3918x916, linia bazowa y=700, x-height 252-700, czyli x-height
// równa x-height mioduszewsky (0,325 wysokości wideo). Domyślnie: wysokość wersalików = wysokość wydłużeń mioduszewsky.
const FITS: Record<string, Fit> = { eskapizm: { h: .665, base: 700 / 916 } };
const f: Fit = { h: .487, base: 1, ...FITS[client], ...fit };

const files = import.meta.glob<string>('../../assets/realizacje/logo-klientow/*.svg', { query: '?raw', import: 'default', eager: true });
const raw = files[`../../assets/realizacje/logo-klientow/${client}.svg`];
const vb = raw?.match(/viewBox="([^"]+)"/)?.[1].split(/[\s,]+/).map(Number);
const aspect = vb && vb[3] ? vb[2] / vb[3] : 0;
// Napis klienta w lockupie jest dekoracją: nazwa idzie do czytników tekstem obok, więc SVG bez roli i etykiety.
const svg = raw && raw.replace(/<svg\b([^>]*)>/, (_, a: string) => `<svg${a.replace(/\s(role|aria-label|width|height|class)="[^"]*"/g, '')} class="lk-svg" aria-hidden="true" focusable="false" preserveAspectRatio="xMinYMax meet">`);

// Szerokość lockupu w jednostkach szerokości wideo: litery + × z oddechem + klient. Z tego skala, która mieści
// lockup obok przycisku Menu i przełącznika języka (rezerwa 136 px) w każdej szerokości od 320 px, bez łamania.
const X = .3 * BOX, GAP = .075;
const k = (1 - 2 * PAD) + X + 2 * GAP + (aspect ? aspect * f.h * BOX : .9);
const vars = `--lk-k:${k.toFixed(3)};--lk-ct:${(BASE - f.h * f.base).toFixed(4)};--lk-ch:${f.h.toFixed(4)}`;
const home = routes[locale].home;
---
<header class="case-lockup" data-case-lockup data-lk-tone={tone} data-lk-logo={logo} style={vars}>
  <div class="lk">
    <a class="lk-home" href={home} aria-label={pl ? 'mioduszewsky. Strona główna.' : 'mioduszewsky. Home page.'}>
      <span class="lk-vid" aria-hidden="true">
        <video class="lk-v" data-lk-v="3d" loop muted playsinline autoplay={logo === '3d'} preload={logo === '3d' ? 'metadata' : 'none'} width="800" height="222" tabindex="-1" poster="/logo3d/logo-nav-poster.webp">
          <source src="/logo3d/logo-nav.mp4" type="video/mp4;codecs=hvc1" />
          <source src="/logo3d/logo-nav.webm" type="video/webm" />
        </video>
        <video class="lk-v" data-lk-v="flat" loop muted playsinline autoplay={logo === 'flat'} preload={logo === 'flat' ? 'metadata' : 'none'} width="600" height="166" tabindex="-1" poster="/logo3d/logo-czarne-nav-poster.webp">
          <source src="/logo3d/logo-czarne-nav.mp4" type="video/mp4;codecs=hvc1" />
          <source src="/logo3d/logo-czarne-nav.webm" type="video/webm" />
        </video>
      </span>
    </a>
    <svg class="lk-x" viewBox="0 0 10 10" aria-hidden="true" focusable="false"><path d="M1 1 9 9M9 1 1 9" /></svg>
    <span class="lk-client">
      {svg ? <Fragment set:html={svg} /> : <span class="lk-name" aria-hidden="true">{name}</span>}
      <span class="lk-sr">{pl ? `, realizacja: ${name}` : `, project: ${name}`}</span>
    </span>
  </div>
  <SiteMenu locale={locale} alternatePath={alternatePath} compact />
</header>

<style>
  /* Wysokość lockupu dla stron, których otwarcie stoi w układzie (nie pod filmem): padding-top: var(--case-lockup-h). */
  :global(:root) { --case-lockup-h: clamp(72px, 7vw, 100px); }
  .case-lockup {
    --lk-w: clamp(60px, calc((100vw - 2 * var(--gutter, 20px) - 136px) / var(--lk-k)), 190px);
    --lk-h: calc(var(--lk-w) * 222 / 800);
    --lk-fg: #111;
    position: fixed; z-index: 100; inset: 0 0 auto; box-sizing: border-box;
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: clamp(12px, 2vw, 24px) var(--gutter, 20px) 0;
    pointer-events: none; color: var(--lk-fg);
    --menu-fg: #111; --menu-line: #111; --menu-bg: #f8f9f2; --menu-focus: #111;
  }
  .case-lockup[data-lk-tone='dark'] {
    --lk-fg: #fff;
    --menu-fg: #fff; --menu-line: rgb(255 255 255 / .9); --menu-bg: rgb(17 17 17 / .28); --menu-focus: #fff;
  }
  .case-lockup > :global(*), .lk-home { pointer-events: auto; }
  .lk { display: flex; align-items: flex-start; min-width: 0; height: var(--lk-h); }
  .lk-home { display: block; flex: none; margin-inline: calc(var(--lk-w) * -47 / 800); border-radius: 4px; }
  .lk-home:focus-visible { outline: 2px solid var(--lk-fg); outline-offset: 2px; }
  .lk-vid { display: grid; width: var(--lk-w); }
  .lk-v { grid-area: 1 / 1; width: 100%; height: auto; display: block; transition: opacity .2s ease; }
  .lk-v::-webkit-media-controls-start-playback-button, .lk-v::-webkit-media-controls { display: none !important; -webkit-appearance: none; }
  [data-lk-logo='3d'] .lk-v[data-lk-v='flat'], [data-lk-logo='flat'] .lk-v[data-lk-v='3d'] { opacity: 0; }
  [data-lk-tone='dark'] .lk-v[data-lk-v='3d'] { filter: drop-shadow(0 4px 10px rgb(0 0 0 / .22)); }
  /* × cienki, w kolorze lockupu, środek na środku x-height mioduszewsky */
  .lk-x { flex: none; width: calc(var(--lk-h) * .3); height: calc(var(--lk-h) * .3); margin: calc(var(--lk-h) * .355) calc(var(--lk-w) * .075) 0; fill: none; stroke: currentColor; stroke-width: 1.4; vector-effect: non-scaling-stroke; }
  .lk-x path { vector-effect: non-scaling-stroke; }
  .lk-client { flex: none; display: block; margin-top: calc(var(--lk-h) * var(--lk-ct)); height: calc(var(--lk-h) * var(--lk-ch)); line-height: 1; }
  .lk-client :global(.lk-svg) { display: block; height: 100%; width: auto; overflow: visible; }
  .lk-name { display: block; font: 600 calc(var(--lk-h) * .42)/1 'GeneralSansV', sans-serif; white-space: nowrap; }
  /* film pod lockupem bywa jasny i gęsty: w tonie ciemnym delikatny cień pod białym ×, klientem i nazwą */
  [data-lk-tone='dark'] :is(.lk-x, .lk-client) { filter: drop-shadow(0 1px 6px rgb(0 0 0 / .45)); }
  .lk-sr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .case-lockup { transition: color .2s ease, transform .25s ease; }
  .lk-x, .lk-client { transition: color .2s ease; }
  /* Schowany lockup znika całkiem: logo klienta z sygnetem wystaje pod pudełko o kilka px i po translateY(-100%)
     zostawało u góry ekranu kreskami (Cannversity, zrzut Kacpra 20.10). Zjazd o 24 px dalej niż pudełko; bez visibility,
     żeby Tab nadal trafiał w lockup i :focus-within go odsłaniał (recenzja Codexa). */
  .case-lockup[data-lk-hidden] { transform: translateY(calc(-100% - 24px)); }
  /* podkład: dwie pigułki dopasowane do zawartości (lockup i Menu z językiem), nie belka na całą szerokość */
  .lk, .case-lockup > :global(.site-menu) { position: relative; isolation: isolate; }
  .lk::before, .case-lockup > :global(.site-menu)::before {
    content: ''; position: absolute; z-index: -1; border-radius: 999px; pointer-events: none;
    background: rgb(248 249 242 / .86); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    opacity: 0; transition: opacity .2s ease;
  }
  .lk::before { inset: calc(var(--lk-h) * -.12) -14px; }
  .case-lockup > :global(.site-menu)::before { inset: -6px -14px -6px -6px; }
  /* poniżej 768 px Menu to sam okrągły plus (SiteMenu compact): podkład koło wokół niego */
  @media (max-width: 767px) { .case-lockup > :global(.site-menu)::before { inset: -6px; } }
  .case-lockup[data-lk-tone='dark'] .lk::before, .case-lockup[data-lk-tone='dark'] > :global(.site-menu)::before { background: rgb(17 17 17 / .6); }
  .case-lockup[data-lk-solid] .lk::before, .case-lockup[data-lk-solid-m] > :global(.site-menu)::before { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .lk-v, .case-lockup, .lk-x, .lk-client, .lk::before, .case-lockup > :global(.site-menu)::before { transition: none; }
  }
</style>

<script>
  // Ton lockupu: przy scrollu (rAF, passive) sprawdza, co leży pod środkiem lockupu, i idzie w górę drzewa do
  // pierwszego elementu z data-tone albo z nieprzezroczystym tłem. Z koloru tła luminancja względna (WCAG)
  // i ten z dwóch tonów (biały albo #111), który daje wyższy kontrast.
  const lk = document.querySelector<HTMLElement>('[data-case-lockup]');
  const mark = lk?.querySelector<HTMLElement>('.lk');
  if (lk && mark) {
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    const narrow = matchMedia('(max-width: 767px)');
    const vids = Object.fromEntries([...lk.querySelectorAll<HTMLVideoElement>('[data-lk-v]')].map((v) => [v.dataset.lkV, v]));
    const lin = (v: number) => ((v /= 255) <= .04045 ? v / 12.92 : ((v + .055) / 1.055) ** 2.4);
    const lum = (c: number[]) => .2126 * lin(c[0]) + .7152 * lin(c[1]) + .0722 * lin(c[2]);
    const INK = lum([17, 17, 17]);
    // kolor tła albo null, gdy przezroczysty (alfa poniżej 0,5) lub w formacie, którego nie liczymy
    const bg = (el: Element) => {
      const m = getComputedStyle(el).backgroundColor.match(/^rgba?\(([^)]+)\)$/);
      if (!m) return null;
      const p = m[1].split(/[\s,/]+/).filter(Boolean).map(parseFloat);
      return (p[3] ?? 1) < .5 ? null : p.slice(0, 3);
    };
    const toneOf = (el: Element | null): 'dark' | 'light' | null => {
      for (let n = el; n; n = n.parentElement) {
        const d = (n as HTMLElement).dataset;
        const t = (narrow.matches && d?.toneM) || d?.tone;
        if (t === 'dark' || t === 'light') return t;
        const c = bg(n);
        if (c) { const L = lum(c); return 1.05 / (L + .05) >= (L + .05) / (INK + .05) ? 'dark' : 'light'; }
      }
      return null;
    };
    // Wariant logo: 3D, chyba że pod logo leży żółte tło (odległość RGB od #ffcc33 poniżej 90) albo obraz z data-logo="flat".
    // Sekcja z data-tone (film, zdjęcie) bez data-logo = 3D.
    const YEL = [255, 204, 51];
    const logoOf = (el: Element | null): '3d' | 'flat' => {
      for (let n = el; n; n = n.parentElement) {
        const d = (n as HTMLElement).dataset;
        if (d?.logo === 'flat' || d?.logo === '3d') return d.logo;
        if (d?.tone || d?.toneM) return '3d';
        const c = bg(n);
        if (c) return Math.hypot(c[0] - YEL[0], c[1] - YEL[1], c[2] - YEL[2]) < 90 ? 'flat' : '3d';
      }
      return '3d';
    };
    // Geometria lockupu (wysokość i punkt pomiaru tonu, z offset*, czyli bez transformacji chowania) w pamięci:
    // odświeżana tylko po resize, orientationchange i wczytaniu fontów, żeby klatka scrolla nie wymuszała układu.
    // Obszary czytelności: same litery lockupu (pudełko .lk, 4 px zapasu) i sam przycisk Menu z językiem. Nie cały obrys
    // pigułki: treść obok liter nie psuje ich czytelności, a szeroki obrys zapalał pigułkę prawie wszędzie.
    type Box = { l: number; r: number; t: number; b: number };
    const menu = lk.querySelector<HTMLElement>(':scope > .site-menu');
    let geo = { h: 0, x: 0, y: 0, boxes: [] as Box[] }, dirty = true;
    const readGeo = () => {
      const boxes = [{ l: mark.offsetLeft - 4, r: mark.offsetLeft + mark.offsetWidth + 4, t: mark.offsetTop - 4, b: mark.offsetTop + mark.offsetHeight + 4 }];
      if (menu) boxes.push({ l: menu.offsetLeft, r: menu.offsetLeft + menu.offsetWidth, t: menu.offsetTop, b: menu.offsetTop + menu.offsetHeight });
      geo = { h: lk.offsetHeight, x: mark.offsetLeft + mark.offsetWidth / 2, y: mark.offsetTop + mark.offsetHeight / 2, boxes };
      dirty = false;
    };
    const measure = () => {
      const top = document.elementsFromPoint(geo.x, geo.y).find((el) => !lk.contains(el)) ?? null;
      return { t: toneOf(top) ?? toneOf(document.body) ?? 'light', l: logoOf(top) };
    };
    // Czy pod obszarem czytelności jest coś, na czym logo straci czytelność. Style i tła liczone raz na klatkę (Map w busy).
    const over = (a: { left: number; right: number; top: number; bottom: number }, r: Box) => a.right - a.left > 0 && a.left < r.r && a.right > r.l && a.top < r.b && a.bottom > r.t;
    const opaque = (c: string) => !/^rgba\(.*,\s*0\)$|^transparent$/.test(c);
    const rng = document.createRange();
    const MEDIA = /^(IMG|VIDEO|CANVAS|PICTURE|IFRAME|svg)$/;
    const borders = (cs: CSSStyleDeclaration) => ['top', 'right', 'bottom', 'left'].some((s) => parseFloat(cs.getPropertyValue(`border-${s}-width`)) > 0 && opaque(cs.getPropertyValue(`border-${s}-color`)));
    // pseudo-element z kolorem albo obramowaniem (kreska, znacznik). Pozycjonowany: prostokąt z top/left/width/height
    // względem elementu (przybliżenie: element jako blok odniesienia). Inny: liczy się jak treść całego elementu.
    const drawn = (el: Element, p: string, b: DOMRect, r: Box) => {
      const s = getComputedStyle(el, p);
      if (s.content === 'none' || s.display === 'none' || !(opaque(s.backgroundColor) || borders(s))) return false;
      if (s.position !== 'absolute') return true;
      const n = (v: string) => (v.endsWith('px') ? parseFloat(v) : NaN);
      const w = n(s.width), h = n(s.height);
      if (!(w >= 0 && h >= 0)) return true;
      const left = !isNaN(n(s.left)) ? b.left + n(s.left) : !isNaN(n(s.right)) ? b.right - n(s.right) - w : b.left;
      const top = !isNaN(n(s.top)) ? b.top + n(s.top) : !isNaN(n(s.bottom)) ? b.bottom - n(s.bottom) - h : b.top;
      return over({ left, right: left + w, top, bottom: top + h }, r);
    };
    const content = (el: Element, r: Box, cs: CSSStyleDeclaration) => {
      const media = el instanceof SVGElement ? (el.ownerSVGElement ?? el) : el;
      if (MEDIA.test(media.tagName)) {
        // tło to tylko obraz sceny: w sekcji oznaczonej data-tone i na całą szerokość ekranu (film otwarcia, sceny eskapizmu).
        // Węższe nagranie, zrzut ekranu poza sceną (też na całą szerokość telefonu) albo ikona to treść.
        const m = media.getBoundingClientRect();
        return !(media.closest('[data-tone],[data-tone-m]') && m.width >= innerWidth * .98 && m.top <= r.t && m.bottom >= r.b);
      }
      if (/^(HR|BUTTON|INPUT|SELECT|TEXTAREA)$/.test(el.tagName)) return true;
      // element w linii tylko z widoczną treścią: tekst, tło albo obramowanie (pusta oprawa nie zapala pigułki)
      if (cs.display.startsWith('inline') && (/\S/.test(el.textContent ?? '') || opaque(cs.backgroundColor) || borders(cs))) return true;
      for (const n of el.childNodes) {
        if (n.nodeType !== 3 || !/\S/.test(n.nodeValue ?? '')) continue;
        rng.selectNodeContents(n);
        for (const a of rng.getClientRects()) if (over(a, r)) return true;
      }
      const b = el.getBoundingClientRect();
      if (drawn(el, '::before', b, r) || drawn(el, '::after', b, r)) return true;
      const w = (s: string) => parseFloat(cs.getPropertyValue(`border-${s}-width`)) || 0;
      const vis = (s: string) => w(s) > 0 && opaque(cs.getPropertyValue(`border-${s}-color`));
      return (vis('top') && over({ left: b.left, right: b.right, top: b.top, bottom: b.top + w('top') }, r))
        || (vis('bottom') && over({ left: b.left, right: b.right, top: b.bottom - w('bottom'), bottom: b.bottom }, r))
        || (vis('left') && over({ left: b.left, right: b.left + w('left'), top: b.top, bottom: b.bottom }, r))
        || (vis('right') && over({ left: b.right - w('right'), right: b.right, top: b.top, bottom: b.bottom }, r));
    };
    // wygląd tła w punkcie: ton sekcji z obrazem (data-tone) albo kolor pierwszego nieprzezroczystego przodka
    const surface = (el: Element, memo: Map<Element, string>): string => {
      const hit = memo.get(el);
      if (hit) return hit;
      let k = 'root';
      for (let n: Element | null = el; n; n = n.parentElement) {
        const d = (n as HTMLElement).dataset;
        const t = (narrow.matches && d?.toneM) || d?.tone;
        if (t) { k = `obraz:${t}`; break; }
        const c = bg(n);
        if (c) { k = c.join(); break; }
      }
      memo.set(el, k);
      return k;
    };
    // Próbki: siatka co ok. 44 px na trzech wysokościach (tło i treść) plus dwa gęste piony co 6 px, które łapią
    // poziome kreski i pojedyncze wiersze przechodzące przez litery między wierszami siatki. Ok. 50 trafień na obszar.
    const busy = (r: Box) => {
      const pts: [number, number][] = [];
      const cols = Math.max(2, Math.round((r.r - r.l) / 44));
      for (let i = 0; i <= cols; i++) for (let j = 0; j <= 2; j++) pts.push([r.l + (r.r - r.l) * i / cols, r.t + (r.b - r.t) * j / 2]);
      for (const fx of [.3, .7]) for (let y = r.t + 3; y < r.b; y += 6) pts.push([r.l + (r.r - r.l) * fx, y]);
      const seen = new Set<Element>(), memo = new Map<Element, string>();
      let key: string | undefined;
      for (const [px, py] of pts) {
        const el = document.elementsFromPoint(Math.min(innerWidth - 1, Math.max(0, px)), Math.max(0, py)).find((e) => !lk.contains(e));
        if (!el) continue;
        if (!seen.has(el)) { seen.add(el); if (content(el, r, getComputedStyle(el))) return true; }
        const k = surface(el, memo);
        if (key === undefined) key = k;
        else if (k !== key) return true;
      }
      return false;
    };
    const GRACE = 350;
    // -Infinity = jeszcze bez treści pod lockupem (zero dawało fałszywą pigułkę przez pierwsze 350 ms strony)
    // Koszt: pomiar obszaru to do ok. 50 hit-testów (1-3 ms). Żeby klatka scrolla została lekka (scroll-film eskapizmu
    // rysuje w rAF), mierzony jest jeden obszar (lockup albo Menu, na zmianę) najwyżej co EVERY ms; drugi trzyma ostatni
    // wynik, a GRACE to przykrywa. Pomiar pominięty w ostatniej klatce przewijania dogania timer (late).
    // Pomiar kontrolny SETTLE ms po ostatnim ruchu: napisy scen dojeżdżają animacją już po zatrzymaniu przewijania.
    // Przebieg z timera (forced) mierzy oba obszary i nie przestawia pomiaru kontrolnego, więc bez przewijania
    // timery wygasają, zamiast krążyć.
    const EVERY = 60, SETTLE = 700;
    let need = [-Infinity, -Infinity], again = 0, turn = 0, wasUp = false, lastBusy = -Infinity, late = false;
    let settle = 0, forced = false;
    const force = () => { forced = true; req(); };
    const play = (v?: HTMLVideoElement) => { if (v && !still.matches && v.paused) { v.preload = 'auto'; v.play().catch(() => {}); } };
    // Chowanie i podkład. Histereza 6 px: drżenie palca nie przełącza; lastY rusza dopiero po wyraźnym ruchu.
    const panel = lk.querySelector<HTMLElement>('[popover]');
    const menuOpen = () => { try { return !!panel?.matches(':popover-open'); } catch { return false; } };
    let lastY = scrollY;
    let tick = false;
    const upd = () => {
      tick = false;
      // najpierw wszystkie odczyty...
      if (dirty) readGeo();
      const y = Math.max(0, scrollY);
      const hold = y <= 80 || lk.matches(':focus-within') || menuOpen();
      const { t, l: under } = measure();
      let hide = lk.hasAttribute('data-lk-hidden');
      if (hold) { hide = false; lastY = y; }
      else if (y - lastY > 6) { hide = true; lastY = y; }
      else if (lastY - y > 6) { hide = false; lastY = y; }
      // pigułka: lockup widoczny nad treścią strony i coś pod obrysem (z wygaszeniem po GRACE)
      const up = !hide && y > geo.h, now = performance.now();
      if (!up) need = [-Infinity, -Infinity];
      else if (!wasUp || forced || now - lastBusy >= EVERY) {
        // w klatce wynurzenia i w przebiegu z timera mierz oba obszary, poza tym jeden na EVERY ms, na zmianę
        turn = (turn + 1) % geo.boxes.length;
        geo.boxes.forEach((r, i) => { if ((!wasUp || forced || i === turn) && busy(r)) need[i] = now; });
        lastBusy = now;
      } else late = true;
      wasUp = up;
      if (!forced) { clearTimeout(settle); if (up) settle = setTimeout(force, SETTLE); }
      forced = false;
      const solid = geo.boxes.map((_, i) => up && now - need[i] < GRACE);
      // ...potem zapisy
      lk.toggleAttribute('data-lk-hidden', hide);
      lk.toggleAttribute('data-lk-solid', !!solid[0]);
      lk.toggleAttribute('data-lk-solid-m', !!solid[1]);
      // pigułka w trakcie wygaszania: sprawdź jeszcze raz, gdy minie jej pozostały czas, także bez przewijania
      clearTimeout(again);
      const left = solid.map((s, i) => (s && need[i] !== now ? need[i] + GRACE - now : Infinity));
      if (late) left.push(lastBusy + EVERY - now);
      late = false;
      if (Math.min(...left) < Infinity) again = setTimeout(force, Math.max(0, Math.min(...left)) + 16);
      if (lk.dataset.lkTone !== t) lk.dataset.lkTone = t;
      // w pigułce zawsze 3D
      const l = solid[0] ? '3d' : under;
      if (lk.dataset.lkLogo === l) return;
      lk.dataset.lkLogo = l;
      const on = vids[l], off = vids[l === '3d' ? 'flat' : '3d'];
      // WebKit odmawia play() wideo z opacity 0: start dopiero w następnej klatce, gdy jest już widoczne
      requestAnimationFrame(() => play(on));
      setTimeout(() => { if (lk.dataset.lkLogo === l) off?.pause(); }, 250);
    };
    const req = () => { if (!tick) { tick = true; requestAnimationFrame(upd); } };
    addEventListener('scroll', req, { passive: true });
    const regeo = () => { dirty = true; req(); };
    addEventListener('resize', regeo, { passive: true });
    addEventListener('orientationchange', regeo);
    document.fonts?.addEventListener?.('loadingdone', regeo);
    document.fonts?.ready.then(regeo);
    addEventListener('load', regeo);
    addEventListener('pageshow', req);
    lk.addEventListener('focusin', req);
    panel?.addEventListener('toggle', req);
    upd();
  }
</script>

const biurkoSrc = (await getImage({ src: biurko, width: 1920, format: 'webp' })).src;
const biurkoEkranSet = (await getImage({ src: biurkoEkran, widths: [828, 1280, 1920, 2560, 3356], format: 'webp' })).srcSet.attribute;
const biurkoEkranSrc = (await getImage({ src: biurkoEkran, width: 1920, format: 'webp' })).src;

const url = 'https://mioduszewsky.com' + (pl ? '/pl/realizacje/eskapizm/' : '/work/eskapizm/');
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Article', headline: T.h2, inLanguage: locale,
      about: pl ? 'System eskapizmu: kalkulator, zamówienie z fakturą, AI Plan Builder, plan w telefonie i panel, eskapizm.com' : 'The eskapizm system: calculator, ordering with invoices, AI Plan Builder, the plan on the phone and the dashboard, eskapizm.com',
      author: { '@type': 'Person', name: 'Kacper Mioduszewski', url: 'https://mioduszewsky.com' + T.homeHref },
      image: 'https://mioduszewsky.com/realizacje/eskapizm/otwarcie-poster.jpg',
      mainEntityOfPage: url },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'mioduszewsky', item: 'https://mioduszewsky.com' + T.homeHref },
      { '@type': 'ListItem', position: 2, name: 'eskapizm', item: url } ] },
  ],
};
---
<!-- Przed publikacją: robots „index, follow, max-image-preview:large” (jak u Igora), dopiero po zgodzie w rejestrze (npm run verify:zgody) i TAK Kacpra. -->
<VariantLayout title={T.title} description={T.description} bg="#FCFFF5" fg="#1c1917" switcher={false} robots="noindex, nofollow" locale={locale} alternatePath={T.alt}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <div class="case">
    <script is:inline>
      // Przeładowanie zaczyna od otwarcia (wada 2, 20.10): przeglądarka przywracała dawną pozycję w dwóch krokach
      // (Chromium wcześnie, potem jeszcze raz przy zdarzeniu load; WebKit dopiero przy load), a load czeka na film otwarcia,
      // więc przez kilka sekund był widoczny inny kadr i skok. Tylko ten wpis historii i tylko przy przeładowaniu;
      // przy wyjściu ze strony wraca „auto” (powrót wstecz jak dotąd), kotwice (#main, #stacja-..) działają jak zwykle.
      try { var nv = performance.getEntriesByType('navigation')[0]; if (nv && nv.type === 'reload') { history.scrollRestoration = 'manual'; addEventListener('pagehide', function () { history.scrollRestoration = 'auto'; }); } } catch (e) {}
    </script>
    <a class="skip" href="#main">{T.skip}</a>
    <CaseLockup locale={locale} client="eskapizm" alternatePath={T.alt} tone="dark" />

    <main id="main">
      <article>
        <!-- 1. Otwarcie: sam film na pełny ekran; nazwa i etykieta tylko dla czytników i wyszukiwarek (decyzja Kacpra 20.10: napis zasłaniał film) -->
        <header class="open" data-tone="dark">
          <Loop name="otwarcie" mobile="otwarcie-m" w={1920} h={1200} mw={720} mh={1558} alt={T.filmAlt} eager class="open-film" />
          <div class="open-txt sr">
            <p class="lbl">{T.label}</p>
            <h1>eskapizm</h1>
          </div>
        </header>

        <!-- 2. Teza -->
        <section class="thesis wrap" aria-labelledby="thesis-h">
          <h2 id="thesis-h" class="h" set:html={P(T.h2)} />
          <p class="lead" set:html={P(T.lead)} />
          <dl class="meta">{T.meta.map(([k, v]) => <div><dt class="lbl">{k}</dt><dd>{v}</dd></div>)}</dl>
        </section>

        <!-- 3. Problem: trzy liczby, potem kaskada okien z filmu -->
        <section class="problem" aria-label={pl ? 'Problem' : 'The problem'}>
          <ul class="nums wrap">
            {T.nums.map(([n, u, c, s]) => (
              <li><p class="n"><span>{n}</span> <span class="u">{u}</span></p><p class="c" set:html={P(c)} /><p class="src lbl">{s}</p></li>
            ))}
          </ul>
          <figure class="kaskada">
            <picture>
              {/* wymiary pionowej wersji: bez nich do wczytania obowiązywały proporcje desktopu i strona rosła o ok. 600 px nad przewiniętym miejscem */}
              <source media="(max-width: 767px)" srcset={kaskadaMSet} sizes="100vw" width="780" height="1688" />
              <Image src={kaskadaD} widths={[1280, 1920, 2560, 2880]} sizes="100vw" alt={T.kaskadaAlt} loading="lazy" />
            </picture>
            <figcaption class="wrap cap" set:html={P(T.kaskadaCap)} />
          </figure>
        </section>

        <!-- 4. Mapa systemu -->
        <div class="map wrap">
          <div class="map-head">
            <h2 id="map-h" class="h" set:html={P(T.mapH)} />
            <p class="lbl">{T.mapPlan}</p>
          </div>
        </div>

        <!-- 5-9. Stacje 01-05 w poziomie (Kacper 20.10, ok. 14:15, punkt D): pasek postępu na dole jest poziomy, więc stacje
             jadą w bok. Komputer: sekcja przypięta, przewijanie w dół przesuwa tor o jedną stację na ekran (skrypt niżej).
             Telefon: pas przewijany palcem w bok z przyciąganiem, pion przewija stronę. Na slajdzie scena, numer, nazwa i jedno
             zdanie; dłuższe opisy pod sekcją (Szczegóły stacji), żeby nic w slajdzie nie wymagało przewijania w pionie. -->
        <section class="stations" data-stations aria-labelledby="map-h">
          <div class="st-pin">
            <div class="st-track" data-track>
              <!-- Stacja 01: biurko wieczorem, telefon z kalkulatorem -->
              <section class="station" id="stacja-01" data-station="0" aria-labelledby="s1-h">
                <div class="scene desk evening" data-tone="dark">
                  <img class="scene-bg" srcset={biurkoEkranSet} sizes="100vw" src={biurkoEkranSrc} width="3356" height="1874" alt="" loading="lazy" decoding="async" />
                  <div class="shade" aria-hidden="true"></div>
                  <div class="s-txt s-right"><p class="lbl">01</p><h2 id="s1-h" class="st" set:html={P(T.s1.t)} /><p class="ss" set:html={P(T.s1.s)} /></div>
                  <EskapizmPhone class="ph ph-s1" dark top="#FCFFF4" bottom="#FCFFF4">
                    {/* runda 5: kalkulator w formie z żywej strony, zielony dok z dołu i panel wysuwany z dołu (nagranie z produkcji 390x752,
                       proporcja pola treści makiety 500:964, więc 600x1156 wchodzi 1:1 między strefy bez przycinania) */}
                    <Loop name="kalkulator" w={600} h={1156} alt={T.s1.alt} />
                  </EskapizmPhone>
                </div>
              </section>

              <!-- Stacja 02: zamówienie na ekranie laptopa z tej samej sceny, telefon z płatnością obok -->
              <section class="station" id="stacja-02" data-station="1" aria-labelledby="s2-h">
                <div class="scene desk dusk" data-tone="dark">
                  <div class="desk-img">
                    <img class="scene-bg" srcset={biurkoSet} sizes="(max-width: 767px) 250vw, 100vw" src={biurkoSrc} width="3356" height="1874" alt="" loading="lazy" decoding="async" />
                    <!-- prostokąt ekranu laptopa z silnika filmu: PHOTO.scr [560.5, 290, 557.5, 348.5] na 1678x937 -->
                    <div class="laptop"><Loop name="zamowienie" w={960} h={600} alt={T.s2.alt} /><i class="glass" aria-hidden="true"></i></div>
                  </div>
                  <div class="shade" aria-hidden="true"></div>
                  <div class="s-txt s-left"><p class="lbl">02</p><h2 id="s2-h" class="st" set:html={P(T.s2.t)} /><p class="ss" set:html={P(T.s2.s)} /></div>
                  <EskapizmPhone class="ph ph-s2" dark bottom="#F4F4F3" pos="50% 87%">
                    <Loop name="platnosc" w={600} h={1298} alt={T.s2.altPhone} />
                  </EskapizmPhone>
                </div>
              </section>

              <!-- Stacja 03: warsztat Justyny na zieleni -->
              <section class="station green" id="stacja-03" data-station="2" aria-labelledby="s3-h">
                <div class="g-slide">
                  <div class="g-txt"><p class="lbl">03</p><h2 id="s3-h" class="st" set:html={P(T.s3.t)} /><p class="ss" set:html={P(T.s3.s)} /></div>
                  <div class="g-media">
                    <!-- ton lockupu nad zrzutem: jasny ekran buildera (lockup bez tła od 20.10) -->
                    <div class="screen" data-tone="light"><Loop name="builder" mobile="builder-m" w={1920} h={1200} mw={780} mh={488} alt={T.s3.alt} /></div>
                  </div>
                </div>
              </section>

              <!-- Stacja 04: zatoka Phi Phi, trio telefonów (kulminacja) -->
              <section class="station" id="stacja-04" data-station="3" aria-labelledby="s4-h">
                <div class="scene bay" data-tone="dark">
                  <picture>
                    <source media="(max-width: 767px)" srcset={zatokaPionSet} sizes="100vw" />
                    <Image class="scene-bg" src={zatoka} widths={[1280, 1920, 2560]} sizes="100vw" alt={T.s4.sceneAlt} loading="lazy" />
                  </picture>
                  <div class="shade" aria-hidden="true"></div>
                  <div class="s-txt s-left"><p class="lbl">04</p><h2 id="s4-h" class="st" set:html={P(T.s4.t)} /><p class="ss" set:html={P(T.s4.s)} /></div>
                  <div class="trio">
                    <EskapizmPhone class="ph t-side d-only" tilt={-5} dark top="#FAFBF6"><Image src={trio[0]} widths={[300, 600]} sizes="300px" alt={T.s4.alts[0]} loading="lazy" /></EskapizmPhone>
                    <EskapizmPhone class="ph t-mid" dark top="#FAFBF6"><Loop name="moj-plan" w={600} h={1298} alt={T.s4.altPlan} /></EskapizmPhone>
                    <EskapizmPhone class="ph t-side d-only" tilt={5} dark top="#FAFBF6"><Image src={trio[1]} widths={[300, 600]} sizes="300px" alt={T.s4.alts[1]} loading="lazy" /></EskapizmPhone>
                  </div>
                </div>
              </section>

              <!-- Stacja 05: panel na zieleni -->
              <section class="station green" id="stacja-05" data-station="4" aria-labelledby="s5-h">
                <div class="g-slide">
                  <div class="g-txt"><p class="lbl">05</p><h2 id="s5-h" class="st" set:html={P(T.s5.t)} /><p class="ss" set:html={P(T.s5.s)} /></div>
                  <figure class="g-media">
                    <div class="screen" data-tone="dark" data-tone-m="light"><Image src={issues} widths={[780, 1280, 1920, 2560]} sizes="(max-width: 767px) 100vw, 66vw" alt={T.s5.alt} loading="lazy" /></div>
                    <figcaption class="cap" set:html={P(T.s5.cap)} />
                  </figure>
                </div>
              </section>
            </div>
          </div>
        </section>

        <!-- pigułka stacji (position: fixed) w kolejności DOM zaraz po torze, żeby Tab trafiał w kropki przy stacjach -->
        <nav class="pill" data-pill data-names={JSON.stringify(T.stops.map(([n]) => n))} hidden aria-label={pl ? 'Stacje' : 'Stations'}><span class="pill-n" aria-hidden="true"></span><span class="pill-t" aria-hidden="true"></span><span class="pill-dots">{stations.map((_, i) => <button type="button" data-go={i} aria-label={`${num(i)} ${T.stops[i][0]}`}><i></i></button>)}</span></nav>

        <!-- Szczegóły stacji: zdanie „dla kogo” i opis każdej stacji, pod przewijaną sekcją (D: slajd = jeden ekran) -->
        <section class="st-details wrap" aria-label={pl ? 'Stacje w szczegółach' : 'The stations in detail'}>
          <ol>
            {stations.map((s, i) => (
              <li class="dr">
                <p class="dr-n"><span class="lbl">{num(i)}</span> <span class="dr-t">{T.stops[i][0]}</span></p>
                <div class="dr-for">
                  <p class="for"><span>{s.f[0]}:</span> <span set:html={P(s.f[1])} /></p>
                  {i === 4 && <p class="repo" set:html={P(T.s5.repo)} />}
                </div>
                <div class="dtxt">
                  <p set:html={P(s.d)} />
                  {i === 1 && <ul class="reg">{T.s2.reg.map((r) => <li>{r}</li>)}</ul>}
                  {i === 2 && <figure class="chat m-only"><Image src={builderCzat} widths={[390, 780]} sizes="100vw" alt={T.s3.altChat} loading="lazy" /></figure>}
                </div>
              </li>
            ))}
          </ol>
        </section>

        <!-- 10. Reszta systemu: 4 + 3 -->
        <section class="rest wrap" aria-labelledby="rest-h">
          <h2 id="rest-h" class="h" set:html={P(T.restH)} />
          <p class="lead" set:html={P(T.restP)} />
          <ul class="rest-grid">
            {rest.map((img, i) => (
              <li class={i < 4 ? 'r4' : 'r3'}>
                <a href={restHref[i]} target="_blank" rel="noopener" aria-label={`${T.rest[i][0]}. ${T.newTab}`}>
                  <Image src={img} widths={[640, 960, 1280]} sizes={i < 4 ? '(max-width: 767px) 84vw, 25vw' : '(max-width: 767px) 84vw, 33vw'} alt={T.rest[i][1]} loading="lazy" />
                  <p class="cap">{T.rest[i][0]}<ExtArrow /></p>
                </a>
              </li>
            ))}
          </ul>
        </section>

        <!-- 11. Liczby skali i cytat Justyny -->
        <section class="scale wrap" aria-label={pl ? 'Skala' : 'Scale'}>
          <ul class="nums four">{T.scale.map(([n, c]) => <li><p class="n"><span>{n}</span></p><p class="c">{c}</p></li>)}</ul>
        </section>
        <figure class="quote wrap">
          <blockquote><p>{T.quote}</p></blockquote>
          <figcaption>{T.quoteBy}<a href={quoteHref} target="_blank" rel="noopener">{T.quoteSrc}</a></figcaption>
        </figure>
      </article>

      <!-- 12. Koniec: jeden zielony blok jak w Cannversity (runda 3): kontakt, pod cienką linią wiersz następnej realizacji
           z pętli (src/content/realizacje-kolejnosc.ts), potem stopka mioduszewsky -->
      <section class="end" aria-labelledby="end-h">
        <div class="wrap end-in">
          <h2 id="end-h" class="h" set:html={P(T.endH)} />
          <div>
            <p set:html={P(T.endP)} />
            <a class="btn" href={T.contact}>{T.btn}</a>
            <p class="more"><a href={T.moreHref}>{T.more}</a></p>
          </div>
        </div>
        <a class="next" href={next.href}>
          <span class="wrap next-in"><span class="next-k lbl">{T.next}</span><span class="next-n">{next.name}<span class="next-a" aria-hidden="true">→</span></span></span>
        </a>
      </section>
    </main>

    <BrandFooter locale={locale} full />
  </div>
</VariantLayout>

<script>
  // Wideo (Loop.astro): źródło wstawiane ok. ekran przed sekcją, desktop albo telefon; gra tylko w widoku.
  // Przy prefers-reduced-motion wideo się nie ładuje, zostaje plakat.
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const narrow = matchMedia('(max-width: 767px)');
  const loops = [...document.querySelectorAll<HTMLElement>('.case [data-loop]')];
  // WebKit odrzuca play() tuż po wczytaniu strony (NotAllowedError, pomiar 19.10: 261 ms) mimo muted i playsinline: ponów kilka razy, póki pętla jest w widoku
  const play = (el: HTMLElement, v: HTMLVideoElement, n = 0) => v.play().catch(() => { if (n < 4) setTimeout(() => { if (el.dataset.inview && !still.matches && v.paused) play(el, v, n + 1); }, 700); });
  // zwraca true, gdy pętla ma już źródło (wtedy obserwacja „blisko” nie jest potrzebna)
  const load = (el: HTMLElement): boolean => {
    if (el.dataset.loaded) return true;
    const v = el.querySelector('video'); if (!v) return true;
    if (narrow.matches && el.dataset.desktopOnly !== undefined) return false; // na telefonie zostaje plakat
    const m = narrow.matches && el.dataset.mMp4;
    const webm = m ? el.dataset.mWebm : el.dataset.dWebm, mp4 = m ? el.dataset.mMp4 : el.dataset.dMp4;
    v.poster = (m ? el.dataset.mPoster : el.dataset.dPoster) || '';
    // MP4 H.264 pierwsze: dekodowane sprzętowo na Macu i iPhonie; WebM VP9 w Chrome z GPU gubił 29% klatek otwarcia (pomiar 19.10)
    if (mp4) { const s = document.createElement('source'); s.src = mp4; s.type = 'video/mp4'; v.append(s); }
    if (webm) { const s = document.createElement('source'); s.src = webm; s.type = 'video/webm'; v.append(s); }
    v.preload = 'auto'; v.load(); el.dataset.loaded = '1';
    // obserwatory odpalają się w dowolnej kolejności, a WebKit odrzuca play() w trakcie wczytywania:
    // pętla w widoku rusza, gdy da się ją odtworzyć
    v.addEventListener('canplay', () => { if (el.dataset.inview && allowed(el) && !still.matches && v.paused) play(el, v); });
    return true;
  };
  // Stacje w poziomie: slajdy poza ekranem są przycięte przez tor (overflow), więc ani obserwator, ani loading="lazy"
  // nie widzą ich „blisko” i slajd wjeżdżał pusty. Gdy tor zbliża się do ekranu (ekran przed nim), wczytują się obrazy
  // i pętle wszystkich stacji naraz; grają nadal tylko pętle w widoku (seen).
  const trackEl = document.querySelector<HTMLElement>('[data-track]');
  const trackLoops = loops.filter((el) => trackEl?.contains(el));
  // w torze gra tylko pętla aktywnej stacji (recenzja Codexa: w przejeździe widać dwie stacje naraz); active ustawia skrypt stacji
  let active = 0;
  const allowed = (el: HTMLElement) => !trackEl?.contains(el) || Number(el.closest<HTMLElement>('[data-station]')?.dataset.station) === active;
  const syncTrack = () => trackLoops.forEach((el) => {
    const v = el.querySelector('video'); if (!v) return;
    if (el.dataset.inview && el.dataset.loaded && allowed(el) && !still.matches) { if (v.paused) play(el, v); } else v.pause();
  });
  if (trackEl) new IntersectionObserver((es, o) => { if (es.some((e) => e.isIntersecting)) { trackEl.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((i) => { i.loading = 'eager'; }); o.disconnect(); } }, { rootMargin: '100% 0px' }).observe(trackEl);
  const near = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting || still.matches) return;
    const el = e.target as HTMLElement;
    const group = trackEl?.contains(el) ? trackLoops : [el];
    group.forEach((g) => { if (load(g)) near.unobserve(g); });
  }), { rootMargin: '100% 0px' });
  const seen = new IntersectionObserver((es) => es.forEach((e) => {
    const v = (e.target as HTMLElement).querySelector('video');
    if (!v) return;
    (e.target as HTMLElement).dataset.inview = e.isIntersecting ? '1' : '';
    if (e.isIntersecting && allowed(e.target as HTMLElement) && !still.matches && (e.target as HTMLElement).dataset.loaded) play(e.target as HTMLElement, v); else v.pause();
  }), { threshold: .15 });
  loops.forEach((el) => {
    if (el.offsetParent === null && getComputedStyle(el).position !== 'fixed') return; // ukryta wersja (d-only na telefonie) nie ładuje się wcale
    const v = el.querySelector('video');
    if (v && v.hasAttribute('data-autoplay')) { // otwarcie: źródło już w HTML, tu tylko pauza poza widokiem i przy reduced motion
      el.dataset.loaded = '1';
      if (still.matches) { v.removeAttribute('autoplay'); v.pause(); }
      seen.observe(el); return;
    }
    near.observe(el); seen.observe(el);
  });
  // zmiana ustawienia w trakcie: pauza od razu; po wyłączeniu ograniczenia ruchu ponowna obserwacja, żeby niewczytane pętle się wczytały
  still.addEventListener('change', () => loops.forEach((el) => {
    const v = el.querySelector('video'); v && v.pause();
    if (v && v.hasAttribute('data-autoplay')) { if (!still.matches) { v.load(); } }
    else if (!el.dataset.loaded) { near.unobserve(el); near.observe(el); }
    seen.unobserve(el); seen.observe(el);
  }));

  // Ton lockupu według czasu filmu otwarcia (decyzja Sławka 20.10, runda 5): film przechodzi z ciemnego biurka w jasny ekran
  // i kremową stronę, więc data-tone na .open zmienia się z czasem filmu, a lockup (CaseLockup) dostaje sygnał do ponownego
  // pomiaru tylko przy zmianie tonu (focusin bez bąbelkowania na samym lockupie: słucha go tylko CaseLockup).
  // Odcinki policzone offline z plików filmu (scratchpad sesji, ton/odcinki3.py): ton z wyższą medianą kontrastu pod lockupem
  // (biel albo #111, najsłabsza z szerokości wersji), odcinki co najmniej 0,5 s, zmiana na środku przenikania (przejście koloru
  // 200 ms w CaseLockup). Wersja na telefon (-m) liczona dla 390 i 320, desktop dla 1440. Film nagrany bez paska menu macOS
  // i wycięcia kamery z makiety ekranu (runda 3), więc pod lockupem nie ma już czarnych elementów paska Safari.
  // Telefon 2,72-3,52 s: kadr mieszany (ciemne i jasne paski okien), ciemny ton wybrany ręcznie, bo przy 390 trzyma 4,9:1;
  // przy 320 w 3,03-3,52 s mediana spada do 1,3 (zgłoszone w meldunku, odcinek krótszy niż 0,5 s nie jest dozwolony).
  const TONES: Record<'d' | 'm', [number, 'dark' | 'light'][]> = {
    // runda 5: końcówka nagrana z tekstem rozdziału narratora obok telefonu (pętla 9,533 s), przesunęła się tylko ostatnia granica
    d: [[0, 'dark'], [1.5, 'light'], [3.6, 'dark'], [6.717, 'light'], [9.3, 'dark']],
    m: [[0, 'dark'], [1.417, 'light'], [2.717, 'dark'], [5.4, 'light'], [6.1, 'dark'], [6.733, 'light'], [9.267, 'dark']],
  };
  const openEl = document.querySelector<HTMLElement>('.case .open');
  const openV = openEl?.querySelector<HTMLVideoElement>('video');
  const lockup = document.querySelector<HTMLElement>('[data-case-lockup]');
  if (openEl && openV && lockup) {
    let raf = 0, onScreen = true;
    // bez wyświetlonej klatki (plakat, ograniczenie ruchu) ton z pierwszej klatki
    const toneAt = () => {
      const t = !still.matches && openV.readyState >= 2 ? openV.currentTime : 0;
      const T = TONES[/otwarcie-m\./.test(openV.currentSrc) ? 'm' : 'd'];
      let k = T[0][1]; for (const [s, v] of T) if (t >= s) k = v;
      return k;
    };
    const apply = () => {
      const k = toneAt();
      if (openEl.dataset.tone === k) return;
      openEl.dataset.tone = k;
      lockup.dispatchEvent(new FocusEvent('focusin', { bubbles: false }));
    };
    const loop = () => { apply(); raf = !openV.paused && onScreen ? requestAnimationFrame(loop) : 0; };
    const start = () => { if (!raf && !openV.paused && onScreen) raf = requestAnimationFrame(loop); };
    ['play', 'playing', 'timeupdate'].forEach((e) => openV.addEventListener(e, start));
    ['pause', 'seeked', 'emptied'].forEach((e) => openV.addEventListener(e, apply));
    new IntersectionObserver((es) => { onScreen = es[0].isIntersecting; if (onScreen) { apply(); start(); } }).observe(openEl);
    still.addEventListener('change', apply);
  }

  // Stacje w poziomie (D, 20.10). Komputer (od 768 px): sekcja .stations ma wysokość 5,4 ekranu, .st-pin jest przyklejony,
  // a tor przesuwa się o jedną stację na ekran przewinięcia: przez pierwsze 30% ekranu stacja stoi, w pozostałych 70%
  // przejeżdża do następnej (smoothstep), ostatnia stoi jeszcze 0,4 ekranu, potem strona jedzie w dół. Tylko transform,
  // odczyt pozycji raz na klatkę. Telefon: tor to poziomy pas z przyciąganiem (CSS), indeks z scrollLeft.
  // Pigułka na dole: numer i nazwa bieżącej stacji, kropki przenoszą do stacji. Widoczna tylko w trakcie sekcji.
  const sec = document.querySelector<HTMLElement>('[data-stations]');
  const pin = sec?.querySelector<HTMLElement>('.st-pin');
  const track = trackEl;
  const pill = document.querySelector<HTMLElement>('[data-pill]');
  const N = document.querySelectorAll('[data-station]').length;
  const names: string[] = JSON.parse(pill?.dataset.names || '[]');
  const wide = matchMedia('(min-width: 768px)');
  const HOLD = .3;
  let vh = innerHeight, edge = 0, cur = -2, tick = false, x = -1, inSec = false;
  // geometria raz i przy resize/fontach: wysokość przypiętego ekranu i odległość góry pigułki od dołu ekranu.
  // vh = wysokość .st-pin (100vh w CSS), nie innerHeight: sekcja ma 5,4 tej samej jednostki, więc przy ruchomych paskach
  // Safari przejazd i postój liczą się w tej samej wysokości co CSS (recenzja Codexa).
  const measure = () => {
    if (!sec || !pill) return;
    vh = (wide.matches && pin?.offsetHeight) || innerHeight;
    const was = pill.hidden;
    if (was) { pill.style.visibility = 'hidden'; pill.hidden = false; }
    edge = innerHeight - pill.getBoundingClientRect().top;
    if (was) { pill.hidden = true; pill.style.visibility = ''; }
  };
  // pozycja toru w stacjach (0..N-1) z tego, o ile góra sekcji weszła nad ekran (odczyt rect w tej samej klatce)
  const pos = (above: number) => {
    const p = Math.min(Math.max(above / vh, 0), N - 1);
    const seg = Math.floor(p);
    if (seg >= N - 1) return N - 1;
    const t = Math.min(Math.max((p - seg - HOLD) / (1 - HOLD), 0), 1);
    return seg + t * t * (3 - 2 * t);
  };
  const upd = () => {
    tick = false; if (!sec || !track || !pill) return;
    const r = sec.getBoundingClientRect();
    let idx: number;
    if (wide.matches) {
      const nx = pos(-r.top);
      if (nx !== x) { x = nx; track.style.transform = `translate3d(${(-x * 100 / N).toFixed(4)}%, 0, 0)`; }
      idx = Math.round(x);
    } else {
      if (x !== -1) { x = -1; track.style.transform = ''; }
      idx = Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
    }
    inSec = r.top < innerHeight && r.bottom > 0;
    const now = Math.min(N - 1, Math.max(0, idx));
    if (now !== active) { active = now; syncTrack(); }
    const on = r.top <= innerHeight * .5 && r.bottom > innerHeight - edge;
    const k = on ? now : -1;
    if (k === cur) return; cur = k;
    pill.hidden = k < 0;
    if (k >= 0) {
      pill.querySelector('.pill-n')!.textContent = String(k + 1).padStart(2, '0');
      pill.querySelector('.pill-t')!.textContent = names[k] || '';
      pill.querySelectorAll('.pill-dots button').forEach((d, i) => d.toggleAttribute('aria-current', i === k));
    }
  };
  const req = () => { if (!tick) { tick = true; requestAnimationFrame(upd); } };
  addEventListener('scroll', req, { passive: true });
  track?.addEventListener('scroll', req, { passive: true });
  const re = () => { measure(); x = -2; cur = -2; req(); };
  // stacja o numerze i: komputer przewija stronę do środka postoju stacji, telefon przesuwa pas
  const go = (i: number, behavior: ScrollBehavior) => {
    if (!sec || !track) return;
    if (wide.matches) scrollTo({ top: sec.getBoundingClientRect().top + scrollY + i * vh + HOLD * vh / 2, behavior });
    else track.scrollTo({ left: i * track.clientWidth, behavior });
  };
  addEventListener('resize', re, { passive: true });
  // przejście przez 768 px (obrót tabletu, zmiana okna) w trakcie sekcji: ta sama stacja w nowym trybie (recenzja Codexa)
  // Po zmianie trybu wysokość sekcji jest już inna (5,4 ekranu albo jeden slajd), więc „czy byłem w sekcji” bierze się
  // z ostatniej klatki, a nie z bieżącego położenia.
  wide.addEventListener('change', () => {
    const keep = active;
    measure();
    if (inSec && sec) {
      if (!wide.matches) scrollTo({ top: sec.getBoundingClientRect().top + scrollY, behavior: 'auto' });
      go(keep, 'auto');
    }
    re();
  });
  document.fonts?.ready.then(re);
  addEventListener('load', re);
  pill?.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('[data-go]');
    if (b) go(+b.dataset.go!, still.matches ? 'auto' : 'smooth');
  });
  // kotwica #stacja-0N: przeglądarka przewija do slajdu przesuniętego transformem (czyli do początku sekcji, stacja 01),
  // więc po jej przewinięciu ustawiamy właściwą stację (recenzja Codexa)
  const hashGo = () => {
    const m = location.hash.match(/^#stacja-0([1-5])$/);
    if (m) requestAnimationFrame(() => { measure(); go(+m[1] - 1, 'auto'); });
  };
  addEventListener('hashchange', hashGo);
  measure();
  upd();
  hashGo();
</script>

<style>
  @font-face { font-family: 'NohemiV'; src: url('/fonts/Nohemi-Variable.woff2') format('woff2'); font-weight: 100 900; font-display: swap; }
  @font-face { font-family: 'GeneralSansV'; src: url('/fonts/GeneralSans-Variable.woff2') format('woff2'); font-weight: 200 700; font-display: swap; }
  /* Układ: sceny pełnoekranowe (biurko wieczorem, zieleń warsztatu, zatoka), pod każdą wąska kolumna szczegółów.
     Pismo: dwie rodziny, pięć stopni (nazwa, liczby, nagłówek, tekst, podpis) + etykieta. */
  .case {
    --paper: #fcfff5; --ink: #1c1917; --dim: #57534e; --rule: rgb(28 25 23 / .14);
    --green: #1e3b25; --on-green: #f3f6ec; --brand: #ffcc33;
    --gutter: clamp(20px, 5vw, 96px);
    /* stopka mioduszewsky na pełną szerokość, treść na tej samej lewej krawędzi co .wrap (runda 5) */
    --footer-pad: max(var(--gutter), calc((100% - 1320px) / 2 + var(--gutter)));
    --t-num: clamp(64px, 8.4vw, 124px); --t-h: clamp(32px, 3.9vw, 56px);
    --t-body: 18px; --t-cap: 14px;
    font-family: 'GeneralSansV', sans-serif; background: var(--paper); color: var(--ink); overflow-x: clip; font-size: var(--t-body); line-height: 1.6;
  }
  h1, h2, p, figure, ol, ul, dl, dd, blockquote { margin: 0; }
  ol, ul { padding: 0; list-style: none; }
  .case :is(h1, h2) { text-wrap: balance; }
  .case p { text-wrap: pretty; }
  .case :is(a, button):focus-visible { outline: 3px solid var(--green); outline-offset: 4px; }
  .case ::selection { background: var(--brand); color: var(--ink); }
  .case img { display: block; max-width: 100%; height: auto; }
  .skip { position: fixed; top: 12px; left: 12px; z-index: 150; padding: 12px 20px; background: var(--brand); color: var(--ink); transform: translateY(-200%); }
  .skip:focus { transform: none; }
  .sr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .wrap { max-width: 1320px; margin-inline: auto; padding-inline: var(--gutter); box-sizing: border-box; }
  .m-only { display: none; }

  .lbl { font-size: 12px; line-height: 1.3; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; }
  .h { font-family: 'NohemiV', sans-serif; font-weight: 600; font-size: var(--t-h); line-height: 1.04; letter-spacing: -.03em; max-width: 15em; }
  .lead { font-size: 20px; line-height: 1.55; max-width: 34em; margin-top: 28px; color: var(--dim); }
  .cap { font-size: var(--t-cap); line-height: 1.5; color: var(--dim); }

  /* 1. Otwarcie */
  /* bez belki: film na pełny ekran, lockup (CaseLockup) unosi się nad nim */
  .open { position: relative; height: min(100vh, 62.5vw); min-height: 460px; background: #2a2018; color: #fff; overflow: hidden; }
  /* Film nagrany z eskapizm.com z ukrytym nagłówkiem strony (logo, menu, pasek postępu) oraz paskiem menu macOS i wycięciem kamery z makiety ekranu laptopa (nagraj.cjs z krokiem js),
     więc pod lockupem nie ma drugiego logo i nic nie trzeba kadrować ani rozmywać. Bez winiety i bez przyciemnienia:
     czytelność lockupu trzyma ton według czasu filmu (skrypt niżej, data-tone na .open). */
  .open :global(.open-film) { position: absolute; inset: 0; }

  /* 2. Teza */
  /* dół tezy: duży oddech między siatką meta a liczbami (runda 3: dwie siatki obok siebie źle się czytały).
     Teza zajmuje co najmniej ekran liczony od nagłówka, więc póki nagłówek i meta są w ekranie, liczby są jeszcze pod nim. */
  .thesis { --pt: clamp(80px, 10vw, 160px); box-sizing: border-box; min-height: calc(100vh + var(--pt)); padding-block: var(--pt) clamp(160px, 24vh, 300px); }
  .meta { margin-top: clamp(48px, 5vw, 72px); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px 32px; border-top: 1px solid var(--rule); padding-top: 20px; }
  .meta dt { color: var(--dim); }
  .meta dd { margin-top: 8px; font-size: 15px; line-height: 1.5; }

  /* 3. Problem i 11. Skala: liczby */
  .nums { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px clamp(24px, 4vw, 64px); }
  .nums.four { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .nums .n { font-family: 'NohemiV', sans-serif; font-weight: 600; font-size: var(--t-num); line-height: .9; letter-spacing: -.045em; font-variant-numeric: tabular-nums; }
  .nums .u { font-size: .32em; letter-spacing: -.02em; }
  .nums .n > span:first-child { white-space: nowrap; }
  /* jednostka pod liczbą we wszystkich trzech kolumnach: „500+ interakcji” nie mieści się w jednej linii kolumny */
  .problem .nums .u { display: block; margin-top: .3em; line-height: 1; }
  .nums .c { margin-top: 18px; font-size: 16px; line-height: 1.5; max-width: 22em; }
  .nums .src { margin-top: 12px; color: var(--dim); font-size: 11px; }
  .problem { padding-bottom: clamp(80px, 9vw, 140px); }
  .kaskada { margin-top: clamp(56px, 7vw, 104px); }
  .kaskada img { width: 100%; }
  .kaskada .cap { margin-top: 16px; }

  /* 4. Mapa */
  .map { padding-block: clamp(64px, 8vw, 120px); border-top: 1px solid var(--rule); display: grid; gap: 40px; }
  .map-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 16px 40px; }
  .map-head .lbl { color: var(--dim); }

  /* Sceny */
  .scene { position: relative; overflow: hidden; color: #fff; background: #2a2018; }
  .desk { aspect-ratio: 1678 / 937; max-height: 100vh; }
  .scene-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .desk-img { position: absolute; inset: 0; }
  .shade { position: absolute; inset: 0; pointer-events: none; }
  .evening .shade { background: linear-gradient(90deg, rgb(14 9 5 / .35) 0%, rgb(14 9 5 / .45) 45%, rgb(14 9 5 / .78) 100%); }
  .dusk .shade { background: linear-gradient(90deg, rgb(14 9 5 / .7) 0%, rgb(14 9 5 / .2) 38%, transparent 60%); }
  .bay .shade { background: linear-gradient(90deg, rgb(4 20 18 / .62) 0%, rgb(4 20 18 / .18) 40%, transparent 62%), linear-gradient(0deg, rgb(4 20 18 / .35), transparent 30%); }
  .s-txt { position: absolute; top: clamp(32px, 6%, 80px); width: var(--stxt-w); z-index: 3; }
  .s-left { left: var(--gutter); }
  .s-right { right: var(--gutter); top: auto; bottom: 34%; }
  .st { font-family: 'NohemiV', sans-serif; font-weight: 600; font-size: var(--t-h); line-height: 1; letter-spacing: -.03em; margin-top: 14px; }
  .ss { margin-top: 16px; font-size: 18px; line-height: 1.5; opacity: .92; }
  /* wysokość sceny biurka: min(100vw * 937/1678, 100vh); telefon dostaje jawną wysokość i szerokość z proporcji bryły 543x1125 */
  .case { --desk-h: min(55.84vw, 100vh); --bay-h: max(560px, min(100vh, 66vw)); --stxt-w: min(30vw, 380px); }
  .scene :global(.ph) { position: absolute; z-index: 2; height: var(--ph-h); width: calc(var(--ph-h) * 543 / 1125); }
  .scene :global(.ph-s1) { --ph-h: calc(var(--desk-h) * .84); top: 8%; left: 50%; translate: -50% 0; }
  .laptop { position: absolute; left: 33.402%; top: 30.950%; width: 33.224%; height: 37.193%; overflow: hidden; border-radius: .2vw; background: #fcfff5; }
  .laptop :global(.loop) { position: absolute; inset: 0; }
  .laptop .glass { position: absolute; inset: 0; background: linear-gradient(115deg, transparent 28%, rgb(255 255 255 / .09) 40%, transparent 54%); pointer-events: none; }
  .scene :global(.ph-s2) { --ph-h: calc(var(--desk-h) * .62); right: 13%; bottom: 7%; }
  .bay { height: var(--bay-h); }
  .trio { position: absolute; inset: 6% var(--gutter) 6% 30%; display: flex; justify-content: center; align-items: center; gap: 2.5%; }
  .trio :global(.ph) { position: relative; --ph-h: calc(var(--bay-h) * .77); }
  .trio :global(.t-side) { --ph-h: calc(var(--bay-h) * .64); }
  .trio :global(.t-mid) { z-index: 3; }

  /* 5-9. Stacje w poziomie (D). Komputer: 5,4 ekranu przewinięcia, przypięty ekran, tor 5 slajdów przesuwany transformem. */
  /* urządzenia liczone jak w dawnej scenie (od szerokości), żeby w niskich oknach nie wchodziły na tekst; trio mieści się
     obok tekstu stacji (szerokość trzech telefonów z odstępami to ok. 1,04 wysokości sceny) */
  .stations { position: relative; height: calc(100vh * 5.4); --desk-h: min(100vh, 55.84vw); --bay-h: min(100vh, (100vw - 2 * var(--gutter) - var(--stxt-w) - 4vw) / 1.04); }
  .stations .trio { left: calc(var(--gutter) + var(--stxt-w) + 2vw); }
  .st-pin { position: sticky; top: 0; height: 100vh; overflow: hidden; }
  .st-track { display: flex; width: 500%; height: 100%; }
  .station { position: relative; flex: 0 0 20%; height: 100%; overflow: hidden; }
  .stations .scene { position: absolute; inset: 0; height: auto; aspect-ratio: auto; max-height: none; }
  /* tło sceny na całą wysokość slajdu (`.case img { height: auto }` wygrywał i pod zdjęciem zostawał ciemny pas) */
  .stations .scene .scene-bg { height: 100%; }
  /* zamówienie: zdjęcie z ekranem laptopa trzyma proporcje 1678:937 i wypełnia slajd jak cover, więc laptop zostaje na ekranie zdjęcia */
  .stations .desk-img { inset: auto; left: 50%; top: 50%; width: max(100%, 100vh * 1678 / 937); aspect-ratio: 1678 / 937; translate: -50% -50%; }
  /* zieleń: tekst z lewej, ekran z prawej, całość w jednym ekranie (miejsce na lockup u góry i pigułkę na dole) */
  .green { background: var(--green); color: var(--on-green); }
  .g-slide { position: absolute; inset: 0; box-sizing: border-box; max-width: 1440px; margin-inline: auto; display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(32px, 4vw, 72px); align-items: center; padding: clamp(96px, 13vh, 140px) var(--gutter) clamp(88px, 12vh, 120px); }
  .g-media { justify-self: end; width: min(100%, (100vh - 280px) * 1.6); }
  .green .ss { max-width: 30em; }
  .green .cap { color: rgb(243 246 236 / .7); margin-top: 14px; }
  .screen { position: relative; border-radius: 14px; overflow: hidden; box-shadow: 0 0 0 1px rgb(0 0 0 / .18), 0 30px 80px -20px rgb(0 0 0 / .45), 0 12px 24px -12px rgb(0 0 0 / .35); background: #fff; }
  .screen :global(.loop) { aspect-ratio: 1920 / 1200; }
  .green .screen img { width: 100%; }

  /* Szczegóły stacji pod sekcją: numer i nazwa, zdanie „dla kogo”, opis */
  .st-details { padding-block: clamp(72px, 9vw, 136px) clamp(48px, 6vw, 88px); }
  .st-details ol { border-top: 1px solid var(--rule); }
  .dr { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 4fr) minmax(0, 5fr); gap: 20px clamp(24px, 3vw, 48px); padding-block: clamp(28px, 3vw, 44px); border-bottom: 1px solid var(--rule); }
  .dr-n { font-family: 'NohemiV', sans-serif; font-weight: 600; font-size: 24px; line-height: 1.15; letter-spacing: -.02em; }
  .dr-n .lbl { display: block; margin-bottom: 10px; font-family: 'GeneralSansV', sans-serif; letter-spacing: .12em; color: var(--dim); }
  .dr-for { display: grid; gap: 28px; align-content: start; }
  .for { font-family: 'NohemiV', sans-serif; font-weight: 500; font-size: clamp(20px, 1.7vw, 26px); line-height: 1.2; letter-spacing: -.02em; max-width: 16em; }
  .for span:first-child { color: var(--dim); }
  .dtxt { font-size: var(--t-body); line-height: 1.65; max-width: 34em; }
  .reg { margin-top: 24px; border-top: 1px solid var(--rule); }
  .reg li { padding: 12px 0; border-bottom: 1px solid var(--rule); font-size: 15px; }
  .repo { font-size: 15px; line-height: 1.5; padding-top: 16px; border-top: 1px solid currentColor; opacity: .85; max-width: 26em; }

  /* 10. Reszta systemu */
  .rest { padding-block: clamp(96px, 11vw, 168px) clamp(64px, 7vw, 104px); }
  .rest-grid { margin-top: clamp(48px, 5vw, 72px); display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 40px clamp(16px, 1.8vw, 28px); }
  .rest-grid .r4 { grid-column: span 3; }
  .rest-grid .r3 { grid-column: span 4; }
  .rest-grid img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; object-position: top; border-radius: 8px; box-shadow: 0 0 0 1px var(--rule), 0 14px 30px -18px rgb(0 0 0 / .35); }
  .rest-grid a { display: block; color: inherit; text-decoration: none; border-radius: 8px; }
  .rest-grid img { transition: transform .3s ease, box-shadow .3s ease; }
  .rest-grid a:hover img { transform: translateY(-3px); box-shadow: 0 0 0 1px var(--rule), 0 20px 36px -18px rgb(0 0 0 / .45); }
  .rest-grid a:hover .cap { text-decoration: underline; text-underline-offset: 3px; }
  .rest-grid .cap { margin-top: 12px; color: var(--ink); }

  .scale { padding-block: clamp(56px, 7vw, 104px); border-top: 1px solid var(--rule); }
  .quote { padding-block: clamp(64px, 8vw, 120px) clamp(96px, 11vw, 168px); }
  .quote blockquote p { font-family: 'NohemiV', sans-serif; font-weight: 500; font-size: clamp(28px, 3.4vw, 48px); line-height: 1.18; letter-spacing: -.025em; max-width: 22em; }
  .quote figcaption { margin-top: 24px; font-size: 15px; color: var(--dim); }
  .quote figcaption a { color: inherit; text-underline-offset: 3px; }

  /* 12. Koniec */
  .end { background: var(--green); color: var(--on-green); }
  .end-in { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 32px 64px; align-items: end; padding-block: clamp(80px, 10vw, 152px) clamp(56px, 7vw, 104px); }
  .end-in p { font-size: 20px; line-height: 1.5; max-width: 24em; }
  .btn { display: inline-block; margin-top: 28px; padding: 16px 32px; border-radius: 999px; background: var(--brand); color: var(--ink); text-decoration: none; font-size: 16px; font-weight: 600; }
  .btn:hover { background: #fff; }
  .more { margin-top: 20px; font-size: 16px !important; }
  .more a { color: inherit; text-underline-offset: 4px; }
  /* biały obrys na zieleni: :is(a, button) jak w regule ogólnej, inaczej wygrywał zielony obrys (niewidoczny na zieleni) */
  .end :is(a, button):focus-visible { outline-color: #fff; }
  /* następna realizacja: wiersz w tym samym zielonym bloku, nad nim cienka linia (układ i skala jak .next-n w Cannversity) */

    /* Sceny na telefonie: tekst na górze kadru, urządzenie pod nim, nic w dolnych 10% */
    .scene { aspect-ratio: auto; max-height: none; }
    /* tło sceny wypełnia całą wysokość (runda 5): `.case img { height: auto }` wygrywał z .scene-bg i pod zdjęciem zostawał pusty brązowy pas */
    .scene .scene-bg { height: 100%; }
    .desk { height: 760px; }
    .evening .shade { background: linear-gradient(180deg, rgb(14 9 5 / .82) 0%, rgb(14 9 5 / .55) 34%, rgb(14 9 5 / .4) 100%); }
    .dusk .shade { background: linear-gradient(180deg, rgb(14 9 5 / .82) 0%, rgb(14 9 5 / .35) 30%, transparent 55%); }
    .bay .shade { background: linear-gradient(180deg, rgb(4 20 18 / .7) 0%, rgb(4 20 18 / .2) 32%, transparent 55%); }
    .s-txt, .s-right, .s-left { left: var(--gutter); right: var(--gutter); top: 32px; bottom: auto; width: auto; }
    .st { font-size: 36px; }
    .ss { font-size: 16px; max-width: 22em; }
    .scene :global(.ph-s1) { --ph-h: 520px; top: auto; bottom: 48px; }
    /* zamówienie: zdjęcie biurka powiększone tak, żeby ekran laptopa wypełnił ok. 83% szerokości */
    .desk-img { inset: auto; left: -75%; width: 250%; top: 200px; aspect-ratio: 1678 / 937; height: auto; }
    .dusk .scene-bg { position: absolute; }
    .scene :global(.ph-s2) { --ph-h: 330px; right: 6%; bottom: 40px; }
    .bay { height: 780px; min-height: 0; }
    .trio { inset: auto 0 48px; height: 540px; }
    .trio :global(.ph) { --ph-h: 540px; }
    .detail { grid-template-columns: 1fr; gap: 28px; padding-block: 40px 88px; }
    .detail > .dtxt, .detail > :first-child { grid-column: 1; }
    .green .g-head { margin-bottom: 32px; }
    .chat { margin-top: 20px; }
    .chat img { width: 100%; border-radius: 12px; }
    .rest-grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 14px; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); scroll-padding-inline: var(--gutter); scrollbar-width: none; }
    .rest-grid li { flex: 0 0 84%; scroll-snap-align: start; }
    /* miejsce na obrys fokusu kafla (przewijany pas obcina wszystko poza sobą) */
    .rest-grid { padding-block: 8px; margin-block: calc(clamp(48px, 5vw, 72px) - 8px) -8px; }
    .end-in { grid-template-columns: 1fr; }
    .thesis { padding-bottom: 160px; }
    .next-in { flex-direction: column; align-items: flex-start; gap: 12px; }
    .pill { bottom: calc(14px + env(safe-area-inset-bottom, 0px)); }
  }
  @media (max-width: 380px) {
    .scene :global(.ph-s1) { --ph-h: 470px; }
    .trio { height: 480px; }
    .trio :global(.ph) { --ph-h: 480px; }
  }
</style>

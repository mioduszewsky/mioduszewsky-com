  .cards { --k-top: 12px; --k-h: calc(100vh - 2 * var(--k-top)); --k-pad: clamp(24px, 3.2vw, 56px); --k-tw: min(36%, 440px);
    --k-tt: max(clamp(28px, 7vh, 72px), calc(var(--case-lockup-h) - var(--k-top))); --steps-h: 64px; padding-inline: 12px; display: flow-root; }
  .card { position: sticky; top: var(--k-top); height: var(--k-h); margin-bottom: 24px; border-radius: 22px; overflow: hidden; isolation: isolate;
    --fg: #fff; --fg-dim: rgb(255 255 255 / .62); --kl: rgb(255 255 255 / .28); color: var(--fg); transform-origin: 50% 0; }
  /* ostatnia karta też z dolnym marginesem (flow-root na .cards trzyma go w kontenerze): przyklejenie liczy się z marginesem
     do końca treści kontenera, bez tego karty pod ostatnią wystawały nad nią o 12 px */
  .k-dark { background: #2a2018; }
  .k-cream { background: #f1ede1; --fg: var(--ink); --fg-dim: rgb(28 25 23 / .55); --kl: rgb(28 25 23 / .2); }
  .k-green { background: var(--green); }
  .k-ink { background: #171513; }
  .k-bg { position: absolute; inset: 0; z-index: -1; }
  /* `.case img { height: auto }` wygrywał z samym `.k-bg img` i pod zdjęciem zostawał pas */
  .case .k-bg img { width: 100%; height: 100%; object-fit: cover; }
  /* D3: pod dłuższym tekstem (opis i „dla kogo”) cień trzyma się do ~40% szerokości */
  .k-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgb(14 9 5 / .84) 0%, rgb(14 9 5 / .72) 36%, rgb(14 9 5 / .16) 62%), linear-gradient(0deg, rgb(14 9 5 / .6), transparent 22%); }
  .k-bay .k-shade { background: linear-gradient(90deg, rgb(4 20 18 / .82) 0%, rgb(4 20 18 / .62) 36%, transparent 60%), linear-gradient(0deg, rgb(4 20 18 / .65), transparent 24%); }
  .k-dim { position: absolute; inset: 0; z-index: 5; background: #000; opacity: 0; pointer-events: none; }
  /* tekst: to samo miejsce w każdej karcie */
  .k-txt { position: absolute; left: var(--k-pad); top: var(--k-tt); width: var(--k-tw); }

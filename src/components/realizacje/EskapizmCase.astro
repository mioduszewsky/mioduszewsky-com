  @media (max-width: 767px) {
    .case { --t-body: 17px; }
    .m-only { display: block; }
    .d-only, .case :global(.d-only) { display: none !important; }
    .lead { font-size: 18px; }
    .open { height: 100svh; min-height: 440px; max-height: 920px; }
    .meta { grid-template-columns: 1fr 1fr; }
    .nums, .nums.four { grid-template-columns: 1fr; gap: 36px; }

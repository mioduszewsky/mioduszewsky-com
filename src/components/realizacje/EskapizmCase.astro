  .btn { display: inline-block; margin-top: 32px; padding: 16px 32px; border-radius: 999px; background: var(--brand); color: var(--ink); text-decoration: none; font-size: 16px; font-weight: 600; }
  .btn:hover { background: #fff; }
  .end :focus-visible { outline-color: #fff; }
  .end .more { margin-top: 24px; }
  .end .more a { color: #fff; text-decoration-color: var(--brand); text-underline-offset: 4px; font-size: 16px; }

  @media (max-width: 1100px) {
    .bname { font-size: 15px; }
    .bsys { display: none; }
  }
  @media (max-width: 900px) {
    .d-only { display: none; }
    .m-only { display: block; }
    .meta { grid-template-columns: 1fr; gap: 14px; }
    /* Telefon: eksponaty od krawędzi do krawędzi, tekst nad albo pod, jedna oś do lewej. */
    .film-frame, .film figcaption { width: auto; }
    .film { padding-inline: 0; }
    .film-frame { border-radius: 0; box-shadow: none; }
    .film figcaption { padding-inline: var(--gutter); text-align: left; }
    .lines { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 16px; justify-content: start; }
    .lines li + li::before { content: none; }
    .txt.cols, .txt.cols2 { grid-template-columns: 1fr; }
    .shot-wide { padding-inline: 0; }
    .shot-wide img { border-radius: 0; box-shadow: none; }
    .shot-wide figcaption { padding-inline: var(--gutter); }
    /* Pasek: na telefonie zostaje sama etykieta, bieżącą stację pokazuje pigułka na dole. */
    .route-bar { position: static; background: none; backdrop-filter: none; border: 0; }
    .bar-in { padding-block: 0 24px; }
    .bar-stops { display: none; }
    .route-pill { display: block; position: fixed; left: 50%; bottom: 16px; z-index: 70; transform: translate(-50%, 140%); opacity: 0; padding: 10px 18px; border-radius: 999px; background: var(--ink); color: #fff; font-family: 'EskCrimson', serif; font-weight: 600; font-size: 16px; white-space: nowrap; box-shadow: 0 10px 30px -8px rgb(0 0 0 / .45); transition: transform .3s, opacity .3s; pointer-events: none; }
    .route-pill.on { transform: translate(-50%, 0); opacity: 1; }
    .route-pill .pn { font-family: 'EskMono', ui-monospace, monospace; font-weight: 400; font-size: 12px; margin-right: 4px; opacity: .75; }

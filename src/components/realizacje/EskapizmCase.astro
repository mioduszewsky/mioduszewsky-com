  .end .next:focus-visible { outline-offset: -6px; }

  /* Pigułka stacji */
  .pill { position: fixed; z-index: 80; left: 50%; bottom: calc(18px + env(safe-area-inset-bottom, 0px)); transform: translateX(-50%); display: flex; align-items: center; gap: 12px; padding: 10px 16px 10px 14px; border-radius: 999px; background: rgb(28 25 23 / .82); color: #fff; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); font-size: 14px; white-space: nowrap; box-shadow: 0 10px 30px rgb(0 0 0 / .25); }
  .pill[hidden] { display: none; }
  .pill-n { font-size: 12px; letter-spacing: .1em; opacity: .7; }
  .pill-t { font-weight: 600; }
  .pill-dots { display: flex; gap: 5px; margin-left: 4px; }
  .pill-dots i { width: 6px; height: 6px; border-radius: 50%; background: rgb(255 255 255 / .3); }

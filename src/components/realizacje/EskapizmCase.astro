  .screen { border-radius: 10px; overflow: hidden; background: #fff; box-shadow: 0 30px 60px -30px rgb(28 25 23 / .45), 0 0 0 1px var(--rule); }
  .set .screen { width: 84%; }
  .set-phone { position: absolute; right: var(--gutter); bottom: 0; width: 18%; max-width: 240px; border-radius: 22px; overflow: hidden; box-shadow: 0 0 0 6px var(--ink), 0 30px 60px -20px rgb(28 25 23 / .55); }

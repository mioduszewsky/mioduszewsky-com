  .green .screen img { width: 100%; }

  /* 10. Reszta systemu */
  .rest { padding-block: clamp(96px, 11vw, 168px) clamp(64px, 7vw, 104px); }
  .rest-grid { margin-top: clamp(48px, 5vw, 72px); display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 40px clamp(16px, 1.8vw, 28px); }
  .rest-grid .r4 { grid-column: span 3; }
  .rest-grid .r3 { grid-column: span 4; }
  .rest-grid img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; object-position: top; border-radius: 8px; box-shadow: 0 0 0 1px var(--rule), 0 14px 30px -18px rgb(0 0 0 / .35); }
  .rest-grid a { display: block; color: inherit; text-decoration: none; border-radius: 8px; }
  .rest-grid img { transition: transform .3s ease, box-shadow .3s ease; }
  .rest-grid a:hover img { transform: translateY(-3px); box-shadow: 0 0 0 1px var(--rule), 0 20px 36px -18px rgb(0 0 0 / .45); }
  .rest-grid a:hover .cap { text-decoration: underline; text-underline-offset: 3px; }

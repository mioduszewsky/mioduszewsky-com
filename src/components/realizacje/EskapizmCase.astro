  .strip ul { display: flex; gap: 20px; width: max-content; padding: 4px var(--edge) 20px; }
  .strip li { flex: 0 0 auto; width: 576px; scroll-snap-align: start; }
  .strip img { aspect-ratio: 16 / 10; object-fit: cover; border-radius: 8px; box-shadow: 0 0 0 1px var(--rule); }
  .scale { margin-top: 28px; font-family: 'EskMono', ui-monospace, monospace; font-size: 14px; display: flex; flex-wrap: wrap; gap: 6px 0; }

  '@graph': [
    { '@type': 'Article', headline: T.h2, inLanguage: locale,
      about: pl ? 'System eskapizmu: kalkulator, zamówienie z fakturą, AI Plan Builder, plan w telefonie i panel, eskapizm.com' : 'The eskapizm system: calculator, ordering with invoices, AI Plan Builder, the plan on the phone and the dashboard, eskapizm.com',
      author: { '@type': 'Person', name: 'Kacper Mioduszewski', url: 'https://mioduszewsky.com' + T.homeHref },
      image: 'https://mioduszewsky.com/realizacje/eskapizm/otwarcie-poster.jpg',
      mainEntityOfPage: url },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'mioduszewsky', item: 'https://mioduszewsky.com' + T.homeHref },
      { '@type': 'ListItem', position: 2, name: 'eskapizm', item: url } ] },
  ],
};
---
<!-- Przed publikacją: robots „index, follow, max-image-preview:large” (jak u Igora), dopiero po zgodzie w rejestrze (npm run verify:zgody) i TAK Kacpra. -->
<VariantLayout title={T.title} description={T.description} bg="#FCFFF5" fg="#1c1917" switcher={false} robots="noindex, nofollow" locale={locale} alternatePath={T.alt}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <div class="case">
    <a class="skip" href="#main">{T.skip}</a>
    <header class="nav">
      <a class="mark" href={T.homeHref} aria-label={T.home}>
        <video autoplay loop muted playsinline preload="metadata" aria-hidden="true" poster="/logo3d/logo-nav-poster.webp">
          <source src="/logo3d/logo-nav.mp4" type="video/mp4;codecs=hvc1" />
          <source src="/logo3d/logo-nav.webm" type="video/webm" />
        </video>
      </a>
      <SiteMenu locale={locale} alternatePath={T.alt} />
    </header>

    <main id="main">
      <article>
        <!-- 1. Otwarcie: sama nazwa na filmie, pełny ekran -->
        <header class="open">
          <Loop name="otwarcie" mobile="otwarcie-m" w={1920} h={1200} mw={720} mh={1558} alt={T.filmAlt} eager class="open-film" />
          <div class="open-scrim" aria-hidden="true"></div>
          <div class="open-txt">
            <p class="lbl">{T.label}</p>
            <h1>eskapizm</h1>
          </div>
        </header>

        <!-- 2. Teza -->
        <section class="thesis wrap" aria-labelledby="thesis-h">
          <h2 id="thesis-h" class="h" set:html={P(T.h2)} />
          <p class="lead" set:html={P(T.lead)} />
          <dl class="meta">{T.meta.map(([k, v]) => <div><dt class="lbl">{k}</dt><dd>{v}</dd></div>)}</dl>
        </section>

        <!-- 3. Problem: trzy liczby, potem kaskada okien z filmu -->
        <section class="problem" aria-label={pl ? 'Problem' : 'The problem'}>
          <ul class="nums wrap">
            {T.nums.map(([n, u, c, s]) => (
              <li><p class="n"><span>{n}</span> <span class="u">{u}</span></p><p class="c" set:html={P(c)} /><p class="src lbl">{s}</p></li>
            ))}
          </ul>
          <figure class="kaskada">
            <picture>
              <source media="(max-width: 767px)" srcset={kaskadaMSet} sizes="100vw" />
              <Image src={kaskadaD} widths={[1280, 1920, 2560, 2880]} sizes="100vw" alt={T.kaskadaAlt} loading="lazy" />
            </picture>
            <figcaption class="wrap cap" set:html={P(T.kaskadaCap)} />
          </figure>
        </section>

        <!-- 4. Mapa systemu -->
        <nav class="map wrap" aria-labelledby="map-h">
          <div class="map-head">
            <h2 id="map-h" class="h" set:html={P(T.mapH)} />
            <p class="lbl">{T.mapPlan}</p>
          </div>
          <ol class="map-list">
            {T.stops.map(([n, w], i) => (
              <li><a href={`#stacja-${num(i)}`}><span class="lbl">{num(i)}</span><span class="mn">{n}</span><span class="mw">{w}</span></a></li>
            ))}
          </ol>
        </nav>

        <!-- 5. Stacja 01: biurko wieczorem, telefon z kalkulatorem -->
        <section class="station" id="stacja-01" data-station="0" aria-labelledby="s1-h">
          <div class="scene desk evening">
            <img class="scene-bg" srcset={biurkoSet} sizes="100vw" src={biurkoSrc} width="3356" height="1874" alt="" loading="lazy" decoding="async" />
            <div class="shade" aria-hidden="true"></div>
            <div class="s-txt s-right"><p class="lbl">01</p><h2 id="s1-h" class="st" set:html={P(T.s1.t)} /><p class="ss" set:html={P(T.s1.s)} /></div>
            <EskapizmPhone class="ph ph-s1" dark>
              <Loop name="kalkulator" w={600} h={1298} alt={T.s1.alt} />
            </EskapizmPhone>
          </div>
          <div class="detail wrap">
            <p class="for"><span>{T.s1.f[0]}:</span> <span set:html={P(T.s1.f[1])} /></p>
            <div class="dtxt"><p set:html={P(T.s1.d)} /></div>
          </div>
        </section>

        <!-- 6. Stacja 02: zamówienie na ekranie laptopa z tej samej sceny, telefon z płatnością obok -->
        <section class="station" id="stacja-02" data-station="1" aria-labelledby="s2-h">
          <div class="scene desk dusk">
            <div class="desk-img">
              <img class="scene-bg" srcset={biurkoSet} sizes="(max-width: 767px) 250vw, 100vw" src={biurkoSrc} width="3356" height="1874" alt="" loading="lazy" decoding="async" />
              <!-- prostokąt ekranu laptopa z silnika filmu: PHOTO.scr [560.5, 290, 557.5, 348.5] na 1678x937 -->
              <div class="laptop"><Loop name="zamowienie" w={960} h={600} alt={T.s2.alt} /><i class="glass" aria-hidden="true"></i></div>
            </div>
            <div class="shade" aria-hidden="true"></div>
            <div class="s-txt s-left"><p class="lbl">02</p><h2 id="s2-h" class="st" set:html={P(T.s2.t)} /><p class="ss" set:html={P(T.s2.s)} /></div>
            <EskapizmPhone class="ph ph-s2" dark>
              <Loop name="platnosc" w={600} h={1298} alt={T.s2.altPhone} />
            </EskapizmPhone>
          </div>
          <div class="detail wrap">
            <p class="for"><span>{T.s2.f[0]}:</span> <span set:html={P(T.s2.f[1])} /></p>
            <div class="dtxt"><p set:html={P(T.s2.d)} /><ul class="reg">{T.s2.reg.map((r) => <li>{r}</li>)}</ul></div>
          </div>
        </section>

        <!-- 7. Stacja 03: warsztat Justyny na zieleni -->
        <section class="station green" id="stacja-03" data-station="2" aria-labelledby="s3-h">
          <div class="wrap g-head"><p class="lbl">03</p><h2 id="s3-h" class="st" set:html={P(T.s3.t)} /><p class="ss" set:html={P(T.s3.s)} /></div>
          <div class="wrap">
            <div class="screen"><Loop name="builder" mobile="builder-m" w={1920} h={1200} mw={780} mh={488} alt={T.s3.alt} /></div>
            <figure class="chat m-only"><Image src={builderCzat} widths={[390, 780]} sizes="100vw" alt={T.s3.altChat} loading="lazy" /></figure>
          </div>
          <div class="detail wrap">
            <p class="for"><span>{T.s3.f[0]}:</span> <span set:html={P(T.s3.f[1])} /></p>
            <div class="dtxt"><p set:html={P(T.s3.d)} /></div>
          </div>
        </section>

        <!-- 8. Stacja 04: zatoka Phi Phi, trio telefonów (kulminacja) -->
        <section class="station" id="stacja-04" data-station="3" aria-labelledby="s4-h">
          <div class="scene bay">
            <picture>
              <source media="(max-width: 767px)" srcset={zatokaPionSet} sizes="100vw" />
              <Image class="scene-bg" src={zatoka} widths={[1280, 1920, 2560]} sizes="100vw" alt={T.s4.sceneAlt} loading="lazy" />
            </picture>
            <div class="shade" aria-hidden="true"></div>
            <div class="s-txt s-left"><p class="lbl">04</p><h2 id="s4-h" class="st" set:html={P(T.s4.t)} /><p class="ss" set:html={P(T.s4.s)} /></div>
            <div class="trio">
              <EskapizmPhone class="ph t-side d-only" tilt={-5} dark><Image src={trio[0]} widths={[300, 600]} sizes="300px" alt={T.s4.alts[0]} loading="lazy" /></EskapizmPhone>
              <EskapizmPhone class="ph t-mid" dark><Loop name="moj-plan" w={600} h={1298} alt={T.s4.altPlan} /></EskapizmPhone>
              <EskapizmPhone class="ph t-side d-only" tilt={5} dark><Image src={trio[1]} widths={[300, 600]} sizes="300px" alt={T.s4.alts[1]} loading="lazy" /></EskapizmPhone>
            </div>
          </div>
          <div class="detail wrap">
            <div class="for-col">
              <p class="for"><span>{T.s4.f[0]}:</span> <span set:html={P(T.s4.f[1])} /></p>
              <figure class="narr">
                <div class="screen sm"><Loop name="narrator" w={1120} h={700} alt={T.s4.narrAlt} desktopOnly /></div>
                <figcaption class="cap" set:html={P(T.s4.narr)} />
              </figure>
            </div>
            <div class="dtxt"><p set:html={P(T.s4.d)} /></div>
          </div>
        </section>

        <!-- 9. Stacja 05: panel na zieleni -->
        <section class="station green" id="stacja-05" data-station="4" aria-labelledby="s5-h">
          <div class="wrap g-head"><p class="lbl">05</p><h2 id="s5-h" class="st" set:html={P(T.s5.t)} /><p class="ss" set:html={P(T.s5.s)} /></div>
          <figure class="wrap">
            <div class="screen"><Image src={issues} widths={[780, 1280, 1920, 2560]} sizes="(max-width: 1320px) 100vw, 1200px" alt={T.s5.alt} loading="lazy" /></div>
            <figcaption class="cap" set:html={P(T.s5.cap)} />
          </figure>
          <div class="detail wrap">
            <div class="for-col">
              <p class="for"><span>{T.s5.f[0]}:</span> <span set:html={P(T.s5.f[1])} /></p>
              <p class="repo" set:html={P(T.s5.repo)} />
            </div>
            <div class="dtxt"><p set:html={P(T.s5.d)} /></div>
          </div>
        </section>

        <!-- 10. Reszta systemu: 4 + 3 -->
        <section class="rest wrap" aria-labelledby="rest-h">
          <h2 id="rest-h" class="h" set:html={P(T.restH)} />
          <p class="lead" set:html={P(T.restP)} />
          <ul class="rest-grid">
            {rest.map((img, i) => (
              <li class={i < 4 ? 'r4' : 'r3'}>
                <Image src={img} widths={[640, 960, 1280]} sizes={i < 4 ? '(max-width: 767px) 84vw, 25vw' : '(max-width: 767px) 84vw, 33vw'} alt={T.rest[i][1]} loading="lazy" />
                <p class="cap">{T.rest[i][0]}</p>
              </li>
            ))}
          </ul>
        </section>

        <!-- 11. Liczby skali i cytat Justyny -->
        <section class="scale wrap" aria-label={pl ? 'Skala' : 'Scale'}>
          <ul class="nums four">{T.scale.map(([n, c]) => <li><p class="n"><span>{n}</span></p><p class="c">{c}</p></li>)}</ul>
        </section>
        <figure class="quote wrap">
          <blockquote><p>{T.quote}</p></blockquote>
          <figcaption>{T.quoteBy}<a href={quoteHref} target="_blank" rel="noopener">{T.quoteSrc}</a></figcaption>
        </figure>
      </article>

      <!-- 12. Koniec: kontakt i następny case (bez linku, dopóki case Cannversity nie jest gotowy, decyzja Fincha 19.10) -->
      <section class="end" aria-labelledby="end-h">
        <div class="wrap end-in">
          <h2 id="end-h" class="h" set:html={P(T.endH)} />
          <div>
            <p set:html={P(T.endP)} />
            <a class="btn" href={T.contact}>{T.btn}</a>
            <p class="more"><a href={T.moreHref}>{T.more}</a></p>
          </div>
        </div>
        <div class="next">
          <Image src={cannversity} widths={[780, 1440, 2048]} sizes="100vw" alt={T.nextAlt} loading="lazy" />
          <div class="next-txt wrap"><p class="lbl">{T.next} · {T.nextNote}</p><p class="next-name">{T.nextName}</p></div>
        </div>
      </section>
    </main>

    <div class="pill" data-pill hidden aria-hidden="true"><span class="pill-n"></span><span class="pill-t"></span><span class="pill-dots">{stations.map(() => <i></i>)}</span></div>
    <BrandFooter locale={locale} inset />
  </div>
</VariantLayout>

<script>
  // Wideo (Loop.astro): źródło wstawiane ok. ekran przed sekcją, desktop albo telefon; gra tylko w widoku.
  // Przy prefers-reduced-motion wideo się nie ładuje, zostaje plakat.
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const narrow = matchMedia('(max-width: 767px)');
  const loops = [...document.querySelectorAll<HTMLElement>('.case [data-loop]')];
  // WebKit odrzuca play() tuż po wczytaniu strony (NotAllowedError, pomiar 19.10: 261 ms) mimo muted i playsinline: ponów kilka razy, póki pętla jest w widoku
  const play = (el: HTMLElement, v: HTMLVideoElement, n = 0) => v.play().catch(() => { if (n < 4) setTimeout(() => { if (el.dataset.inview && !still.matches && v.paused) play(el, v, n + 1); }, 700); });
  // zwraca true, gdy pętla ma już źródło (wtedy obserwacja „blisko” nie jest potrzebna)
  const load = (el: HTMLElement): boolean => {
    if (el.dataset.loaded) return true;
    const v = el.querySelector('video'); if (!v) return true;
    if (narrow.matches && el.dataset.desktopOnly !== undefined) return false; // na telefonie zostaje plakat
    const m = narrow.matches && el.dataset.mMp4;
    const webm = m ? el.dataset.mWebm : el.dataset.dWebm, mp4 = m ? el.dataset.mMp4 : el.dataset.dMp4;
    v.poster = (m ? el.dataset.mPoster : el.dataset.dPoster) || '';
    // MP4 H.264 pierwsze: dekodowane sprzętowo na Macu i iPhonie; WebM VP9 w Chrome z GPU gubił 29% klatek otwarcia (pomiar 19.10)
    if (mp4) { const s = document.createElement('source'); s.src = mp4; s.type = 'video/mp4'; v.append(s); }
    if (webm) { const s = document.createElement('source'); s.src = webm; s.type = 'video/webm'; v.append(s); }
    v.preload = 'auto'; v.load(); el.dataset.loaded = '1';
    // obserwatory odpalają się w dowolnej kolejności, a WebKit odrzuca play() w trakcie wczytywania:
    // pętla w widoku rusza, gdy da się ją odtworzyć
    v.addEventListener('canplay', () => { if (el.dataset.inview && !still.matches && v.paused) play(el, v); });
    return true;
  };
  const near = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting && !still.matches && load(e.target as HTMLElement)) near.unobserve(e.target); }), { rootMargin: '100% 0px' });
  const seen = new IntersectionObserver((es) => es.forEach((e) => {
    const v = (e.target as HTMLElement).querySelector('video');
    if (!v) return;
    (e.target as HTMLElement).dataset.inview = e.isIntersecting ? '1' : '';
    if (e.isIntersecting && !still.matches && (e.target as HTMLElement).dataset.loaded) play(e.target as HTMLElement, v); else v.pause();
  }), { threshold: .15 });
  loops.forEach((el) => {
    if (el.offsetParent === null && getComputedStyle(el).position !== 'fixed') return; // ukryta wersja (d-only na telefonie) nie ładuje się wcale
    const v = el.querySelector('video');
    if (v && v.hasAttribute('data-autoplay')) { // otwarcie: źródło już w HTML, tu tylko pauza poza widokiem i przy reduced motion
      el.dataset.loaded = '1';
      if (still.matches) { v.removeAttribute('autoplay'); v.pause(); }
      seen.observe(el); return;
    }
    near.observe(el); seen.observe(el);
  });
  // zmiana ustawienia w trakcie: pauza od razu; po wyłączeniu ograniczenia ruchu ponowna obserwacja, żeby niewczytane pętle się wczytały
  still.addEventListener('change', () => loops.forEach((el) => {
    const v = el.querySelector('video'); v && v.pause();
    if (v && v.hasAttribute('data-autoplay')) { if (!still.matches) { v.load(); } }
    else if (!el.dataset.loaded) { near.unobserve(el); near.observe(el); }
    seen.unobserve(el); seen.observe(el);
  }));

  // Pigułka stacji: numer i nazwa bieżącej stacji, widoczna tylko w trakcie stacji.
  const pill = document.querySelector<HTMLElement>('[data-pill]');
  const st = [...document.querySelectorAll<HTMLElement>('[data-station]')];
  const names = [...document.querySelectorAll<HTMLElement>('.map-list .mn')].map((e) => e.textContent || '');
  let cur = -2, tick = false;
  const upd = () => {
    tick = false; if (!pill) return;
    const line = innerHeight * .5; let idx = -1;
    st.forEach((s, i) => { const r = s.getBoundingClientRect(); if (r.top <= line && r.bottom > line) idx = i; });
    if (idx === cur) return; cur = idx;
    pill.hidden = idx < 0;
    if (idx >= 0) {
      pill.querySelector('.pill-n')!.textContent = String(idx + 1).padStart(2, '0');
      pill.querySelector('.pill-t')!.textContent = names[idx] || '';
      pill.querySelectorAll('.pill-dots i').forEach((d, i) => d.classList.toggle('on', i === idx));
    }
  };
  addEventListener('scroll', () => { if (!tick) { tick = true; requestAnimationFrame(upd); } }, { passive: true });
  upd();
</script>

<style>
  @font-face { font-family: 'NohemiV'; src: url('/fonts/Nohemi-Variable.woff2') format('woff2'); font-weight: 100 900; font-display: swap; }
  @font-face { font-family: 'GeneralSansV'; src: url('/fonts/GeneralSans-Variable.woff2') format('woff2'); font-weight: 200 700; font-display: swap; }
  /* Układ: sceny pełnoekranowe (biurko wieczorem, zieleń warsztatu, zatoka), pod każdą wąska kolumna szczegółów.
     Pismo: dwie rodziny, pięć stopni (nazwa, liczby, nagłówek, tekst, podpis) + etykieta. */
  .case {
    --paper: #fcfff5; --ink: #1c1917; --dim: #57534e; --rule: rgb(28 25 23 / .14);
    --green: #1e3b25; --on-green: #f3f6ec; --brand: #ffcc33;
    --gutter: clamp(20px, 5vw, 96px);
    --t-name: clamp(84px, 13.2vw, 190px); --t-num: clamp(64px, 8.4vw, 124px); --t-h: clamp(32px, 3.9vw, 56px);
    --t-body: 18px; --t-cap: 14px;
    font-family: 'GeneralSansV', sans-serif; background: var(--paper); color: var(--ink); overflow-x: clip; font-size: var(--t-body); line-height: 1.6;
  }
  h1, h2, p, figure, ol, ul, dl, dd, blockquote { margin: 0; }
  ol, ul { padding: 0; list-style: none; }
  .case :is(h1, h2) { text-wrap: balance; }
  .case p { text-wrap: pretty; }
  .case :is(a, button):focus-visible { outline: 3px solid var(--green); outline-offset: 4px; }
  .case ::selection { background: var(--brand); color: var(--ink); }
  .case img { display: block; max-width: 100%; height: auto; }
  .skip { position: fixed; top: 12px; left: 12px; z-index: 150; padding: 12px 20px; background: var(--brand); color: var(--ink); transform: translateY(-200%); }
  .skip:focus { transform: none; }
  .nav { background: var(--paper); height: 104px; box-sizing: border-box; padding: 24px var(--gutter); display: flex; align-items: center; justify-content: space-between; position: relative; z-index: 90; }
  .mark video { width: clamp(155px, 18vw, 220px); display: block; filter: drop-shadow(0 5px 10px rgb(0 0 0 / .18)); }
  .wrap { max-width: 1320px; margin-inline: auto; padding-inline: var(--gutter); box-sizing: border-box; }
  .m-only { display: none; }

  .lbl { font-size: 12px; line-height: 1.3; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; }
  .h { font-family: 'NohemiV', sans-serif; font-weight: 600; font-size: var(--t-h); line-height: 1.04; letter-spacing: -.03em; max-width: 15em; }
  .lead { font-size: 20px; line-height: 1.55; max-width: 34em; margin-top: 28px; color: var(--dim); }
  .cap { font-size: var(--t-cap); line-height: 1.5; color: var(--dim); }

  /* 1. Otwarcie */
  .open { position: relative; height: min(calc(100vh - 104px), 62.5vw); min-height: 460px; background: #2a2018; color: #fff; overflow: hidden; }
  .open :global(.open-film) { position: absolute; inset: 0; }
  /* film pod nazwą bywa jasny i gęsty (kaskada okien), więc dół kadru zawsze ciemny */
  .open-scrim { position: absolute; inset: 0; background: linear-gradient(0deg, rgb(12 8 4 / .86) 0%, rgb(12 8 4 / .62) 30%, rgb(12 8 4 / .2) 52%, transparent 66%), linear-gradient(90deg, rgb(12 8 4 / .4), transparent 62%); pointer-events: none; }
  /* nazwa nad paskiem cookies serwisu (pierwsza wizyta) i nad paskami przeglądarki */
  .open-txt { position: absolute; left: var(--gutter); right: var(--gutter); bottom: clamp(56px, 5vw, 80px); }
  .open h1 { font-family: 'NohemiV', sans-serif; font-weight: 600; font-size: var(--t-name); line-height: .86; letter-spacing: -.05em; margin-top: 18px; }
  .open .lbl { opacity: .9; }

  /* 2. Teza */
  .thesis { padding-block: clamp(80px, 10vw, 160px) clamp(56px, 7vw, 104px); }
  .meta { margin-top: clamp(48px, 5vw, 72px); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px 32px; border-top: 1px solid var(--rule); padding-top: 20px; }
  .meta dt { color: var(--dim); }
  .meta dd { margin-top: 8px; font-size: 15px; line-height: 1.5; }

  /* 3. Problem i 11. Skala: liczby */
  .nums { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px clamp(24px, 4vw, 64px); }
  .nums.four { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .nums .n { font-family: 'NohemiV', sans-serif; font-weight: 600; font-size: var(--t-num); line-height: .9; letter-spacing: -.045em; font-variant-numeric: tabular-nums; }
  .nums .u { font-size: .32em; letter-spacing: -.02em; }
  .nums .c { margin-top: 18px; font-size: 16px; line-height: 1.5; max-width: 22em; }
  .nums .src { margin-top: 12px; color: var(--dim); font-size: 11px; }

---
// Case study Cannversity (19.10.2026), kierunek A „Żółte pole” z otwarciem z C „Jedno kliknięcie w żółć”,
// wybrany przez Kacpra 19.10. Tablica: docs/case-studies/cannversity/runda-1/TABLICA.html.
// Otwarcie: menu mioduszewsky.com na kremie, pozycja „Branża konopna” podkreślona żółcią (ten sam #ffcc33
// co akcent Cannversity) i przy przewijaniu ta żółć zalewa ekran. Dalej case leży na żółci Cannversity.
// Decyzje Kacpra 19.10: case prosty i krótki, bez wyników, leadów i klientów; newsletter zdjęty z cannversity.com.
// Treść: docs/case-studies/cannversity/COPY.md i COPY-EN.md, fakty: FAKTY.md. Nagrania i zrzuty z żywej
// cannversity.com (PL) i /en (EN), robione po zdjęciu newslettera, bez banera (strona nie ma bramki zgody).
import VariantLayout from '../../layouts/VariantLayout.astro';
import SiteMenu from '../SiteMenu.astro';
import BrandFooter from '../BrandFooter.astro';
import { cannabisHref } from '../../content/cannabis';
import type { Locale } from '../../i18n/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const pl = locale === 'pl';
const P = (t: string) => pl ? t.replace(/(^|[\s(„])([wziouaWZIOUA]) /g, '$1$2&nbsp;') : t;
const self = pl ? '/pl/realizacje/cannversity/' : '/work/cannversity/';
const alt = pl ? '/work/cannversity/' : '/pl/realizacje/cannversity/';
const url = `https://mioduszewsky.com${self}`;
const live = cannabisHref('realizacje', locale);
// Bez parametru service: formularz kontaktu nie zna usługi „strona” i i tak by go odrzucił (recenzja Codexa 19.10).
const contact = pl ? '/pl/kontakt/#ctForm' : '/contact/#ctForm';
// Ujęcia: PL z cannversity.com, EN z cannversity.com/en. Sekcja o dwóch językach w obu wersjach pokazuje /en.
const dir = `/case/cannversity/${pl ? 'pl' : 'en'}`;

const T = pl ? {
  title: 'Cannversity: landing dla branży konopnej, który prowadzi do jednej rozmowy · mioduszewsky',
  description: 'Cannversity to moja usługa dla founderów i marek z branży konopnej. Zrobiłem do niej prosty landing po polsku i po angielsku, który prowadzi do bezpłatnej, 30-minutowej rozmowy.',
  skip: 'Przejdź do treści',
  home: 'mioduszewsky. Strona główna.',
  note: 'W menu mioduszewsky.com jest pozycja „Branża konopna”. Prowadzi tutaj.',
  menuTop: 'Rozejrzyj się', menuClose: 'Zamknij',
  menu: ['Strona główna', 'Usługi', 'Branża konopna', 'Kontakt'],
  kicker: 'Własny projekt',
  h1: 'Landing dla branży konopnej, który prowadzi do jednej rozmowy.',
  lead: 'Cannversity to moja usługa dla founderów i marek z branży konopnej: strategia, MVP i strony, doradztwo. Ta sama robota co pod mioduszewsky, w jednej branży. Zrobiłem do niej prosty landing po polsku i po angielsku. Ma jeden cel: umówić bezpłatną, 30-minutową rozmowę.',
  live: 'Zobacz cannversity.com',
  vidDesk: 'Nagranie cannversity.com na komputerze: hasło „Od pomysłu do produktu. W branży konopnej.”, trzy sytuacje na żółtym tle, sekcja „Co dostajesz, zamiast zgadywać” i proces w trzech krokach.',
  vidPhone: 'Nagranie cannversity.com na telefonie: hasło, przycisk „Umów bezpłatną rozmowę” i trzy sytuacje, od których zaczyna się współpraca.',
  band: ['Od pomysłu do produktu.', 'W branży konopnej.'],
  bandCap: 'Hasło z pierwszego ekranu cannversity.com',
  h2a: 'Najpierw sytuacja, potem oferta, na końcu rozmowa.',
  blocks: [
    ['Dla kogo', 'Strona mówi do founderów i marek z branży konopnej. Na start pokazuje trzy sytuacje, od których zwykle zaczyna się współpraca: pomysł, który trzeba sprawdzić, MVP albo strona do zbudowania, projekt, który utknął.'],
    ['Co pokazuje', 'Niżej są trzy filary oferty: Strategy & Roadmap, MVP & Product Build i Business Advisory, każdy z listą tego, co dostajesz. Sekcja „O Cannversity” mówi wprost, że za projektem stoję ja. Przy imporcie, rejestracji produktu i regulacjach pytam ludzi, którzy robią to od lat.'],
    ['Do czego prowadzi', 'Przycisk do kalendarza Google stoi w menu i w siedmiu sekcjach strony. Wybierasz w nim termin bezpłatnej rozmowy: 30 minut, online. Kto woli napisać, ma na dole formularz.'],
  ],
  capFilary: 'Trzy filary oferty',
  altFilary: 'Sekcja „Trzy filary. Jeden cel.” na cannversity.com: Strategy & Roadmap, MVP & Product Build i Business Advisory, każdy z listą „Co dostajesz”.',
  capRozmowa: 'Sekcja „Zaczynamy od rozmowy”: 30 minut, online, bezpłatnie',
  altRozmowa: 'Sekcja „Zaczynamy od rozmowy” na cannversity.com: trzy kroki rozmowy, przycisk „Wybierz termin w kalendarzu” i karta „0 zł, pierwsza rozmowa jest bezpłatna”.',
  h2b: 'Po polsku i po angielsku, pod własną domeną.',
  langTxt: [
    'Wersja angielska ma własny adres cannversity.com/en. Angielski tytuł i opis są już w kodzie tej strony, więc link wysłany za granicę od razu pokazuje się po angielsku. Regulamin i polityka prywatności też są w obu językach.',
    'Pierwszą wersję zrobiłem szybko w Lovable. We wrześniu 2026 sam przepisałem treść, dodałem angielskie metadane i przeniosłem stronę na własny hosting, pod domenę cannversity.com.',
  ],
  capEn: 'cannversity.com/en',
  altEn: 'Pierwszy ekran cannversity.com/en: „From idea to product. In cannabis.” i przycisk „Book a free call”.',
  h2end: 'Twoja oferta też potrzebuje jednej prostej strony?',
  endTxt: 'Napisz, co sprzedajesz i komu. Odpiszę, jak ułożyłbym taką stronę.',
  btn: 'Napisz do mnie',
  headline: 'Landing dla branży konopnej, który prowadzi do jednej rozmowy',
  about: 'Cannversity, usługa Kacpra Mioduszewskiego dla branży konopnej, cannversity.com',
} : {
  title: 'Cannversity: a cannabis industry landing page built to book one call · mioduszewsky',
  description: 'Cannversity is my service for cannabis founders and brands. I built it a simple landing page in Polish and English that leads to a free 30-minute call.',
  skip: 'Skip to content',
  home: 'mioduszewsky. Home.',
  note: 'The mioduszewsky.com menu has a “Cannabis industry” link. This is where it goes.',
  menuTop: 'Take a look', menuClose: 'Close',
  menu: ['Home', 'Services', 'Cannabis industry', 'Contact'],
  kicker: 'My own project',
  h1: 'A cannabis industry landing page built to book one call.',
  lead: 'Cannversity is my service for cannabis founders and brands: strategy, MVPs and websites, advisory. It’s the same work I do as mioduszewsky, focused on one industry. I built it a simple landing page in Polish and English. It has one job: get you to book a free 30-minute call.',
  live: 'See cannversity.com',
  vidDesk: 'Screen recording of cannversity.com/en on a laptop: the headline “From idea to product. In cannabis.”, three situations on yellow, the “What you get instead of guessing” section and the three-step process.',
  vidPhone: 'Screen recording of cannversity.com/en on a phone: the headline, the “Book a free call” button and the three situations people come in with.',
  band: ['From idea to product.', 'In cannabis.'],
  bandCap: 'The headline on the first screen of cannversity.com/en',
  h2a: 'The situation first, then the offer, then the call.',
  blocks: [
    ['Who it’s for', 'The page talks to founders and brands in the cannabis industry. It opens with the three situations people usually come in with: an idea that needs testing, an MVP or a website to build, a project that’s stuck.'],
    ['What it shows', 'Next come the three pillars of the offer: Strategy & Roadmap, MVP & Product Build and Business Advisory, each with a list of what you get. The “About Cannversity” section says plainly that I’m the one behind it. For import, product registration and regulation, I ask people who’ve been doing it for years.'],
    ['Where it leads', 'The Google Calendar button sits in the menu and in seven sections of the page. You pick a slot for a free call: 30 minutes, online. If you’d rather write, there’s a form at the bottom.'],
  ],
  capFilary: 'The three pillars of the offer',
  altFilary: 'The “Three pillars. One goal.” section of cannversity.com/en: Strategy & Roadmap, MVP & Product Build and Business Advisory, each with a “What you get” list.',
  capRozmowa: 'The “We start with a conversation” section: 30 minutes, online, free',
  altRozmowa: 'The “We start with a conversation” section of cannversity.com/en: three steps of the call, a calendar button and a card saying the first call is free.',
  h2b: 'Polish and English, on its own domain.',
  langTxt: [
    'The English version lives at cannversity.com/en. Its English title and description are baked into the page’s code, so a link you send abroad shows up in English straight away. The terms and the privacy policy come in both languages too.',
    'I built the first version fast, in Lovable. In September 2026 I rewrote the copy myself, added the English metadata and moved the site to my own hosting, on the cannversity.com domain.',
  ],
  capEn: 'cannversity.com/en',
  altEn: 'The first screen of cannversity.com/en: “From idea to product. In cannabis.” and a “Book a free call” button.',
  h2end: 'Does your offer need one simple page too?',
  endTxt: 'Tell me what you sell and who to. I’ll write back with how I’d lay that page out.',
  btn: 'Write to me',
  headline: 'A cannabis industry landing page built to book one call',
  about: 'Cannversity, Kacper Mioduszewski’s service for the cannabis industry, cannversity.com',
};

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Article', headline: T.headline, inLanguage: locale, about: T.about,
      author: { '@type': 'Person', name: 'Kacper Mioduszewski', url: pl ? 'https://mioduszewsky.com/pl/' : 'https://mioduszewsky.com/' },
      image: `https://mioduszewsky.com${dir}/strona-1440.webp`, mainEntityOfPage: url },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'mioduszewsky', item: pl ? 'https://mioduszewsky.com/pl/' : 'https://mioduszewsky.com/' },
      { '@type': 'ListItem', position: 2, name: 'Cannversity', item: url } ] },
  ],
};
---
<VariantLayout title={T.title} description={T.description} bg="#f8f9f2" fg="#111111" switcher={false}
  robots="index, follow, max-image-preview:large" locale={locale} alternatePath={alt}>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <div class="case">
    <a class="skip" href="#main">{T.skip}</a>
    <header class="nav">
      <a class="mark" href={pl ? '/pl/' : '/'} aria-label={T.home}>
        <video autoplay loop muted playsinline preload="metadata" aria-hidden="true" poster="/logo3d/logo-nav-poster.webp">
          <source src="/logo3d/logo-nav.mp4" type="video/mp4;codecs=hvc1" />
          <source src="/logo3d/logo-nav.webm" type="video/webm" />
        </video>
      </a>
      <SiteMenu locale={locale} alternatePath={alt} />
    </header>

    <main id="main">
      <article>
        <!-- Otwarcie: menu mioduszewsky.com, żółte podkreślenie „Branża konopna” zalewa ekran przy przewijaniu. -->
        <section class="jump" aria-label={T.note}>
          <div class="jump-pin">
            <div class="jump-in">
              <p class="jump-note">{T.note}</p>
              <div class="menu-card" aria-hidden="true">
                <div class="menu-top"><span>{T.menuTop}</span><span>{T.menuClose} ×</span></div>
                {T.menu.map((m, i) => i === 2
                  ? <p class="mi hot"><span class="hl">{m}</span><span class="ext">↗</span></p>
                  : <p class="mi">{m}</p>)}
              </div>
            </div>
            <div class="flood" aria-hidden="true"></div>
          </div>
        </section>

        <header class="stage">
          <div class="wrap">
            <p class="kicker">{T.kicker}</p>
            <h1>{T.h1}</h1>
            <p class="lead" set:html={P(T.lead)} />
          </div>
          <div class="wrap set">
            <div class="screen">
              <video class="vid" loop muted playsinline preload="metadata" width="1440" height="900" poster={`${dir}/strona-1440.webp`} aria-label={T.vidDesk}>
                <source src={`${dir}/strona-1440.webm`} type="video/webm" />
                <source src={`${dir}/strona-1440.mp4`} type="video/mp4" />
              </video>
            </div>
            <div class="phone">
              <video class="vid" loop muted playsinline preload="metadata" width="390" height="664" poster={`${dir}/telefon.webp`} aria-label={T.vidPhone}>
                <source src={`${dir}/telefon.webm`} type="video/webm" />
                <source src={`${dir}/telefon.mp4`} type="video/mp4" />
              </video>
            </div>
          </div>
          <div class="wrap live"><a href={live} target="_blank" rel="noopener">{T.live}<span aria-hidden="true"> ↗</span></a></div>
        </header>

        <figure class="band">
          <blockquote lang={pl ? 'pl' : 'en'}><p>{T.band[0]}</p><p>{T.band[1]}</p></blockquote>
          <figcaption class="wrap">{T.bandCap}</figcaption>
        </figure>

        <section class="paper">
          <div class="wrap">
            <h2>{T.h2a}</h2>
            <div class="trio">
              {T.blocks.map(([h, t]) => (
                <div><h3>{h}</h3><p set:html={P(t)} /></div>
              ))}
            </div>
          </div>
          <div class="wrap pair">
            <figure>
              <!-- Filary na telefonie: ta sama sekcja w układzie z komputera, w całości (wersja z telefonu ma 1800 px wysokości). -->
              <img src={`${dir}/filary-1440.webp`} loading="lazy" alt={T.altFilary} />
              <figcaption>{T.capFilary}</figcaption>
            </figure>
            <figure>
              <picture>
                <source media="(max-width: 700px)" srcset={`${dir}/rozmowa-390.webp`} />
                <img src={`${dir}/rozmowa-1440.webp`} loading="lazy" alt={T.altRozmowa} />
              </picture>
              <figcaption>{T.capRozmowa}</figcaption>
            </figure>
          </div>
        </section>

        <section class="ink">
          <div class="wrap duo">
            <div>
              <h2>{T.h2b}</h2>
              <div class="txt">{T.langTxt.map((t) => <p set:html={P(t)} />)}</div>
            </div>
            <figure class="en">
              <picture>
                <source media="(max-width: 700px)" srcset="/case/cannversity/en/en-390.webp" />
                <img src="/case/cannversity/en/en-1440.webp" loading="lazy" alt={T.altEn} />
              </picture>
              <figcaption>{T.capEn}</figcaption>
            </figure>
          </div>
        </section>
      </article>

      <section class="end" aria-labelledby="end-h">
        <div class="wrap end-in">
          <h2 id="end-h">{T.h2end}</h2>
          <div>
            <p>{T.endTxt}</p>
            <a class="btn" href={contact}>{T.btn}</a>
            <p class="more"><a href={live} target="_blank" rel="noopener">{T.live}<span aria-hidden="true"> ↗</span></a></p>
          </div>
        </div>
      </section>
    </main>
    <BrandFooter locale={locale} inset />
  </div>
</VariantLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  // Pętle nagrań bez atrybutu autoplay: startuje je tylko skrypt, w ekranie i bez prefers-reduced-motion.
  // Bez JS albo przy reduced motion zostaje plakat (recenzja Codexa 19.10).
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const vids = document.querySelectorAll<HTMLVideoElement>('.case video.vid');
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    const v = e.target as HTMLVideoElement;
    if (e.isIntersecting && !still.matches) v.play().catch(() => {}); else v.pause();
  }), { threshold: .2 });
  vids.forEach((v) => io.observe(v));

  // Jedno kliknięcie w żółć: koło żółci rośnie z podkreślenia „Branża konopna”, prowadzone scrollem.
  // Bez JS i przy prefers-reduced-motion sekcja jest zwykłym ekranem z menu, a żółta scena idzie zaraz pod nim.
  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const jump = document.querySelector<HTMLElement>('.jump');
    const pin = jump?.querySelector<HTMLElement>('.jump-pin');
    const hl = jump?.querySelector<HTMLElement>('.hl');
    const flood = jump?.querySelector<HTMLElement>('.flood');
    if (!jump || !pin || !hl || !flood) return;
    jump.classList.add('on');
    const origin = () => {
      const p = pin.getBoundingClientRect(), h = hl.getBoundingClientRect();
      const x = h.left - p.left + h.width / 2, y = h.top - p.top + h.height / 2;
      const r = Math.hypot(Math.max(x, p.width - x), Math.max(y, p.height - y));
      return { x, y, r };
    };
    let o = origin();
    const st = ScrollTrigger.create({
      trigger: jump, start: 'top top', end: 'bottom bottom', scrub: true,
      invalidateOnRefresh: true, onRefresh: () => { o = origin(); },
      onUpdate: (self) => {
        // Pierwsza ćwierć: nic, czytelnik widzi menu. Potem żółć rośnie aż do brzegów ekranu.
        const t = gsap.utils.clamp(0, 1, (self.progress - .22) / .7);
        const e = gsap.parseEase('power2.in')(t);
        flood.style.clipPath = `circle(${(o.r * e).toFixed(1)}px at ${o.x.toFixed(1)}px ${o.y.toFixed(1)}px)`;
      },
    });
    return () => { st.kill(); jump.classList.remove('on'); flood.style.clipPath = ''; };
  });
  window.addEventListener('pagehide', () => mm.revert(), { once: true });
</script>

<style>
  .case {
    --ivory: #f8f9f2; --ink: #111; --dim: #5f5b4e; --rule: rgb(17 17 17 / .16);
    /* Żółć Cannversity hsl(45 100% 60%) = #ffcc33, ten sam kolor co akcent mioduszewsky. */
    --cann: #ffcc33; --black: #141414; --blue: #0522ff;
    --gutter: clamp(20px, 5vw, 96px); --focus: var(--ink);
    font-family: 'GeneralSansV', sans-serif; background: var(--ivory); color: var(--ink); overflow-x: clip;
  }
  @font-face { font-family: 'NohemiV'; src: url('/fonts/Nohemi-Variable.woff2') format('woff2'); font-weight: 100 900; font-display: swap; }
  @font-face { font-family: 'GeneralSansV'; src: url('/fonts/GeneralSans-Variable.woff2') format('woff2'); font-weight: 200 700; font-display: swap; }
  /* Krój Cannversity (Inter, gruba kursywa jak w hero cannversity.com), tylko do hasła strony. */
  @font-face { font-family: 'InterCann'; font-style: italic; font-weight: 800 900; font-display: swap; src: url('/fonts/cannversity/inter-italic-latin-ext.woff2') format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF; }
  @font-face { font-family: 'InterCann'; font-style: italic; font-weight: 800 900; font-display: swap; src: url('/fonts/cannversity/inter-italic-latin.woff2') format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
  .case :is(h1,h2,h3,p,figure,blockquote) { margin: 0; }
  .case :is(h1,h2) { text-wrap: balance; }
  .case p { text-wrap: pretty; }
  .case :is(a,button):focus-visible { outline: 3px solid var(--focus); outline-offset: 4px; }
  .case ::selection { background: var(--cann); color: var(--ink); }
  .skip { position: fixed; top: 12px; left: 12px; z-index: 150; padding: 12px 20px; background: var(--cann); color: var(--ink); transform: translateY(-200%); }
  .skip:focus { transform: none; }
  .nav { height: 104px; box-sizing: border-box; padding: 24px var(--gutter); display: flex; align-items: center; justify-content: space-between; position: relative; z-index: 90; }
  .mark video { width: clamp(155px, 18vw, 220px); height: auto; display: block; filter: drop-shadow(0 5px 10px rgb(0 0 0 / .26)); }
  .wrap { max-width: 1320px; margin-inline: auto; padding-inline: var(--gutter); box-sizing: border-box; }

  /* Otwarcie. Bez JS: zwykły ekran. Z JS (.on): sekcja dłuższa, ekran przyklejony, żółć rośnie. */
  .jump { position: relative; }
  .jump.on { height: 230svh; }
  .jump-pin { position: relative; min-height: calc(100svh - 104px); display: grid; place-items: center; padding: 24px var(--gutter) 64px; box-sizing: border-box; overflow: hidden; }
  .jump.on .jump-pin { position: sticky; top: 0; height: 100svh; min-height: 0; }
  .jump-in { width: min(520px, 100%); }
  .jump-note { font-size: clamp(18px, 1.6vw, 21px); line-height: 1.5; margin-bottom: 28px !important; max-width: 26em; }
  .menu-card { box-sizing: border-box; padding: 28px 32px 32px; background: var(--ivory); border: 1px solid #0003; border-radius: 16px; box-shadow: 0 24px 80px #0002; }
  .menu-top { display: flex; justify-content: space-between; gap: 16px; margin-bottom: 24px; font-size: 13px; }
  .mi { padding: 12px 0; font-family: 'NohemiV', sans-serif; font-size: clamp(24px, 3vw, 38px); font-weight: 520; letter-spacing: -.035em; line-height: 1.3; }
  .mi.hot { display: flex; align-items: center; gap: 12px; }
  /* Podkreślenie żółcią, jak zakreślacz w hero mioduszewsky.com. */
  .hl { background: linear-gradient(transparent 18%, var(--cann) 18%, var(--cann) 88%, transparent 88%); padding-inline: 4px; margin-inline: -4px; }
  .ext { font-size: 22px; color: var(--blue); }
  .flood { position: absolute; inset: 0; background: var(--cann); clip-path: circle(0 at 50% 50%); pointer-events: none; display: none; }
  .jump.on .flood { display: block; }

  /* Scena na żółci Cannversity. */
  .stage { background: var(--cann); padding: clamp(32px, 6vw, 80px) 0 clamp(48px, 6vw, 80px); overflow: clip; }

  .cann { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; margin-top: 40px; padding: 32px 0; background: transparent; border: 0; border-block: 1px solid #00000024; gap: 24px 40px; }
  .cann-brand { display: block; margin: 0 0 12px; color: var(--blue); font-family: 'NohemiV', sans-serif; font-size: clamp(30px, 3vw, 42px); line-height: 1.2; font-weight: 520; letter-spacing: -.035em; text-transform: none; white-space: nowrap; }
  .cann-q { margin: 0; max-width: 52ch; font-family: 'GeneralSansV', sans-serif; font-size: 16px; line-height: 1.6; font-weight: 400; letter-spacing: 0; color: var(--body-ink); text-wrap: pretty; }

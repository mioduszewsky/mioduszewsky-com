<script>
  // Adapted from the user-supplied Motiq Holo Card (MIT): spring tilt, no idle loop.
  // Stable outer bounds prevent the moving card feeding back into pointer coordinates.
  const motion = matchMedia('(hover: hover) and (pointer: fine) and (min-width: 701px) and (prefers-reduced-motion: no-preference)');
  document.querySelectorAll<HTMLElement>('.services-index .rest-row').forEach(row => {
    const card = row.querySelector<HTMLElement>('.rest-link')!;
    const foil = row.querySelector<HTMLElement>('.card-foil')!;
    const glare = row.querySelector<HTMLElement>('.card-glare')!;
    let rx = 0, ry = 0, vx = 0, vy = 0, tx = 0, ty = 0, frame = 0, last = 0;
    const stop = () => {
      cancelAnimationFrame(frame); frame = 0; last = 0;
      rx = ry = vx = vy = tx = ty = 0;
      card.style.transform = ''; foil.style.transform = ''; glare.style.opacity = '0';
    };
    const tick = (now: number) => {
      const dt = Math.min((now - (last || now - 16)) / 1000, .032); last = now;
      vx += (120 * (tx - rx) - 10 * vx) * dt;
      vy += (120 * (ty - ry) - 10 * vy) * dt;
      rx += vx * dt; ry += vy * dt;
      card.style.transform = `rotateX(${rx}deg) rotateY(${ry}deg)`;
      foil.style.transform = `translate3d(${ry * 3}px, ${rx * 3}px, 0) rotate(${ry * 2}deg)`;
      if (Math.abs(tx-rx)+Math.abs(ty-ry)+Math.abs(vx)+Math.abs(vy) > .015) frame = requestAnimationFrame(tick);
      else { frame = 0; last = 0; }
    };
    const start = () => { if (!frame) frame = requestAnimationFrame(tick); };
    row.addEventListener('pointermove', event => {
      if (!motion.matches || event.pointerType !== 'mouse' || card.matches(':focus-visible')) return;
      const bounds = row.getBoundingClientRect();
      const x = Math.max(0, Math.min(1, (event.clientX - bounds.left) / bounds.width));
      const y = Math.max(0, Math.min(1, (event.clientY - bounds.top) / bounds.height));
      tx = -(y - .5) * 8; ty = (x - .5) * 10;
      glare.style.transform = `translate3d(${x * bounds.width - 220}px, ${y * bounds.height - 220}px, 0)`;
      glare.style.opacity = '1'; start();
    });
    const release = () => { tx = ty = 0; glare.style.opacity = '0'; if (motion.matches) start(); else stop(); };
    row.addEventListener('pointerleave', release);
    row.addEventListener('pointercancel', release);
    card.addEventListener('focus', stop);
    motion.addEventListener('change', stop);
    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); });
    const observer = new IntersectionObserver(entries => { if (!entries[0].isIntersecting) stop(); });
    observer.observe(row);
    window.addEventListener('pagehide', () => { stop(); observer.disconnect(); }, { once: true });
  });
</script>

  .rest-body, .card-bottom { position: relative; z-index: 2; }
  .card-bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; width: 100%; margin-top: auto; }
  .card-bottom .rest-price { color: var(--ink); margin: 0; max-width: 24ch; font-size: 15px; line-height: 1.5; letter-spacing: 0; text-transform: none; }
  .card-button { display: inline-block; border: 1px solid var(--ink); border-radius: 999px; padding: 14px 24px; background: var(--ink); color: var(--ivory); font-size: 12px; line-height: 1.45; letter-spacing: .1em; text-transform: uppercase; transition: color 150ms, background-color 150ms; }

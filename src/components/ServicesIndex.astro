---
import VariantLayout from '../layouts/VariantLayout.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import { services, servicePath } from '../content/services-pl';
import { servicesEn, serviceEnPath } from '../content/services-en';
import { servicesIndex } from '../content/services-index';
import { cannabisHref, cannabisCopy } from '../content/cannabis';
import { routes, type Locale } from '../i18n/site';
interface Props { locale?: Locale }
const { locale = 'pl' } = Astro.props;
const isPl = locale === 'pl';
const t = servicesIndex[locale];
const cann = cannabisCopy[locale];
const r = routes[locale];
const alternatePath = isPl ? '/services/' : '/pl/uslugi/';

// Cztery rownorzedne pozycje (decyzja Kacpra 17.09.2026, po pierwszym wdrozeniu).
// Poprzednia wersja otwierala ta strone wyroznionym blokiem strony internetowej. Kacper:
// „caly landing jest pod strone internetowa, a moze sie okazac, ze ktos trafi i nie bedzie
// potrzebowal strony, tylko czegos innego". Strona glowna jest w calosci pitchem pod www,
// wiec to jedyne miejsce, w ktorym widac reszte oferty — i nie moze powtarzac tego samego
// komunikatu. Flagowosci broni strona glowna, ta lista ma byc mapa, nie kolejnym pitchem.
// Strona internetowa zostaje pierwsza, bo jest najczestszym punktem wejscia — ale ta sama
// waga wizualna co pozostale trzy.
const items = [
  { nr: '01', name: t.webName, lead: t.webLead, price: t.webPrice, href: `${r.home}#oferta` },
  ...(isPl ? services : servicesEn)
    .filter((s) => !s.consultation)
    .map((s, i) => ({
      nr: String(i + 2).padStart(2, '0'),
      name: s.name,
      lead: (t.leads as Record<string, string>)[s.slug] ?? s.description,
      price: s.price || (isPl ? 'Porozmawiajmy o współpracy' : "Let's talk about it"),
      href: isPl ? servicePath(s) : serviceEnPath(s),
    })),
];

const contactFor = (service: string) => `${r.contact}?service=${encodeURIComponent(service)}#ctForm`;
const ui = isPl
  ? { skip: 'Przejdź do treści', home: 'Strona główna', homeAria: 'mioduszewsky. Strona główna.', nav: 'Nawigacja', legal: 'Informacje', privacy: 'Polityka prywatności', terms: 'Regulamin' }
  : { skip: 'Skip to content', home: 'Home', homeAria: 'mioduszewsky. Home page.', nav: 'Navigation', legal: 'Information', privacy: 'Privacy policy', terms: 'Terms of service' };
---
<VariantLayout title={t.title} description={t.description} bg="#f8f9f2" fg="#000000" switcher={false} robots="index, follow, max-image-preview:large" locale={locale} alternatePath={alternatePath}>
  <div class="service-page services-index">
    <a class="skip" href="#main">{ui.skip}</a>
    <header class="nav">
      <a class="mark" href={r.home} aria-label={ui.homeAria}>
        <video autoplay loop muted playsinline preload="metadata" aria-hidden="true" poster="/logo3d/logo-nav-poster.webp">
          <source src="/logo3d/logo-nav.mp4" type="video/mp4;codecs=hvc1" />
          <source src="/logo3d/logo-nav.webm" type="video/webm" />
        </video>
      </a>
      <nav class="nav-actions" aria-label={ui.nav}>
        <a class="home-link" href={r.home}>{ui.home}</a>
        <a class="home-link home-link-out" href={cannabisHref('nav', locale)} target="_blank" rel="noopener" aria-label={cann.navAria}><span class="cann-full">{cann.nav}</span><span class="cann-short">{cann.navShort}</span><span class="home-arr" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7" /><path d="M8 7h9v9" /></svg></span></a>
        <LanguageSwitch locale={locale} href={alternatePath} class="service-lang" />
      </nav>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <p class="label">( {t.label} )</p>
        <h1 id="hero-title">{t.h1a} <em>{t.h1b}</em></h1>
        <div class="hero-b">
          <div class="hero-sub"><p>{t.lead}</p></div>
        </div>
      </section>

      <section class="rest" aria-labelledby="rest-title">
        <h2 class="rest-label" id="rest-title">{t.restLabel}</h2>
        <ul class="rest-list">
          {items.map((s) => (
            <li class="rest-row">
              <a class="rest-link" href={s.href}>
                <span class="rest-nr" aria-hidden="true">{s.nr}</span>
                <span class="rest-body">
                  <span class="rest-name">{s.name}<span class="rest-arr" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7" /><path d="M8 7h9v9" /></svg></span></span>
                  <span class="rest-lead">{s.lead}</span>
                </span>
                <span class="rest-price">{s.price}</span>
              </a>
            </li>
          ))}
        </ul>

        <a class="cann" href={cannabisHref('uslugi', locale)} target="_blank" rel="noopener">
          <span class="cann-q">{cann.q}</span>
          <span class="cann-a">{cann.a}<span class="cann-arr" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7" /><path d="M8 7h9v9" /></svg></span></span>
        </a>
      </section>

      <section class="closing" aria-labelledby="closing-title">
        <h2 class="sec-h" id="closing-title">{t.closingH}</h2>
        <div class="closing-copy">
          <p>{t.closingP}</p>
          <a class="btn mag big" href={r.contact}><span class="btn-in">{t.closingCta}</span></a>
        </div>
      </section>
    </main>

    <footer class="service-footer">
      <a href="mailto:kacper@mioduszewsky.com" class="footer-mail">kacper@mioduszewsky.com</a>
      <nav aria-label={ui.legal}><a href={isPl ? '/pl/polityka-prywatnosci/' : '/privacy/'}>{ui.privacy}</a><a href={isPl ? '/pl/regulamin/' : '/terms/'}>{ui.terms}</a></nav>
    </footer>
  </div>
</VariantLayout>

<style>
  /* W5 subpages: literal existing nav/button/marker rules, then layout-only overrides.
     Current brief overrides old DESIGN.md palette and rejected notebook/catalog design. */
  .service-page {
    /* kanoniczna paleta marki (decyzja Kacpra 14.07.2026) */
    --ivory: #f8f9f2;
    --ink: #000000;
    --dim: #777265;
    --blue: #0522ff;
    --brand: #ffcc33;
    /* ring focusu: niebieski trzyma 7.4:1 na kremie, na czarnych bryłach
       przejmuje go żółć marki (13.9:1) — niebieski dawał tam 2.5:1 */
    --focus: var(--blue);
    font-family: 'GeneralSansV', sans-serif;
    background: var(--ivory);
    color: var(--ink);
    overflow-x: clip;
  }
  @font-face { font-family: 'NohemiV'; src: url('/fonts/Nohemi-Variable.woff2') format('woff2'); font-weight: 100 900; font-display: swap; }
  @font-face { font-family: 'ClashV'; src: url('/fonts/ClashDisplay-Variable.woff2') format('woff2'); font-weight: 200 700; font-display: swap; }
  @font-face { font-family: 'GeneralSansV'; src: url('/fonts/GeneralSans-Variable.woff2') format('woff2'); font-weight: 200 700; font-display: swap; }
  @font-face { font-family: 'GeneralSansV'; src: url('/fonts/GeneralSans-VariableItalic.woff2') format('woff2'); font-weight: 200 700; font-style: italic; font-display: swap; }

  .nav {
    position: fixed; inset-inline: 0; top: 0; z-index: 90;
    display: flex; align-items: center; justify-content: space-between;
    padding: 24px 3vw; pointer-events: none;
  }
  .nav a { pointer-events: auto; }
  .nav-actions { display: flex; align-items: center; gap: 14px; pointer-events: auto; }
  :global(.nav .language-switch) {
    color: var(--ink); text-decoration: none; font-size: 11px; font-weight: 650;
    letter-spacing: 0.14em; padding: 10px 4px; transition: color 0.25s;
  }
  :global(.nav .language-switch:hover) { color: var(--blue); }
  .nav { transition: translate 0.5s cubic-bezier(0.19, 1, 0.22, 1); }
  .nav.nav-hide { translate: 0 -130%; opacity: 0 !important; pointer-events: none; }
  .mark { display: block; }
  .mark video {
    height: clamp(46px, 4.6vw, 68px); width: auto; display: block;
    filter: drop-shadow(0 5px 10px color-mix(in srgb, var(--ink) 26%, transparent));
    transition: scale 0.4s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .mark:hover video { scale: 1.05; }

  .btn {
    /* reset `*` z VariantLayout jest scope'owany przez Astro i nie sięga tu:
       bez tego `width:100%` w stopce dokłada 68px paddingu i baton wychodzi poza ekran */
    box-sizing: border-box;
    display: inline-block; position: relative; text-decoration: none; color: var(--ink);
    border: 1px solid var(--ink); border-radius: 999px; padding: 10px 22px;
    font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase;
    background: var(--ivory);
    overflow: clip;
    transition: color 0.3s, border-color 0.3s, scale 0.18s ease-out;
    will-change: transform;
  }
  /* hover: tusz nalewa się od dołu (zamiast twardego przełącznika koloru) */
  .btn::before {
    content: ""; position: absolute; inset: 0; z-index: 0; background: var(--ink);
    transform: scaleY(0); transform-origin: bottom;
    transition: transform 0.45s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .btn .btn-in { display: inline-block; position: relative; z-index: 1; }
  .btn:hover { color: var(--ivory); }
  .btn:hover::before { transform: scaleY(1); }
  /* press: fizyczne dociśnięcie */
  .btn:active { scale: 0.96; }
  .btn.big { padding: 16px 34px; font-size: 13px; background: var(--ink); color: var(--ivory); }
  .btn.big::before { background: var(--blue); }
  .btn.big:hover { border-color: var(--blue); }
  /* nav „Book a call": nalewa się niebieskim (ujednolicenie z resztą niebieskich akcentów) */
  .nav .btn::before { background: var(--blue); }
  .nav .btn:hover { border-color: var(--blue); }
  /* chowa się, gdy poza hero — sticky-cta albo CTA stopki i tak są wtedy widoczne */
  .nav .btn { transition: opacity 0.3s, translate 0.3s, color 0.3s, border-color 0.3s, scale 0.18s ease-out; }
  .nav .btn.hide { opacity: 0; translate: 0 -8px; pointer-events: none; }
  /* baton w navie byl w tej samej skali co CTA w tresci i dusil gore strony */
  .nav .btn { padding: 9px 18px; font-size: 11px; letter-spacing: 0.12em; }
  .nav-actions { transition: opacity 0.4s cubic-bezier(0.19, 1, 0.22, 1), translate 0.4s cubic-bezier(0.19, 1, 0.22, 1); }
  .nav-actions.hide { opacity: 0; translate: 0 -8px; pointer-events: none; }

  .hero h1 em, .hero-sub em, .proj-d em, .foot-h em, .sec-h em, .lead-close em, .how-out em, .how-why-t em,
  .hero-sub p:last-child :global(strong), .closing .section-copy > p:first-child :global(strong) {
    font-style: normal;
    /* ujemny margines rownowazy padding: marker maluje sie szerzej niz glify,
       ale nie odsuwa sasiedniego przecinka ani spacji */
    padding: 0 0.08em; margin: 0 -0.08em;
    background:
      linear-gradient(100deg, transparent 1.5%, color-mix(in srgb, var(--brand) 72%, transparent) 6% 94%, transparent 98.5%)
      no-repeat 0 68% / 100% var(--mk-h, 56%);
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    transition: background-size 0.9s cubic-bezier(0.19, 1, 0.22, 1) 0.15s;
  }

  .service-page { --body-ink: #4c483c; --nav-height: 104px; --gutter: clamp(24px, 5vw, 96px); }
  .service-page :is(a,button):focus-visible { outline: 3px solid var(--focus); outline-offset: 5px; }
  .service-page :is(h1,h2,p) { margin: 0; }
  .service-page :is(h1,h2) { text-wrap: balance; overflow-wrap: break-word; }
  .service-page ::selection { background: var(--brand); color: var(--ink); }
  .service-page.has-cur :is(a,button) { cursor: none; }
  .skip { position: fixed; top: 12px; left: 12px; z-index: 150; padding: 12px 20px; background: var(--brand); color: var(--ink); transform: translateY(-200%); }
  .skip:focus { transform: none; }
  .nav { position: relative; height: var(--nav-height); box-sizing: border-box; padding: 24px var(--gutter); }
  .mark video { width: clamp(155px, 18vw, 220px); height: auto; }
  .home-link { display: inline-flex; align-items: center; min-height: 44px; color: var(--ink); font-size: 13px; text-underline-offset: 5px; }
  .service-lang { display: inline-flex; align-items: center; min-height: 44px; color: var(--ink); font-size: 13px; letter-spacing: .06em; text-decoration: none; }
  .service-lang:hover { text-decoration: underline; text-underline-offset: 5px; }
  /* Header + hero fill the first viewport, but grow with zoom/long copy. */
  .hero { box-sizing: border-box; min-height: calc(100svh - var(--nav-height)); padding: 64px var(--gutter) 104px; display: flex; flex-direction: column; justify-content: center; }
  .label { font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--dim); margin-bottom: 32px!important; }
  .hero h1 { font-family: 'NohemiV', 'ClashV', sans-serif; font-weight: 520; letter-spacing: -.025em; font-size: clamp(44px, 5.3vw, 80px); line-height: 1.1; max-width: 24ch; }
  .hero-b { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(48px, 8vw, 144px); align-items: start; margin-top: 48px; }
  .hero-sub { max-width: 58ch; font-size: clamp(16px, 1.3vw, 19px); line-height: 1.6; color: var(--body-ink); text-wrap: pretty; }
  .hero-sub p + p { margin-top: 20px; }
  .hero-sub :global(strong), .section-copy :global(strong) { font-weight: 650; color: var(--ink); }
  .hero-cta { padding-top: 4px; }
  .btn { text-align: center; max-width: 100%; line-height: 1.45; }
  .sec-h { font-family: 'NohemiV', 'ClashV', sans-serif; font-weight: 520; font-size: clamp(28px, 2.8vw, 40px); line-height: 1.15; letter-spacing: -.02em; max-width: 22ch; }
  .sec-h::before { content: ''; display: block; width: 40px; height: 5px; background: var(--brand); margin-bottom: 28px; }
  .service-footer { margin-inline: var(--gutter); padding: 56px 0; border-top: 1px solid color-mix(in srgb, var(--ink) 16%, transparent); display: flex; align-items: center; justify-content: space-between; gap: 32px; }
  .service-footer a { color: var(--ink); text-underline-offset: 6px; }
  .footer-mail { font-family: 'NohemiV', sans-serif; font-size: clamp(18px, 2vw, 28px); font-weight: 520; letter-spacing: -.02em; text-decoration-color: var(--blue); text-decoration-thickness: 2px; overflow-wrap: anywhere; }
  .service-footer nav { display: flex; gap: 24px; font-size: 12px; }
  .service-footer nav a { display: inline-flex; align-items: center; min-height: 44px; }
  @media (max-width: 960px) {
    .hero-b { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .hero h1 { font-size: clamp(40px, 6vw, 60px); }
    .hero { padding-block: 48px 80px; }
    .service-footer { align-items: flex-start; flex-direction: column; }
  }
  @media (max-width: 640px) {
    .service-page { --nav-height: 80px; --gutter: 24px; }
    .nav { padding-block: 16px; }
    .mark video { width: 142px; }
    .home-link { font-size: 12px; }
    .hero { padding-block: 40px 80px; }
    .label { font-size: 10px; letter-spacing: .14em; margin-bottom: 28px!important; }
    .hero h1 { font-size: clamp(32px, 8vw, 44px); line-height: 1.14; }
    .hero-b { margin-top: 32px; gap: 32px; }
    .hero-sub { font-size: 16px; }
    .hero-cta { padding: 0; }
    .btn.big { padding: 17px 18px; font-size: 12px; letter-spacing: .1em; }
    .hero-cta .btn, .closing-action .btn { width: 100%; }
    .sec-h { font-size: 28px; max-width: 23ch; line-height: 1.2; }
    .sec-h::before { margin-bottom: 24px; }
    .service-footer { padding-block: 40px; gap: 24px; }
    .service-footer nav { flex-wrap: wrap; gap: 8px 24px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .service-page *, .service-page *::before { animation: none!important; transition: none!important; }
  }

  /* ——— Strona „Usługi": spis, nie drugi front marki ———
     Flagowa oferta (01) dostaje wagę wizualną trzech pozostałych razem.
     Kontekst: docs/STRUKTURA-NAWIGACJA.md §3. */
  .services-index .hero { min-height: auto; padding-block: clamp(120px, 14vh, 190px) clamp(48px, 6vh, 72px); justify-content: flex-start; }
  .services-index .hero-b { grid-template-columns: minmax(0, 1fr); margin-top: 28px; }
  .services-index .hero-sub { max-width: 62ch; }


  .rest { padding: clamp(8px, 1.5vw, 18px) var(--gutter) clamp(48px, 6vw, 80px); }
  .rest-label { font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--dim); font-weight: 650; margin-bottom: 6px; }
  .rest-list { list-style: none; margin: 0; padding: 0; }
  .rest-row { border-top: 1px solid color-mix(in srgb, var(--ink) 16%, transparent); }
  .rest-link { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: clamp(14px, 2vw, 34px); align-items: baseline; padding: clamp(18px, 2.4vw, 28px) 0; text-decoration: none; color: inherit; transition: background 0.25s; }
  .rest-link:hover { background: color-mix(in srgb, var(--ink) 4%, transparent); }
  .rest-nr { font-size: 12px; font-weight: 650; color: var(--dim); font-variant-numeric: tabular-nums; }
  .rest-name { display: inline-flex; align-items: center; gap: 7px; font-family: 'NohemiV', 'ClashV', sans-serif; font-weight: 530; font-size: clamp(19px, 1.9vw, 25px); letter-spacing: -.01em; }
  .rest-arr { display: inline-flex; color: var(--blue); }
  .rest-arr svg { width: 15px; height: 15px; display: block; }
  .rest-lead { display: block; margin-top: 7px; max-width: 58ch; font-size: 14.5px; line-height: 1.55; color: var(--body-ink); text-wrap: pretty; }
  .rest-price { font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--dim); white-space: nowrap; }

  /* Wejscie konopne: filtr, nie piata usluga — odciete zolta linia i wlasnym rytmem. */
  .cann { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 1rem; margin-top: clamp(30px, 4vw, 46px); padding-top: clamp(16px, 2vw, 22px); border-top: 2px solid var(--brand); text-decoration: none; color: inherit; }
  .cann-q { font-size: clamp(16px, 1.5vw, 19px); font-weight: 650; }
  .cann-a { display: inline-flex; align-items: center; gap: 6px; font-size: clamp(14px, 1.3vw, 16px); color: var(--dim); transition: color 0.25s; }
  .cann-arr { display: inline-flex; color: var(--blue); }
  .cann-arr svg { width: 14px; height: 14px; display: block; }
  .cann:hover .cann-a { color: var(--ink); }

  .closing { padding: clamp(40px, 5vw, 72px) var(--gutter) clamp(56px, 7vw, 96px); border-top: 1px solid color-mix(in srgb, var(--ink) 16%, transparent); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 88px); align-items: start; }
  .closing-copy p { max-width: 52ch; font-size: clamp(15px, 1.2vw, 17px); line-height: 1.6; color: var(--body-ink); text-wrap: pretty; }
  .closing-copy .btn.big { margin-top: 24px; }

  /* Telefon: jedna os tekstu w calym bloku, bez dwoch krawedzi (ROLES/slawek.md). */
  @media (max-width: 860px) {
    .rest-link { grid-template-columns: auto minmax(0, 1fr); }
    .rest-price { grid-column: 2; margin-top: 8px; }
    .cann { flex-direction: column; gap: 4px; align-items: flex-start; }
    .services-index .hero h1 { font-size: clamp(30px, 8.4vw, 46px); text-wrap: balance; }
  }

  /* Nav podstron ma teraz cztery elementy (logo, Strona glowna, Uslugi, jezyk).
     Ta sama poprawka co na glownej: mniejsze logo i ciasniejszy padding przy waskim ekranie. */
  @media (max-width: 640px) {
    .nav { padding: 16px 4vw; gap: 8px; }
    .mark video { height: 34px; }
    .nav-actions { gap: 10px; }
    .home-link { font-size: 12px; }
  }

  .home-link-out { display: inline-flex; align-items: center; gap: 5px; text-decoration: none; }
  .home-link-out:hover { color: var(--blue); }
  .home-arr { display: inline-flex; color: var(--blue); }
  .home-arr svg { width: 12px; height: 12px; display: block; }
  .cann-short { display: none; }
  @media (max-width: 420px) {
    .cann-full { display: none; }
    .cann-short { display: inline; }
  }

  /* Ponizej 420 px nav podstrony mial pieć elementow (logo, Strona glowna, Uslugi, Konopie,
     jezyk) i wypychal przelacznik jezyka poza kadr przy 320 px. „Strona glowna" wypada,
     bo logo obok prowadzi dokladnie tam i zostaje z etykieta dla czytnikow ekranu. */
  @media (max-width: 420px) {
    .nav-actions > .home-link:first-of-type { display: none; }
  }
</style>
